  </data>
  <data name="Library_patrol_coverage_Name" xml:space="preserve">
    <value>Streifenabdeckung</value>
  </data>
  <data name="Library_patrol_coverage_Description" xml:space="preserve">
    <value>Heatmap der Einheitenpositionen der letzten 7 Tage: wo Streifen und Außendiensteinheiten ihre Zeit verbringen.</value>
  </data>
  <data name="Library_search_coverage_Name" xml:space="preserve">
    <value>Suchabdeckung</value>
  </data>
  <data name="Library_search_coverage_Description" xml:space="preserve">
    <value>Ein Raster der Mitgliederpositionen sowie Mitglieder- und Einheitenpfade der letzten 3 Tage, um zu sehen, welche Gebiete abgedeckt wurden.</value>
  </data>
  <data name="Library_incident_footprint_Name" xml:space="preserve">
    <value>Einsatzverlauf</value>
  </data>
  <data name="Library_incident_footprint_Description" xml:space="preserve">
    <value>Wählen Sie einen Einsatz, um zu sehen, wohin jede Einheit und jedes Mitglied bei dessen Abarbeitung gegangen ist: Pfade, Statuspositionen und woher die Einsatzkräfte kamen.</value>
