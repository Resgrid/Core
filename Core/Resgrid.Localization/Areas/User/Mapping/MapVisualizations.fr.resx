  <data name="Library_call_hot_zones_Name" xml:space="preserve">
    <value>Zones chaudes des appels</value>
  </data>
  <data name="Library_call_hot_zones_Description" xml:space="preserve">
    <value>Carte de chaleur de tous les appels des 12 derniers mois. Les zones les plus lumineuses sont celles où les appels se concentrent.</value>
  </data>
  <data name="Library_busiest_areas_Name" xml:space="preserve">
    <value>Secteurs les plus sollicités (grille)</value>
  </data>
  <data name="Library_busiest_areas_Description" xml:space="preserve">
    <value>Une grille hexagonale qui compte les appels de chaque secteur, pour comparer les quartiers par un nombre plutôt que par l'intensité lumineuse.</value>
  </data>
  <data name="Library_calls_by_type_Name" xml:space="preserve">
    <value>Appels par type</value>
  </data>
  <data name="Library_calls_by_type_Description" xml:space="preserve">
    <value>Chaque appel des 90 derniers jours sous forme de point, coloré selon le type d'appel.</value>
  </data>
  <data name="Library_dominant_call_type_Name" xml:space="preserve">
    <value>Type d'appel principal par secteur</value>
  </data>
  <data name="Library_dominant_call_type_Description" xml:space="preserve">
    <value>Une grille colorée selon le type d'appel le plus fréquent dans chaque secteur. Une couleur plus intense signifie plus d'appels.</value>
  </data>
  <data name="Library_calls_by_priority_Name" xml:space="preserve">
    <value>Appels par priorité</value>
  </data>
  <data name="Library_calls_by_priority_Description" xml:space="preserve">
    <value>Appels des 90 derniers jours colorés selon la priorité, pour voir d'où viennent les appels urgents.</value>
  </data>
  <data name="Library_call_outcomes_Name" xml:space="preserve">
    <value>Issues des appels</value>
  </data>
  <data name="Library_call_outcomes_Description" xml:space="preserve">
    <value>Appels colorés selon la façon dont ils ont été clôturés : clôturé, annulé, non fondé, fausse alerte, transféré, etc.</value>
  </data>
  <data name="Library_time_of_day_Name" xml:space="preserve">
    <value>Moment de la journée</value>
  </data>
  <data name="Library_time_of_day_Description" xml:space="preserve">
    <value>Appels colorés selon le moment où ils sont arrivés : nuit, matin, après-midi ou soirée. Utile pour la planification des effectifs et des gardes.</value>
  </data>
  <data name="Library_weekday_vs_weekend_Name" xml:space="preserve">
    <value>Semaine et week-end</value>
  </data>
  <data name="Library_weekday_vs_weekend_Description" xml:space="preserve">
    <value>Appels répartis entre semaine et week-end, pour planifier la disponibilité des volontaires.</value>
  </data>
  <data name="Library_seasonal_patterns_Name" xml:space="preserve">
    <value>Tendances saisonnières</value>
  </data>
  <data name="Library_seasonal_patterns_Description" xml:space="preserve">
    <value>Deux ans d'appels colorés par mois, pour repérer la demande saisonnière comme les feux de forêt, les sauvetages nautiques ou les saisons d'événements.</value>
  </data>
  <data name="Library_response_time_by_area_Name" xml:space="preserve">
    <value>Délai de réponse par secteur (90e centile)</value>
  </data>
  <data name="Library_response_time_by_area_Description" xml:space="preserve">
    <value>Une grille colorée selon le 90e centile du délai entre l'enregistrement de l'appel et l'arrivée de la première unité sur les lieux, comme sont mesurés les objectifs NFPA 1710 et 1720. Nécessite que les unités définissent le statut « Sur les lieux ».</value>
  </data>
  <data name="Library_response_time_bands_Name" xml:space="preserve">
    <value>Tranches de délai de réponse</value>
  </data>
  <data name="Library_response_time_bands_Description" xml:space="preserve">
    <value>Chaque appel coloré selon les minutes écoulées jusqu'à l'arrivée de la première unité sur les lieux : moins de 4, 4 à 8, 8 à 12, 12 à 20 et plus de 20.</value>
  </data>
  <data name="Library_turnout_by_area_Name" xml:space="preserve">
    <value>Délai avant le premier départ par secteur</value>
  </data>
  <data name="Library_turnout_by_area_Description" xml:space="preserve">
    <value>Une grille colorée selon le délai médian entre l'enregistrement de l'appel et la première unité en route ou en chemin.</value>
  </data>
  <data name="Library_time_committed_Name" xml:space="preserve">
    <value>Temps d'engagement par secteur</value>
  </data>
  <data name="Library_time_committed_Description" xml:space="preserve">
    <value>Une grille colorée selon le délai moyen entre l'enregistrement et la clôture de l'appel : là où les appels mobilisent les ressources le plus longtemps.</value>
  </data>
  <data name="Library_station_coverage_gaps_Name" xml:space="preserve">
    <value>Appels hors couverture des casernes</value>
  </data>
  <data name="Library_station_coverage_gaps_Description" xml:space="preserve">
    <value>Appels colorés selon la distance à vol d'oiseau jusqu'à la caserne la plus proche, avec des anneaux à 1.5, 2.5 et 5 milles (repères courants de classement d'assurance).</value>
  </data>
  <data name="Library_station_area_workload_Name" xml:space="preserve">
    <value>Charge de travail par secteur de caserne</value>
  </data>
  <data name="Library_station_area_workload_Description" xml:space="preserve">
    <value>Appels colorés selon leur caserne d'attache (d'abord son périmètre géographique, puis les unités engagées), pour comparer la charge de première intervention.</value>
  </data>
  <data name="Library_where_units_go_Name" xml:space="preserve">
    <value>Où vont les unités</value>
  </data>
  <data name="Library_where_units_go_Description" xml:space="preserve">
    <value>Chaque réponse d'unité des 90 derniers jours au lieu de l'appel, colorée par unité.</value>
  </data>
  <data name="Library_unit_type_demand_Name" xml:space="preserve">
    <value>Demande par type d'unité</value>
  </data>
  <data name="Library_unit_type_demand_Description" xml:space="preserve">
    <value>Une grille colorée selon le type d'unité qui intervient le plus dans chaque secteur, par exemple fourgons-pompes, ambulances ou unités de sauvetage.</value>
  </data>
  <data name="Library_personnel_response_footprint_Name" xml:space="preserve">
    <value>Empreinte des réponses du personnel</value>
  </data>
  <data name="Library_personnel_response_footprint_Description" xml:space="preserve">
    <value>Carte de chaleur des appels auxquels des membres ont répondu. Les appels comptant plus d'intervenants sont plus lumineux.</value>
  </data>
  <data name="Library_responder_origins_Name" xml:space="preserve">
    <value>D'où viennent les intervenants</value>
  </data>
  <data name="Library_responder_origins_Description" xml:space="preserve">
    <value>Carte de chaleur de l'endroit où se trouvaient les membres lorsqu'ils se sont déclarés en route, avec un anneau de 5 milles autour de la caserne. Nécessite le partage de la position dans l'application.</value>
  </data>
  <data name="Library_repeat_locations_Name" xml:space="preserve">
    <value>Lieux récurrents</value>
  </data>
  <data name="Library_repeat_locations_Description" xml:space="preserve">
    <value>Lieux ayant 3 appels ou plus au cours des 12 derniers mois, dimensionnés et colorés selon leur nombre. Utile pour les appelants fréquents, les problèmes d'alarme et le suivi de prévention.</value>
  </data>
  <data name="Library_false_alarm_hot_spots_Name" xml:space="preserve">
    <value>Zones de fausses alertes</value>
  </data>
  <data name="Library_false_alarm_hot_spots_Description" xml:space="preserve">
    <value>Carte de chaleur des appels clôturés comme fausse alerte ou non fondés.</value>
  </data>
  <data name="Library_unit_movement_24h_Name" xml:space="preserve">
    <value>Déplacements des unités (dernières 24 heures)</value>
  </data>
  <data name="Library_unit_movement_24h_Description" xml:space="preserve">
    <value>Trajets enregistrés des unités pour la dernière journée, colorés par unité.</value>
  </data>
  <data name="Library_patrol_coverage_Name" xml:space="preserve">
    <value>Couverture des patrouilles</value>
  </data>
  <data name="Library_patrol_coverage_Description" xml:space="preserve">
    <value>Carte de chaleur des positions des unités sur les 7 derniers jours : où les patrouilles et les unités de terrain passent leur temps.</value>
  </data>
  <data name="Library_search_coverage_Name" xml:space="preserve">
    <value>Couverture des recherches</value>
  </data>
  <data name="Library_search_coverage_Description" xml:space="preserve">
    <value>Une grille des positions des membres, plus les trajets des membres et des unités sur les 3 derniers jours, pour voir quels secteurs ont été couverts.</value>
  </data>
  <data name="Library_incident_footprint_Name" xml:space="preserve">
    <value>Empreinte de l'appel</value>
  </data>
  <data name="Library_incident_footprint_Description" xml:space="preserve">
    <value>Choisissez un appel pour voir où chaque unité et chaque membre est allé pendant son traitement : leurs trajets, leurs positions de statut et la provenance des intervenants.</value>
  </data>
