  <data name="Library_call_hot_zones_Name" xml:space="preserve">
    <value>Zone calde delle chiamate</value>
  </data>
  <data name="Library_call_hot_zones_Description" xml:space="preserve">
    <value>Mappa di calore di tutte le chiamate degli ultimi 12 mesi. Le aree più luminose sono quelle in cui le chiamate si concentrano.</value>
  </data>
  <data name="Library_busiest_areas_Name" xml:space="preserve">
    <value>Aree più attive (griglia)</value>
  </data>
  <data name="Library_busiest_areas_Description" xml:space="preserve">
    <value>Una griglia esagonale che conta le chiamate di ogni area, per confrontare i quartieri in base al numero anziché alla luminosità.</value>
  </data>
  <data name="Library_calls_by_type_Name" xml:space="preserve">
    <value>Chiamate per tipo</value>
  </data>
  <data name="Library_calls_by_type_Description" xml:space="preserve">
    <value>Ogni chiamata degli ultimi 90 giorni come punto, colorato per tipo di chiamata.</value>
  </data>
  <data name="Library_dominant_call_type_Name" xml:space="preserve">
    <value>Tipo di chiamata principale per area</value>
  </data>
  <data name="Library_dominant_call_type_Description" xml:space="preserve">
    <value>Una griglia colorata in base al tipo di chiamata più frequente in ogni area. Un colore più intenso indica più chiamate.</value>
  </data>
  <data name="Library_calls_by_priority_Name" xml:space="preserve">
    <value>Chiamate per priorità</value>
  </data>
  <data name="Library_calls_by_priority_Description" xml:space="preserve">
    <value>Chiamate degli ultimi 90 giorni colorate per priorità, per vedere da dove provengono le chiamate urgenti.</value>
  </data>
  <data name="Library_call_outcomes_Name" xml:space="preserve">
    <value>Esiti delle chiamate</value>
  </data>
  <data name="Library_call_outcomes_Description" xml:space="preserve">
    <value>Chiamate colorate in base a come sono state chiuse: chiusa, annullata, infondata, falso allarme, trasferita e altro.</value>
  </data>
  <data name="Library_time_of_day_Name" xml:space="preserve">
    <value>Momento della giornata</value>
  </data>
  <data name="Library_time_of_day_Description" xml:space="preserve">
    <value>Chiamate colorate in base al momento in cui sono arrivate: notte, mattina, pomeriggio o sera. Utile per la pianificazione del personale e dei turni.</value>
  </data>
  <data name="Library_weekday_vs_weekend_Name" xml:space="preserve">
    <value>Giorni feriali e fine settimana</value>
  </data>
  <data name="Library_weekday_vs_weekend_Description" xml:space="preserve">
    <value>Chiamate suddivise tra giorni feriali e fine settimana, per pianificare la disponibilità dei volontari.</value>
  </data>
  <data name="Library_seasonal_patterns_Name" xml:space="preserve">
    <value>Andamento stagionale</value>
  </data>
  <data name="Library_seasonal_patterns_Description" xml:space="preserve">
    <value>Due anni di chiamate colorate per mese, per individuare la domanda stagionale, come le stagioni degli incendi boschivi, dei soccorsi in acqua o degli eventi.</value>
  </data>
  <data name="Library_response_time_by_area_Name" xml:space="preserve">
    <value>Tempo di risposta per area (90° percentile)</value>
  </data>
  <data name="Library_response_time_by_area_Description" xml:space="preserve">
    <value>Una griglia colorata in base al 90° percentile del tempo che intercorre tra la registrazione della chiamata e l'arrivo sul posto della prima unità, secondo il metodo con cui vengono misurati gli obiettivi NFPA 1710 e 1720. Richiede che le unità impostino gli stati di arrivo sul posto.</value>
  </data>
  <data name="Library_response_time_bands_Name" xml:space="preserve">
    <value>Fasce di tempo di risposta</value>
  </data>
  <data name="Library_response_time_bands_Description" xml:space="preserve">
    <value>Ogni chiamata colorata in base ai minuti necessari alla prima unità per arrivare sul posto: meno di 4, da 4 a 8, da 8 a 12, da 12 a 20 e oltre 20.</value>
  </data>
  <data name="Library_turnout_by_area_Name" xml:space="preserve">
    <value>Tempo alla prima risposta per area</value>
  </data>
  <data name="Library_turnout_by_area_Description" xml:space="preserve">
    <value>Una griglia colorata in base al tempo mediano che intercorre tra la registrazione della chiamata e la prima unità in risposta o in viaggio.</value>
  </data>
  <data name="Library_time_committed_Name" xml:space="preserve">
    <value>Tempo impegnato per area</value>
  </data>
  <data name="Library_time_committed_Description" xml:space="preserve">
    <value>Una griglia colorata in base al tempo medio che intercorre tra la registrazione e la chiusura della chiamata: dove le chiamate impegnano le risorse più a lungo.</value>
  </data>
  <data name="Library_station_coverage_gaps_Name" xml:space="preserve">
    <value>Chiamate fuori dalla copertura delle stazioni</value>
  </data>
  <data name="Library_station_coverage_gaps_Description" xml:space="preserve">
    <value>Chiamate colorate in base alla distanza in linea d'aria dalla stazione più vicina, con anelli a 1,5 mi, 2,5 mi e 5 mi (parametri comuni nelle valutazioni assicurative).</value>
  </data>
  <data name="Library_station_area_workload_Name" xml:space="preserve">
    <value>Carico di lavoro per area di stazione</value>
  </data>
  <data name="Library_station_area_workload_Description" xml:space="preserve">
    <value>Chiamate colorate in base alla stazione di appartenenza (prima la sua geofence, poi chi è stato inviato), per confrontare il carico di lavoro di primo intervento.</value>
  </data>
  <data name="Library_where_units_go_Name" xml:space="preserve">
    <value>Dove vanno le unità</value>
  </data>
  <data name="Library_where_units_go_Description" xml:space="preserve">
    <value>Ogni risposta delle unità negli ultimi 90 giorni nel luogo della chiamata, colorata per unità.</value>
  </data>
  <data name="Library_unit_type_demand_Name" xml:space="preserve">
    <value>Richiesta per tipo di unità</value>
  </data>
  <data name="Library_unit_type_demand_Description" xml:space="preserve">
    <value>Una griglia colorata in base al tipo di unità che risponde più spesso in ogni area, ad esempio autopompe, ambulanze o mezzi di soccorso.</value>
  </data>
  <data name="Library_personnel_response_footprint_Name" xml:space="preserve">
    <value>Impronta di risposta del personale</value>
  </data>
  <data name="Library_personnel_response_footprint_Description" xml:space="preserve">
    <value>Mappa di calore delle chiamate a cui i membri hanno risposto. Le chiamate con più persone in risposta risultano più luminose.</value>
  </data>
  <data name="Library_responder_origins_Name" xml:space="preserve">
    <value>Da dove arrivano i soccorritori</value>
  </data>
  <data name="Library_responder_origins_Description" xml:space="preserve">
    <value>Mappa di calore dei luoghi in cui si trovavano i membri quando si sono segnati in risposta, con un anello di 5 miglia attorno alla stazione. Richiede la condivisione della posizione nell'app.</value>
  </data>
  <data name="Library_repeat_locations_Name" xml:space="preserve">
    <value>Luoghi ricorrenti</value>
  </data>
  <data name="Library_repeat_locations_Description" xml:space="preserve">
    <value>Luoghi con 3 o più chiamate negli ultimi 12 mesi, dimensionati e colorati in base al numero. Utile per chi chiama spesso, problemi di allarme e follow-up di prevenzione.</value>
  </data>
  <data name="Library_false_alarm_hot_spots_Name" xml:space="preserve">
    <value>Punti caldi dei falsi allarmi</value>
  </data>
  <data name="Library_false_alarm_hot_spots_Description" xml:space="preserve">
    <value>Mappa di calore delle chiamate chiuse come falso allarme o infondate.</value>
  </data>
  <data name="Library_unit_movement_24h_Name" xml:space="preserve">
    <value>Movimento delle unità (ultime 24 ore)</value>
  </data>
  <data name="Library_unit_movement_24h_Description" xml:space="preserve">
    <value>Percorsi registrati delle unità nell'ultimo giorno, colorati per unità.</value>
  </data>
  <data name="Library_patrol_coverage_Name" xml:space="preserve">
    <value>Copertura del pattugliamento</value>
  </data>
  <data name="Library_patrol_coverage_Description" xml:space="preserve">
    <value>Mappa di calore delle posizioni delle unità negli ultimi 7 giorni: dove le pattuglie e le unità sul campo trascorrono il loro tempo.</value>
  </data>
  <data name="Library_search_coverage_Name" xml:space="preserve">
    <value>Copertura della ricerca</value>
  </data>
  <data name="Library_search_coverage_Description" xml:space="preserve">
    <value>Una griglia delle posizioni dei membri più i percorsi di membri e unità negli ultimi 3 giorni, per vedere quali aree sono state coperte.</value>
  </data>
  <data name="Library_incident_footprint_Name" xml:space="preserve">
    <value>Impronta dell'evento</value>
  </data>
  <data name="Library_incident_footprint_Description" xml:space="preserve">
    <value>Scegli una chiamata per vedere dove sono andati ogni unità e ogni membro mentre la gestivano: i loro percorsi, le posizioni degli stati e da dove sono arrivati i soccorritori.</value>
  </data>
