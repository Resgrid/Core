  <data name="Library_call_hot_zones_Name" xml:space="preserve">
    <value>Call hot zones</value>
  </data>
  <data name="Library_call_hot_zones_Description" xml:space="preserve">
    <value>Heat map of every call in the last 12 months. The brightest areas are where calls cluster.</value>
  </data>
  <data name="Library_busiest_areas_Name" xml:space="preserve">
    <value>Busiest areas (grid)</value>
  </data>
  <data name="Library_busiest_areas_Description" xml:space="preserve">
    <value>A hexagon grid that counts the calls in each area, so you can compare neighborhoods by number instead of by glow.</value>
  </data>
  <data name="Library_calls_by_type_Name" xml:space="preserve">
    <value>Calls by type</value>
  </data>
  <data name="Library_calls_by_type_Description" xml:space="preserve">
    <value>Each call in the last 90 days as a dot, colored by call type.</value>
  </data>
  <data name="Library_dominant_call_type_Name" xml:space="preserve">
    <value>Main call type by area</value>
  </data>
  <data name="Library_dominant_call_type_Description" xml:space="preserve">
    <value>A grid colored by the most common call type in each area. Stronger color means more calls.</value>
  </data>
  <data name="Library_calls_by_priority_Name" xml:space="preserve">
    <value>Calls by priority</value>
  </data>
  <data name="Library_calls_by_priority_Description" xml:space="preserve">
    <value>Calls in the last 90 days colored by priority, to see where urgent calls come from.</value>
  </data>
  <data name="Library_call_outcomes_Name" xml:space="preserve">
    <value>Call outcomes</value>
  </data>
  <data name="Library_call_outcomes_Description" xml:space="preserve">
    <value>Calls colored by how they were closed: closed, cancelled, unfounded, false alarm, transferred and more.</value>
  </data>
  <data name="Library_time_of_day_Name" xml:space="preserve">
    <value>Time of day</value>
  </data>
  <data name="Library_time_of_day_Description" xml:space="preserve">
    <value>Calls colored by when they came in: overnight, morning, afternoon or evening. Useful for staffing and shift planning.</value>
  </data>
  <data name="Library_weekday_vs_weekend_Name" xml:space="preserve">
    <value>Weekday vs weekend</value>
  </data>
  <data name="Library_weekday_vs_weekend_Description" xml:space="preserve">
    <value>Calls split into weekday and weekend, for planning volunteer availability.</value>
  </data>
  <data name="Library_seasonal_patterns_Name" xml:space="preserve">
    <value>Seasonal patterns</value>
  </data>
  <data name="Library_seasonal_patterns_Description" xml:space="preserve">
    <value>Two years of calls colored by month, to spot seasonal demand such as wildland, water rescue or event seasons.</value>
  </data>
  <data name="Library_response_time_by_area_Name" xml:space="preserve">
    <value>Response time by area (90th percentile)</value>
  </data>
  <data name="Library_response_time_by_area_Description" xml:space="preserve">
    <value>A grid colored by the 90th-percentile time from call logged to first unit on scene, the way NFPA 1710 and 1720 goals are measured. Needs units to set on-scene statuses.</value>
  </data>
  <data name="Library_response_time_bands_Name" xml:space="preserve">
    <value>Response time bands</value>
  </data>
  <data name="Library_response_time_bands_Description" xml:space="preserve">
    <value>Each call colored by minutes to the first unit on scene: under 4, 4 to 8, 8 to 12, 12 to 20 and over 20.</value>
  </data>
  <data name="Library_turnout_by_area_Name" xml:space="preserve">
    <value>Time to first responding by area</value>
  </data>
  <data name="Library_turnout_by_area_Description" xml:space="preserve">
    <value>A grid colored by the median time from call logged to the first unit responding or en route.</value>
  </data>
  <data name="Library_time_committed_Name" xml:space="preserve">
    <value>Time committed by area</value>
  </data>
  <data name="Library_time_committed_Description" xml:space="preserve">
    <value>A grid colored by the average time from call logged to call closed: where calls tie up resources the longest.</value>
  </data>
  <data name="Library_station_coverage_gaps_Name" xml:space="preserve">
    <value>Calls outside station coverage</value>
  </data>
  <data name="Library_station_coverage_gaps_Description" xml:space="preserve">
    <value>Calls colored by straight-line distance to the nearest station, with 1.5, 2.5 and 5 mile rings (common insurance rating benchmarks).</value>
  </data>
  <data name="Library_station_area_workload_Name" xml:space="preserve">
    <value>Workload by station area</value>
  </data>
  <data name="Library_station_area_workload_Description" xml:space="preserve">
    <value>Calls colored by their home station (its geofence first, then who was dispatched), to compare first-due workload.</value>
  </data>
  <data name="Library_where_units_go_Name" xml:space="preserve">
    <value>Where units go</value>
  </data>
  <data name="Library_where_units_go_Description" xml:space="preserve">
    <value>Every unit response in the last 90 days at the call location, colored by unit.</value>
  </data>
  <data name="Library_unit_type_demand_Name" xml:space="preserve">
    <value>Demand by unit type</value>
  </data>
  <data name="Library_unit_type_demand_Description" xml:space="preserve">
    <value>A grid colored by the unit type that responds most in each area, such as engines, ambulances or rescues.</value>
  </data>
  <data name="Library_personnel_response_footprint_Name" xml:space="preserve">
    <value>Personnel response footprint</value>
  </data>
  <data name="Library_personnel_response_footprint_Description" xml:space="preserve">
    <value>Heat map of the calls members responded to. Calls with more responders glow brighter.</value>
  </data>
  <data name="Library_responder_origins_Name" xml:space="preserve">
    <value>Where responders come from</value>
  </data>
  <data name="Library_responder_origins_Description" xml:space="preserve">
    <value>Heat map of where members were when they marked themselves responding, with a 5 mile station ring. Needs location sharing in the app.</value>
  </data>
  <data name="Library_repeat_locations_Name" xml:space="preserve">
    <value>Repeat locations</value>
  </data>
  <data name="Library_repeat_locations_Description" xml:space="preserve">
    <value>Locations with 3 or more calls in the last 12 months, sized and colored by how many. Useful for frequent callers, alarm problems and prevention follow-up.</value>
  </data>
  <data name="Library_false_alarm_hot_spots_Name" xml:space="preserve">
    <value>False alarm hot spots</value>
  </data>
  <data name="Library_false_alarm_hot_spots_Description" xml:space="preserve">
    <value>Heat map of calls closed as false alarm or unfounded.</value>
  </data>
  <data name="Library_unit_movement_24h_Name" xml:space="preserve">
    <value>Unit movement (last 24 hours)</value>
  </data>
  <data name="Library_unit_movement_24h_Description" xml:space="preserve">
