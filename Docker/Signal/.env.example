# Pin maintained images that you have validated; webhook support and json-rpc mode are required.
SIGNAL_BRIDGE_IMAGE=
SIGNAL_GATEWAY_IMAGE=
# Generate two independent random base64url secrets, 32-128 characters, without padding.
SIGNAL_API_TOKEN=
SIGNAL_WEBHOOK_SECRET=
# Hostname only (no scheme, path or port); certificate must be trusted by the nginx container.
RESGRID_API_HOST=
