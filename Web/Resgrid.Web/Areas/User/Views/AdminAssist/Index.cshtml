@inject Microsoft.Extensions.Localization.IStringLocalizer<Resgrid.Localization.Areas.User.AdminAssist.AdminAssist> adminAssistLocalizer
@{
	// Standalone setup routes keep their own names; they must not read as Admin Assist when that shell is off.
	bool standaloneSetup = ViewBag.AdminAssistSetup == true;
	string entryPage = ViewBag.AdminAssistPage as string;
	string titleKey = standaloneSetup ? (entryPage == "report" ? "Ui.report" : "Ui.wizard") : "Ui.Title";
	string title = adminAssistLocalizer[titleKey];
	ViewBag.Title = "Resgrid | " + title;
	Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
	var adpReveal = new Resgrid.Web.Areas.User.Models.AdpRevealView { BannerTitle = title };
}
<div class="row wrapper border-bottom white-bg page-heading">
	<div class="col-sm-12">
		<h2>@title</h2>
		<ol class="breadcrumb">
			<li><a asp-controller="Home" asp-action="Dashboard" asp-route-area="User">@commonLocalizer["HomeModule"]</a></li>
			<li class="active"><strong>@title</strong></li>
		</ol>
	</div>
</div>
<div class="wrapper wrapper-content">
	@if (ViewBag.AdminAssistProtected == true)
	{
		<partial name="_AdpRevealBanner" model="adpReveal" />
	}
	<rg-admin-assist page="@ViewBag.AdminAssistPage" setup="@(ViewBag.AdminAssistSetup ? "true" : "false")"
		loadinglabel="@adminAssistLocalizer["Ui.Loading"]" errorlabel="@adminAssistLocalizer["Ui.Error"]" retrylabel="@adminAssistLocalizer["Ui.Retry"]"></rg-admin-assist>
</div>
@section Scripts
{
	@if (ViewBag.AdminAssistProtected == true)
	{
		<partial name="_AdpRevealScripts" model="adpReveal" />
		<script type="text/javascript">
			window.resgridAdpPageRevealed = window.resgridAdpPageConcealed = window.resgridAdpPageRenewed = function () {
				window.dispatchEvent(new CustomEvent('resgrid:adp-reveal-changed'));
			};
		</script>
	}
}
