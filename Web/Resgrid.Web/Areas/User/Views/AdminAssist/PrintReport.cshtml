@model Resgrid.Model.AdminAssist.AdminAssistOverview
@using Resgrid.Model.AdminAssist
@using System.Globalization
@inject IAdminAssistCatalog catalog
@inject Microsoft.Extensions.Localization.IStringLocalizer<Resgrid.Localization.Areas.User.AdminAssist.AdminAssist> aa
@{
	Layout = null;
	var report = Model.Report;
	var findings = report.Findings.Where(f => f.Result != RuleResult.NotApplicable && (f.AreaId == "security" || f.ScopeIndependent || report.SelectedAreas.Contains(f.AreaId))).ToArray();
	// Learning progress covers the key features setup teaches, matching the on-screen report.
	var keyFeatureIds = catalog.Capabilities.Where(c => c.IsKey).Select(c => c.Id).ToHashSet();
	var learned = Model.Workspace.LearnedCapabilityIds.Count(keyFeatureIds.Contains);
	var setupMode = string.Equals(Context.Request.Query["setup"], "true", StringComparison.OrdinalIgnoreCase);
	// Information-level failures are review suggestions, listed apart and never counted as failures (as on screen).
	string Display(ConfigurationFinding f) => f.Severity == FindingSeverity.Information && f.Result != RuleResult.Pass ? "Suggestion" : f.Result.ToString();
	var groups = new[] { ("Fail", "Ui.Fail"), ("Unknown", "Ui.GroupUnknown"), ("Suggestion", "Ui.GroupSuggestions"), ("Pass", "Ui.Pass") };
	string Width(int part) => report.Required > 0 ? (part * 100.0 / report.Required).ToString("0.##", CultureInfo.InvariantCulture) + "%" : "0%";
	string AreaLabel(string id) => aa[catalog.Areas.FirstOrDefault(a => a.Id == id)?.LabelKey ?? id].Value;
	var tiers = new[] { ProductArea.Core, ProductArea.Recommended, ProductArea.Optional, ProductArea.AddOn };
	var interests = catalog.Capabilities.Where(c => Model.Workspace.InterestedCapabilityIds.Contains(c.Id)).ToArray();
}
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name" dir="@(CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "rtl" : "ltr")">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Resgrid — @aa["Ui.report"]</title><link rel="stylesheet" href="~/css/admin-assist-print.css" asp-append-version="true" /></head>
<body>
	<nav class="print-controls" aria-label="@aa["Ui.report"]">
		<a class="print-back" href="@(setupMode ? "/User/Help/SetupReport" : "/User/AdminAssist/SetupReport")"><span aria-hidden="true">←</span> @aa["Ui.report"]</a>
		<button type="button" id="admin-assist-print" class="print-button">@aa["Ui.Print"]</button>
	</nav>
	<main class="sheet">
		<header class="report-head">
			<p class="brand">Resgrid</p>
			<h1>@aa["Ui.report"]</h1>
			<dl class="meta">
				<div><dt>@aa["Ui.Freshness"]</dt><dd><time datetime="@report.Snapshot.AsOfUtc.ToString("O")">@report.Snapshot.AsOfUtc.ToString("u")</time></dd></div>
				<div><dt>@aa["Ui.DepartmentId"]</dt><dd>@report.Snapshot.DepartmentId</dd></div>
				<div><dt>@aa["Ui.CatalogVersion"]</dt><dd>@Model.CatalogVersion</dd></div>
				<div><dt>@aa["Ui.EvidenceRevision"]</dt><dd class="code">@report.Snapshot.Revision</dd></div>
				@if (Model.Workspace.RevisitOnUtc.HasValue) { <div><dt>@aa["Ui.RevisitDate"]</dt><dd>@Model.Workspace.RevisitOnUtc.Value.ToString("yyyy-MM-dd")</dd></div> }
			</dl>
		</header>

		@if (!report.Snapshot.Consistent) { <p class="callout callout--fail" role="alert">@aa["Ui.Inconsistent"]</p> }
		@if (report.HasCriticalUncertainty) { <p class="callout callout--warn">@aa["Ui.CriticalUnknown"]</p> }
		@if (report.UncheckedAreaIds.Count > 0) { <p class="callout callout--info">@aa["Ui.UncheckedAreas"]: @string.Join(", ", report.UncheckedAreaIds.Select(AreaLabel))</p> }

		<section class="metrics" aria-label="@aa["Ui.Checks"]">
			<div class="metric metric--ok">
				<span class="metric__label">@aa["Ui.Checks"]</span>
				<span class="metric__value">@report.Verified <small>/ @report.Required</small></span>
				<span class="bar" aria-hidden="true"><span class="bar__ok" style="width: @Width(report.Verified)"></span><span class="bar__fail" style="width: @Width(report.Failed)"></span><span class="bar__unknown" style="width: @Width(report.Unknown)"></span></span>
				<span class="metric__note">@string.Format(aa["Ui.LegendVerified"].Value, report.Verified) · @string.Format(aa["Ui.LegendAttention"].Value, report.Failed) · @string.Format(aa["Ui.LegendUnknown"].Value, report.Unknown)</span>
			</div>
			<div class="metric @(report.Failed > 0 ? "metric--fail" : "metric--ok")">
				<span class="metric__label">@aa["Ui.Failures"]</span>
				<span class="metric__value">@report.Failed</span>
			</div>
			<div class="metric @(report.Unknown > 0 ? "metric--unknown" : "metric--ok")">
				<span class="metric__label">@aa["Ui.UnknownChecks"]</span>
				<span class="metric__value">@report.Unknown</span>
				<span class="metric__note">@aa["Ui.UnknownMeaning"]</span>
			</div>
			<div class="metric metric--info">
				<span class="metric__label">@aa["Ui.Learning"]</span>
				<span class="metric__value">@learned <small>/ @keyFeatureIds.Count</small></span>
				<span class="metric__note">@aa["Ui.LearningSeparate"]</span>
			</div>
		</section>

		<div class="notes">
			<p>@aa["Ui.ReportBoundary"]</p>
			<p>@aa["Ui.VerificationCoverage"]</p>
			<p>@aa["Ui.PrintNotice"]</p>
		</div>

		<section class="block" aria-labelledby="review-heading">
			<h2 id="review-heading">@aa["Ui.SetupReview"]</h2>
			@if (Model.Workspace.ReviewEvidence is { } reviewed)
			{
				var changed = reviewed.CatalogVersion != Model.CatalogVersion || reviewed.SnapshotRevision != report.Snapshot.Revision || reviewed.ScopeRevision != Model.Workspace.ScopeRevision;
				<p><strong>@aa["Ui.Reviewed"]:</strong> @(Model.Workspace.ReviewedOnUtc?.ToString("u") ?? reviewed.AsOfUtc.ToString("u"))</p>
				<p class="muted">@aa["Ui.ReviewEvidence"]: @reviewed.Verified / @reviewed.Required · @aa["Ui.Failures"]: @reviewed.Failed · @aa["Ui.UnknownChecks"]: @reviewed.Unknown · @reviewed.AsOfUtc.ToString("u")</p>
				@if (changed) { <p class="callout callout--warn">@aa["Ui.ReviewChanged"]</p> }
			}
			else
			{
				<p><strong>@aa["Ui.Reviewed"]:</strong> @aa["Ui.NoReview"]</p>
			}
		</section>

		<section class="block" aria-labelledby="checks-heading">
			<h2 id="checks-heading">@aa["Ui.Checks"]</h2>
			@if (findings.Length == 0) { <p class="muted">@aa["Ui.None"]</p> }
			@foreach (var (result, titleKey) in groups)
			{
				var items = findings.Where(f => Display(f) == result).OrderByDescending(f => f.Severity).ToArray();
				if (items.Length == 0) { continue; }
				<h3 class="group group--@result.ToLowerInvariant()">@aa[titleKey] <span class="count">@items.Length</span></h3>
				<ul class="findings">
					@foreach (var finding in items)
					{
						<li class="finding finding--@result.ToLowerInvariant()">
							<p class="finding__meta">
								<span class="badge badge--@result.ToLowerInvariant()">@aa[result == "Suggestion" ? "Ui.Suggestion" : "Ui." + finding.Result]</span>
								@if (result != "Suggestion") { <span class="badge badge--severity-@finding.Severity.ToString().ToLowerInvariant()">@aa["Ui." + finding.Severity]</span> }
								<span class="muted">@AreaLabel(finding.AreaId)</span>
							</p>
							<p class="finding__title">@aa[finding.TitleKey]</p>
							<p>@aa[finding.ExplanationKey]</p>
							@if (finding.Result == RuleResult.Fail && Model.FindingSubjects != null && Model.FindingSubjects.TryGetValue(finding.RuleId, out var subjects)) { <p class="finding-subjects">@string.Join(", ", subjects.Select(s => s.Name))</p> }
							<p class="finding__action"><span aria-hidden="true">→</span> <a href="@finding.Destination">@aa[finding.NextActionKey]</a></p>
						</li>
					}
				</ul>
			}
		</section>

		<section class="block" aria-labelledby="scope-heading">
			<h2 id="scope-heading">@aa["Ui.AreaReadiness"]</h2>
			<table class="scope">
				<thead><tr><th scope="col">@aa["Ui.Area"]</th><th scope="col">@aa["Ui.SetupChoice"]</th></tr></thead>
				@foreach (var tier in tiers)
				{
					var tierAreas = catalog.Areas.Where(a => a.Tier == tier).OrderBy(a => a.Order).ToArray();
					if (tierAreas.Length == 0) { continue; }
					<tbody>
						<tr class="scope__tier"><th colspan="2" scope="colgroup">@aa["Ui.Tier." + tier]</th></tr>
						@foreach (var area in tierAreas)
						{
							var choice = area.Id == "security" ? SetupAreaChoice.UseNow : Model.Workspace.Areas.TryGetValue(area.Id, out var chosen) ? chosen : SetupAreaChoice.LearnLater;
							<tr><th scope="row">@aa[area.LabelKey]</th><td><span class="badge badge--choice-@choice.ToString().ToLowerInvariant()">@aa["Ui." + choice]</span></td></tr>
						}
					</tbody>
				}
			</table>
		</section>

		@if (interests.Length > 0)
		{
			<section class="block" aria-labelledby="interests-heading">
				<h2 id="interests-heading">@aa["Ui.SelectedWorkflows"]</h2>
				<p class="muted">@aa["Ui.WorkflowProgressHelp"]</p>
				<div class="cards">
					@foreach (var interest in interests)
					{
						var availability = Model.Access.FirstOrDefault(a => a.CapabilityId == interest.Id);
						var progress = Model.CapabilitySetup?.FirstOrDefault(s => s.CapabilityId == interest.Id);
						<article class="card"><h3>@aa[interest.LabelKey]</h3>
							<p>@aa[Model.Workspace.LearnedCapabilityIds.Contains(interest.Id) ? "Ui.LearningComplete" : "Ui.LearningPending"]</p>
							<p>@aa[availability?.State == EvidenceState.Known ? "Ui.AvailableForSetup" : availability?.State == EvidenceState.Unavailable ? "Ui.WorkflowBlocked" : "Ui.WorkflowAccessUnknown"]</p>
							@if (availability != null) { foreach (var reason in availability.ReasonCodes) { <p class="muted">@aa["Ui." + reason]</p> } }
							<p><strong>@aa["Ui.SetupState." + (progress?.State ?? CapabilitySetupState.NotAssessed)]</strong></p><p class="muted">@aa[progress?.GuidanceKey ?? "Ui.ConfigurationNotAssessed"]</p><p>@aa[interest.AdoptionKey]</p>
						</article>
					}
				</div>
			</section>
		}

		<section class="block" aria-labelledby="addons-heading">
			<h2 id="addons-heading">@aa["Ui.OptionalCapabilities"]</h2>
			<p class="muted">@aa["Ui.Optional"]</p>
			<div class="cards">
				@foreach (var capability in catalog.Capabilities.Where(c => c.Id.StartsWith("addon-", StringComparison.Ordinal)))
				{
					var availability = Model.Access.FirstOrDefault(a => a.CapabilityId == capability.Id);
					var state = availability?.State.ToString() ?? "Unknown";
					<article class="card">
						<h3>@aa[capability.LabelKey] <span class="badge badge--access-@state.ToLowerInvariant()">@aa["Ui.AvailableReasons"]: @aa["Ui." + state]</span></h3>
						<p>@aa[capability.PurposeKey]</p><p class="muted">@aa[capability.ValueKey]</p><p>@aa[capability.AdoptionKey]</p>
					</article>
				}
			</div>
		</section>
	</main>
	<script src="~/js/app/internal/admin-assist-print.js" asp-append-version="true"></script>
</body>
</html>
