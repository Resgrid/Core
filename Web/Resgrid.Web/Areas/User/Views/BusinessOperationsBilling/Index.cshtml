@model Resgrid.Model.BusinessOperationsBillingStatus
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Invoicing.Invoicing> localizer
@using Resgrid.Config
@using Newtonsoft.Json
@{ ViewBag.Title = "Resgrid | " + localizer["BusinessOperations"]; }
<div class="row wrapper border-bottom white-bg page-heading">
    <div class="col-sm-12">
        <h2>@localizer["BusinessOperations"]</h2>
        <ol class="breadcrumb">
            <li><a asp-controller="Home" asp-action="Dashboard" asp-route-area="User">@commonLocalizer["HomeModule"]</a></li>
            <li><a asp-controller="Subscription" asp-action="Index" asp-route-area="User">@localizer["ManageSubscription"]</a></li>
            <li class="active"><strong>@localizer["BusinessOperations"]</strong></li>
        </ol>
    </div>
</div>
<div class="wrapper wrapper-content">
    <div class="row">
        <div class="col-lg-8">
            <div class="ibox">
                <div class="ibox-title"><h5>@localizer["BusinessOperationsAddon"]</h5></div>
                <div class="ibox-content">
                    <p>@localizer["BusinessOperationsAddonIntro"]</p>
                    <ul>
                        <li>@localizer["AddonFeatureInvoicing"]</li>
                        <li>@localizer["AddonFeatureContractorBilling"]</li>
                        <li>@localizer["AddonFeatureWorkforce"]</li>
                    </ul>
                    @if (Model == null)
                    {
                        <p class="alert alert-warning">@localizer["BillingUnavailable"]</p>
                    }
                    else
                    {
                        <h3>@Model.MonthlyAmount.ToString("N2") @Model.Currency / @localizer["Monthly"]</h3>
                        @if (Model.Active)
                        {
                            <p class="text-navy"><i class="fa fa-check"></i> @localizer["AddonActive"]</p>
                        }
                        else
                        {
                            <p>@localizer["CheckoutPending"]</p>
                        }
                        @if (Model.PaidThroughUtc.HasValue)
                        {
                            <p>@localizer["PaidThrough"]: @Model.PaidThroughUtc.Value.ToString("u")</p>
                        }
                        @if (Model.Cancelled)
                        {
                            <p class="text-warning">@localizer["SubscriptionCancelled"]</p>
                        }
                        @if (Model.CheckoutAvailable)
                        {
                            <form method="post" asp-action="Checkout" id="business-operations-checkout">@Html.AntiForgeryToken()<button type="submit" class="btn btn-primary">@localizer["Buy"]</button></form>
                        }
                        @if (Model.CanCancel && !Model.Cancelled)
                        {
                            <form method="post" asp-action="CancelRenewal" class="m-t-sm">@Html.AntiForgeryToken()<button type="submit" class="btn btn-default" onclick="return confirm('@localizer["CancelSubscriptionConfirm"]');">@localizer["CancelSubscription"]</button></form>
                        }
                    }
                    <p class="alert alert-danger m-t-sm" id="business-operations-billing-error" hidden></p>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="ibox">
                <div class="ibox-title"><h5>@localizer["Links"]</h5></div>
                <div class="ibox-content">
                    <p><a asp-controller="Subscription" asp-action="Index" asp-route-area="User">@localizer["ManageSubscription"]</a></p>
                    <p><a asp-controller="Invoicing" asp-action="Index" asp-route-area="User">@localizer["Invoicing"]</a></p>
                    <p><a asp-controller="Department" asp-action="ModuleSettings" asp-route-area="User">@localizer["ModuleSettings"]</a></p>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
@if (Model?.Provider == "Paddle") { <script src="https://cdn.paddle.com/paddle/v2/paddle.js"></script> }
<script type="application/json" id="business-operations-billing-config">@Html.Raw(JsonConvert.SerializeObject(new {
    provider = Model?.Provider, token = Model?.Provider == "Paddle" ? PaymentProviderConfig.GetPaddleClientToken() : null,
    environment = PaymentProviderConfig.GetPaddleEnvironment(), error = localizer["BillingUnavailable"].Value
}, new JsonSerializerSettings { StringEscapeHandling = StringEscapeHandling.EscapeHtml }))</script>
<script src="~/js/app/internal/invoicing/business-operations-billing.js" asp-append-version="true"></script>
}
