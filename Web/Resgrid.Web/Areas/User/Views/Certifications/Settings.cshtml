@model Resgrid.Web.Areas.User.Models.Certifications.CertificationSettingsView
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Certifications.Certifications> localizer
@{
    ViewBag.Title = "Resgrid | " + localizer["Settings"];
    ViewData["Tab"] = "Settings";
    ViewData["Title"] = localizer["CertificationSettings"].Value;
    ViewData["Subtitle"] = localizer["SettingsIntro"].Value;
    var s = Model.Settings;
}

@await Html.PartialAsync("_Shell")

<div class="wrapper wrapper-content">
    @await Html.PartialAsync("_Message", (Resgrid.Web.Areas.User.Models.Certifications.CertificationPageView)Model)
    <div class="ibox float-e-margins">
        <div class="ibox-title"><h5>@localizer["CertificationSettings"]</h5></div>
        <div class="ibox-content">
            @await Html.PartialAsync("_Tabs")
            <form method="post" asp-controller="Certifications" asp-action="Settings" asp-route-area="User" class="form-horizontal" id="certSettings">
                @Html.AntiForgeryToken()
                <h4>@localizer["Enforcement"]</h4>
                <div class="form-group">
                    <label class="col-sm-3 control-label" for="EnforcementMode">@localizer["EnforcementMode"]</label>
                    <div class="col-sm-5">
                        <select class="form-control" id="EnforcementMode" name="EnforcementMode">
                            <option value="0" selected="@(s.EnforcementMode == 0)">@localizer["EnforcementOff"]</option>
                            <option value="1" selected="@(s.EnforcementMode == 1)">@localizer["EnforcementWarnOnly"]</option>
                            <option value="2" selected="@(s.EnforcementMode == 2)">@localizer["EnforcementEnforce"]</option>
                        </select>
                        <span class="help-block m-b-none">@localizer["EnforcementHint"]</span>
                        <input type="hidden" name="ConfirmEnforce" id="ConfirmEnforce" value="false" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label" for="RoleRemovalGraceDays">@localizer["RoleRemovalGraceDays"]</label>
                    <div class="col-sm-2"><input type="number" class="form-control" id="RoleRemovalGraceDays" name="RoleRemovalGraceDays" value="@s.RoleRemovalGraceDays" min="0" max="3650" /></div>
                    <div class="col-sm-5"><span class="help-block m-b-none">@localizer["RoleRemovalGraceDaysHint"]</span></div>
                </div>
                <div class="form-group">
                    <div class="col-sm-offset-3 col-sm-8">
                        <div class="checkbox"><label><input type="checkbox" name="TreatPendingVerificationAsValid" value="true" checked="@s.TreatPendingVerificationAsValid" /><input type="hidden" name="TreatPendingVerificationAsValid" value="false" /> @localizer["TreatPendingVerificationAsValid"]</label></div>
                    </div>
                </div>
                <div class="hr-line-dashed"></div>
                <h4>@localizer["Notifications"]</h4>
                <div class="form-group">
                    <label class="col-sm-3 control-label" for="NotifyLeadDaysCsv">@localizer["NotifyLeadDays"]</label>
                    <div class="col-sm-3"><input type="text" class="form-control" id="NotifyLeadDaysCsv" name="NotifyLeadDaysCsv" value="@s.NotifyLeadDaysCsv" maxlength="100" /></div>
                    <div class="col-sm-5"><span class="help-block m-b-none">@localizer["NotifyLeadDaysHint"]</span></div>
                </div>
                <div class="form-group">
                    <div class="col-sm-offset-3 col-sm-8">
                        <div class="checkbox"><label><input type="checkbox" name="NotifyCertificationHolder" value="true" checked="@s.NotifyCertificationHolder" /><input type="hidden" name="NotifyCertificationHolder" value="false" /> @localizer["NotifyCertificationHolder"]</label></div>
                        <div class="checkbox"><label><input type="checkbox" name="SendAdminDigest" value="true" checked="@s.SendAdminDigest" /><input type="hidden" name="SendAdminDigest" value="false" /> @localizer["SendAdminDigest"]</label></div>
                        <span class="help-block m-b-none">@localizer["NotificationsHint"] <a asp-controller="Notifications" asp-action="Index" asp-route-area="User">@localizer["NotificationSettings"]</a></span>
                    </div>
                </div>
                <div class="hr-line-dashed"></div>
                <div class="form-group">
                    <div class="col-sm-offset-3 col-sm-6">
                        <button type="submit" class="btn btn-primary">@localizer["Save"]</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            var initial = '@s.EnforcementMode';
            $('#certSettings').on('submit', function () {
                if ($('#EnforcementMode').val() === '2' && initial !== '2') {
                    if (!confirm(@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(string.Format(localizer["EnforceConfirm"].Value, Model.MandatoryRequirementCount))))) return false;
                    $('#ConfirmEnforce').val('true');
                }
                return true;
            });
        });
    </script>
}
