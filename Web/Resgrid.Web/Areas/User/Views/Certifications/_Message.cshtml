@model Resgrid.Web.Areas.User.Models.Certifications.CertificationPageView
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Certifications.Certifications> localizer
@if (Model.SaveSuccess)
{
    <div class="alert alert-success">@localizer["Saved"]</div>
}
@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-danger">@Model.Message</div>
}
