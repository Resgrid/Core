@using Resgrid.Web.Helpers
@using Resgrid.Model
@model Resgrid.Web.Areas.User.Models.CommunicationTests.CommunicationTestIndexView
@inject IStringLocalizer<Resgrid.Localization.Areas.User.CommunicationTest.CommunicationTest> localizer
@{
    ViewBag.Title = "Resgrid | " + @localizer["CommunicationTestsHeader"];
}

<div class="row wrapper border-bottom white-bg page-heading">
    <div class="col-sm-4">
        <h2>@localizer["CommunicationTestsHeader"]</h2>
        <ol class="breadcrumb">
            <li>
                <a asp-controller="Home" asp-action="Dashboard" asp-route-area="User">@localizer["Home"]</a>
            </li>
            <li class="active">
                <strong>@localizer["CommunicationTestsHeader"]</strong>
            </li>
        </ol>
    </div>
    @if (ClaimsAuthorizationHelper.IsUserDepartmentAdmin())
    {
        <div class="col-sm-8">
            <div class="btn-group top-page-buttons" style="float:right;padding-right:15px;">
                <a class="btn btn-success" asp-controller="CommunicationTest" asp-action="New" asp-route-area="User">@localizer["NewTest"]</a>
            </div>
        </div>
    }
</div>
<div class="wrapper wrapper-content animated fadeInUp">
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox">
                <div class="ibox-title">
                    <h5>@localizer["TestDefinitions"]</h5>
                </div>
                <div class="ibox-content" style="border-bottom:none; padding-bottom:0;">
                    <div class="alert alert-info" style="margin-bottom:0;">
                        @localizer["TargetsUsersBanner"]
                    </div>
                </div>
                <div class="ibox-content">
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>@localizer["TestName"]</th>
                                    <th>@localizer["Schedule"]</th>
                                    <th>@localizer["Channels"]</th>
                                    <th>@localizer["Scope"]</th>
                                    <th>@localizer["Active"]</th>
                                    <th>@localizer["ResponseWindow"]</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var test in Model.Tests)
                                {
                                    var scheduleLabel = ((CommunicationTestScheduleType)test.ScheduleType).ToString();
                                    var channels = new System.Collections.Generic.List<string>();
                                    if (test.TestSms) channels.Add(localizer["SMS"]);
                                    if (test.TestEmail) channels.Add(localizer["Email"]);
                                    if (test.TestVoice) channels.Add(localizer["Voice"]);
                                    if (test.TestPush) channels.Add(localizer["Push"]);

                                    var scopeLabel = Model.TestScopes.TryGetValue(test.CommunicationTestId.ToString(), out var scope) && !string.IsNullOrWhiteSpace(scope) ? scope : localizer["ScopeEveryone"].Value;

                                    <tr>
                                        <td>@test.Name</td>
                                        <td>@scheduleLabel</td>
                                        <td>@string.Join(", ", channels)</td>
                                        <td>@scopeLabel</td>
                                        <td>
                                            @if (test.Active)
                                            {
                                                <span class="label label-primary">@localizer["Active"]</span>
                                            }
                                            else
                                            {
                                                <span class="label label-default">@localizer["Inactive"]</span>
                                            }
                                        </td>
                                        <td>@test.ResponseWindowMinutes @localizer["MinutesShort"]</td>
                                        <td style="text-align:right;">
                                            @if (Model.IsDepartmentAdmin)
                                            {
                                                if (test.ScheduleType == (int)Resgrid.Model.CommunicationTestScheduleType.OnDemand)
                                                {
                                                    <form asp-controller="CommunicationTest" asp-action="StartRun" asp-route-area="User" method="post" style="display:inline;">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="testId" value="@test.CommunicationTestId" />
                                                        <button type="submit" class="btn btn-sm btn-primary" onclick="return confirmRunNow();">@localizer["RunNow"]</button>
                                                    </form>
                                                }
                                                <a class="btn btn-sm btn-info" asp-controller="CommunicationTest" asp-action="Edit" asp-route-area="User" asp-route-testId="@test.CommunicationTestId">@localizer["Edit"]</a>
                                                <form asp-controller="CommunicationTest" asp-action="Delete" asp-route-area="User" method="post" style="display:inline;">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="testId" value="@test.CommunicationTestId" />
                                                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm(@Html.Raw(Json.Serialize(localizer["DeleteTestWarning"].Value)));">@localizer["Delete"]</button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox">
                <div class="ibox-title">
                    <h5>@localizer["RecentTestRuns"]</h5>
                </div>
                <div class="ibox-content">
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>@localizer["TestNameHeader"]</th>
                                    <th>@localizer["RunCode"]</th>
                                    <th>@localizer["Started"]</th>
                                    <th>@localizer["Status"]</th>
                                    <th>@localizer["UsersTested"]</th>
                                    <th>@localizer["Responses"]</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var run in Model.RecentRuns)
                                {
                                    var testName = "";
                                    Model.TestNames.TryGetValue(run.CommunicationTestId.ToString(), out testName);
                                    var statusLabel = ((CommunicationTestRunStatus)run.Status).ToString();

                                    <tr>
                                        <td>@testName</td>
                                        <td><code>@run.RunCode</code></td>
                                        <td>@run.StartedOn.ToString("g")</td>
                                        <td>
                                            @if (run.Status == (int)CommunicationTestRunStatus.Completed)
                                            {
                                                <span class="label label-primary">@statusLabel</span>
                                            }
                                            else if (run.Status == (int)CommunicationTestRunStatus.Failed)
                                            {
                                                <span class="label label-danger">@statusLabel</span>
                                            }
                                            else
                                            {
                                                <span class="label label-warning">@statusLabel</span>
                                            }
                                        </td>
                                        <td>@run.TotalUsersTested</td>
                                        <td>@run.TotalResponses</td>
                                        <td>
                                            <a class="btn btn-sm btn-info" asp-controller="CommunicationTest" asp-action="Report" asp-route-area="User" asp-route-runId="@run.CommunicationTestRunId">@localizer["ViewReport"]</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Spelled out at the point of no return: a communication test really does message people,
        // and push confirmation only works for personnel running the Responder app. Serialized from
        // the resource so the warning appears in the administrator's language, newlines and all.
        var runNowConfirmText = @Html.Raw(Json.Serialize(localizer["RunNowConfirm"].Value));

        function confirmRunNow() {
            return confirm(runNowConfirmText);
        }
    </script>
}
