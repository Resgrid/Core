@model Resgrid.Web.Areas.User.Models.CommunicationTests.NewCommunicationTestView
@inject IStringLocalizer<Resgrid.Localization.Areas.User.CommunicationTest.CommunicationTest> localizer
@{
    ViewBag.Title = "Resgrid | " + @localizer["NewTest"];
}

<div class="row wrapper border-bottom white-bg page-heading">
    <div class="col-sm-12">
        <h2>@localizer["NewTest"]</h2>
        <ol class="breadcrumb">
            <li>
                <a asp-controller="Home" asp-action="Dashboard" asp-route-area="User">@localizer["Home"]</a>
            </li>
            <li>
                <a asp-controller="CommunicationTest" asp-action="Index" asp-route-area="User">@localizer["CommunicationTestsHeader"]</a>
            </li>
            <li class="active">
                <strong>@localizer["NewTest"]</strong>
            </li>
        </ol>
    </div>
</div>
<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">
        <div class="col-lg-8">
            @if (!string.IsNullOrWhiteSpace(Model.Message))
            {
                <div class="alert alert-danger">@Model.Message</div>
            }
            <div class="ibox">
                <div class="ibox-title">
                    <h5>@localizer["TestDefinitions"]</h5>
                </div>
                <div class="ibox-content">
                    <form asp-controller="CommunicationTest" asp-action="New" asp-route-area="User" method="post" class="form-horizontal">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="form-group">
                            <label class="col-sm-3 control-label">@localizer["TestName"]</label>
                            <div class="col-sm-9">
                                <input type="text" class="form-control" asp-for="Test.Name" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label">@localizer["TestDescription"]</label>
                            <div class="col-sm-9">
                                <textarea class="form-control" asp-for="Test.Description" rows="3"></textarea>
                            </div>
                        </div>

                        <hr />
                        <h4 class="col-sm-offset-3">@localizer["Schedule"]</h4>
                        <div class="form-group">
                            <label class="col-sm-3 control-label">@localizer["ScheduleType"]</label>
                            <div class="col-sm-9">
                                <select class="form-control" asp-for="Test.ScheduleType" id="scheduleType">
                                    <option value="0">@localizer["OnDemand"]</option>
                                    <option value="1">@localizer["Weekly"]</option>
                                    <option value="2">@localizer["Monthly"]</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-group" id="weeklyOptions" style="display:none;">
                            <label class="col-sm-3 control-label">@localizer["DaysOfWeek"]</label>
                            <div class="col-sm-9">
                                <label class="radio-inline"><input type="radio" name="DayOfWeek" value="Sunday" /> @localizer["Sun"]</label>
                                <label class="radio-inline"><input type="radio" name="DayOfWeek" value="Monday" checked /> @localizer["Mon"]</label>
                                <label class="radio-inline"><input type="radio" name="DayOfWeek" value="Tuesday" /> @localizer["Tue"]</label>
                                <label class="radio-inline"><input type="radio" name="DayOfWeek" value="Wednesday" /> @localizer["Wed"]</label>
                                <label class="radio-inline"><input type="radio" name="DayOfWeek" value="Thursday" /> @localizer["Thu"]</label>
                                <label class="radio-inline"><input type="radio" name="DayOfWeek" value="Friday" /> @localizer["Fri"]</label>
                                <label class="radio-inline"><input type="radio" name="DayOfWeek" value="Saturday" /> @localizer["Sat"]</label>
                                <input type="hidden" asp-for="Test.Sunday" id="hdnSunday" />
                                <input type="hidden" asp-for="Test.Monday" id="hdnMonday" />
                                <input type="hidden" asp-for="Test.Tuesday" id="hdnTuesday" />
                                <input type="hidden" asp-for="Test.Wednesday" id="hdnWednesday" />
                                <input type="hidden" asp-for="Test.Thursday" id="hdnThursday" />
                                <input type="hidden" asp-for="Test.Friday" id="hdnFriday" />
                                <input type="hidden" asp-for="Test.Saturday" id="hdnSaturday" />
                            </div>
                        </div>
                        <div class="form-group" id="monthlyOptions" style="display:none;">
                            <label class="col-sm-3 control-label">@localizer["DayOfMonth"]</label>
                            <div class="col-sm-9">
                                <input type="number" class="form-control" asp-for="Test.DayOfMonth" min="1" max="28" />
                            </div>
                        </div>
                        <div class="form-group" id="timeOptions" style="display:none;">
                            <label class="col-sm-3 control-label">@localizer["Time"]</label>
                            <div class="col-sm-9">
                                <input type="text" class="form-control" asp-for="Test.Time" id="timePicker" placeholder="09:00 AM" />
                            </div>
                        </div>

                        <hr />
                        <h4 class="col-sm-offset-3">@localizer["ChannelsToTest"]</h4>
                        <div class="form-group">
                            <div class="col-sm-offset-3 col-sm-9">
                                <label class="checkbox-inline"><input type="checkbox" asp-for="Test.TestSms" /> @localizer["SMS"]</label>
                                <label class="checkbox-inline"><input type="checkbox" asp-for="Test.TestEmail" /> @localizer["Email"]</label>
                                <label class="checkbox-inline"><input type="checkbox" asp-for="Test.TestVoice" /> @localizer["Voice"]</label>
                                <label class="checkbox-inline"><input type="checkbox" asp-for="Test.TestPush" /> @localizer["Push"]</label>
                            </div>
                        </div>

                        <hr />
                        <h4 class="col-sm-offset-3">@localizer["WhoToTest"]</h4>
                        <div class="form-group">
                            <div class="col-sm-offset-3 col-sm-9">
                                <p class="help-block">
                                    @localizer["WhoToTestHelp"]
                                </p>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label" for="SelectedGroupIds">@localizer["Groups"]</label>
                            <div class="col-sm-9">
                                <select class="form-control" id="SelectedGroupIds" name="SelectedGroupIds" multiple size="6">
                                    @foreach (var group in Model.TargetOptions.Groups)
                                    {
                                        <option value="@group.DepartmentGroupId" selected="@(Model.SelectedGroupIds.Contains(group.DepartmentGroupId))">@group.Name</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label" for="SelectedRoleIds">@localizer["Roles"]</label>
                            <div class="col-sm-9">
                                <select class="form-control" id="SelectedRoleIds" name="SelectedRoleIds" multiple size="6">
                                    @foreach (var role in Model.TargetOptions.Roles)
                                    {
                                        <option value="@role.PersonnelRoleId" selected="@(Model.SelectedRoleIds.Contains(role.PersonnelRoleId))">@role.Name</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label" for="SelectedUserIds">@localizer["Individuals"]</label>
                            <div class="col-sm-9">
                                <select class="form-control" id="SelectedUserIds" name="SelectedUserIds" multiple size="10">
                                    @foreach (var person in Model.TargetOptions.Personnel)
                                    {
                                        <option value="@person.UserId" selected="@(Model.SelectedUserIds.Contains(person.UserId))">@person.Name</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <hr />
                        <div class="form-group">
                            <label class="col-sm-3 control-label">@localizer["ResponseWindowMinutes"]</label>
                            <div class="col-sm-9">
                                <input type="number" class="form-control" asp-for="Test.ResponseWindowMinutes" min="1" max="1440" />
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-sm-offset-3 col-sm-9">
                                <label class="checkbox-inline"><input type="checkbox" asp-for="Test.Active" /> @localizer["Active"]</label>
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-sm-offset-3 col-sm-9">
                                <button type="submit" class="btn btn-primary">@localizer["CreateTest"]</button>
                                <a class="btn btn-default" asp-controller="CommunicationTest" asp-action="Index" asp-route-area="User">@localizer["Cancel"]</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-8">
            @await Html.PartialAsync("_ChannelPreview", Model.Preview)
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            function toggleScheduleOptions() {
                var type = $('#scheduleType').val();
                $('#weeklyOptions').toggle(type === '1');
                $('#monthlyOptions').toggle(type === '2');
                $('#timeOptions').toggle(type !== '0');
            }
            $('#scheduleType').change(toggleScheduleOptions);
            toggleScheduleOptions();

            $('#timePicker').datetimepicker({
                datepicker: false,
                format: 'h:i A',
                formatTime: 'h:i A',
                step: 15
            });

            function syncDayRadios() {
                var days = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
                var selected = $('input[name="DayOfWeek"]:checked').val();
                days.forEach(function(d) {
                    $('#hdn' + d).val(d === selected ? 'true' : 'false');
                });
            }


            function updatePreviewNames() {
                var name = $('#Test_Name').val();
                if (!name) {
                    name = 'Your Test Name';
                }

                $('[data-preview-template]').each(function () {
                    var template = $(this).attr('data-preview-template');
                    $(this).find('.preview-text').text(template.split('{name}').join(name));
                });
            }

            $('#Test_Name').on('input', updatePreviewNames);
            updatePreviewNames();
            $('input[name="DayOfWeek"]').change(syncDayRadios);
            syncDayRadios();

            $('form').on('submit', function () {
                syncDayRadios();
            });
        });
    </script>
}
