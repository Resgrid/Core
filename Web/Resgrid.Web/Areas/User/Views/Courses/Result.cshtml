@using Resgrid.Model.Lms
@using Resgrid.Web.Areas.User.Models.Courses
@model AttemptResultModel
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Courses.Courses> localizer
@* A finished attempt, as the lesson's answer-review policy allows (a grader sees every answer, R-T12). *@
@{
    var result = Model.Result;
    var attempt = result.Attempt;
    ViewBag.Title = "Resgrid | " + localizer["ResultTitle"];
    ViewData["Section"] = "Courses";
    ViewData["Title"] = (result.Lesson?.Title ?? localizer["AssessmentTitle"].Value) + " — " + localizer["ResultTitle"].Value;
    ViewData["Subtitle"] = Model.MemberName;
    ViewData["Message"] = Model.Message;
    ViewData["Error"] = Model.Error;
}

@await Html.PartialAsync("~/Areas/User/Views/Trainings/_Shell.cshtml")

<div class="wrapper wrapper-content rgw-page">
    <div class="rgw-stat-tiles" role="list">
        <div class="rgw-stat-tile" role="listitem">
            <div class="rgw-stat-label">@localizer["ScoreColumn"]</div>
            <div class="rgw-stat-value">@attempt.Percent.ToString("0.#")%</div>
        </div>
        <div class="rgw-stat-tile" role="listitem">
            <div class="rgw-stat-label">@localizer["ResultColumn"]</div>
            <div class="rgw-stat-value">
                @if (attempt.Status == (int)LmsAttemptStatuses.PendingGrading)
                {
                    <span class="text-warning">@localizer["AwaitingGradeBadge"]</span>
                }
                else if (attempt.Passed == true)
                {
                    <span class="text-navy"><i class="fa fa-check" aria-hidden="true"></i> @localizer["PassedBadge"]</span>
                }
                else
                {
                    <span class="text-danger"><i class="fa fa-times" aria-hidden="true"></i> @localizer["FailedBadge"]</span>
                }
            </div>
        </div>
        <div class="rgw-stat-tile" role="listitem">
            <div class="rgw-stat-label">@localizer["PassMarkLabel"]</div>
            <div class="rgw-stat-value">@attempt.PassMark%</div>
        </div>
    </div>

    @if (result.ShowCorrectness || result.ShowAnswers)
    {
        <div class="ibox float-e-margins">
            <div class="ibox-content">
                @foreach (var item in result.Questions)
                {
                    <div class="m-b-md">
                        <h5>
                            @if (item.Correct == true)
                            {
                                <i class="fa fa-check text-navy" aria-hidden="true"></i><span class="sr-only">@localizer["CorrectLabel"]</span>
                            }
                            else if (item.Correct == false)
                            {
                                <i class="fa fa-times text-danger" aria-hidden="true"></i><span class="sr-only">@localizer["IncorrectLabel"]</span>
                            }
                            else if (item.AwaitingGrade)
                            {
                                <i class="fa fa-hourglass-half text-warning" aria-hidden="true"></i><span class="sr-only">@localizer["AwaitingGradeBadge"]</span>
                            }
                            @item.Question.Text
                        </h5>
                        @if (item.Question.Kind == (int)LmsQuestionKinds.ShortAnswer)
                        {
                            <p class="well well-sm" style="white-space:pre-wrap">@item.Answer?.Text</p>
                        }
                        else
                        {
                            <ul class="list-unstyled">
                                @foreach (var option in item.Question.Options)
                                {
                                    var chosen = item.Answer?.Keys?.Contains(option.Key) == true;
                                    var right = item.CorrectKeys?.Contains(option.Key) == true;
                                    <li class="@(right ? "text-navy" : "")">
                                        <i class="fa @(chosen ? "fa-dot-circle-o" : "fa-circle-o")" aria-hidden="true"></i> @option.Text
                                        @if (chosen) {<span class="rgw-sub">@localizer["YourAnswerLabel"]</span>}
                                        @if (right) {<span class="rgw-sub">@localizer["CorrectAnswerLabel"]</span>}
                                    </li>
                                }
                            </ul>
                            @if (item.Question.Kind == (int)LmsQuestionKinds.Ordering && item.CorrectKeys != null)
                            {
                                <p class="small">@localizer["CorrectOrderLabel"] @string.Join(" → ", item.CorrectKeys.Select(k => item.Question.Options.FirstOrDefault(o => o.Key == k)?.Text))</p>
                            }
                        }
                        @if (!string.IsNullOrWhiteSpace(item.Explanation))
                        {
                            <p class="text-muted small"><i class="fa fa-lightbulb-o" aria-hidden="true"></i> @item.Explanation</p>
                        }
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <p class="text-muted">@localizer["AnswersHiddenNote"]</p>
    }

    @if (!string.IsNullOrWhiteSpace(attempt.GradeNotes) && (Model.MemberName == null || result.ShowAnswers))
    {
        <div class="alert alert-info"><strong>@localizer["GraderNotesLabel"]</strong> @attempt.GradeNotes</div>
    }

    @if (Model.MemberName == null)
    {
        <a class="btn btn-primary" asp-controller="Courses" asp-action="Play" asp-route-area="User" asp-route-id="@attempt.LmsEnrollmentId"><i class="fa fa-arrow-left" aria-hidden="true"></i> @localizer["BackToCourse"]</a>
    }
    else
    {
        <a class="btn btn-white" asp-controller="Courses" asp-action="Grading" asp-route-area="User"><i class="fa fa-arrow-left" aria-hidden="true"></i> @localizer["GradingTitle"]</a>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/module-workspace.css" asp-append-version="true" />
}
