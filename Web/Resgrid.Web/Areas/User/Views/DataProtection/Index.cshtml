@using Resgrid.Model
@using Resgrid.Web.Helpers
@model Resgrid.Web.Areas.User.Models.DataProtection.DataProtectionIndexView
@inject IStringLocalizer<Resgrid.Localization.Areas.User.DataProtection.DataProtection> localizer
@{
    ViewBag.Title = "Resgrid | " + @localizer["PageTitle"];
}

@Html.AntiForgeryToken()

<div class="row wrapper border-bottom white-bg page-heading">
    <div class="col-sm-8">
        <h2>@localizer["PageTitle"]</h2>
        <ol class="breadcrumb">
            <li>
                <a asp-controller="Home" asp-action="Dashboard" asp-route-area="User">@localizer["BreadcrumbHome"]</a>
            </li>
            <li>
                <a asp-controller="Security" asp-action="Index" asp-route-area="User">@localizer["BreadcrumbSecurity"]</a>
            </li>
            <li class="active">
                <strong>@localizer["PageTitle"]</strong>
            </li>
        </ol>
    </div>
</div>

<div class="wrapper wrapper-content animated fadeInRight">

    @if (Model.IsDepartmentLocked)
    {
        <div class="alert alert-warning">
            <strong>@localizer["MigrationWindowActive"]</strong> @(string.IsNullOrWhiteSpace(Model.LockReason) ? @localizer["DataEntryPaused"].Value : Model.LockReason)
        </div>
    }

    @* ── Status panel (always shown) ─────────────────────────────────────── *@
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>@localizer["ProtectionStatusHeader"]</h5>
                </div>
                <div class="ibox-content">
                    <p>
                        @localizer["CurrentState"]
                        <span class="label @(Model.State == DepartmentDataProtectionState.Enabled || Model.State == DepartmentDataProtectionState.Rotating || Model.State == DepartmentDataProtectionState.OffboardingScheduled ? "label-primary" : Model.State == DepartmentDataProtectionState.Failed ? "label-danger" : "label-default")">
                            @Model.StateName
                        </span>
                    </p>

                    @switch (Model.State)
                    {
                        case DepartmentDataProtectionState.Disabled:
                            if (!Model.Preflight.GateOpen)
                            {
                                <div class="alert alert-info">
                                    @localizer["EnrollmentUnavailable"]
                                </div>
                            }
                            else if (!Model.Preflight.HasActiveAddon)
                            {
                                <div class="alert alert-info">
                                    <p>
                                        @localizer["AddonRequiredIntro"]
                                    </p>
                                    @if (Model.IsManagingMember)
                                    {
                                        <a class="btn btn-primary" asp-controller="Subscription" asp-action="Index" asp-route-area="User">@localizer["PurchaseAddon"]</a>
                                    }
                                    else
                                    {
                                        <p><em>@localizer["ManagingMemberOnlyPurchase"]</em></p>
                                    }
                                </div>
                            }
                            else if (!Model.IsManagingMember)
                            {
                                <div class="alert alert-info">
                                    @localizer["AddonActiveManagingMemberOnly"]
                                </div>
                            }
                            break;

                        case DepartmentDataProtectionState.EnrollmentQueued:
                            <div class="alert alert-info">
                                <p>
                                    @localizer["EnrollmentQueuedNotice", Model.MigrationWindowStartLocal, Model.MigrationWindowEndLocal, Model.MigrationWindowTimeZone]
                                </p>
                                @if (Model.IsManagingMember)
                                {
                                    <button id="btnCancelQueued" class="btn btn-warning">@localizer["CancelQueuedEnrollment"]</button>
                                }
                            </div>
                            break;

                        case DepartmentDataProtectionState.ProvisioningKey:
                        case DepartmentDataProtectionState.Encrypting:
                        case DepartmentDataProtectionState.Verifying:
                        case DepartmentDataProtectionState.Rotating:
                            <div class="alert alert-info">
                                @localizer["MigrationInProgress", Model.MigrationWindowStartLocal, Model.MigrationWindowEndLocal, Model.MigrationWindowTimeZone]
                            </div>
                            break;

                        case DepartmentDataProtectionState.Enabled:
                            <div class="alert alert-success">
                                <p><strong>@localizer["ProtectionActiveHeader"]</strong> @localizer["ProtectionActiveDetail"]</p>
                                <p>
                                    @localizer["TurnOffInstructions"]
                                    <a asp-controller="Subscription" asp-action="Index" asp-route-area="User">@localizer["SubscriptionPage"]</a>
                                </p>
                            </div>
                            break;

                        case DepartmentDataProtectionState.OffboardingScheduled:
                            <div class="alert alert-warning">
                                <p>
                                    <strong>@localizer["OffboardingScheduledHeader"]</strong>
                                    @localizer["OffboardingScheduledDetail", string.IsNullOrWhiteSpace(Model.OffboardingEffectiveOn) ? @localizer["EndOfBillingPeriod"].Value : Model.OffboardingEffectiveOn]
                                </p>
                                <p>@localizer["TurnOffInstructions"]</p>
                                @if (Model.IsManagingMember)
                                {
                                    <button id="btnRevokeOffboarding" class="btn btn-primary">@localizer["RevokeOffboarding"]</button>
                                }
                            </div>
                            break;

                        case DepartmentDataProtectionState.DisableRequested:
                        case DepartmentDataProtectionState.Decrypting:
                            <div class="alert alert-info">
                                @localizer["OffboardingInProgress"]
                            </div>
                            break;

                        case DepartmentDataProtectionState.Failed:
                            <div class="alert alert-danger">
                                @localizer["MigrationFailed"]
                            </div>
                            break;
                    }
                    <div id="commandResult"></div>
                </div>
            </div>
        </div>
    </div>

    @* ── Enrollment Wizard (Disabled + gate open + addon + managing member) ── *@
    @if (Model.State == DepartmentDataProtectionState.Disabled && Model.Preflight.GateOpen &&
         Model.Preflight.HasActiveAddon && Model.IsManagingMember)
    {
        <div class="row" id="adpWizard">
            <div class="col-lg-12">
                <div class="ibox float-e-margins">
                    <div class="ibox-title"><h5>@localizer["WizardHeader"]</h5></div>
                    <div class="ibox-content">

                        @* Step 1: Introduction and scope *@
                        <div class="adp-step" data-step="1">
                            <h3>@localizer["Step1Header"]</h3>
                            <p>@localizer["Step1Intro"]</p>
                            <ul>
                                <li><strong>@localizer["Step1ProtectedLabel"]</strong> @localizer["Step1ProtectedList"]</li>
                                <li><strong>@localizer["Step1PlaintextLabel"]</strong> @localizer["Step1PlaintextList"]</li>
                            </ul>
                            <p>@localizer["Step1WhileProtected"]</p>
                            <ul>
                                <li>@localizer["Step1LimitSearch"]</li>
                                <li>@localizer["Step1LimitBigBoard"]</li>
                                <li>@localizer["Step1LimitWorkflow"]</li>
                                <li>@localizer["Step1LimitNotifications"]</li>
                            </ul>
                            <div class="alert alert-warning">
                                @localizer["Step1NotCompliance"]
                            </div>
                            <button class="btn btn-primary adp-next">@localizer["Continue"]</button>
                        </div>

                        @* Step 2: Acknowledgements *@
                        <div class="adp-step" data-step="2" style="display:none;">
                            <h3>@localizer["Step2Header"]</h3>
                            <p>@localizer["Step2Intro"]</p>
                            <div id="adpAcks">
                                <div class="checkbox"><label><input type="checkbox" class="adp-ack" value="catalog_scope" /> @localizer["AckCatalogScope"]</label></div>
                                <div class="checkbox"><label><input type="checkbox" class="adp-ack" value="plaintext_metadata" /> @localizer["AckPlaintextMetadata"]</label></div>
                                <div class="checkbox"><label><input type="checkbox" class="adp-ack" value="authorized_server_access" /> @localizer["AckAuthorizedServerAccess"]</label></div>
                                <div class="checkbox"><label><input type="checkbox" class="adp-ack" value="step_up_window" /> @localizer["AckStepUpWindow"]</label></div>
                                <div class="checkbox"><label><input type="checkbox" class="adp-ack" value="bigboard_reduction" /> @localizer["AckBigBoardReduction"]</label></div>
                                <div class="checkbox"><label><input type="checkbox" class="adp-ack" value="workflow_redaction" /> @localizer["AckWorkflowRedaction"]</label></div>
                                <div class="checkbox"><label><input type="checkbox" class="adp-ack" value="default_egress" /> @localizer["AckDefaultEgress"]</label></div>
                                <div class="checkbox"><label><input type="checkbox" class="adp-ack" value="search_report_limitations" /> @localizer["AckSearchReportLimitations"]</label></div>
                                <div class="checkbox"><label><input type="checkbox" class="adp-ack" value="migration_disable" /> @localizer["AckMigrationDisable"]</label></div>
                                <div class="checkbox"><label><input type="checkbox" class="adp-ack" value="key_loss_support" /> @localizer["AckKeyLossSupport"]</label></div>
                                <div class="checkbox"><label><input type="checkbox" class="adp-ack" value="not_hipaa_compliance" /> @localizer["AckNotHipaaCompliance"]</label></div>
                            </div>
                            <button class="btn btn-default adp-prev">@localizer["Back"]</button>
                            <button class="btn btn-primary adp-next" id="adpAckNext" disabled>@localizer["Continue"]</button>
                        </div>

                        @* Step 3: Preflight *@
                        <div class="adp-step" data-step="3" style="display:none;">
                            <h3>@localizer["Step3Header"]</h3>
                            <table class="table">
                                <tbody>
                                    <tr><td>@localizer["CheckManagingMember"]</td><td>@(Model.Preflight.IsManagingMember ? "✔" : "✖")</td></tr>
                                    <tr><td>@localizer["CheckPaidPlan"]</td><td>@(Model.Preflight.HasPaidPlan ? "✔" : "✖")</td></tr>
                                    <tr><td>@localizer["CheckActiveAddon"]</td><td>@(Model.Preflight.HasActiveAddon ? "✔" : "✖")</td></tr>
                                    <tr><td>@localizer["CheckGateOpen"]</td><td>@(Model.Preflight.GateOpen ? "✔" : "✖")</td></tr>
                                    <tr><td>@localizer["CheckStateAllows"]</td><td>@(Model.Preflight.StateAllowsEnrollment ? "✔" : "✖")</td></tr>
                                    <tr><td>@localizer["CheckBrokerHealthy"]</td><td>@(Model.BrokerHealthy ? "✔" : "✖")</td></tr>
                                    <tr><td>@localizer["CheckManagingMemberMfa"]</td><td>@(Model.ManagingMemberHasMfa ? "✔" : "✖")</td></tr>
                                </tbody>
                            </table>
                            @if (!(Model.Preflight.Passed && Model.BrokerHealthy && Model.ManagingMemberHasMfa))
                            {
                                <div class="alert alert-danger">@localizer["PreflightFailed"]</div>
                            }
                            <button class="btn btn-default adp-prev">@localizer["Back"]</button>
                            <button class="btn btn-primary adp-next" @(Model.Preflight.Passed && Model.BrokerHealthy && Model.ManagingMemberHasMfa ? "" : "disabled")>@localizer["Continue"]</button>
                        </div>

                        @* Step 4: Sizing scan *@
                        <div class="adp-step" data-step="4" style="display:none;">
                            <h3>@localizer["Step4Header"]</h3>
                            <p>@localizer["Step4Intro"]</p>
                            <button class="btn btn-info" id="adpRunSizing">@localizer["RunSizingScan"]</button>
                            <div id="adpSizingResult" style="margin-top:12px;"></div>
                            <hr />
                            <button class="btn btn-default adp-prev">@localizer["Back"]</button>
                            <button class="btn btn-primary adp-next">@localizer["Continue"]</button>
                        </div>

                        @* Step 5: Window selection + lock consent *@
                        <div class="adp-step" data-step="5" style="display:none;">
                            <h3>@localizer["Step5Header"]</h3>
                            <p>@localizer["Step5Intro", Model.DefaultWindowStart, Model.DefaultWindowEnd]</p>
                            <div class="form-group">
                                <label>@localizer["WindowStartLabel"]</label>
                                <input type="time" id="adpWindowStart" class="form-control" style="max-width:200px" value="@Model.DefaultWindowStart" />
                            </div>
                            <div class="form-group">
                                <label>@localizer["WindowEndLabel"]</label>
                                <input type="time" id="adpWindowEnd" class="form-control" style="max-width:200px" value="@Model.DefaultWindowEnd" />
                            </div>
                            <div class="form-group">
                                <label>@localizer["TimeZoneLabel"]</label>
                                <select id="adpWindowTimeZone" class="form-control" style="max-width:420px" asp-items="Model.TimeZones"></select>
                            </div>
                            <div class="alert alert-warning">
                                <strong>@localizer["OperationPauseHeader"]</strong> @localizer["OperationPauseDetail"]
                            </div>
                            <div class="checkbox"><label><input type="checkbox" id="adpLockConsent" /> @localizer["LockConsent"]</label></div>
                            <button class="btn btn-default adp-prev">@localizer["Back"]</button>
                            <button class="btn btn-primary adp-next" id="adpLockNext" disabled>@localizer["Continue"]</button>
                        </div>

                        @* Step 6: Confirm and queue *@
                        <div class="adp-step" data-step="6" style="display:none;">
                            <h3>@localizer["Step6Header"]</h3>
                            <p>@localizer["Step6Intro"]</p>
                            <div id="adpQueueError"></div>
                            <button class="btn btn-default adp-prev">@localizer["Back"]</button>
                            <button class="btn btn-primary" id="adpQueueEnrollment">@localizer["QueueEnrollment"]</button>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts
{
    <script type="text/javascript">
        // The wizard's error text and confirmations are localized here and handed to the script,
        // keyed by the value-free codes the server returns.
        var adpWizardMessages = {
            acknowledgements_incomplete: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(localizer["ErrAcknowledgementsIncomplete"].Value)),
            lock_consent_required: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(localizer["ErrLockConsentRequired"].Value)),
            protected_access_denied: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(localizer["ErrProtectedAccessDenied"].Value)),
            addon_required: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(localizer["ErrAddonRequired"].Value)),
            plan_required: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(localizer["ErrPlanRequired"].Value)),
            feature_not_available: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(localizer["ErrFeatureNotAvailable"].Value)),
            invalid_state: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(localizer["ErrInvalidState"].Value)),
            invalid_window: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(localizer["ErrInvalidWindow"].Value)),
            command_failed: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(localizer["ErrCommandFailed"].Value)),
            confirm_cancel_queued: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(localizer["ConfirmCancelQueued"].Value)),
            confirm_revoke_offboarding: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(localizer["ConfirmRevokeOffboarding"].Value))
        };
    </script>
    <script src="~/js/app/internal/dataprotection/resgrid.dataprotection.wizard.js" type="text/javascript"></script>
}
