@model Resgrid.Web.Areas.User.Models.Settings.SettingsAddressModel
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Department.Department> localizer
@{
    ViewBag.Title = "Resgrid | " + @localizer["DepartmentAddressHeader"];
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
}

<div class="row wrapper border-bottom white-bg page-heading">
    <div class="col-sm-12">
        <h2>@localizer["DepartmentAddressHeader"]</h2>
        <ol class="breadcrumb">
            <li>
                <a asp-controller="Home" asp-action="Dashboard" asp-route-area="User">@commonLocalizer["HomeModule"]</a>
            </li>
            <li>
                <a asp-controller="Department" asp-action="Settings" asp-route-area="User">@localizer["DepartmentSettingsHeader"]</a>
            </li>
            <li class="active">
                <strong>@localizer["DepartmentAddressHeader"]</strong>
            </li>
        </ol>
    </div>
</div>

<div class="wrapper wrapper-content">
    <div class="row">
        <div class="col-xs-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>@localizer["DepartmentAddressHeader"]</h5>
                </div>
                <div class="ibox-content">
                    @using (Html.BeginForm("Address", "Department", FormMethod.Post, new { area = "User", @class = "form-horizontal" }))
                    {
                        if (!String.IsNullOrEmpty(Model.Message))
                        {
                            <div class="alert alert-success">
                                @Model.Message
                            </div>
                        }
                        if (!String.IsNullOrEmpty(Model.ErrorMessage))
                        {
                            <div class="alert alert-danger">
                                @Model.ErrorMessage
                            </div>
                        }
                        @Html.ValidationSummary(false, "", new { @class = "text-danger" })
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.Department.Name)
                        @Html.HiddenFor(m => m.Department.Address.AddressId)

                        <div class="form-group">
                            <label asp-for="Department.Address.Address1" class="col-sm-3 control-label">
                                @localizer["StreetLabel"]
                            </label>
                            <div class="col-sm-6">
                                @Html.TextBoxFor(m => m.Department.Address.Address1, new { @class = "form-control" }) @Html.ValidationMessageFor(m => m.Department.Address.Address1, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            <label asp-for="Department.Address.City" class="col-sm-3 control-label">
                                @localizer["CityLabel"]
                            </label>
                            <div class="col-sm-6">
                                @Html.TextBoxFor(m => m.Department.Address.City, new { @class = "form-control" }) @Html.ValidationMessageFor(m => m.Department.Address.City, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            <label asp-for="Department.Address.State" class="col-sm-3 control-label">
                                @localizer["StateLabel"]
                            </label>
                            <div class="col-sm-6">
                                @Html.TextBoxFor(m => m.Department.Address.State, new { @class = "form-control" }) @Html.ValidationMessageFor(m => m.Department.Address.State, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            <label asp-for="Department.Address.PostalCode" class="col-sm-3 control-label">
                                @localizer["PostalCodeLabel"]
                            </label>
                            <div class="col-sm-6">
                                @Html.TextBoxFor(m => m.Department.Address.PostalCode, new { @class = "form-control" }) @Html.ValidationMessageFor(m => m.Department.Address.PostalCode, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            <label asp-for="Department.Address.Country" class="col-sm-3 control-label">
                                @localizer["CountryLabel"]
                            </label>
                            <div class="col-sm-6">
                                @Html.TextBoxFor(m => m.Department.Address.Country, new { @class = "form-control" }) @Html.ValidationMessageFor(m => m.Department.Address.Country, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="hr-line-dashed"></div>
                        <div class="form-group">
                            <div class="col-sm-6 col-sm-offset-3">
                                <input class="btn btn-primary" id="submit_action" name="commit" type="submit" value="@commonLocalizer["Save"]" />
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts
    {
    <partial name="_ValidationScriptsPartial" />
}
