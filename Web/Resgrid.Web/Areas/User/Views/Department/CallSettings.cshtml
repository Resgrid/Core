@model Resgrid.Web.Areas.User.Models.Departments.CallSettings.CallSettingsView
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Department.Department> localizer
@inject IStringLocalizer<Resgrid.Localization.Areas.User.AiDispatch.AiDispatch> aiDispatchLocalizer
@inject Resgrid.Model.AiDispatch.IAiDispatchEnrichmentService aiDispatch
@{
    ViewBag.Title = "Resgrid | " + @localizer["CallSettingsHeader"];
}
@section Styles
{

}

<div class="row wrapper border-bottom white-bg page-heading">
    <div class="col-sm-4">
        <h2>@localizer["CallSettingsHeader"]</h2>
        <ol class="breadcrumb">
            <li>
                <a asp-controller="Home" asp-action="Dashboard" asp-route-area="User">@commonLocalizer["HomeModule"]</a>
            </li>
            <li>
                <a asp-controller="Department" asp-action="Settings" asp-route-area="User">@localizer["DepartmentSettingsHeader"]</a>
            </li>
            <li class="active">
                <strong>@localizer["CallSettingsHeader"]</strong>
            </li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="col-xs-12">
        <div class="wrapper wrapper-content">
            <div class="ibox float-e-margins">
                <div class="ibox-content">
                    <form id="call-settings-form" class="form-horizontal" role="form" asp-controller="Department" asp-action="CallSettings" asp-route-area="User" method="post" data-next-number-confirm="@localizer["CallNumberRaiseConfirm"]">

                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.EmailSettings.DepartmentCallEmailId)
                        @Html.HiddenFor(m => m.CallType)
                        @Html.HiddenFor(m => m.TextCallType)
                        <div asp-validation-summary="All" class="text-danger"></div>
                        @if (!String.IsNullOrEmpty(Model.Message))
                        {
                            <div class="alert alert-success">
                                @Model.Message
                            </div>
                        }
                        @if (!String.IsNullOrEmpty(Model.ErrorMessage))
                        {
                            <div class="alert alert-danger">
                                @Model.ErrorMessage
                            </div>
                        }

                        <div class="form-group">
                            <label class="col-sm-2 control-label">@localizer["DispatchImportEmail"]</label>
                            <div class="col-sm-10">
                                <strong>@Model.InternalDispatchEmail</strong>
                                <span class="help-block m-b-none">@localizer["DispatchImportEmailHelp"]</span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-2 control-label">@localizer["PruneCalls"]</label>
                            <div class="col-sm-10">
                                <input type="checkbox" asp-for="PruneEmailCalls">
                                <span class="help-block m-b-none">@localizer["PruneCallsHelp"]</span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-2 control-label">@localizer["MinutesToKeepOpen"]</label>
                            <div class="col-sm-10">
                                <strong><input type="number" asp-for="MinutesTillPrune" min="0" step="10" max="10080" /></strong>
                                <span class="help-block m-b-none">@localizer["MinutesToKeepOpenHelp"]</span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-2 control-label">@localizer["EmailType"]</label>
                            <div class="col-sm-10">
                                <div id="listView"></div>
                                <div id="pager" class="k-pager-wrap"></div>
                                @if (Model.Department != null && await aiDispatch.IsAvailableAsync(Model.Department.DepartmentId))
                                {
                                    <p class="m-t-sm"><a asp-controller="AiDispatch" asp-action="Index" asp-route-area="User">@aiDispatchLocalizer["SettingsTitle"]</a></p>
                                }
                            </div>
                        </div>

                        <div class="hr-line-dashed"></div>
                        <h3>@localizer["CallNumberingHeader"]</h3>
                        <p class="text-muted">@localizer["CallNumberingIntro"]</p>
                        <div class="form-group">
                            <label class="col-sm-2 control-label" for="CallNumberPattern">@localizer["CallNumberPattern"]</label>
                            <div class="col-sm-4">
                                <input type="text" class="form-control" maxlength="@CallNumberFormat.MaxPatternLength" autocomplete="off" spellcheck="false" asp-for="CallNumberPattern" />
                            </div>
                            <div class="col-sm-6">
                                <p class="form-control-static">@localizer["CallNumberExample"] <code id="call-number-preview"></code></p>
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-sm-offset-2 col-sm-10">
                                <span class="help-block m-b-none">@localizer["CallNumberPatternHelp"]</span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-2 control-label" for="CallNumberSequenceWidth">@localizer["CallNumberSequenceWidth"]</label>
                            <div class="col-sm-2">
                                <input type="number" class="form-control" min="@CallNumberFormat.MinWidth" max="@CallNumberFormat.MaxWidth" asp-for="CallNumberSequenceWidth" />
                            </div>
                            <div class="col-sm-8">
                                <span class="help-block m-b-none">@localizer["CallNumberSequenceWidthHelp"]</span>
                            </div>
                        </div>
                        @{
                            var callYearStart = new NumberingYearStart(Model.CallNumberYearStartMonth, Model.CallNumberYearStartDay, (NumberingYearLabel)Model.CallNumberYearLabel);
                            var callYearMonths = System.Globalization.CultureInfo.CurrentUICulture.DateTimeFormat.MonthNames.Take(12)
                                .Select((name, i) => new SelectListItem(name, (i + 1).ToString(System.Globalization.CultureInfo.InvariantCulture), i + 1 == callYearStart.Month)).ToList();
                        }
                        <div class="form-group">
                            <label class="col-sm-2 control-label" for="CallNumberYearStartMonth">@localizer["CallNumberYearStart"]</label>
                            <div class="col-sm-10">
                                <div class="numbering-year-start">
                                    <select class="form-control" asp-for="CallNumberYearStartMonth" asp-items="callYearMonths"></select>
                                    <input type="number" class="form-control numbering-year-day" min="1" max="31" asp-for="CallNumberYearStartDay" aria-label="@localizer["CallNumberYearStartDay"]" />
                                    <select class="form-control" asp-for="CallNumberYearLabel" aria-label="@localizer["CallNumberYearStart"]">
                                        <option value="@((int)NumberingYearLabel.EndYear)">@localizer["CallNumberYearLabelEndYear"]</option>
                                        <option value="@((int)NumberingYearLabel.StartYear)">@localizer["CallNumberYearLabelStartYear"]</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-sm-offset-2 col-sm-10">
                                <span class="help-block m-b-none">@localizer["CallNumberYearStartHelp"]</span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-2 control-label">@localizer["CallNumberNext"]</label>
                            <div class="col-sm-10">
                                <p class="form-control-static">
                                    <code>@Model.CallNumberNextNumber</code>
                                    @if (Model.CallNumberResetPeriod == CallNumberResetPeriod.Yearly && !callYearStart.IsCalendarYear)
                                    {
                                        <span class="text-muted">@localizer["CallNumberResetsYearlyOn", new DateTime(2001, callYearStart.Month, callYearStart.Day).ToString("M", System.Globalization.CultureInfo.CurrentUICulture)]</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">@localizer["CallNumberResets" + Model.CallNumberResetPeriod]</span>
                                    }
                                </p>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-2 control-label" for="CallNumberNextSequence">@localizer["CallNumberRaiseTo"]</label>
                            <div class="col-sm-2">
                                <input type="hidden" asp-for="CallNumberScopeKey" />
                                <input type="number" class="form-control" asp-for="CallNumberNextSequence" min="@Model.CallNumberCurrentNextSequence" max="@CallNumberFormat.MaxSequence" placeholder="@Model.CallNumberCurrentNextSequence" />
                            </div>
                            <div class="col-sm-8">
                                <span class="help-block m-b-none">@localizer["CallNumberRaiseToHelp"]</span>
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-sm-8 col-sm-offset-2">
                                <a class="btn btn-white" asp-controller="Home" asp-action="Dashboard" asp-route-area="User">@commonLocalizer["Cancel"]</a>
                                <button class="btn btn-primary" type="submit">@commonLocalizer["Update"]</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" id="resgridEmailTypeModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title">Resgrid Email Type</h4>
            </div>
            <div class="modal-body">
                <p>
                    Want to use the Call Import system to add calls into Resgrid? Are you able to control the format of emails? If so use the Resgrid email type.
                </p>
                <dl>
                    <dt>What is the Resgrid Email Type format?</dt>
                    <dd>
                        The Resgrid email type is formatted like this, values are separated by the PIPE, or vertical bar, character: <br /> <br />

                        ID | TYPE | PRIORITY | ADDRESS | MAPPAGE | NATURE | NOTES
                    </dd>
                    <dt>What are the values?</dt>
                    <dd>
                        <dl class="dl-horizontal">
                            <dt>ID</dt>
                            <dd>Incident Identifier from the CAD system. This field can be empty or set to 0000.</dd>
                            <dt>TYPE</dt>
                            <dd>Type of incident, can be anything, i.e. MEDICAL, FIRE, WILDLAND, HAZMAT, etc. When your department has Call Types set up and this value matches one of them, casing aside, the call is tagged with that Call Type. This value can also be empty.</dd>
                            <dt>PRIORITY</dt>
                            <dd>Priority of the Incident, either the priority name or its integer value. On the built in priorities that is Low = 0, Medium = 1, High = 2, Emergency = 3. When your department has Custom Call Priorities set up send the priority name instead, i.e. Structure Fire, casing aside. This value can be empty, and a value that does not match one of your priorities uses your department default priority.</dd>
                            <dt>ADDRESS</dt>
                            <dd>Full Address of incident (Address, City, State, Zip). This value is required.</dd>
                            <dt>MAPPAGE</dt>
                            <dd>Map page of the Incident. This value can be empty.</dd>
                            <dt>NATURE</dt>
                            <dd>Nature of the Incident, the reason the call exists. I.e. "Fully involved 2 story residential structure". This value is required</dd>
                            <dt>NOTES</dt>
                            <dd>Any additional information. This value can be empty.</dd>
                        </dl>
                    </dd>
                    <dt>How do I specify blank/empty values</dt>
                    <dd>
                        Just leave a space between the pipes: <br /> <br />

                        | MEDICAL | 3 | 155 Main St. Carson City, NV 89701 |  | 55 Y/O Male, Chest Pain, Diaphoretic, Conscious and abnormal breathing | <br /> <br />

                        In this example ID, MAPPAGE and NOTES are empty/not supplied.
                    </dd>
                </dl>
            </div>
            <div class="modal-footer">
                <a href="#" class="btn btn-primary" data-dismiss="modal">@commonLocalizer["Close"]</a>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" id="provisionPhoneNumberModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title">Resgrid Text-To-Call Number</h4>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label class=" control-label">
                        Country
                    </label>
                    <div class="controls">
                        <select class="input-xlarge" id="country" name="country">
                            <option value="" selected="selected">Select Country</option>
                            <option value="US">United States</option>
                            <option value="CA">Canada</option>
                            <option value="GB">United Kingdom</option>
                            <option value="AU">Australia</option>
                        </select>
                    </div>
                </div>

                <table class="table table-bordered table-striped table-hover data-table">
                    <thead>
                        <tr>
                            <th>Phone Number</th>
                            <th>&nbsp;</th>
                        </tr>
                    </thead>
                    <tbody id="phoneNumberTableBody"></tbody>
                </table>
            </div>
            <div class="modal-footer">
                <a href="@Url.Action("CallSettings", "Department", new {area = "User"})" class="btn">Close</a>
            </div>
        </div>
    </div>
</div>

@section Scripts
{

    <script type="text/x-kendo-tmpl" id="template">
        <div class="product">
            <img src="/images/CallEmails/${Code}.png" alt="${Code} image" />
            <h4>${Name}</h4>
        </div>
    </script>

    <script type="text/x-kendo-tmpl" id="textTemplate">
        <div class="product">
            <img src="/images/CallTexts/${Code}.png" alt="${Code} image" />
            <h4>${Name}</h4>
        </div>
    </script>

    <script src="~/js/app/internal/department/resgrid.department.callsettings.js" type="text/javascript"></script>

    <script type="text/javascript">
        (function () {
            var pattern = $('#CallNumberPattern'), width = $('#CallNumberSequenceWidth'), preview = $('#call-number-preview');
            var startMonth = $('#CallNumberYearStartMonth'), startDay = $('#CallNumberYearStartDay'), yearLabel = $('#CallNumberYearLabel');
            var year = '@Model.CallNumberPreviewDate.ToString("yyyy", System.Globalization.CultureInfo.InvariantCulture)';
            var month = '@Model.CallNumberPreviewDate.ToString("MM", System.Globalization.CultureInfo.InvariantCulture)';
            var day = '@Model.CallNumberPreviewDate.ToString("dd", System.Globalization.CultureInfo.InvariantCulture)';
            // Mirrors NumberingYearStart.YearOf: the year naming today's numbering year. Only yearly patterns use it.
            function numberingYear() {
                var m = parseInt(startMonth.val(), 10) || 1, d = parseInt(startDay.val(), 10) || 1;
                var y = parseInt(year, 10), pm = parseInt(month, 10), pd = parseInt(day, 10);
                var startYear = pm > m || (pm === m && pd >= d) ? y : y - 1;
                return (m === 1 && d === 1) || yearLabel.val() === '@((int)NumberingYearLabel.StartYear)' ? startYear : startYear + 1;
            }
            // A sample only: the server validates the pattern and shows the real next number below it.
            function render() {
                var digits = Math.max(@CallNumberFormat.MinWidth, Math.min(@CallNumberFormat.MaxWidth, parseInt(width.val(), 10) || @CallNumberFormat.DefaultWidth));
                var sequence = '153';
                while (sequence.length < digits)
                    sequence = '0' + sequence;
                var text = pattern.val() || '';
                var shown = /\{(MM|DD)\}/i.test(text) ? year : String(numberingYear());
                preview.text(text
                    .replace(/\{YYYY\}/gi, shown).replace(/\{YY\}/gi, shown.slice(-2))
                    .replace(/\{MM\}/gi, month).replace(/\{DD\}/gi, day)
                    .replace(/\{SEQ\}/gi, sequence));
                // Which year names a fiscal year only matters when it does not start on January 1.
                yearLabel.toggle(!(startMonth.val() === '1' && (parseInt(startDay.val(), 10) || 1) === 1));
            }
            pattern.on('input', render);
            width.on('input', render);
            startMonth.on('change', render);
            startDay.on('input', render);
            yearLabel.on('change', render);
            render();

            $('#call-settings-form').on('submit', function (e) {
                if ($('#CallNumberNextSequence').val() !== '' && !window.confirm($(this).data('next-number-confirm')))
                    e.preventDefault();
            });
        })();
    </script>

    <style scoped>
        .product {
            float: left;
            width: 270px;
            height: 60px;
            margin: 5px;
            padding: 5px;
            -moz-box-shadow: inset 0 0 30px rgba(0, 0, 0, 0.15);
            -webkit-box-shadow: inset 0 0 30px rgba(0, 0, 0, 0.15);
            box-shadow: inset 0 0 30px rgba(0, 0, 0, 0.15);
            -webkit-border-radius: 15px;
            -moz-border-radius: 15px;
            border-radius: 15px;
            background-image: none;
            cursor: pointer;
        }

            .product img {
                float: left;
                width: 140px;
                height: 50px;
                -webkit-border-radius: 10px;
                -moz-border-radius: 10px;
                border-radius: 10px;
                margin: 4px 0 0 0;
            }

            .product h4 {
                margin: 0px 0 0 0;
                padding: 20px 2px 10px 10px;
                font-size: 1em;
                float: left;
                max-width: 130px;
                text-transform: uppercase;
            }

        .call-email-type-list {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            padding: 0;
            border: none;
        }

        .call-email-type-item {
            display: flex;
            align-items: center;
            width: 280px;
            border: 1px solid #e7eaec;
            border-radius: 6px;
            padding: 8px 10px;
            transition: background-color 0.15s, border-color 0.15s;
        }

        .call-email-type-item.active {
            border-color: #1ab394;
            background-color: #f0faf7;
        }

        .call-email-type-label {
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 0;
            font-weight: normal;
            cursor: pointer;
            width: 100%;
        }

        .call-email-type-img {
            width: 160px;
            height: 45px;
            object-fit: contain;
            border-radius: 4px;
            border: 1px solid #ddd;
            background: #fff;
            flex-shrink: 0;
        }

        .call-email-type-name {
            font-size: 0.85em;
            text-transform: uppercase;
            font-weight: 600;
            color: #444;
            flex: 1;
        }
        /*.k-state-selected h3
                            {
                                color: #fff;
                                background-color: rgba(0,0,0,0.4);
                                -moz-box-shadow: inset 0 0 20px rgba(0,0,0,0.2);
                                -webkit-box-shadow: inset 0 0 20px rgba(0,0,0,0.2);
                                box-shadow: inset 0 0 20px rgba(0,0,0,0.2);
                                -moz-border-radius-topright: 5px;
                                -moz-border-radius-bottomright: 5px;
                                -webkit-border-top-right-radius: 5px;
                                -webkit-border-bottom-right-radius: 5px;
                                border-top-right-radius: 5px;
                                border-bottom-right-radius: 5px;
                            }*/
        .k-listview:after {
            content: ".";
            display: block;
            height: 0;
            clear: both;
            visibility: hidden;
        }

        .k-listview {
            border: 0;
            padding: 0 0 20px 0;
            min-width: 0;
        }
    </style>
}
