@model Resgrid.Web.Areas.User.Models.Departments.MappingSettingsView
@using System.Globalization
@using Newtonsoft.Json
@using Resgrid.Model
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Department.Department> localizer
@{
    ViewBag.Title = "Resgrid | " + @localizer["MappingSettingsHeader"];

    // Lookup tables for the preview script, keyed by enum name because that is what the selects post.
    var jsonSettings = new JsonSerializerSettings { StringEscapeHandling = StringEscapeHandling.EscapeHtml };
    var styleValues = MapStylePresets.SelectableStyles.ToDictionary(s => s.ToString(), s => (int)s);

    // Provider-aware pickers (plan §5.3): only the presets this install can render, plus the saved value if it is not one
    // of them, so saving the page never silently changes it.
    var available = Model.AvailableStyles ?? new List<MapStyleTypes>();
    var selfHosted = Model.BaseMapProvider == Resgrid.Config.MappingConfig.SelfHostedMapProvider;
    var listedMapbox = MapStylePresets.MapboxStyles.Where(available.Contains).ToList();
    var listedCommunity = MapStylePresets.CommunityStyles.Where(available.Contains).ToList();
    bool NotAvailable(MapStyleTypes style) => style != MapStyleTypes.Automatic && !available.Contains(style);
    var routingName = Model.RoutingProvider switch
    {
        RoutingProviderNames.Valhalla => "Valhalla",
        RoutingProviderNames.Mapbox => "Mapbox",
        RoutingProviderNames.Google => "Google",
        RoutingProviderNames.Osrm => "OSRM",
        _ => localizer["MapProviderRoutingEstimate"].Value
    };
    var styleNames = MapStylePresets.SelectableStyles.ToDictionary(s => s.ToString(), s => localizer["MapStyle_" + s].Value);
    var nightPairs = MapStylePresets.SelectableStyles.ToDictionary(s => s.ToString(), s => MapStylePresets.ResolveNightStyle(s, MapStyleTypes.Automatic).ToString());
}

<div class="row wrapper border-bottom white-bg page-heading">
    <div class="col-sm-4">
        <h2>@localizer["MappingSettingsHeader"]</h2>
        <ol class="breadcrumb">
            <li>
                <a asp-controller="Home" asp-action="Dashboard" asp-route-area="User">@commonLocalizer["HomeModule"]</a>
            </li>
            <li>
                <a asp-controller="Department" asp-action="Settings" asp-route-area="User">@localizer["DepartmentSettingsHeader"]</a>
            </li>
            <li class="active">
                <strong>@localizer["MappingSettingsHeader"]</strong>
            </li>
        </ol>
    </div>
</div>

<form role="form" class="form-horizontal" asp-controller="Department" asp-action="MappingSettings" asp-route-area="User" method="post">
    <div class="row">
        <div class="col-xs-12">
            <div class="wrapper wrapper-content">
                <div class="ibox float-e-margins">
                    <div class="ibox-content">
                        <div class="form-horizontal">
                            @Html.AntiForgeryToken()
                            <div asp-validation-summary="All" class="text-danger"></div>

                            @if (Model.SaveSuccess.GetValueOrDefault())
				            {
                              <div class="alert alert-success">
                                @localizer["SavedMappingSettings"]
                              </div>
				            }

                            <h3>@localizer["MappingSettingsPersonnelHeader"]</h3>
                            <div class="form-group">
                                <label class="col-sm-3 control-label">@localizer["MappingSettingsPersonnelAllowOverwriteLabel"]</label>
                                <div class="col-sm-6">
                                    <admin-assist-help-after>
                                        <div class="row">
                                            <div class="col-sm-6">
                                                <input type="checkbox" asp-for="PersonnelAllowStatusWithNoLocationToOverwrite">
                                            </div>
                                        </div>
                                    </admin-assist-help-after>
                                    <span class="help-block m-b-none">@localizer["PersonnelAllowOverwriteHelp"]</span>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-3 control-label">@localizer["MappingSettingsPersonnelTTLLabel"]</label>
                                <div class="col-sm-6">
                                    <admin-assist-help-after>
                                        <div class="row">
                                            <div class="col-sm-6">
                                                <input type="number" asp-for="PersonnelLocationTTL" min="0" max="1440">
                                            </div>
                                        </div>
                                    </admin-assist-help-after>
                                    <span class="help-block m-b-none">@localizer["PersonnelTTLHelp"]</span>
                                </div>
                            </div>
                            
                            <h3>@localizer["MappingSettingsUnitsHeader"]</h3>
                            <div class="form-group">
                                <label class="col-sm-3 control-label">@localizer["MappingSettingsUnitAllowOverwriteLabel"]</label>
                                <div class="col-sm-6">
                                    <admin-assist-help-after>
                                        <div class="row">
                                            <div class="col-sm-6">
                                                <input type="checkbox" asp-for="UnitAllowStatusWithNoLocationToOverwrite">
                                            </div>
                                        </div>
                                    </admin-assist-help-after>
                                    <span class="help-block m-b-none">@localizer["UnitAllowOverwriteHelp"]</span>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-3 control-label">@localizer["MappingSettingsUnitTTLLabel"]</label>
                                <div class="col-sm-6">
                                    <admin-assist-help-after>
                                        <div class="row">
                                            <div class="col-sm-6">
                                                <input type="number" asp-for="UnitLocationTTL" min="0" max="1440">
                                            </div>
                                        </div>
                                    </admin-assist-help-after>
                                    <span class="help-block m-b-none">@localizer["UnitTTLHelp"]</span>
                                </div>
                            </div>

							<h3>@localizer["MapStyleHeader"]</h3>
							<div class="form-group">
								<div class="col-sm-6 col-sm-offset-3">
									<span class="help-block">@localizer["MapStyleHelp"]</span>
									<ul class="list-unstyled small m-b-sm" id="mapProviders">
										<li><strong>@localizer["MapProviderBaseMap"]:</strong> @(selfHosted ? localizer["MapProviderSelfHosted"].Value : "Mapbox")</li>
										<li><strong>@localizer["MapProviderRouting"]:</strong> @routingName</li>
										<li><strong>@localizer["MapProviderTraffic"]:</strong> @(Model.TrafficLayerAvailable ? localizer["MapProviderTrafficOn"] : localizer["MapProviderTrafficOff"])</li>
									</ul>
									@if (selfHosted)
									{
										<div class="alert alert-info">@localizer["MapStyleSelfHostedNote"]</div>
									}
									@if (!Model.WebsiteSupportsMapStyle)
									{
										<div class="alert alert-info">@localizer["MapStyleWebsiteUnavailable"]</div>
									}
									@if (Model.UseMapboxOverride)
									{
										<div class="alert alert-warning">@localizer["MapStyleOverrideActive"]</div>
									}
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-3 control-label" asp-for="MapStyle">@localizer["MapStyleDayLabel"]</label>
								<div class="col-sm-6">
									<select class="form-control" asp-for="MapStyle">
										<option value="@MapStyleTypes.Automatic">@localizer["MapStyleAutomaticDay"]</option>
										@if (NotAvailable(Model.MapStyle))
										{
											<option value="@Model.MapStyle">@localizer["MapStyle_" + Model.MapStyle] @localizer["MapStyleNotAvailable"]</option>
										}
										@if (listedMapbox.Any())
										{
											<optgroup label="@(selfHosted ? localizer["MapStyleServerGroup"] : localizer["MapStyleMapboxGroup"])">
												@foreach (var style in listedMapbox)
												{
													<option value="@style">@localizer["MapStyle_" + style]</option>
												}
											</optgroup>
										}
										@if (listedCommunity.Any())
										{
											<optgroup label="@localizer["MapStyleCommunityGroup"]">
												@foreach (var style in listedCommunity)
												{
													<option value="@style">@localizer["MapStyle_" + style]</option>
												}
											</optgroup>
										}
									</select>
									<span class="help-block m-b-none">@localizer["MapStyleDayHelp"]@if (listedCommunity.Any()) { <text> @localizer["MapStyleCommunityHelp"]</text> }</span>
									<img id="mapStyleDayPreview" class="img-responsive m-t-sm" style="display: none; border-radius: 4px;" width="600" height="240" loading="lazy" alt="@localizer["MapStylePreviewAlt"]" />
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-3 control-label" asp-for="MapStyleNight">@localizer["MapStyleNightLabel"]</label>
								<div class="col-sm-6">
									<select class="form-control" asp-for="MapStyleNight">
										<option value="@MapStyleTypes.Automatic">@string.Format(localizer["MapStyleAutomaticNight"].Value, localizer["MapStyle_" + MapStylePresets.ResolveNightStyle(Model.MapStyle, MapStyleTypes.Automatic)].Value)</option>
										@if (NotAvailable(Model.MapStyleNight))
										{
											<option value="@Model.MapStyleNight">@localizer["MapStyle_" + Model.MapStyleNight] @localizer["MapStyleNotAvailable"]</option>
										}
										@if (listedMapbox.Any())
										{
											<optgroup label="@(selfHosted ? localizer["MapStyleServerGroup"] : localizer["MapStyleMapboxGroup"])">
												@foreach (var style in listedMapbox)
												{
													<option value="@style">@localizer["MapStyle_" + style]</option>
												}
											</optgroup>
										}
										@if (listedCommunity.Any())
										{
											<optgroup label="@localizer["MapStyleCommunityGroup"]">
												@foreach (var style in listedCommunity)
												{
													<option value="@style">@localizer["MapStyle_" + style]</option>
												}
											</optgroup>
										}
									</select>
									<span class="help-block m-b-none">@localizer["MapStyleNightHelp"]</span>
									<img id="mapStyleNightPreview" class="img-responsive m-t-sm" style="display: none; border-radius: 4px;" width="600" height="240" loading="lazy" alt="@localizer["MapStylePreviewAlt"]" />
								</div>
							</div>

							<h3>Department Mapbox Override</h3>
							<div class="form-group">
								<label class="col-sm-3 control-label">Use Department Mapbox Map</label>
								<div class="col-sm-6">
									<admin-assist-help-after>
										<div class="row">
											<div class="col-sm-6">
												<input type="checkbox" asp-for="UseMapboxOverride">
											</div>
										</div>
									</admin-assist-help-after>
									<span class="help-block m-b-none">When enabled, this department's own Mapbox style and public token replace the Map Style above everywhere: the department website views (even when the system stays on Leaflet) and the Dispatch, Responder, Unit, IC and BigBoard apps, which load the token and style the next time they fetch their configuration. The custom style is used in both light and dark mode.</span>
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-3 control-label">Mapbox Style Url</label>
								<div class="col-sm-6">
									<input type="text" class="form-control" asp-for="MapboxStyleUrl" placeholder="mapbox://styles/username/styleid">
									<span class="help-block m-b-none">Supported values are `mapbox://styles/...` or `https://api.mapbox.com/styles/v1/...`.</span>
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-3 control-label">Mapbox Public Access Token</label>
								<div class="col-sm-6">
									<input type="text" class="form-control" asp-for="MapboxAccessToken" placeholder="pk.ey...">
									<span class="help-block m-b-none">Use a public (pk.) Mapbox token intended for website and mobile client-side map rendering for this department. It is sent to every member's browser and app; never use a secret (sk.) token.</span>
								</div>
							</div>
 
							<h3>@localizer["UnitStatusThresholdsLabel"]</h3>
							<div class="form-group">
								<div class="col-sm-9 col-sm-offset-3">
									<span class="help-block">@localizer["UnitStatusThresholdsHelp"]</span>
									<table class="table table-condensed">
										<thead>
											<tr>
												<th>@localizer["UnitStatusThresholdsStatusColumn"]</th>
												<th style="width: 140px;">@localizer["UnitStatusThresholdsWarnColumn"]</th>
												<th style="width: 140px;">@localizer["UnitStatusThresholdsAlertColumn"]</th>
											</tr>
										</thead>
										<tbody>
											@for (var i = 0; i < Model.UnitStatusThresholds.Count; i++)
											{
												<tr>
													<td>
														@localizer["UnitStatusBaseType_" + Model.UnitStatusThresholds[i].BaseType]
														<input type="hidden" asp-for="UnitStatusThresholds[i].BaseType" />
													</td>
													<td><input type="number" min="0" class="form-control" asp-for="UnitStatusThresholds[i].WarnMinutes" /></td>
													<td><input type="number" min="0" class="form-control" asp-for="UnitStatusThresholds[i].AlertMinutes" /></td>
												</tr>
											}
										</tbody>
									</table>
									@if (Model.UnitStatusTimerWarnings.Any())
									{
										<div class="alert alert-warning m-b-none" id="unitStatusTimerWarnings">
											<strong>@localizer["UnitStatusTimerWarningsHeader"]</strong>
											<ul class="m-b-xs">
												@foreach (var warning in Model.UnitStatusTimerWarnings)
												{
													<li>@warning</li>
												}
											</ul>
											<a asp-controller="CustomStatuses" asp-action="Index" asp-route-area="User">@localizer["UnitStatusTimerWarningsCustomStatuses"]</a>
											&middot;
											<a asp-controller="Department" asp-action="DispatchSettings" asp-route-area="User">@localizer["UnitStatusTimerWarningsDispatchSettings"]</a>
										</div>
									}
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-3 control-label" asp-for="UnitStatusAlertNoteRequirement">@localizer["UnitStatusAlertNoteRequirementLabel"]</label>
								<div class="col-sm-6">
									<select class="form-control" asp-for="UnitStatusAlertNoteRequirement">
										<option value="@UnitStatusAlertNoteRequirements.Optional">@localizer["UnitStatusAlertNoteRequirement_Optional"]</option>
										<option value="@UnitStatusAlertNoteRequirements.AtAlert">@localizer["UnitStatusAlertNoteRequirement_AtAlert"]</option>
										<option value="@UnitStatusAlertNoteRequirements.Always">@localizer["UnitStatusAlertNoteRequirement_Always"]</option>
									</select>
									<span class="help-block m-b-none">@localizer["UnitStatusAlertNoteRequirementHelp"]</span>
								</div>
							</div>

							<h3 id="navigation">@localizer["NavigationHeader"]</h3>
							<div class="form-group">
								<div class="col-sm-6 col-sm-offset-3">
									<span class="help-block">@localizer["NavigationHelp"]</span>
									@if (!Model.NavigationEnabled)
									{
										<div class="alert alert-info">@localizer["NavigationNotEnabled"]</div>
									}
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-3 control-label">@localizer["NavigationVoiceGuidanceLabel"]</label>
								<div class="col-sm-6">
									<admin-assist-help-after>
										<input type="checkbox" asp-for="NavigationVoiceGuidance">
									</admin-assist-help-after>
									<span class="help-block m-b-none">@localizer["NavigationVoiceGuidanceHelp"]</span>
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-3 control-label" asp-for="NavigationDistanceUnits">@localizer["NavigationDistanceUnitsLabel"]</label>
								<div class="col-sm-6">
									<select class="form-control" asp-for="NavigationDistanceUnits">
										<option value="@NavigationDistanceUnits.Device">@localizer["NavigationDistanceUnits_Device"]</option>
										<option value="@NavigationDistanceUnits.Imperial">@localizer["NavigationDistanceUnits_Imperial"]</option>
										<option value="@NavigationDistanceUnits.Metric">@localizer["NavigationDistanceUnits_Metric"]</option>
									</select>
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-3 control-label" asp-for="NavigationArrivalRadiusMeters">@localizer["NavigationArrivalRadiusLabel"]</label>
								<div class="col-sm-6">
									<input type="number" class="form-control" asp-for="NavigationArrivalRadiusMeters" min="10" max="1000">
									<span class="help-block m-b-none">@localizer["NavigationArrivalRadiusHelp"]</span>
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-3 control-label">@localizer["NavigationOnScenePromptLabel"]</label>
								<div class="col-sm-6">
									<admin-assist-help-after>
										<input type="checkbox" asp-for="NavigationOnScenePrompt">
									</admin-assist-help-after>
									<span class="help-block m-b-none">@localizer["NavigationOnScenePromptHelp"]</span>
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-3 control-label">@localizer["NavigationAvoidLabel"]</label>
								<div class="col-sm-6">
									<admin-assist-help-after>
										<label class="checkbox-inline"><input type="checkbox" asp-for="NavigationAvoidTolls"> @localizer["NavigationAvoid_Tolls"]</label>
										<label class="checkbox-inline"><input type="checkbox" asp-for="NavigationAvoidHighways"> @localizer["NavigationAvoid_Highways"]</label>
										<label class="checkbox-inline"><input type="checkbox" asp-for="NavigationAvoidFerries"> @localizer["NavigationAvoid_Ferries"]</label>
										<label class="checkbox-inline"><input type="checkbox" asp-for="NavigationAvoidUnpaved"> @localizer["NavigationAvoid_Unpaved"]</label>
									</admin-assist-help-after>
									<span class="help-block m-b-none">@localizer["NavigationAvoidHelp"]</span>
								</div>
							</div>

							<h3 id="route-deviations">@localizer["RouteDeviationsHeader"]</h3>
							<div class="form-group">
								<label class="col-sm-3 control-label">@localizer["RouteTimeDeviationsLabel"]</label>
								<div class="col-sm-6">
									<admin-assist-help-after>
										<input type="checkbox" asp-for="RouteTimeDeviations">
									</admin-assist-help-after>
									<span class="help-block m-b-none">@localizer["RouteTimeDeviationsHelp"]</span>
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-3 control-label" asp-for="RouteDeviationThresholdMinutes">@localizer["RouteDeviationThresholdLabel"]</label>
								<div class="col-sm-6">
									<input type="number" class="form-control" asp-for="RouteDeviationThresholdMinutes" min="1" max="1440">
									<span class="help-block m-b-none">@localizer["RouteDeviationThresholdHelp"]</span>
								</div>
							</div>

							<h3 id="offline-maps">@localizer["OfflineMapsHeader"]</h3>
							<div class="form-group">
								<div class="col-sm-6 col-sm-offset-3">
									<span class="help-block">@localizer["OfflineMapsHelp"]</span>
									@if (!Model.OfflineMapsEnabled)
									{
										<div class="alert alert-info">@localizer["OfflineMapsNotEnabled"]</div>
									}
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-3 control-label" asp-for="OfflineResponseAreaGeoJson">@localizer["OfflineResponseAreaLabel"]</label>
								<div class="col-sm-9">
									<span class="help-block">@string.Format(localizer["OfflineResponseAreaHelp"].Value, Model.OfflineFallbackRadiusKm)</span>
									<div id="offlineAreaMap" style="position: relative; width: 100%; height: 420px;"></div>
									<div id="offlineAreaEstimate" class="alert alert-info m-t-sm m-b-sm" role="status" aria-live="polite" style="display: none;"></div>
									<button type="button" class="btn btn-white btn-sm m-b-sm" id="offlineAreaClear">@localizer["OfflineResponseAreaClear"]</button>
									<textarea class="form-control" asp-for="OfflineResponseAreaGeoJson" rows="3" spellcheck="false" style="font-family: monospace; font-size: 12px;"></textarea>
									<span class="help-block m-b-none">@localizer["OfflineResponseAreaGeoJsonHelp"]</span>
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-3 control-label">@localizer["OfflineIncludedDataLabel"]</label>
								<div class="col-sm-6">
									<admin-assist-help-after>
										<label class="checkbox-inline"><input type="checkbox" asp-for="OfflineIncludeCustomMaps"> @localizer["OfflineInclude_CustomMaps"]</label>
										<label class="checkbox-inline"><input type="checkbox" asp-for="OfflineIncludeIndoorMaps"> @localizer["OfflineInclude_IndoorMaps"]</label>
										<label class="checkbox-inline"><input type="checkbox" asp-for="OfflineIncludeLayers"> @localizer["OfflineInclude_Layers"]</label>
										<label class="checkbox-inline"><input type="checkbox" asp-for="OfflineIncludePois"> @localizer["OfflineInclude_Pois"]</label>
										<label class="checkbox-inline"><input type="checkbox" asp-for="OfflineIncludeHydrants"> @localizer["OfflineInclude_Hydrants"]</label>
									</admin-assist-help-after>
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-3 control-label" asp-for="OfflineDownloadPolicy">@localizer["OfflineDownloadPolicyLabel"]</label>
								<div class="col-sm-6">
									<select class="form-control" asp-for="OfflineDownloadPolicy">
										<option value="@OfflineDownloadPolicy.WifiOnly">@localizer["OfflineDownloadPolicy_WifiOnly"]</option>
										<option value="@OfflineDownloadPolicy.AnyNetwork">@localizer["OfflineDownloadPolicy_AnyNetwork"]</option>
										<option value="@OfflineDownloadPolicy.Manual">@localizer["OfflineDownloadPolicy_Manual"]</option>
									</select>
									<span class="help-block m-b-none">@localizer["OfflineDownloadPolicyHelp"]</span>
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-3 control-label">@localizer["OfflineIncidentPacksLabel"]</label>
								<div class="col-sm-6">
									<admin-assist-help-after>
										<input type="checkbox" asp-for="OfflineIncidentPacks">
									</admin-assist-help-after>
									<span class="help-block m-b-none">@localizer["OfflineIncidentPacksHelp"]</span>
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-3 control-label" asp-for="OfflineIncidentRadiusKm">@localizer["OfflineIncidentRadiusLabel"]</label>
								<div class="col-sm-6">
									<input type="number" class="form-control" asp-for="OfflineIncidentRadiusKm" min="1" max="25">
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-3 control-label">@localizer["OfflineCorridorPacksLabel"]</label>
								<div class="col-sm-6">
									<admin-assist-help-after>
										<input type="checkbox" asp-for="OfflineCorridorPacks">
									</admin-assist-help-after>
									<span class="help-block m-b-none">@localizer["OfflineCorridorPacksHelp"]</span>
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-3 control-label" asp-for="OfflineCorridorBufferMeters">@localizer["OfflineCorridorBufferLabel"]</label>
								<div class="col-sm-6">
									<input type="number" class="form-control" asp-for="OfflineCorridorBufferMeters" min="50" max="5000">
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-3 control-label" asp-for="OfflineRefreshHours">@localizer["OfflineRefreshHoursLabel"]</label>
								<div class="col-sm-6">
									<input type="number" class="form-control" asp-for="OfflineRefreshHours" min="1" max="720">
									<span class="help-block m-b-none">@localizer["OfflineRefreshHoursHelp"]</span>
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-3 control-label" asp-for="OfflineStaleDays">@localizer["OfflineStaleDaysLabel"]</label>
								<div class="col-sm-6">
									<input type="number" class="form-control" asp-for="OfflineStaleDays" min="1" max="365">
									<span class="help-block m-b-none">@localizer["OfflineStaleDaysHelp"]</span>
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-3 control-label">@localizer["OfflinePreferLocalLabel"]</label>
								<div class="col-sm-6">
									<admin-assist-help-after>
										<input type="checkbox" asp-for="OfflinePreferLocalInArea">
									</admin-assist-help-after>
									<span class="help-block m-b-none">@localizer["OfflinePreferLocalHelp"]</span>
								</div>
							</div>

                            <div class="form-group">
                                <div class="col-sm-4 col-sm-offset-2">
                                    <a class="btn btn-white" asp-controller="Home" asp-action="Dashboard" asp-route-area="User">@commonLocalizer["Cancel"]</a>
                                    <button class="btn btn-primary" type="submit">@commonLocalizer["Save"]</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Styles
{
	<link rel="stylesheet" href="~/lib/geoman-io/leaflet-geoman-free/dist/leaflet-geoman.css" />
}

@section Scripts
{
	<script src="~/lib/geoman-io/leaflet-geoman-free/dist/leaflet-geoman.min.js"></script>
	<partial name="_MapKitConfig" />
	<script>
		var offlineAreaSettings = {
			center: [@Model.PreviewLatitude.ToString(CultureInfo.InvariantCulture), @Model.PreviewLongitude.ToString(CultureInfo.InvariantCulture)],
			estimateUrl: '@Url.Action("EstimateResponseArea", "Department", new { area = "User" })',
			measuring: @Html.Raw(JsonConvert.SerializeObject(localizer["OfflineAreaMeasuring"].Value, jsonSettings)),
			failed: @Html.Raw(JsonConvert.SerializeObject(localizer["OfflineAreaMeasureFailed"].Value, jsonSettings)),
			invalidJson: @Html.Raw(JsonConvert.SerializeObject(localizer["OfflineAreaInvalid"].Value, jsonSettings))
		};
	</script>
	<script src="~/js/app/internal/department/resgrid.department.offlinearea.js"></script>
	<script>
		(function () {
			// Previews come from the server's signed GetStaticMap (plan §6.6), drawn the way this install renders the style.
			var template = @Html.Raw(JsonConvert.SerializeObject(Model.PreviewUrlTemplate ?? string.Empty, jsonSettings));
			var center = [@Model.PreviewLongitude.ToString(CultureInfo.InvariantCulture), @Model.PreviewLatitude.ToString(CultureInfo.InvariantCulture)];
			var styleValues = @Html.Raw(JsonConvert.SerializeObject(styleValues, jsonSettings));
			var styleNames = @Html.Raw(JsonConvert.SerializeObject(styleNames, jsonSettings));
			var nightPairs = @Html.Raw(JsonConvert.SerializeObject(nightPairs, jsonSettings));
			var automaticNightFormat = @Html.Raw(JsonConvert.SerializeObject(localizer["MapStyleAutomaticNight"].Value, jsonSettings));

			var daySelect = document.getElementById('MapStyle');
			var nightSelect = document.getElementById('MapStyleNight');
			var dayPreview = document.getElementById('mapStyleDayPreview');
			var nightPreview = document.getElementById('mapStyleNightPreview');

			if (!daySelect || !nightSelect)
				return;

			function resolveDay(value) {
				return value === 'Automatic' ? 'Streets' : value;
			}

			function resolveNight(dayValue, nightValue) {
				return nightValue === 'Automatic' ? nightPairs[resolveDay(dayValue)] : nightValue;
			}

			function showPreview(img, style, night) {
				if (!img)
					return;

				if (!template || styleValues[style] === undefined) {
					img.style.display = 'none';
					return;
				}

				img.src = template
					.replace('{lat}', center[1]).replace('{lon}', center[0]).replace('{zoom}', '11')
					.replace('{width}', '600').replace('{height}', '240').replace('{scale}', '2')
					.replace('{scheme}', night ? 'night' : 'day') + '&style=' + styleValues[style];
				img.style.display = 'block';
			}

			function update() {
				var nightAutomatic = nightSelect.querySelector('option[value="Automatic"]');
				var pairedNight = nightPairs[resolveDay(daySelect.value)];

				if (nightAutomatic && pairedNight)
					nightAutomatic.textContent = automaticNightFormat.replace('{0}', styleNames[pairedNight] || pairedNight);

				showPreview(dayPreview, resolveDay(daySelect.value), false);
				showPreview(nightPreview, resolveNight(daySelect.value, nightSelect.value), true);
			}

			daySelect.addEventListener('change', update);
			nightSelect.addEventListener('change', update);
			update();
		})();
	</script>
}
