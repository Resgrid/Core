@model Resgrid.Web.Areas.User.Models.Departments.ShiftSettingsView
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Department.Department> localizer
@{
    ViewBag.Title = "Resgrid | " + localizer["ShiftSettingsHeader"];
}

<div class="row wrapper border-bottom white-bg page-heading">
    <div class="col-sm-4">
        <h2>@localizer["ShiftSettingsHeader"]</h2>
        <ol class="breadcrumb">
            <li>
                <a asp-controller="Home" asp-action="Dashboard" asp-route-area="User">@commonLocalizer["HomeModule"]</a>
            </li>
            <li>
                <a asp-controller="Department" asp-action="Settings" asp-route-area="User">@localizer["DepartmentSettingsHeader"]</a>
            </li>
            <li class="active">
                <strong>@localizer["ShiftSettingsHeader"]</strong>
            </li>
        </ol>
    </div>
</div>

<form role="form" class="form-horizontal" asp-controller="Department" asp-action="ShiftSettings" asp-route-area="User" method="post">
    <div class="row">
        <div class="col-xs-12">
            <div class="wrapper wrapper-content">
                <div class="ibox float-e-margins">
                    <div class="ibox-content">
                        <div class="form-horizontal">
                            @Html.AntiForgeryToken()
                            <div asp-validation-summary="All" class="text-danger"></div>

                            @if (Model.SaveSuccess.GetValueOrDefault())
				            {
                              <div class="alert alert-success">
                                  @localizer["SaveShiftSettingsText"]
                              </div>
				            }

                            <h3>@localizer["ShiftSignupSettingsHeader"]</h3>
                            <div class="form-group">
                                <label class="col-sm-3 control-label">@localizer["ShiftSignupsMultipleGroupsHeader"]</label>
                                <div class="col-sm-9">
                                    <div class="row">
                                        <div class="col-sm-10">
                                            <input type="checkbox" asp-for="AllowSignupsForMultipleShiftGroups">
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <h3>@localizer["ShiftTradeSettingsHeader"]</h3>
                            <p class="text-muted">@localizer["ShiftTradeApproversHelp"]</p>
                            <div class="form-group">
                                <label class="col-sm-3 control-label">@localizer["ShiftTradeApproversDepartmentAdmins"]</label>
                                <div class="col-sm-9">
                                    <input type="checkbox" checked="checked" disabled="disabled" aria-describedby="tradeAdminsHelp">
                                    <span id="tradeAdminsHelp" class="help-block m-b-none">@localizer["ShiftTradeApproversDepartmentAdminsHelp"]</span>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-3 control-label" for="TradeApproversGroupAdmins">@localizer["ShiftTradeApproversGroupAdmins"]</label>
                                <div class="col-sm-9">
                                    <input type="checkbox" asp-for="TradeApproversGroupAdmins">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-3 control-label" for="TradeApproversRequester">@localizer["ShiftTradeApproversRequester"]</label>
                                <div class="col-sm-9">
                                    <input type="checkbox" asp-for="TradeApproversRequester">
                                    <span class="help-block m-b-none">@localizer["ShiftTradeApproversRequesterHelp"]</span>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-3 control-label" for="TradeApproverRoleIds">@localizer["ShiftTradeApproversRoles"]</label>
                                <div class="col-sm-9">
                                    <select asp-for="TradeApproverRoleIds" multiple class="form-control trade-approver-roles" style="width:100%;">
                                        @foreach (var role in Model.Roles.OrderBy(x => x.Name))
                                        {
                                            <option value="@role.PersonnelRoleId" selected="@(Model.TradeApproverRoleIds.Contains(role.PersonnelRoleId))">@role.Name</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="form-group">
                                <div class="col-sm-4 col-sm-offset-2">
                                    <a class="btn btn-white" asp-controller="Home" asp-action="Dashboard" asp-route-area="User">@commonLocalizer["Cancel"]</a>
                                    <button class="btn btn-primary" type="submit">@commonLocalizer["Save"]</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts
{
    <script>
        $(function () {
            if ($.fn.select2) {
                $('.trade-approver-roles').select2();
            }
        });
    </script>
}
