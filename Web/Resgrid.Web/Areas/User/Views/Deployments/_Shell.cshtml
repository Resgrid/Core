@inject IStringLocalizer<Resgrid.Localization.Areas.User.Deployments.Deployments> localizer
@*
    Page heading shared by every deployment screen (Workforce & Business Operations plan, Phase C6).
    ViewData["Title"] heading + last crumb (defaults to the module name); ViewData["Subtitle"] optional line under it.
*@
@{
    var title = (string)ViewData["Title"] ?? localizer["Deployments"].Value;
    var subtitle = (string)ViewData["Subtitle"];
    var isRoot = string.Equals(title, localizer["Deployments"].Value, StringComparison.Ordinal);
}
<div class="row wrapper border-bottom white-bg page-heading rgw-page-heading">
    <div class="@(ViewData["HeaderActions"] == null ? "col-sm-12" : "col-sm-4")">
        <h2>@title</h2>
        <ol class="breadcrumb">
            <li><a asp-controller="Home" asp-action="Dashboard" asp-route-area="User">@commonLocalizer["HomeModule"]</a></li>
            @if (isRoot)
            {
                <li class="active"><strong>@title</strong></li>
            }
            else
            {
                <li><a asp-controller="Deployments" asp-action="Index" asp-route-area="User">@localizer["Deployments"]</a></li>
                <li class="active"><strong>@title</strong></li>
            }
        </ol>
        @if (!string.IsNullOrEmpty(subtitle))
        {
            <small class="text-muted">@subtitle</small>
        }
    </div>
    @await Html.PartialAsync("_WorkspaceHeaderActions")
</div>
