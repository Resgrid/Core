@using Resgrid.Model
@using Resgrid.Web.Helpers
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Dispatch.Dashboard> localizer
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Department.Department> departmentLocalizer
@inject IStringLocalizer<Resgrid.Localization.Common> commonLocalizer
@{
	ViewBag.Title = "Resgrid | " + departmentLocalizer["AwaitingResourcesLabel"];
	Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
}

<div class="row wrapper border-bottom white-bg page-heading">
	<div class="col-sm-4">
		<h2>@departmentLocalizer["AwaitingResourcesLabel"]</h2>
		<ol class="breadcrumb">
			<li>
				<a asp-controller="Home" asp-action="Dashboard" asp-route-area="User">@commonLocalizer["HomeModule"]</a>
			</li>
			<li>
				<a asp-controller="Dispatch" asp-action="Dashboard" asp-route-area="User">@commonLocalizer["CallsModule"]</a>
			</li>
			<li class="active">
				<strong>@departmentLocalizer["AwaitingResourcesLabel"]</strong>
			</li>
		</ol>
	</div>
	<div class="col-sm-8">
		<div class="btn-group top-page-buttons" style="float:right;padding-right:15px;">
			<div class="buttons-actions">
				<a title="@localizer["ActiveCallsHeader"]" class="btn btn-info" asp-controller="Dispatch" asp-action="Dashboard" asp-route-area="User">@localizer["ActiveCallsHeader"]</a>
			</div>
		</div>
	</div>
</div>

<div class="row">
	<div class="col-xs-12">
		<div class="wrapper wrapper-content">
			<div class="ibox float-e-margins">
				<div class="ibox-title">
					<h5><i class="fa fa-exclamation-triangle"></i> @departmentLocalizer["AwaitingResourcesLabel"]</h5>
				</div>
				<div class="ibox-content">
					<p class="text-muted">@departmentLocalizer["AwaitingResourcesHelp"]</p>
					<div id="awaitingResourcesList"></div>
					<form id="awaitingResourcesForm">@Html.AntiForgeryToken()</form>
				</div>
			</div>
		</div>
	</div>
</div>

@section Scripts
{
	@await Html.PartialAsync("_DispatchLocalizationScript")
	<script src="~/js/app/common/signalr/resgrid.common.signalr.js" type="text/javascript"></script>
	<script type="text/javascript">
		$(document).ready(function () {
			resgrid.common.analytics.track('Dispatch Awaiting Resources');
			// Dispatches, closes and dismissals arrive as call events; freed units as outstandingRequirementsUpdated.
			resgrid.common.signalr.init(resgrid.dispatch.awaitingresources.refresh, function () { }, function () { }, resgrid.dispatch.awaitingresources.refresh);
		});
	</script>
}
