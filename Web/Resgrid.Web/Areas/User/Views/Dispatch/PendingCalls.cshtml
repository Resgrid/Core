@using Resgrid.Model
@using Resgrid.Web.Helpers
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Dispatch.Dashboard> localizer
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Dispatch.Call> callLocalizer
@inject IStringLocalizer<Resgrid.Localization.Common> commonLocalizer
@{
	ViewBag.Title = "Resgrid | " + @callLocalizer["PendingCallsHeader"];
	Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
}


<div class="row wrapper border-bottom white-bg page-heading">
	<div class="col-sm-4">
		<h2>@callLocalizer["PendingCallsHeader"]</h2>
		<ol class="breadcrumb">
			<li>
				<a asp-controller="Home" asp-action="Dashboard" asp-route-area="User">@commonLocalizer["HomeModule"]</a>
			</li>
			<li>
				<a asp-controller="Dispatch" asp-action="Dashboard" asp-route-area="User">@commonLocalizer["CallsModule"]</a>
			</li>
			<li class="active">
				<strong>@callLocalizer["PendingCallsHeader"]</strong>
			</li>
		</ol>
	</div>
	<div class="col-sm-8">
		<div class="btn-group top-page-buttons" style="float:right;padding-right:15px;">
			<div class="buttons-actions">
				<a title="@localizer["ActiveCallsHeader"]" class="btn btn-info" asp-controller="Dispatch" asp-action="Dashboard" asp-route-area="User">@localizer["ActiveCallsHeader"]</a>
				<a title="@localizer["ScheduledCalls"]" class="btn btn-warning" asp-controller="Dispatch" asp-action="ScheduledCalls" asp-route-area="User">@localizer["ScheduledCalls"]</a>
				@if (ClaimsAuthorizationHelper.CanCreateCall())
				{
					<a title="@localizer["NewCallHelp"]" class="btn btn-success" href="@Url.Action("NewCall", "Dispatch", new { area = "User" })">@localizer["NewCall"]</a>
				}
			</div>
		</div>
	</div>
</div>

<div class="row">
	<div class="col-xs-12">
		<div class="wrapper wrapper-content">
			<div class="ibox float-e-margins">
				<div class="ibox-title">
					<h5><i class="fa fa-hourglass-half"></i> @callLocalizer["PendingCallsHeader"]</h5>
				</div>
				<div class="ibox-content">
					<p class="text-muted">@callLocalizer["PendingCallsDescription"]</p>
					<table id="pendingCallsList" class="table table-striped table-bordered table-hover" width="100%"></table>
					<form id="dispatchCallNowForm">@Html.AntiForgeryToken()</form>
				</div>
			</div>
		</div>
	</div>
</div>

@section Scripts
{
	@await Html.PartialAsync("_DispatchLocalizationScript")
	<script src="~/js/app/common/signalr/resgrid.common.signalr.js" type="text/javascript"></script>
	<script src="@Url.Content("~/js/app/internal/dispatch/resgrid.dispatch.waitingcalls.js")" type="text/javascript"></script>
	<script type="text/javascript">
		$(document).ready(function () {
			resgrid.common.analytics.track('Dispatch Pending Calls');
			resgrid.dispatch.waitingcalls.initPendingTable('#pendingCallsList', 50);
			// New, edited, dispatched and closed calls all arrive as call events.
			resgrid.common.signalr.init(resgrid.dispatch.waitingcalls.refresh, function () { }, function () { }, function () { });
		});
	</script>
}
