@using Resgrid.Model
@using Resgrid.Web.Helpers
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Dispatch.Dashboard> localizer
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Dispatch.Call> callLocalizer
@inject IStringLocalizer<Resgrid.Localization.Common> commonLocalizer
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Dispatch.RecurringCalls> recurringLocalizer
@{
	ViewBag.Title = "Resgrid | " + @localizer["ScheduledCallsHeader"];
	Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
	// ?view=calendar opens on the calendar (the links from Recurring Calls and the department calendar).
	var showCalendar = string.Equals(Context.Request.Query["view"], "calendar", StringComparison.OrdinalIgnoreCase);
}


<div class="row wrapper border-bottom white-bg page-heading">
	<div class="col-sm-4">
		<h2>@localizer["ScheduledCallsHeader"]</h2>
		<ol class="breadcrumb">
			<li>
				<a asp-controller="Home" asp-action="Dashboard" asp-route-area="User">@commonLocalizer["HomeModule"]</a>
			</li>
			<li>
				<a asp-controller="Dispatch" asp-action="Dashboard" asp-route-area="User">@commonLocalizer["CallsModule"]</a>
			</li>
			<li class="active">
				<strong>@localizer["ScheduledCallsHeader"]</strong>
			</li>
		</ol>
	</div>
	<div class="col-sm-8">
		<div class="btn-group top-page-buttons" style="float:right;padding-right:15px;">
			<div class="buttons-actions">
				<a title="@localizer["ActiveCallsHeader"]" class="btn btn-info" asp-controller="Dispatch" asp-action="Dashboard" asp-route-area="User">@localizer["ActiveCallsHeader"]</a>
				<a title="@localizer["ArchivedCalls"]" class="btn btn-info" asp-controller="Dispatch" asp-action="ArchivedCalls" asp-route-area="User">@localizer["ArchivedCalls"]</a>
				<a class="btn btn-danger" asp-controller="Dispatch" asp-action="PendingCalls" asp-route-area="User">@callLocalizer["PendingCallsHeader"]</a>
				<a id="recurringCallsButton" class="btn btn-primary" asp-controller="RecurringCalls" asp-action="Index" asp-route-area="User">@recurringLocalizer["PageTitle"]</a>
			</div>
		</div>
	</div>
</div>

<div class="row">
	<div class="col-xs-12">
		<div class="wrapper wrapper-content">
			<div class="alert alert-danger" id="recurringAlertsBanner" style="display:none;">
				<i class="fa fa-exclamation-triangle"></i> <span id="recurringAlertsBannerText"></span>
				<a class="alert-link" asp-controller="RecurringCalls" asp-action="Index" asp-route-area="User" asp-fragment="alerts">@recurringLocalizer["AlertsBannerLink"]</a>
			</div>
			<div class="ibox float-e-margins">
				<div class="ibox-title">
					<h5>@localizer["ScheduledCallsHeader"]</h5>
				</div>
				<div class="ibox-content">
					<ul class="nav nav-tabs" role="tablist">
						<li role="presentation" class="@(showCalendar ? "" : "active")"><a href="#scheduledListTab" aria-controls="scheduledListTab" role="tab" data-toggle="tab">@recurringLocalizer["ListTab"]</a></li>
						<li role="presentation" class="@(showCalendar ? "active" : "")"><a href="#scheduledCalendarTab" id="scheduledCalendarTabLink" aria-controls="scheduledCalendarTab" role="tab" data-toggle="tab">@recurringLocalizer["Calendar"]</a></li>
					</ul>
					<div class="tab-content" style="padding-top:15px;">
						<div role="tabpanel" class="tab-pane @(showCalendar ? "" : "active")" id="scheduledListTab">
							<table id="scheduledCallsList" class="table table-striped table-bordered table-hover" width="100%"></table>
						</div>
						<div role="tabpanel" class="tab-pane @(showCalendar ? "active" : "")" id="scheduledCalendarTab">
							<p class="small">
								<span class="rg-scheduled-legend rg-scheduled-scheduled">@recurringLocalizer["LegendScheduled"]</span>
								<span class="rg-scheduled-legend rg-scheduled-projected">@recurringLocalizer["LegendProjected"]</span>
								<span class="rg-scheduled-legend rg-scheduled-dispatched">@recurringLocalizer["LegendDispatched"]</span>
								<span class="rg-scheduled-legend rg-scheduled-due">@recurringLocalizer["LegendDue"]</span>
								<span class="rg-scheduled-legend rg-scheduled-held">@recurringLocalizer["LegendHeld"]</span>
								<span class="rg-scheduled-legend rg-scheduled-missed">@recurringLocalizer["LegendMissed"]</span>
								<span class="rg-scheduled-legend rg-scheduled-skipped">@recurringLocalizer["LegendSkipped"]</span>
								<span class="rg-scheduled-legend rg-scheduled-cancelled">@recurringLocalizer["LegendCancelled"]</span>
							</p>
							<p id="scheduledCalendarError" class="text-danger" role="alert" style="display:none;">
								<a href="#" id="scheduledCalendarRetry" class="text-danger"><i class="fa fa-refresh" aria-hidden="true"></i> @recurringLocalizer["ActionFailed"]</a>
							</p>
							<div id="scheduledCallsCalendar"></div>
						</div>
					</div>
					<form id="dispatchCallNowForm">@Html.AntiForgeryToken()</form>
				</div>
			</div>
		</div>
	</div>
</div>

<div class="modal fade" id="scheduledOccurrenceModal" tabindex="-1" role="dialog" aria-labelledby="scheduledOccurrenceTitle">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
				<h4 class="modal-title" id="scheduledOccurrenceTitle"></h4>
			</div>
			<div class="modal-body">
				<p><strong id="scheduledOccurrenceWhen"></strong></p>
				<p id="scheduledOccurrenceAddress" class="text-muted"></p>
				<p id="scheduledOccurrenceHelp"></p>
				<p id="scheduledOccurrenceError" class="text-danger" style="display:none;">@recurringLocalizer["ActionFailed"]</p>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-white" data-dismiss="modal">@commonLocalizer["Close"]</button>
				<a class="btn btn-default" id="scheduledOccurrenceEdit" href="#">@recurringLocalizer["EditRecurringCall"]</a>
				<button type="button" class="btn btn-warning" id="scheduledOccurrenceSkip">@recurringLocalizer["SkipOccurrence"]</button>
				<button type="button" class="btn btn-success" id="scheduledOccurrenceRestore">@recurringLocalizer["RestoreOccurrence"]</button>
				<button type="button" class="btn btn-default" id="scheduledOccurrenceCreate">@recurringLocalizer["CreateNow"]</button>
				<button type="button" class="btn btn-primary" id="scheduledOccurrenceSend">@recurringLocalizer["SendNow"]</button>
			</div>
		</div>
	</div>
</div>

@section Styles
{
	<link rel="stylesheet" href="~/css/fullcalendar-inspinia.css" asp-append-version="true" />
	<style>
		.rg-scheduled-legend { display: inline-block; padding: 2px 8px; margin: 0 6px 4px 0; border-radius: 3px; color: #fff; background: #1e90ff; border: 1px solid #1e90ff; }
		.rg-scheduled-legend.rg-scheduled-projected { background: #fff; color: #1e90ff; border-style: dashed; }
		.rg-scheduled-legend.rg-scheduled-dispatched { opacity: 0.55; }
		.rg-scheduled-legend.rg-scheduled-skipped { background: #b8b8b8; border-color: #b8b8b8; text-decoration: line-through; }
		.rg-scheduled-legend.rg-scheduled-cancelled { background: #8a8a8a; border-color: #8a8a8a; }
		.rg-scheduled-legend.rg-scheduled-due { background: #f8ac59; border-color: #f8ac59; }
		.rg-scheduled-legend.rg-scheduled-held { background: #ed5565; border-color: #ed5565; }
		.rg-scheduled-legend.rg-scheduled-missed { background: #fff; color: #ed5565; border-color: #ed5565; border-style: dashed; }
		.fc-event.rg-scheduled-missed { border-style: dashed !important; border-width: 2px !important; }
		.fc-event.rg-scheduled-projected { opacity: 0.75; border-style: dashed !important; border-width: 2px !important; }
		.fc-event.rg-scheduled-dispatched { opacity: 0.55; }
		.fc-event.rg-scheduled-skipped, .fc-event.rg-scheduled-cancelled { text-decoration: line-through; }
		/* The theme paints every .fc-event blue; list rows keep the white row and coloured dot. */
		#scheduledCallsCalendar .fc-list-event, #scheduledCallsCalendar .fc-list-event a { background-color: transparent; padding: 0; }
		/* Month view entries are dots: keep the coloured dot (the kind / priority) on a plain row instead of the theme's blue. */
		#scheduledCallsCalendar .fc-daygrid-dot-event { background-color: transparent; border-color: transparent; color: #333; }
		#scheduledCallsCalendar .fc-daygrid-dot-event .fc-event-time, #scheduledCallsCalendar .fc-daygrid-dot-event .fc-event-title { color: #333; }
		#scheduledCallsCalendar .fc-daygrid-dot-event:hover { background-color: rgba(0, 0, 0, 0.05); }
	</style>
}

@section Scripts
{
	@await Html.PartialAsync("_DispatchLocalizationScript")
	<script>
		window.resgridScheduledCalendarText = {
			projectedHelp: '@JsEncoder.Encode(recurringLocalizer["ProjectedHelp"].Value)',
			skippedHelp: '@JsEncoder.Encode(recurringLocalizer["SkippedHelp"].Value)',
			readOnlyHelp: '@JsEncoder.Encode(recurringLocalizer["ReadOnlyHelp"].Value)',
			dueHelp: '@JsEncoder.Encode(recurringLocalizer["DueHelp"].Value)',
			missedHelp: '@JsEncoder.Encode(recurringLocalizer["MissedHelp"].Value)',
			alertsBanner: '@JsEncoder.Encode(recurringLocalizer["AlertsBanner"].Value)',
			locale: '@JsEncoder.Encode(System.Globalization.CultureInfo.CurrentUICulture.Name)'
		};
	</script>
	<script src="~/lib/fullcalendar/index.global.min.js" asp-append-version="true"></script>
	<script src="@Url.Content("~/js/app/internal/dispatch/resgrid.dispatch.waitingcalls.js")" type="text/javascript"></script>
	<script src="@Url.Content("~/js/app/internal/dispatch/resgrid.dispatch.scheduledcalls.js")" type="text/javascript"></script>
	<script src="@Url.Content("~/js/app/internal/dispatch/resgrid.dispatch.scheduledcalendar.js")" asp-append-version="true" type="text/javascript"></script>
}
