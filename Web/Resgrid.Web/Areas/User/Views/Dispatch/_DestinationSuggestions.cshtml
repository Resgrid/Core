@inject IStringLocalizer<Resgrid.Localization.Areas.User.Mapping.DestinationRules> destinationRulesLocalizer
@*
	Suggested destinations under the Destination field (Mapping → Destination Rules, M0317). Hidden until the first answer:
	while the department's suggestions are off the script stops after one cheap request. "fill" (New Call only) lets the
	script fill an empty, untouched destination with the best suggestion.
	A form whose fields are not the call form's names them with "DestinationSuggestions.{Field}" view data (jQuery selectors):
	Destination, Latitude, Longitude, Coordinates (one "lat,lon" field), Address (looked up when there is no point), Priority,
	Type, TypeId, Free (free destination inputs), Unit (a unit field); UnitId and CallId are ids. Blank keeps the call form's.
*@
@{
	var fill = ViewData["DestinationSuggestionsFill"] is bool b && b;
	Func<string, string> field = key => ViewData["DestinationSuggestions." + key]?.ToString();
}
<div class="form-group" id="destinationSuggestionsRow" style="display: none;" data-fill="@(fill ? "true" : "false")"
	 data-destination="@field("Destination")" data-latitude="@field("Latitude")" data-longitude="@field("Longitude")"
	 data-coordinates="@field("Coordinates")" data-address="@field("Address")" data-priority="@field("Priority")"
	 data-type="@field("Type")" data-type-id="@field("TypeId")" data-free="@field("Free")" data-unit="@field("Unit")"
	 data-unit-id="@field("UnitId")" data-call-id="@field("CallId")">
	<label class="col-sm-2 control-label">@destinationRulesLocalizer["SuggestedDestinations"]</label>
	<div class="col-sm-10">
		<div id="destinationSuggestionsRequirements" class="text-muted small" style="margin-bottom: 4px;"></div>
		<div id="destinationSuggestionsNote" class="small" style="display: none; margin-bottom: 4px;"></div>
		<div id="destinationSuggestionsList"></div>
	</div>
</div>
<script type="text/javascript">
	var destinationSuggestionStrings = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(new
	{
		loading = destinationRulesLocalizer["SuggestionLoading"].Value,
		none = destinationRulesLocalizer["SuggestionNone"].Value,
		noneMeet = destinationRulesLocalizer["SuggestionNoneMeet"].Value,
		needs = destinationRulesLocalizer["SuggestionNeeds"].Value,
		prefers = destinationRulesLocalizer["SuggestionPrefers"].Value,
		rules = destinationRulesLocalizer["SuggestionRules"].Value,
		use = destinationRulesLocalizer["UseDestination"].Value,
		inUse = destinationRulesLocalizer["InUse"].Value,
		suggested = destinationRulesLocalizer["SuggestedBadge"].Value,
		filled = destinationRulesLocalizer["FilledAutomatically"].Value,
		missing = destinationRulesLocalizer["MissingCapabilities"].Value,
		down = destinationRulesLocalizer["DownCapabilities"].Value,
		minutes = destinationRulesLocalizer["MinutesShort"].Value,
		kilometers = destinationRulesLocalizer["KilometersShort"].Value,
		straightLine = destinationRulesLocalizer["StraightLineKilometers"].Value,
		failed = destinationRulesLocalizer["SuggestionFailed"].Value,
		retry = destinationRulesLocalizer["SuggestionRetry"].Value
	}, new Newtonsoft.Json.JsonSerializerSettings { StringEscapeHandling = Newtonsoft.Json.StringEscapeHandling.EscapeHtml }));
</script>
