@model List<Resgrid.Model.DepartmentGroup>
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Dispatch.Call> localizer
@*
    The nearest-unit board for New Call and Update Call (filled by resgrid.dispatch.nearestboard.js once the call has a
    location): units and personnel ranked by response time, with pick boxes tied to the dispatch lists. The script block
    gives the page script its strings and the groups' boundaries for the call map ([{ name, color, points: [[lat, lng]] }]).
*@
<div class="form-group" id="nearestUnitsRow" style="display: none;">
    <label class="col-sm-2 control-label">@localizer["NearestUnitsLabel"]</label>
    <div class="col-sm-10">
        <div class="text-muted" style="font-size: 11px;">@localizer["NearestUnitsHint"]</div>
        <div id="nearestUnitsBoundaries" class="text-muted" style="margin-bottom: 6px;"></div>
        <div class="table-responsive">
            <table id="nearestUnitsTable" class="table table-striped table-bordered table-condensed" style="margin-bottom: 4px;">
                <thead>
                    <tr>
                        <th style="width: 30px;" title="@localizer["NearestUnitsPick"]"></th>
                        <th>@localizer["NearestUnitsUnit"]</th>
                        <th>@localizer["NearestUnitsStatus"]</th>
                        <th>@localizer["NearestUnitsEta"]</th>
                        <th>@localizer["NearestUnitsPosition"]</th>
                        <th>@localizer["NearestUnitsShift"]</th>
                        <th>@localizer["NearestUnitsRoleMix"]</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
        <div id="nearestUnitsMore" class="text-muted" style="display: none; font-size: 11px;"></div>
        <div id="nearestPersonnelSection" style="display: none;">
            <h5 style="margin: 10px 0 4px 0;">@localizer["NearestPersonnelLabel"]</h5>
            <div class="table-responsive">
                <table id="nearestPersonnelTable" class="table table-striped table-bordered table-condensed" style="margin-bottom: 4px;">
                    <thead>
                        <tr>
                            <th style="width: 30px;" title="@localizer["NearestUnitsPick"]"></th>
                            <th>@localizer["NearestPersonnelPerson"]</th>
                            <th>@localizer["NearestUnitsStatus"]</th>
                            <th>@localizer["NearestPersonnelStaffing"]</th>
                            <th>@localizer["NearestUnitsEta"]</th>
                            <th>@localizer["NearestUnitsPosition"]</th>
                            <th>@localizer["NearestPersonnelGroupRoles"]</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
            <div id="nearestPersonnelMore" class="text-muted" style="display: none; font-size: 11px;"></div>
        </div>
        <div id="nearestUnitsNotes" class="text-muted" style="font-size: 11px;"></div>
    </div>
</div>
<script type="text/javascript">
    var nearestUnitStrings = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(new Dictionary<string, string>
    {
        ["inBoundary"] = localizer["NearestUnitsInBoundary"].Value,
        ["inParentBoundary"] = localizer["NearestUnitsInParentBoundary"].Value,
        ["incidentInside"] = localizer["NearestUnitsIncidentInside"].Value,
        ["noBoundary"] = localizer["NearestUnitsNoBoundary"].Value,
        ["estimate"] = localizer["NearestUnitsEstimate"].Value,
        ["minutes"] = localizer["NearestUnitsMinutes"].Value,
        ["includesTurnout"] = localizer["NearestUnitsIncludesTurnout"].Value,
        ["live"] = localizer["NearestUnitsLive"].Value,
        ["station"] = localizer["NearestUnitsStation"].Value,
        ["stale"] = localizer["NearestUnitsStale"].Value,
        ["noPosition"] = localizer["NearestUnitsNoPosition"].Value,
        ["crewOnShift"] = localizer["NearestUnitsCrewOnShift"].Value,
        ["stationShift"] = localizer["NearestUnitsStationShift"].Value,
        ["noCrew"] = localizer["NearestUnitsNoCrew"].Value,
        ["scoped"] = localizer["NearestUnitsScoped"].Value,
        ["nearest"] = localizer["NearestUnitsNearest"].Value,
        ["hidden"] = localizer["NearestUnitsHidden"].Value,
        ["onUnit"] = localizer["NearestPersonnelOnUnit"].Value,
        ["mapUnits"] = localizer["NearestUnitsMapUnits"].Value,
        ["mapPersonnel"] = localizer["NearestUnitsMapPersonnel"].Value,
        ["mapBoundaries"] = localizer["NearestUnitsMapBoundaries"].Value,
        ["pick"] = localizer["NearestUnitsPick"].Value,
        ["showingClosest"] = localizer["NearestUnitsShowingClosest"].Value
    }, new Newtonsoft.Json.JsonSerializerSettings { StringEscapeHandling = Newtonsoft.Json.StringEscapeHandling.EscapeHtml }));
    var groupBoundaries = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject((Model ?? new List<DepartmentGroup>())
        .Select(g => new { group = g, points = Resgrid.Model.GeoMath.ParseGeofence(g.Geofence) })
        .Where(x => x.points != null)
        .Select(x => new
        {
            name = x.group.Name,
            color = Resgrid.Model.UnitStatusColors.ToHexColor(x.group.GeofenceColor) ?? "#0ea5e9",
            points = x.points.Select(p => new[] { p.Latitude, p.Longitude })
        }), new Newtonsoft.Json.JsonSerializerSettings { StringEscapeHandling = Newtonsoft.Json.StringEscapeHandling.EscapeHtml }));
</script>
