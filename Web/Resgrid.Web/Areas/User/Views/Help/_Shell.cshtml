@using Resgrid.Web.Areas.User.Models
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Academy.AcademyGuidance> guidanceLocalizer
@*
    Page heading shared by the Help center screens (A3, module-workspace.css): title, breadcrumb, an optional line under it, and the sections
    in a strip underneath (Shared/_ModuleTabs). ViewData["Section"] Search, Tours or WhatsNew.
*@
@{
    var moduleName = guidanceLocalizer["HelpCenterHeader"].Value;
    var title = (string)ViewData["Title"] ?? moduleName;
    var subtitle = (string)ViewData["Subtitle"];
    var section = (string)ViewData["Section"] ?? "Search";

    var sections = new ModuleTabsView { Label = moduleName };
    sections.Tabs.Add(new ModuleTab(guidanceLocalizer["SearchTab"].Value, "fa-search", "Help", "Search", section == "Search"));
    sections.Tabs.Add(new ModuleTab(guidanceLocalizer["ToursTab"].Value, "fa-map-signs", "Help", "Tours", section == "Tours"));
    sections.Tabs.Add(new ModuleTab(guidanceLocalizer["WhatsNewTab"].Value, "fa-bullhorn", "Help", "WhatsNew", section == "WhatsNew"));
}
<div class="row wrapper border-bottom white-bg page-heading rgw-page-heading">
    <div class="col-sm-12">
        <h2>@title</h2>
        <ol class="breadcrumb">
            <li><a asp-controller="Home" asp-action="Dashboard" asp-route-area="User">@commonLocalizer["HomeModule"]</a></li>
            <li><a asp-controller="Help" asp-action="Search" asp-route-area="User">@moduleName</a></li>
            <li class="active"><strong>@title</strong></li>
        </ol>
        @if (!string.IsNullOrEmpty(subtitle))
        {
            <small class="text-muted">@subtitle</small>
        }
    </div>
    @await Html.PartialAsync("_WorkspaceHeaderActions")
    <div class="col-sm-12 rgw-module-navigation">
        @await Html.PartialAsync("_ModuleTabs", sections)
    </div>
</div>
