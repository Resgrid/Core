@model Resgrid.Web.Areas.User.Models.IncidentBackOffice.IncidentBackOfficeBillingView
@inject IStringLocalizer<Resgrid.Localization.Areas.User.IncidentBackOffice.IncidentBackOffice> localizer
@using Resgrid.Config
@using Newtonsoft.Json
@{
    ViewBag.Title = "Resgrid | " + localizer["IncidentBackOffice"];
    var status = Model.Status;
}
<div class="row wrapper border-bottom white-bg page-heading">
    <div class="col-sm-12">
        <h2>@localizer["IncidentBackOffice"]</h2>
        <ol class="breadcrumb">
            <li><a asp-controller="Home" asp-action="Dashboard" asp-route-area="User">@commonLocalizer["HomeModule"]</a></li>
            @if (Model.IsOwner)
            {
                <li><a asp-controller="Subscription" asp-action="Index" asp-route-area="User">@localizer["ManageSubscription"]</a></li>
            }
            <li class="active"><strong>@localizer["IncidentBackOffice"]</strong></li>
        </ol>
    </div>
</div>
<div class="wrapper wrapper-content">
    @if (Model.Access.IsLapsed)
    {
        <div class="alert alert-warning" role="status"><i class="fa fa-lock" aria-hidden="true"></i> @localizer["LapsedBanner"]</div>
    }
    <div class="row">
        <div class="col-lg-8">
            <div class="ibox">
                <div class="ibox-title"><h5>@localizer["IncidentBackOfficeAddon"]</h5></div>
                <div class="ibox-content">
                    <p>@localizer["AddonIntro"]</p>
                    <ul>
                        <li>@localizer["AddonFeatureFoundation"]</li>
                        <li>@localizer["AddonFeatureLogistics"]</li>
                        <li>@localizer["AddonFeatureFinance"]</li>
                        <li>@localizer["AddonFeatureCoordination"]</li>
                    </ul>
                    @if (!Model.IsOwner)
                    {
                        <p class="alert alert-info">@(Model.Access.Licensed ? localizer["AddonActive"] : localizer["AskOwner"])</p>
                    }
                    else if (status == null)
                    {
                        <p class="alert alert-warning">@localizer["BillingUnavailable"]</p>
                    }
                    else
                    {
                        <h3>@status.MonthlyAmount.ToString("N2") @status.Currency / @localizer["Monthly"]</h3>
                        @if (status.Active)
                        {
                            <p class="text-navy"><i class="fa fa-check" aria-hidden="true"></i> @localizer["AddonActive"]</p>
                        }
                        else
                        {
                            <p>@localizer["CheckoutPending"]</p>
                        }
                        @if (status.PaidThroughUtc.HasValue)
                        {
                            <p>@localizer["PaidThrough"]: @status.PaidThroughUtc.Value.ToString("u")</p>
                        }
                        @if (status.Cancelled)
                        {
                            <p class="text-warning">@localizer["SubscriptionCancelled"]</p>
                        }
                        @if (status.CheckoutAvailable)
                        {
                            <form method="post" asp-action="Checkout" id="incident-back-office-checkout">@Html.AntiForgeryToken()<button type="submit" class="btn btn-primary">@localizer["Buy"]</button></form>
                        }
                        @if (status.CanCancel && !status.Cancelled)
                        {
                            <form method="post" asp-action="CancelRenewal" class="m-t-sm ibo-confirm" data-confirm="@localizer["CancelSubscriptionConfirm"]">@Html.AntiForgeryToken()<button type="submit" class="btn btn-default">@localizer["CancelSubscription"]</button></form>
                        }
                    }
                    <p class="alert alert-danger m-t-sm" id="incident-back-office-billing-error" hidden></p>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="ibox">
                <div class="ibox-title"><h5>@localizer["Links"]</h5></div>
                <div class="ibox-content">
                    @if (Model.Access.CanRead)
                    {
                        <p><a asp-controller="IncidentBackOffice" asp-action="Index" asp-route-area="User">@localizer["IncidentBackOffice"]</a></p>
                    }
                    @if (Model.IsOwner)
                    {
                        <p><a asp-controller="Subscription" asp-action="Index" asp-route-area="User">@localizer["ManageSubscription"]</a></p>
                    }
                    @if (ClaimsAuthorizationHelper.IsUserDepartmentAdmin())
                    {
                        <p><a asp-controller="Department" asp-action="ModuleSettings" asp-route-area="User">@localizer["ModuleSettings"]</a></p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
@if (status?.Provider == "Paddle") { <script src="https://cdn.paddle.com/paddle/v2/paddle.js"></script> }
<script type="application/json" id="incident-back-office-billing-config">@Html.Raw(JsonConvert.SerializeObject(new {
    provider = status?.Provider, token = status?.Provider == "Paddle" ? PaymentProviderConfig.GetPaddleClientToken() : null,
    environment = PaymentProviderConfig.GetPaddleEnvironment(), error = localizer["BillingUnavailable"].Value
}, new JsonSerializerSettings { StringEscapeHandling = StringEscapeHandling.EscapeHtml }))</script>
<script src="~/js/app/internal/incidentbackoffice/incident-back-office-billing.js" asp-append-version="true"></script>
<script src="~/js/app/internal/incidentbackoffice/incident-back-office.js" asp-append-version="true"></script>
}
