@model Resgrid.Web.Areas.User.Models.IntakeChannels.IntakeChannelsIndexView
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Department.IntakeChannels> localizer
@{
	ViewBag.Title = "Resgrid | " + localizer["PageTitle"];
}

<div class="row wrapper border-bottom white-bg page-heading">
	<div class="col-sm-6">
		<h2>@localizer["PageTitle"]</h2>
		<ol class="breadcrumb">
			<li>
				<a asp-controller="Home" asp-action="Dashboard" asp-route-area="User">@commonLocalizer["HomeModule"]</a>
			</li>
			<li>
				<a asp-controller="Department" asp-action="TextSettings" asp-route-area="User">@commonLocalizer["TextMessaging"]</a>
			</li>
			<li class="active">
				<strong>@localizer["PageTitle"]</strong>
			</li>
		</ol>
	</div>
	<div class="col-sm-6">
		<div class="btn-group top-page-buttons" style="float:right;padding-right:15px;">
			<div class="dropdown" style="display:inline-block;">
				<button class="btn btn-success dropdown-toggle" type="button" id="addIntakeChannel" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
					@localizer["AddChannel"] <span class="caret"></span>
				</button>
				<ul class="dropdown-menu dropdown-menu-right" aria-labelledby="addIntakeChannel">
					@foreach (var type in Resgrid.Web.Areas.User.Controllers.IntakeChannelsController.CreatableTypes)
					{
						<li><a asp-controller="IntakeChannels" asp-action="Edit" asp-route-area="User" asp-route-type="@((int)type)">@localizer["Type." + type]</a></li>
					}
				</ul>
			</div>
		</div>
	</div>
</div>

<div class="row">
	<div class="col-xs-12">
		<div class="wrapper wrapper-content">
			<div class="ibox float-e-margins">
				<div class="ibox-content">
					<p>@localizer["PageIntro"]</p>
					<p class="text-muted">@localizer["ChatRules"]</p>

					@if (!Model.FeatureEnabled)
					{
						<div class="alert alert-info">@localizer["FeatureOff"]</div>
					}
					@if (!String.IsNullOrEmpty(Model.Message))
					{
						<div class="alert alert-success">@Model.Message</div>
					}
					@if (!String.IsNullOrEmpty(Model.ErrorMessage))
					{
						<div class="alert alert-danger">@Model.ErrorMessage</div>
					}

					@if (!Model.Channels.Any())
					{
						<p><em>@localizer["NoChannels"]</em></p>
					}
					else
					{
						<div class="table-responsive">
							<table class="table table-striped table-bordered" id="intakeChannelsTable">
								<thead>
									<tr>
										<th>@localizer["Name"]</th>
										<th>@localizer["Type"]</th>
										<th>@localizer["Address"]</th>
										<th>@localizer["Mode"]</th>
										<th>@localizer["Status"]</th>
										<th>@localizer["ThisMonth"]</th>
										<th>@localizer["Actions"]</th>
									</tr>
								</thead>
								<tbody>
									@foreach (var channel in Model.Channels)
									{
										<tr>
											<td>@channel.Name</td>
											<td>@localizer["Type." + channel.ChannelType]</td>
											<td>
												@if (channel.ChannelType == IntakeChannelTypes.Webhook)
												{
													<a asp-controller="IntakeChannels" asp-action="Webhook" asp-route-area="User" asp-route-id="@channel.IntakeChannelId">@localizer["WebhookUrl"]</a>
												}
												else
												{
													<code>@channel.Address</code>
												}
											</td>
											<td>@(channel.ProcessingMode == IntakeProcessingModes.EnhancedAi ? localizer["ModeEnhancedAi"] : localizer["ModeTemplate"])</td>
											<td>
												@if (channel.IsEnabled)
												{
													<span class="label label-primary">@localizer["Enabled"]</span>
												}
												else
												{
													<span class="label label-default">@localizer["Disabled"]</span>
												}
											</td>
											<td>@channel.ThisMonth</td>
											<td style="white-space:nowrap;">
												<a class="btn btn-xs btn-primary" asp-controller="IntakeChannels" asp-action="Edit" asp-route-area="User" asp-route-id="@channel.IntakeChannelId">@localizer["Edit"]</a>
												<form method="post" asp-controller="IntakeChannels" asp-action="SetEnabled" asp-route-area="User" style="display:inline;">
													@Html.AntiForgeryToken()
													<input type="hidden" name="id" value="@channel.IntakeChannelId" />
													<input type="hidden" name="enabled" value="@(channel.IsEnabled ? "false" : "true")" />
													<button type="submit" class="btn btn-xs btn-default">@(channel.IsEnabled ? localizer["Disable"] : localizer["Enable"])</button>
												</form>
												<form method="post" asp-controller="IntakeChannels" asp-action="Delete" asp-route-area="User" style="display:inline;" class="intake-delete-form">
													@Html.AntiForgeryToken()
													<input type="hidden" name="id" value="@channel.IntakeChannelId" />
													<button type="submit" class="btn btn-xs btn-danger">@localizer["Delete"]</button>
												</form>
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}

					<h3 style="margin-top:25px;">@localizer["BlockedSenders"]</h3>
					<p class="text-muted">@localizer["BlockedSendersIntro"]</p>
					@if (Model.BlockedSendersUnavailable)
					{
						<div class="alert alert-warning" id="intakeBlockedSendersUnavailable">@localizer["BlockedSendersUnavailable"]</div>
					}
					else if (!Model.BlockedSenders.Any())
					{
						<p><em>@localizer["NoBlockedSenders"]</em></p>
					}
					else
					{
						<div class="table-responsive">
							<table class="table table-striped table-bordered" id="intakeBlockedSendersTable">
								<thead>
									<tr>
										<th>@localizer["Sender"]</th>
										<th>@localizer["Type"]</th>
										<th>@localizer["BlockedBy"]</th>
										<th>@localizer["BlockedOn"]</th>
										<th>@localizer["BlockedUntil"]</th>
										<th>@localizer["Actions"]</th>
									</tr>
								</thead>
								<tbody>
									@foreach (var block in Model.BlockedSenders)
									{
										<tr>
											<td>
												<code>@block.Sender</code>
												@if (block.CallId.HasValue)
												{
													<a asp-controller="Dispatch" asp-action="ViewCall" asp-route-area="User" asp-route-callId="@block.CallId" style="margin-left:6px;">@localizer["BlockedCall"]</a>
												}
											</td>
											<td>@localizer["Type." + block.ChannelType]</td>
											<td>@block.BlockedByName</td>
											<td>@block.BlockedOn.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)</td>
											<td>
												@if (block.Expired)
												{
													<span class="label label-default">@localizer["BlockExpired"]</span>
												}
												else if (block.ExpiresOn.HasValue)
												{
													@block.ExpiresOn.Value.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)
												}
												else
												{
													@localizer["BlockedUntilLifted"]
												}
											</td>
											<td style="white-space:nowrap;">
												@if (!block.Expired)
												{
													<form method="post" asp-controller="IntakeChannels" asp-action="Unblock" asp-route-area="User" style="display:inline;" class="intake-unblock-form">
														@Html.AntiForgeryToken()
														<input type="hidden" name="id" value="@block.IntakeBlockedSenderId" />
														<button type="submit" class="btn btn-xs btn-default">@localizer["Unblock"]</button>
													</form>
												}
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</div>
			</div>
		</div>
	</div>
</div>

@section Scripts
{
	<script type="text/javascript">
		$(document).ready(function () {
			var confirmText = '@JsEncoder.Encode(localizer["DeleteConfirm"].Value)';
			$('.intake-delete-form').on('submit', function (e) {
				if (!window.confirm(confirmText)) { e.preventDefault(); }
			});
			var unblockText = '@JsEncoder.Encode(localizer["UnblockConfirm"].Value)';
			$('.intake-unblock-form').on('submit', function (e) {
				if (!window.confirm(unblockText)) { e.preventDefault(); }
			});
		});
	</script>
}
