@model Resgrid.Web.Areas.User.Models.Invoicing.BillingSettingsView
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Invoicing.Invoicing> localizer
@{
    var departmentTime = DepartmentTime.From(ViewData);
    ViewBag.Title = "Resgrid | " + localizer["BillingSettings"];
    ViewData["Tab"] = "Settings";
    ViewData["Title"] = localizer["BillingSettings"].Value;
    ViewData["Subtitle"] = localizer["BillingSettingsIntro"].Value;
    var identity = Model.Identity;
    var write = Model.CanWrite && Model.CanManage;
    var op = Model.OnlinePayments ?? new Resgrid.Model.Invoicing.OnlinePaymentsStatus();
    // The Online payments tab is absent while the cluster does not offer collection and nothing was ever connected (plan B2.5).
    var showOnlineTab = op.AvailableInCluster || op.Connection != null;
    var onlineActive = showOnlineTab && Model.ActiveTab == "online";
    var connection = op.Connection;
}

@await Html.PartialAsync("_Shell")

<div class="wrapper wrapper-content rgw-page">
    @if (Model.SaveSuccess)
    {
        <div class="alert alert-success">@localizer["Saved"]</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-danger">@Model.Message</div>
    }
    <div class="ibox float-e-margins">
        <div class="ibox-title"><h5>@localizer["BillingSettings"]</h5></div>
        <div class="ibox-content">

            <ul class="nav nav-pills rgw-module-tabs">
                <li class="@(onlineActive ? null : "active")"><a data-toggle="tab" href="#identity">@localizer["BillingIdentity"]</a></li>
                @if (showOnlineTab)
                {
                    <li class="@(onlineActive ? "active" : null)"><a data-toggle="tab" href="#online">@localizer["OnlinePayments"]</a></li>
                }
            </ul>
            <div class="tab-content">
                <div class="tab-pane @(onlineActive ? null : "active")" id="identity">
                    <p class="text-muted">@localizer["BillingIdentityIntro"]</p>
                    <form method="post" asp-controller="Invoicing" asp-action="Settings" asp-route-area="User" class="form-horizontal">
                        @Html.AntiForgeryToken()
                        <div class="form-group">
                            <label class="col-sm-3 control-label" for="LegalBusinessName">@localizer["LegalBusinessName"]</label>
                            <div class="col-sm-6"><input type="text" class="form-control" id="LegalBusinessName" name="LegalBusinessName" value="@identity.LegalBusinessName" maxlength="250" disabled="@(!write)" /></div>
                        </div>
                        <div class="hr-line-dashed"></div>
                        <h4>@localizer["RemitTo"]</h4>
                        <div class="form-group">
                            <label class="col-sm-3 control-label" for="Address1">@localizer["Address"]</label>
                            <div class="col-sm-6"><input type="text" class="form-control" id="Address1" name="Address1" value="@Model.RemitTo.Address1" maxlength="250" disabled="@(!write)" /></div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label" for="City">@localizer["City"]</label>
                            <div class="col-sm-3"><input type="text" class="form-control" id="City" name="City" value="@Model.RemitTo.City" maxlength="100" disabled="@(!write)" /></div>
                            <label class="col-sm-1 control-label" for="State">@localizer["State"]</label>
                            <div class="col-sm-2"><input type="text" class="form-control" id="State" name="State" value="@Model.RemitTo.State" maxlength="100" disabled="@(!write)" /></div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label" for="PostalCode">@localizer["PostalCode"]</label>
                            <div class="col-sm-2"><input type="text" class="form-control" id="PostalCode" name="PostalCode" value="@Model.RemitTo.PostalCode" maxlength="20" disabled="@(!write)" /></div>
                            <label class="col-sm-1 control-label" for="Country">@localizer["Country"]</label>
                            <div class="col-sm-3"><input type="text" class="form-control" id="Country" name="Country" value="@Model.RemitTo.Country" maxlength="100" disabled="@(!write)" /></div>
                        </div>
                        <div class="hr-line-dashed"></div>
                        <h4>@localizer["Registrations"]</h4>
                        <div class="form-group">
                            <label class="col-sm-3 control-label" for="TaxRegistrationNumber">@localizer["TaxRegistrationNumber"]</label>
                            <div class="col-sm-3"><input type="text" class="form-control" id="TaxRegistrationNumber" name="TaxRegistrationNumber" value="@identity.TaxRegistrationNumber" maxlength="100" disabled="@(!write)" /></div>
                            <label class="col-sm-2 control-label" for="SecondaryTaxRegistrationNumber">@localizer["SecondaryTaxRegistrationNumber"]</label>
                            <div class="col-sm-3"><input type="text" class="form-control" id="SecondaryTaxRegistrationNumber" name="SecondaryTaxRegistrationNumber" value="@identity.SecondaryTaxRegistrationNumber" maxlength="100" disabled="@(!write)" /></div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label" for="SamUei">@localizer["SamUei"]</label>
                            <div class="col-sm-3"><input type="text" class="form-control" id="SamUei" name="SamUei" value="@identity.SamUei" maxlength="50" disabled="@(!write)" /></div>
                            <label class="col-sm-2 control-label" for="CageCode">@localizer["CageCode"]</label>
                            <div class="col-sm-3"><input type="text" class="form-control" id="CageCode" name="CageCode" value="@identity.CageCode" maxlength="50" disabled="@(!write)" /></div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label" for="WorkersCompAccountNumber">@localizer["WorkersCompAccountNumber"]</label>
                            <div class="col-sm-3"><input type="text" class="form-control" id="WorkersCompAccountNumber" name="WorkersCompAccountNumber" value="@identity.WorkersCompAccountNumber" maxlength="100" disabled="@(!write)" /></div>
                        </div>
                        <div class="hr-line-dashed"></div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label" for="InvoiceFooterText">@localizer["InvoiceFooterText"]</label>
                            <div class="col-sm-9"><textarea class="form-control" id="InvoiceFooterText" name="InvoiceFooterText" rows="3" maxlength="2000" disabled="@(!write)">@identity.InvoiceFooterText</textarea>
                                <span class="help-block m-b-none">@localizer["InvoiceFooterHint"]</span></div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label" for="PayLinkExpiryDays">@localizer["PayLinkExpiryDays"]</label>
                            <div class="col-sm-2"><input type="number" min="1" max="365" class="form-control" id="PayLinkExpiryDays" name="PayLinkExpiryDays" value="@identity.PayLinkExpiryDays" disabled="@(!write)" /></div>
                            <div class="col-sm-4">
                                <div class="checkbox"><label><input type="checkbox" name="ShowPayOnlineOnDocuments" value="true" checked="@identity.ShowPayOnlineOnDocuments" disabled="@(!write)" /> @localizer["ShowPayOnlineOnDocuments"]</label></div>
                            </div>
                        </div>
                        @if (write)
                        {
                            <div class="form-group">
                                <div class="col-sm-6 col-sm-offset-3">
                                    <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> @commonLocalizer["Save"]</button>
                                </div>
                            </div>
                        }
                    </form>
                </div>
                @if (showOnlineTab)
                {
                <div class="tab-pane @(onlineActive ? "active" : null)" id="online">
                    @if (!op.AvailableInCluster)
                    {
                        <div class="alert alert-warning"><i class="fa fa-pause-circle"></i> @localizer["SuspendedByOperator"]</div>
                    }
                    else if (!op.FlagEnabled)
                    {
                        <div class="alert alert-info"><i class="fa fa-info-circle"></i> @localizer["OnlinePaymentsFlagOff"]</div>
                    }
                    <p class="text-muted">@localizer["OnlinePaymentsIntro"]</p>

                    <div class="row">
                        <div class="col-md-6">
                            <h4>@localizer["YourStripeAccount"]</h4>
                            @if (connection == null)
                            {
                                <p>@localizer["NoConnectionYet"]</p>
                                @if (Model.IsDepartmentAdmin && write && op.AvailableInCluster)
                                {
                                    <form method="post" asp-controller="Invoicing" asp-action="BeginPaymentConnect" asp-route-area="User" asp-route-provider="stripe">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-primary"><i class="fa fa-cc-stripe"></i> @localizer["ConnectStripe"]</button>
                                    </form>
                                    <p class="help-block">@localizer["ConnectStripeIntro"]</p>
                                }
                                else if (!Model.IsDepartmentAdmin)
                                {
                                    <p class="help-block">@localizer["ConnectAdminOnly"]</p>
                                }
                            }
                            else
                            {
                                var status = (Resgrid.Model.Invoicing.PaymentConnectionStatuses)connection.Status;
                                var statusCss = status == Resgrid.Model.Invoicing.PaymentConnectionStatuses.Connected ? "label-primary" : status == Resgrid.Model.Invoicing.PaymentConnectionStatuses.ActionRequired ? "label-warning" : "label-default";
                                <dl class="dl-horizontal">
                                    <dt>@localizer["ConnectedAccount"]</dt><dd><code>@connection.ExternalAccountId</code> <span class="label @statusCss">@localizer["ConnectionStatus" + status]</span> <span class="label label-default">@(connection.Environment == (int)Resgrid.Model.Invoicing.PaymentEnvironments.Live ? localizer["LiveMode"] : localizer["SandboxMode"])</span></dd>
                                    <dt>@localizer["BusinessName"]</dt><dd>@(connection.DisplayName ?? "—") @(string.IsNullOrWhiteSpace(connection.Country) ? "" : "(" + connection.Country + (string.IsNullOrWhiteSpace(connection.DefaultCurrency) ? "" : ", " + connection.DefaultCurrency) + ")")</dd>
                                    <dt>@localizer["ConnectedOn"]</dt><dd>@departmentTime.Format(connection.ConnectedOn)</dd>
                                    <dt>@localizer["LastVerified"]</dt><dd>@(departmentTime.Format(connection.LastVerifiedOn) ?? "—")</dd>
                                    <dt>@localizer["Capabilities"]</dt>
                                    <dd>
                                        @foreach (var capability in op.Capabilities)
                                        {
                                            <span class="label @(capability.Value ? "label-primary" : "label-default")">@capability.Key</span>
                                        }
                                    </dd>
                                    @if (!string.IsNullOrWhiteSpace(connection.LastError))
                                    {
                                        <dt>@localizer["LastError"]</dt><dd class="text-danger">@connection.LastError</dd>
                                    }
                                </dl>
                                @if (Model.IsDepartmentAdmin && write)
                                {
                                    <form method="post" asp-controller="Invoicing" asp-action="DisconnectPayment" asp-route-area="User" asp-route-id="@connection.DepartmentPaymentConnectionId" style="display: inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('@localizer["DisconnectConfirm"]');"><i class="fa fa-unlink"></i> @localizer["Disconnect"]</button>
                                    </form>
                                    @if (!connection.IsUsable && op.AvailableInCluster)
                                    {
                                        <form method="post" asp-controller="Invoicing" asp-action="BeginPaymentConnect" asp-route-area="User" asp-route-provider="stripe" style="display: inline;" class="m-l-sm">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-primary btn-sm"><i class="fa fa-cc-stripe"></i> @localizer["ReconnectStripe"]</button>
                                        </form>
                                    }
                                }
                            }
                        </div>
                        <div class="col-md-6">
                            <h4>@localizer["CollectionSettings"]</h4>
                            <form method="post" asp-controller="Invoicing" asp-action="SaveOnlinePayments" asp-route-area="User">
                                @Html.AntiForgeryToken()
                                <div class="checkbox"><label><input type="checkbox" name="OnlinePaymentsEnabled" value="true" checked="@op.EnabledByDepartment" disabled="@(!write)" /> @localizer["OnlinePaymentsEnabledLabel"]</label></div>
                                <label class="m-t-sm">@localizer["AllowedPaymentMethods"]</label>
                                <div class="checkbox"><label><input type="checkbox" name="AllowedPaymentMethods" value="card" checked="@op.AllowedPaymentMethods.Contains("card")" disabled="@(!write)" /> @localizer["PaymentMethodCard"]</label></div>
                                <div class="checkbox"><label><input type="checkbox" name="AllowedPaymentMethods" value="us_bank_account" checked="@op.AllowedPaymentMethods.Contains("us_bank_account")" disabled="@(!write)" /> @localizer["PaymentMethodAch"]</label></div>
                                <p class="help-block">@localizer["PaymentMethodsHint"]</p>
                                @if (write)
                                {
                                    <button type="submit" class="btn btn-primary btn-sm m-t-sm"><i class="fa fa-save"></i> @commonLocalizer["Save"]</button>
                                }
                            </form>
                            <div class="hr-line-dashed"></div>
                            <dl class="dl-horizontal">
                                <dt>@localizer["PayLinksReady"]</dt>
                                <dd>@(op.CanCollect ? localizer["Available"].Value : localizer[op.BlockedReason ?? "pay_not_offered"].Value)</dd>
                            </dl>
                            <p class="text-muted small">@localizer["OnlinePaymentsStripeNote"]</p>
                        </div>
                    </div>
                </div>
                }
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/module-workspace.css" asp-append-version="true" />
}
