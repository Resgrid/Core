@model Resgrid.Web.Areas.User.Models.Invoicing.InvoiceDetailView
@using Resgrid.Model.Invoicing
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Invoicing.Invoicing> localizer
@functions {
    public static class InvoicePaymentStatusesHelper
    {
        public static string RequestStatus(int status) => System.Enum.IsDefined(typeof(PaymentRequestStatuses), status) ? ((PaymentRequestStatuses)status).ToString() : "Unknown";
    }
}
@{
    var invoice = Model.Invoice;
    ViewBag.Title = "Resgrid | " + localizer["Invoice"] + " #" + invoice.InvoiceNumber;
    ViewData["Tab"] = "Index";
    ViewData["Title"] = localizer["Invoice"].Value + " #" + invoice.InvoiceNumber;
    var status = (InvoiceStatus)invoice.Status;
    var isDraft = status == InvoiceStatus.Draft;
    var isOpen = status == InvoiceStatus.Sent || status == InvoiceStatus.PartiallyPaid || status == InvoiceStatus.Overdue;
    var canVoid = status != InvoiceStatus.Void && status != InvoiceStatus.Paid && (invoice.Payments == null || invoice.Payments.Count == 0);
    var write = Model.CanWrite && Model.CanManage;
    var lines = (invoice.LineItems ?? new List<InvoiceLineItem>()).OrderBy(x => x.SortOrder).ToList();
    var payments = (invoice.Payments ?? new List<InvoicePayment>()).OrderBy(x => x.PaidOn).ToList();
}

@await Html.PartialAsync("_Shell")

<div class="wrapper wrapper-content">
    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-info">@Model.Message</div>
    }
    <div class="row">
        <div class="col-lg-8">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>@localizer["Invoice"] #@invoice.InvoiceNumber &mdash; @(Model.ContactName(invoice.ContactId) ?? "—")</h5>
                    <div class="ibox-tools">@await Html.PartialAsync("_Status", invoice.Status)</div>
                </div>
                <div class="ibox-content">
                    <div class="row">
                        <div class="col-sm-6">
                            <dl class="dl-horizontal m-b-none">
                                <dt>@localizer["Customer"]</dt><dd>@(Model.ContactName(invoice.ContactId) ?? "—")</dd>
                                <dt>@localizer["BillingEmail"]</dt><dd>@(Model.Profile?.BillingEmail ?? "—")</dd>
                                <dt>@localizer["IssuedOn"]</dt><dd>@(invoice.IssuedOn?.ToString("yyyy-MM-dd") ?? "—")</dd>
                                <dt>@localizer["DueOn"]</dt><dd>@(invoice.DueOn?.ToString("yyyy-MM-dd") ?? "—")</dd>
                                @if (invoice.SentOn.HasValue)
                                {
                                    <dt>@localizer["SentOn"]</dt><dd>@invoice.SentOn.Value.ToString("yyyy-MM-dd HH:mm") @(string.IsNullOrWhiteSpace(invoice.SentToEmail) ? "" : "(" + invoice.SentToEmail + ")")</dd>
                                }
                                @if (invoice.VoidedOn.HasValue)
                                {
                                    <dt>@localizer["VoidedOn"]</dt><dd>@invoice.VoidedOn.Value.ToString("yyyy-MM-dd") @invoice.VoidReason</dd>
                                }
                            </dl>
                        </div>
                        <div class="col-sm-6">
                            <table class="table table-condensed m-b-none">
                                <tr><td>@localizer["SubTotal"]</td><td class="text-right">@invoice.SubTotal.ToString("N2") @invoice.Currency</td></tr>
                                <tr><td>@localizer["Discount"] @(invoice.DiscountPercent.HasValue ? "(" + invoice.DiscountPercent + "%)" : "")</td><td class="text-right">-@invoice.DiscountAmount.ToString("N2")</td></tr>
                                <tr><td>@localizer["Tax"]</td><td class="text-right">@invoice.TaxAmount.ToString("N2")</td></tr>
                                <tr class="font-bold"><td>@localizer["Total"]</td><td class="text-right">@invoice.Total.ToString("N2") @invoice.Currency</td></tr>
                                <tr><td>@localizer["AmountPaid"]</td><td class="text-right">@invoice.AmountPaid.ToString("N2")</td></tr>
                                <tr class="font-bold"><td>@localizer["Balance"]</td><td class="text-right">@invoice.Balance.ToString("N2") @invoice.Currency</td></tr>
                            </table>
                        </div>
                    </div>

                    <div class="hr-line-dashed"></div>
                    <h4>@localizer["LineItems"]</h4>
                    @if (lines.Count == 0)
                    {
                        <p class="text-muted">@localizer["NoLineItems"]</p>
                    }
                    else
                    {
                        <table class="table table-condensed">
                            <thead><tr><th>@localizer["Description"]</th><th class="text-right">@localizer["Quantity"]</th><th class="text-right">@localizer["UnitRate"]</th><th class="text-center">@localizer["Taxable"]</th><th class="text-right">@localizer["Amount"]</th></tr></thead>
                            <tbody>
                                @foreach (var line in lines)
                                {
                                    <tr>
                                        <td>@line.Description @if (line.CallId.HasValue) { <small class="text-muted">(Call @line.CallId)</small> }</td>
                                        <td class="text-right">@line.Quantity.ToString("0.##")</td>
                                        <td class="text-right">@line.UnitRate.ToString("N2")</td>
                                        <td class="text-center">@(line.Taxable ? "✓" : "")</td>
                                        <td class="text-right">@line.Amount.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }

                    <div class="hr-line-dashed"></div>
                    <h4>@localizer["Payments"]</h4>
                    @if (payments.Count == 0)
                    {
                        <p class="text-muted">@localizer["NoPayments"]</p>
                    }
                    else
                    {
                        <table class="table table-condensed">
                            <thead><tr><th>@localizer["PaidOn"]</th><th>@localizer["Method"]</th><th>@localizer["Reference"]</th><th>@localizer["PaymentStatus"]</th><th class="text-right">@localizer["Fee"]</th><th class="text-right">@localizer["Amount"]</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var payment in payments)
                                {
                                    <tr>
                                        <td>@payment.PaidOn.ToString("yyyy-MM-dd")</td>
                                        <td>@localizer["Method" + (InvoicePaymentMethods)payment.Method] @payment.PaymentMethodSummary</td>
                                        <td>@payment.Reference</td>
                                        <td>@localizer["PaymentStatus" + (InvoicePaymentStatuses)payment.Status]@(payment.RefundedAmount > 0 ? " (-" + payment.RefundedAmount.ToString("N2") + ")" : "")</td>
                                        <td class="text-right">@(payment.ProviderFeeAmount?.ToString("N2") ?? "—")</td>
                                        <td class="text-right">@payment.Amount.ToString("N2")</td>
                                        <td>@if (!string.IsNullOrWhiteSpace(payment.ReceiptUrl) && payment.ReceiptUrl.StartsWith("https://", System.StringComparison.OrdinalIgnoreCase)) { <a href="@payment.ReceiptUrl" target="_blank" rel="noopener noreferrer" title="@localizer["Receipt"]"><i class="fa fa-external-link"></i></a> }</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>

            <div class="ibox float-e-margins">
                <div class="ibox-title"><h5>@localizer["Preview"]</h5></div>
                <div class="ibox-content" style="padding: 0;">
                    <iframe sandbox="" srcdoc="@Model.RenderedHtml" style="width: 100%; height: 900px; border: 0;" title="@localizer["Preview"]"></iframe>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="ibox float-e-margins">
                <div class="ibox-title"><h5>@localizer["Actions"]</h5></div>
                <div class="ibox-content">
                    @if (isDraft && write)
                    {
                        <a asp-controller="Invoicing" asp-action="Edit" asp-route-area="User" asp-route-id="@invoice.InvoiceId" class="btn btn-default btn-block"><i class="fa fa-pencil"></i> @localizer["EditDraft"]</a>
                    }
                    <a asp-controller="Invoicing" asp-action="Pdf" asp-route-area="User" asp-route-id="@invoice.InvoiceId" class="btn btn-default btn-block"><i class="fa fa-file-pdf-o"></i> @localizer["DownloadPdf"]</a>
                    @if ((isDraft || isOpen) && write)
                    {
                        <button type="button" class="btn btn-primary btn-block" data-toggle="modal" data-target="#sendModal"><i class="fa fa-envelope-o"></i> @(isDraft ? localizer["SendInvoice"] : localizer["ResendInvoice"])</button>
                    }
                    @if (isDraft && write)
                    {
                        <form method="post" asp-controller="Invoicing" asp-action="MarkSent" asp-route-area="User" asp-route-id="@invoice.InvoiceId" class="m-t-xs">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-white btn-block" onclick="return confirm('@localizer["MarkSentConfirm"]');"><i class="fa fa-check"></i> @localizer["MarkSentWithoutEmail"]</button>
                        </form>
                    }
                    @if (isOpen && write)
                    {
                        <button type="button" class="btn btn-success btn-block" data-toggle="modal" data-target="#paymentModal"><i class="fa fa-money"></i> @localizer["RecordPayment"]</button>
                    }
                    @if (canVoid && write)
                    {
                        <button type="button" class="btn btn-danger btn-block" data-toggle="modal" data-target="#voidModal"><i class="fa fa-ban"></i> @localizer["VoidInvoice"]</button>
                    }
                    <div class="hr-line-dashed"></div>
                    <a asp-controller="Invoicing" asp-action="Index" asp-route-area="User" class="btn btn-white btn-block">@localizer["BackToInvoices"]</a>
                    <a asp-controller="Invoicing" asp-action="BillingProfile" asp-route-area="User" asp-route-contactId="@invoice.ContactId" class="btn btn-white btn-block">@localizer["BillingProfile"]</a>
                </div>
            </div>

            @if (Model.OnlinePayments != null)
            {
                var op = Model.OnlinePayments;
                <div class="ibox float-e-margins">
                    <div class="ibox-title"><h5><i class="fa fa-credit-card"></i> @localizer["PayOnline"]</h5></div>
                    <div class="ibox-content">
                        @if (!string.IsNullOrWhiteSpace(Model.PayUrl))
                        {
                            <label for="payUrl">@localizer["PayLink"]</label>
                            <div class="input-group">
                                <input type="text" class="form-control" id="payUrl" value="@Model.PayUrl" readonly />
                                <span class="input-group-btn"><button type="button" class="btn btn-default" id="copyPayUrl" title="@localizer["CopyLink"]"><i class="fa fa-copy"></i></button></span>
                            </div>
                            <p class="help-block">@localizer["PayLinkHint"]</p>
                            @if (Model.OpenRequest != null)
                            {
                                <p class="m-b-xs">@localizer["OpenRequest"]: <span class="label label-info">@localizer["RequestStatus" + (InvoicePaymentStatusesHelper.RequestStatus(Model.OpenRequest.Status))]</span> <small class="text-muted">@localizer["ExpiresOn"] @Model.OpenRequest.ExpiresOn.ToString("yyyy-MM-dd HH:mm") UTC</small></p>
                            }
                            @if (isOpen && write)
                            {
                                <form method="post" asp-controller="Invoicing" asp-action="CreatePayLink" asp-route-area="User" asp-route-id="@invoice.InvoiceId">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-default btn-sm"><i class="fa fa-refresh"></i> @(Model.OpenRequest == null ? localizer["OpenPaymentRequest"] : localizer["RefreshPaymentRequest"])</button>
                                </form>
                            }
                        }
                        else
                        {
                            <p class="text-muted">@localizer["PayOnlineNotOffered"] @(op.BlockedReason == null ? "" : localizer[op.BlockedReason].Value)</p>
                            @if (!op.EnabledByDepartment && Model.CanManage)
                            {
                                <a asp-controller="Invoicing" asp-action="Settings" asp-route-area="User" asp-route-tab="online" class="btn btn-xs btn-default">@localizer["OnlinePayments"]</a>
                            }
                        }
                        @if (Model.PaymentRequests != null && Model.PaymentRequests.Count > 0)
                        {
                            <div class="hr-line-dashed"></div>
                            <table class="table table-condensed m-b-none">
                                <thead><tr><th>@localizer["Started"]</th><th>@localizer["Status"]</th><th class="text-right">@localizer["Amount"]</th></tr></thead>
                                <tbody>
                                    @foreach (var request in Model.PaymentRequests.Take(10))
                                    {
                                        <tr>
                                            <td>@request.AddedOn.ToString("yyyy-MM-dd HH:mm")</td>
                                            <td>@localizer["RequestStatus" + InvoicePaymentStatusesHelper.RequestStatus(request.Status)]</td>
                                            <td class="text-right">@request.Amount.ToString("N2") @request.Currency</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@if (write)
{
    <div class="modal inmodal" id="sendModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog">
            <form method="post" asp-controller="Invoicing" asp-action="Send" asp-route-area="User" asp-route-id="@invoice.InvoiceId" class="modal-content">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title">@localizer["SendInvoice"]</h4>
                    <small>@localizer["SendInvoiceIntro"]</small>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label for="toEmail">@localizer["SendTo"]</label>
                        <input type="email" class="form-control" id="toEmail" name="toEmail" value="@(Model.Profile?.BillingEmail)" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-white" data-dismiss="modal">@commonLocalizer["Cancel"]</button>
                    <button type="submit" class="btn btn-primary"><i class="fa fa-envelope-o"></i> @localizer["Send"]</button>
                </div>
            </form>
        </div>
    </div>

    <div class="modal inmodal" id="paymentModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog">
            <form method="post" asp-controller="Invoicing" asp-action="RecordPayment" asp-route-area="User" class="modal-content">
                @Html.AntiForgeryToken()
                <input type="hidden" name="InvoiceId" value="@invoice.InvoiceId" />
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title">@localizer["RecordPayment"]</h4>
                    <small>@localizer["RecordPaymentIntro"]</small>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-sm-6 form-group">
                            <label for="Amount">@localizer["Amount"]</label>
                            <input type="number" step="0.01" min="0.01" class="form-control" id="Amount" name="Amount" value="@invoice.Balance.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" required />
                        </div>
                        <div class="col-sm-6 form-group">
                            <label for="PaidOn">@localizer["PaidOn"]</label>
                            <input type="date" class="form-control" id="PaidOn" name="PaidOn" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="Method">@localizer["Method"]</label>
                        <select class="form-control" id="Method" name="Method">
                            @foreach (var method in Enum.GetValues<InvoicePaymentMethods>().Where(m => m != InvoicePaymentMethods.Online))
                            {
                                <option value="@((int)method)">@localizer["Method" + method]</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="Reference">@localizer["Reference"]</label>
                        <input type="text" class="form-control" id="Reference" name="Reference" maxlength="200" />
                    </div>
                    <div class="form-group">
                        <label for="PaymentNotes">@localizer["Notes"]</label>
                        <textarea class="form-control" id="PaymentNotes" name="Notes" rows="2" maxlength="2000"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-white" data-dismiss="modal">@commonLocalizer["Cancel"]</button>
                    <button type="submit" class="btn btn-success"><i class="fa fa-money"></i> @localizer["RecordPayment"]</button>
                </div>
            </form>
        </div>
    </div>

    <div class="modal inmodal" id="voidModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog">
            <form method="post" asp-controller="Invoicing" asp-action="Void" asp-route-area="User" asp-route-id="@invoice.InvoiceId" class="modal-content">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title">@localizer["VoidInvoice"]</h4>
                    <small>@localizer["VoidInvoiceIntro"]</small>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label for="reason">@localizer["Reason"]</label>
                        <input type="text" class="form-control" id="reason" name="reason" maxlength="500" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-white" data-dismiss="modal">@commonLocalizer["Cancel"]</button>
                    <button type="submit" class="btn btn-danger"><i class="fa fa-ban"></i> @localizer["VoidInvoice"]</button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <script>
        $(function () {
            $('#copyPayUrl').on('click', function () {
                var input = document.getElementById('payUrl');
                if (!input) return;
                input.select();
                var copied = function () { toastr.success('@localizer["LinkCopied"]'); };
                var fallback = function () { try { if (document.execCommand('copy')) copied(); } catch (e) { } };
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(input.value).then(copied, fallback);
                } else {
                    fallback();
                }
            });
        });
    </script>
}
