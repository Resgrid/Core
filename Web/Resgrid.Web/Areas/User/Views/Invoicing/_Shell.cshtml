@inject IStringLocalizer<Resgrid.Localization.Areas.User.Invoicing.Invoicing> localizer
@*
    Page heading shared by every invoicing screen (Workforce & Business Operations plan, Phase B).

    ViewData["Title"]      heading and last breadcrumb crumb (defaults to the module name)
    ViewData["Subtitle"]   optional one line description under the breadcrumb
    ViewData["ParentText"] optional intermediate crumb, with ParentAction and ParentRoute (route value dictionary)
*@
@{
    var title = (string)ViewData["Title"] ?? localizer["Invoicing"].Value;
    var subtitle = (string)ViewData["Subtitle"];
    var parentText = (string)ViewData["ParentText"];
    var parentAction = (string)ViewData["ParentAction"];
    var parentRoute = ViewData["ParentRoute"] as IDictionary<string, string> ?? new Dictionary<string, string>();
    var isRoot = string.Equals(title, localizer["Invoicing"].Value, StringComparison.Ordinal);
    var canWrite = ViewData["InvoicingCanWrite"] as bool? ?? false;
}
<div class="row wrapper border-bottom white-bg page-heading rgw-page-heading">
    <div class="@(ViewData["HeaderActions"] == null ? "col-sm-12" : "col-sm-4")">
        <h2>@title</h2>
        <ol class="breadcrumb">
            <li><a asp-controller="Home" asp-action="Dashboard" asp-route-area="User">@commonLocalizer["HomeModule"]</a></li>
            @if (isRoot)
            {
                <li class="active"><strong>@localizer["Invoicing"]</strong></li>
            }
            else
            {
                <li><a asp-controller="Invoicing" asp-action="Index" asp-route-area="User">@localizer["Invoicing"]</a></li>
                @if (!string.IsNullOrEmpty(parentText))
                {
                    <li><a asp-controller="Invoicing" asp-action="@parentAction" asp-all-route-data="parentRoute" asp-route-area="User">@parentText</a></li>
                }
                <li class="active"><strong>@title</strong></li>
            }
        </ol>
        @if (!string.IsNullOrEmpty(subtitle))
        {
            <small class="text-muted">@subtitle</small>
        }
    </div>
    @await Html.PartialAsync("_WorkspaceHeaderActions")
    @if (ViewData["Tab"] != null)
    {
        <div class="col-sm-12 rgw-module-navigation">
            @await Html.PartialAsync("_Tabs")
        </div>
    }
</div>
@if (!canWrite)
{
    <div class="wrapper wrapper-content" style="padding-bottom: 0;">
        <div class="alert alert-warning m-b-none">
            <i class="fa fa-lock"></i> @localizer["ReadOnlyNotice"]
            <a asp-controller="BusinessOperationsBilling" asp-action="Index" asp-route-area="User">@localizer["BusinessOperations"]</a>
        </div>
    </div>
}
