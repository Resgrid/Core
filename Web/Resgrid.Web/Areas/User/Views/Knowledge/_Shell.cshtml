@using Resgrid.Web.Areas.User.Models
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Knowledge.Knowledge> localizer
@*
    Page heading shared by the knowledge screens (module-workspace.css): title, breadcrumb, an optional line under it, and the sections in
    a strip underneath (Shared/_ModuleTabs). ViewData["Section"] Gaps or Settings; ViewData["IsAdmin"] shows Settings.
*@
@{
    var moduleName = localizer["KnowledgeHeader"].Value;
    var title = (string)ViewData["Title"] ?? moduleName;
    var subtitle = (string)ViewData["Subtitle"];
    var section = (string)ViewData["Section"] ?? "Gaps";
    var isAdmin = ViewData["IsAdmin"] as bool? ?? false;
    var canSeeGaps = ViewData["CanSeeGaps"] as bool? ?? true;

    var sections = new ModuleTabsView { Label = moduleName };
    if (canSeeGaps || section == "Gaps")
    {
        sections.Tabs.Add(new ModuleTab(localizer["GapsTab"].Value, "fa-question-circle", "Knowledge", "Gaps", section == "Gaps"));
    }
    if (isAdmin || section == "Settings")
    {
        sections.Tabs.Add(new ModuleTab(localizer["SettingsTab"].Value, "fa-cog", "Knowledge", "Settings", section == "Settings"));
    }
}
<div class="row wrapper border-bottom white-bg page-heading rgw-page-heading">
    <div class="col-sm-12">
        <h2>@title</h2>
        <ol class="breadcrumb">
            <li><a asp-controller="Home" asp-action="Dashboard" asp-route-area="User">@commonLocalizer["HomeModule"]</a></li>
            <li><a asp-controller="Protocols" asp-action="Index" asp-route-area="User">@localizer["ProtocolsCrumb"]</a></li>
            <li class="active"><strong>@title</strong></li>
        </ol>
        @if (!string.IsNullOrEmpty(subtitle))
        {
            <small class="text-muted">@subtitle</small>
        }
    </div>
    @await Html.PartialAsync("_WorkspaceHeaderActions")
    <div class="col-sm-12 rgw-module-navigation">
        @await Html.PartialAsync("_ModuleTabs", sections)
    </div>
</div>
