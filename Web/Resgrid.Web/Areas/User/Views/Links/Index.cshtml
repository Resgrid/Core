@using Resgrid.Framework
@using Resgrid.Model
@using Resgrid.Model.Events
@using Resgrid.Web.Extensions
@using Resgrid.Web.Helpers
@model Resgrid.WebCore.Areas.User.Models.Links.LinksIndexView
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Links.Links> localizer
@{
  ViewBag.Title = "Resgrid | " + localizer["PageTitle"];
}

<div class="row wrapper border-bottom white-bg page-heading">
	<div class="col-sm-4">
		<h2>@localizer["DepartmentLinks"]</h2>
		<ol class="breadcrumb">
			<li>
				<a asp-controller="Home" asp-action="Dashboard" asp-route-area="User">@commonLocalizer["Home"]</a>
			</li>
			<li class="active">
				<strong>@localizer["DepartmentLinks"]</strong>
			</li>
		</ol>
	</div>
	@if (ClaimsAuthorizationHelper.IsUserDepartmentAdmin())
	{
		<div class="col-sm-8">
			<div class="btn-group top-page-buttons" style="float:right;padding-right:15px;">
				<a title="Add a new department link" class="btn btn-success" asp-controller="Links" asp-action="New" asp-route-area="User">@localizer["NewDepartmentLinks"]</a>
			</div>
		</div>
	}
</div>

  <div class="row">
    @*@if (ClaimsAuthorizationHelper.IsUserDepartmentAdmin())
	  {*@
    @*Html.Raw("<div class='col-xs-9'>");*@
    @*}
	  else
	  {
		Html.Raw("<div class='col-xs-12'>");
	  }*@
    <div class='col-xs-9'>
      <div class="wrapper wrapper-content">
        <div class="ibox float-e-margins">
          <div class="ibox-content">
            <div class="table-responsive">
              <table class="table table-striped">
                <thead>
                  <tr>
                    <th>@localizer["FromDepartment"]</th>
                    <th></th>
                    <th>@localizer["ToDepartment"]</th>
                    <th>@localizer["Enabled"]</th>
                    <th>@localizer["SharedData"]</th>
                    <th>@commonLocalizer["Actions"]</th>
                  </tr>
                </thead>
                <tbody>
                  @foreach (var l in Model.Links)
				  {
                    <tr>
                      <td>
                        <span>@l.Department?.Name</span>
                      </td>
                      <td>
                        @if (l.DepartmentId != Model.DepartmentId && !String.IsNullOrWhiteSpace(l.DepartmentColor))
						{
                          <i class="fa fa-arrow-right" style="color: @l.DepartmentColor"></i>
						}
						else
						{
                          <i class="fa fa-arrow-right"></i>
						}
                      </td>
                      <td>
                        <span>@l.LinkedDepartment?.Name</span>
                      </td>
                      <td>
                        @if (l.LinkEnabled)
						{
                          <span style="color: green;">@localizer["LinkEnabled"]</span>
						}
						else
						{
                          <span style="color: red;">@localizer["LinkDisabled"]</span>
						}
                      </td>
                      <td>
                        @{
						  var data = String.Empty;

						  if (l.DepartmentShareCalls)
						  {
							if (data.Length <= 0)
							{
							  data = localizer["Calls"];
							}
							else
							{
							  data = data + "," + localizer["Calls"];
							}
						  }

						  if (l.DepartmentSharePersonnel)
						  {
							if (data.Length <= 0)
							{
							  data = localizer["Personnel"];
							}
							else
							{
							  data = data + "," + localizer["Personnel"];
							}
						  }

						  if (l.DepartmentShareUnits)
						  {
							if (data.Length <= 0)
							{
							  data = localizer["Units"];
							}
							else
							{
							  data = data + "," + localizer["Units"];
							}
						  }

						  if (l.DepartmentShareOrders)
						  {
							if (data.Length <= 0)
							{
							  data = localizer["Orders"];
							}
							else
							{
							  data = data + "," + localizer["Orders"];
							}
						  }

						  // Round 10 A3: the Protocols and Training share kinds, and what the linked department shares back.
						  if (l.DepartmentShareProtocols)
						  {
							data = data.Length <= 0 ? localizer["Protocols"].Value : data + "," + localizer["Protocols"];
						  }

						  if (l.DepartmentShareTraining)
						  {
							data = data.Length <= 0 ? localizer["Training"].Value : data + "," + localizer["Training"];
						  }

						  var back = new System.Collections.Generic.List<string>();
						  if (l.LinkedDepartmentShareCalls) { back.Add(localizer["Calls"].Value); }
						  if (l.LinkedDepartmentSharePersonnel) { back.Add(localizer["Personnel"].Value); }
						  if (l.LinkedDepartmentShareUnits) { back.Add(localizer["Units"].Value); }
						  if (l.LinkedDepartmentShareOrders) { back.Add(localizer["Orders"].Value); }
						  if (l.LinkedDepartmentShareProtocols) { back.Add(localizer["Protocols"].Value); }
						  if (l.LinkedDepartmentShareTraining) { back.Add(localizer["Training"].Value); }
                        }

                        @if (!String.IsNullOrWhiteSpace(data))
						{
                          <span>@data</span>
						}
						else
						{
                          <span>@localizer["NoDataShared"]</span>
						}
                        @if (back.Count > 0)
						{
                          <div class="small text-muted">@localizer["SharedBack"] @string.Join(",", back)</div>
						}
                      </td>
                      <td>
                        @if (l.DepartmentId != Model.DepartmentId && l.LinkEnabled == false && ClaimsAuthorizationHelper.IsUserDepartmentAdmin())
						{
                          <a href="@Url.Action("Enable", "Links", new { area = "User", linkId = l.DepartmentLinkId })" class='btn btn-xs btn-success'>
                            @localizer["Enable"]
                          </a>
						}
						else if (l.DepartmentId != Model.DepartmentId && l.LinkEnabled && ClaimsAuthorizationHelper.IsUserDepartmentAdmin())
						{
                          <form class="department-link-disable-form" asp-controller="Links" asp-action="DisableLink" asp-route-area="User" asp-antiforgery="true" method="post" style="display:inline;">
                            <input type="hidden" name="linkId" value="@l.DepartmentLinkId" />
                            <button type="submit" class='btn btn-xs btn-warning'>@localizer["Disable"]</button>
                          </form>
						}

                        @if (ClaimsAuthorizationHelper.IsUserDepartmentAdmin())
						{
                          <form class="department-link-delete-form" asp-controller="Links" asp-action="DeleteLink" asp-route-area="User" asp-antiforgery="true" method="post" style="display:inline;" onsubmit="return confirm('@JsEncoder.Encode(localizer["DeleteLinkConfirm"])');">
                            <input type="hidden" name="linkId" value="@l.DepartmentLinkId" />
                            <button type="submit" class='btn btn-xs btn-danger'>@localizer["Delete"]</button>
                          </form>
						}


                        @if (l.DepartmentId != Model.DepartmentId && l.LinkEnabled)
						{
                          <a href="@Url.Action("View", "Links", new { area = "User", linkId = l.DepartmentLinkId })" class='btn btn-xs btn-primary'>
                            @localizer["ViewData"]
                          </a>
						}

                        @* Round 10 A3: each side sets what it shares; the other side's published protocols when it shares them toward us. *@
                        @if (l.LinkEnabled && ClaimsAuthorizationHelper.IsUserDepartmentAdmin())
						{
                          <a href="@Url.Action("Sharing", "Links", new { area = "User", linkId = l.DepartmentLinkId })" class='btn btn-xs btn-white'>
                            @localizer["EditSharing"]
                          </a>
						}
                        @if (Resgrid.Model.Helpers.DepartmentLinkSharing.GetSharedDepartmentId(l, Model.DepartmentId, Resgrid.Model.DepartmentLinkShareTypes.Protocols).HasValue)
						{
                          <a href="@Url.Action("Protocols", "Links", new { area = "User", linkId = l.DepartmentLinkId })" class='btn btn-xs btn-info'>
                            @localizer["ViewProtocols"]
                          </a>
						}
                      </td>
                    </tr>
						  }
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-xs-3">
      <div class="wrapper wrapper-content">
        <div class="ibox">
          <div class="ibox-content">
            <p class="small text-muted">@localizer["SetsIntro"]</p>
            <a class="btn btn-sm btn-white btn-block" href="@Url.Action("Index", "ContentSets", new { area = "User", kind = 0 })"><i class="fa fa-book" aria-hidden="true"></i> @localizer["ProtocolSetsLink"]</a>
            <a class="btn btn-sm btn-white btn-block" href="@Url.Action("Index", "ContentSets", new { area = "User", kind = 1 })"><i class="fa fa-graduation-cap" aria-hidden="true"></i> @localizer["CourseSetsLink"]</a>
            <a class="btn btn-sm btn-white btn-block" href="@Url.Action("Agreements", "Links", new { area = "User" })"><i class="fa fa-pencil-square-o" aria-hidden="true"></i> @localizer["PartnerAgreementsLink"]</a>
          </div>
        </div>
      </div>
    </div>

    @if (ClaimsAuthorizationHelper.IsUserDepartmentAdmin() && Model.CanCreateLinks)
	{
      <div class="col-xs-3">
        <div class="wrapper wrapper-content animated fadeInUp">
          <div class="ibox">
            <div class="ibox-content">
              <div id="gravatarSection" style="text-align: center; padding-top: 10px;">

                <span>@localizer["YourDepartmentLinkCode"]</span>
                <div style="color: #337ab7;">@Model.Code</div>
              </div>
            </div>
          </div>
        </div>
      </div>
	  }
  </div>

  @section Scripts
{

  }
