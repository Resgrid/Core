@using System.Globalization
@using Resgrid.Model
@using Resgrid.Model.Lms
@model Resgrid.Web.Areas.User.Models.LmsClasses.LmsClassSessionView
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Trainings.Trainings> trainingLocalizer
@*
    Round 7B (permission 135): record that the class's attendees completed its linked LMS course or baseline training (they took it together).
    Attendees are ticked by default; a row that cannot be recorded says why (no seat, not active, outside your group, already complete).
    The attestation is required. Recordings already made are listed below with their void (a reason is required) - outside the record
    form, so no form is nested.
*@
@{
    var view = Model.Recording;
    var culture = CultureInfo.CurrentCulture;
    string T(string key) { var v = trainingLocalizer[key]; return v.ResourceNotFound ? key : v.Value; }
}
<div class="ibox float-e-margins" id="record-completions">
    <div class="ibox-title"><h5><i class="fa fa-check-circle-o" aria-hidden="true"></i> @T("RecordCompletions.Title")</h5></div>
    <div class="ibox-content">
        @if (view.TargetId == null || string.IsNullOrEmpty(view.TargetName))
        {
            <p class="text-muted">@T("training_record_no_linked_training")</p>
        }
        else
        {
            <p>@string.Format(culture, T("RecordCompletions.Help"), view.TargetName)</p>
            @if (view.Refusal != null)
            {
                <div class="alert alert-info" role="status">@T(view.Refusal)</div>
            }
            else if (view.Rows.Count == 0)
            {
                <p class="text-muted">@T("RecordCompletions.None")</p>
            }
            else
            {
                <form method="post" asp-controller="LmsClasses" asp-action="RecordCompletions" asp-route-area="User" data-submit-once>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@view.Session.LmsClassSessionId" />
                    <input type="hidden" name="attestationVersion" value="@view.AttestationVersion" />
                    <div class="table-responsive">
                        <table class="table rgw-table">
                            <thead><tr><th scope="col"><span class="sr-only">@T("RecordCompletions.Select")</span></th><th scope="col">@T("RecordCompletions.Attendees")</th><th scope="col">@T("RecordCompletions.State")</th></tr></thead>
                            <tbody>
                                @foreach (var row in view.Rows)
                                {
                                    var inputId = "rc-" + row.Enrollment.LmsClassEnrollmentId.ToString(CultureInfo.InvariantCulture);
                                    var disabled = row.Refusal != null || row.Recording != null;
                                    <tr>
                                        <td><input type="checkbox" id="@inputId" name="userIds" value="@row.UserId" checked="@(row.Selected ? "checked" : null)" disabled="@(disabled ? "disabled" : null)" /></td>
                                        <td>
                                            <label for="@inputId" class="m-b-none">@row.Name</label>
                                            @if (row.IsExternal) { <span class="rgw-sub">@T("RecordCompletions.External")</span> }
                                        </td>
                                        <td>
                                            @if (row.Recording != null)
                                            {
                                                <span class="label label-primary">@T("RecordCompletions.Method")</span>
                                                <span class="rgw-sub">@string.Format(culture, T("RecordCompletions.RecordedByFormat"), Model.NameOf(row.Recording.RecordedByUserId), Model.Local(row.Recording.RecordedOn).ToString("g", culture))</span>
                                            }
                                            else if (row.Refusal != null)
                                            {
                                                <span class="text-muted">@T(row.Refusal)</span>
                                            }
                                            else if (row.Attended)
                                            {
                                                <span class="label label-success">@T("RecordCompletions.Attended")</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="form-group">
                        <label for="rc-note">@T("RecordCompletions.Note") <span class="text-muted small">@T("RecordCompletions.NoteOptional")</span></label>
                        <textarea id="rc-note" name="note" class="form-control" rows="2" maxlength="1000"></textarea>
                    </div>
                    <div class="checkbox">
                        <label><input type="checkbox" name="attested" value="true" required /> @T(TrainingCompletionAttestation.StatementKey(view.AttestationVersion))</label>
                        <input type="hidden" name="attested" value="false" />
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm" @(view.Selectable == 0 ? "disabled" : null)><i class="fa fa-check" aria-hidden="true"></i> @T("RecordCompletions.Submit")</button>
                </form>
            }

            @if (view.Recordings.Count > 0)
            {
                <h4 class="m-t">@T("RecordCompletions.History")</h4>
                <div class="table-responsive">
                    <table class="table rgw-table">
                        <thead><tr><th scope="col">@T("RecordCompletions.Attendees")</th><th scope="col">@T("RecordCompletions.State")</th><th scope="col" class="rgw-row-actions"><span class="sr-only">@T("RecordCompletions.Void")</span></th></tr></thead>
                        <tbody>
                            @foreach (var recording in view.Recordings)
                            {
                                <tr>
                                    <td>@(view.Rows.FirstOrDefault(r => string.Equals(r.UserId, recording.UserId, StringComparison.OrdinalIgnoreCase))?.Name ?? Model.NameOf(recording.UserId))<span class="rgw-sub">@recording.TargetName</span></td>
                                    <td>
                                        @if (recording.IsVoided)
                                        {
                                            <span class="label label-default">@T("RecordCompletions.Voided")</span>
                                            <span class="rgw-sub">@string.Format(culture, T("RecordCompletions.VoidedFormat"), Model.NameOf(recording.VoidedByUserId), Model.Local(recording.VoidedOn.Value).ToString("g", culture), recording.VoidReason)</span>
                                        }
                                        else
                                        {
                                            <span class="label label-primary">@T("RecordCompletions.Method")</span>
                                            <span class="rgw-sub">@string.Format(culture, T("RecordCompletions.RecordedByFormat"), Model.NameOf(recording.RecordedByUserId), Model.Local(recording.RecordedOn).ToString("g", culture))</span>
                                            @if (recording.QuizWaived) { <span class="rgw-sub">@T("RecordCompletions.QuizWaived")</span> }
                                            @if (!string.IsNullOrWhiteSpace(recording.Note)) { <span class="rgw-sub">@recording.Note</span> }
                                        }
                                    </td>
                                    <td class="rgw-row-actions">
                                        @if (!recording.IsVoided)
                                        {
                                            <form method="post" asp-controller="LmsClasses" asp-action="VoidRecordedCompletion" asp-route-area="User" class="form-inline" data-submit-once>
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@view.Session.LmsClassSessionId" />
                                                <input type="hidden" name="recordingId" value="@recording.TrainingCompletionRecordingId" />
                                                <label class="sr-only" for="rv-@recording.TrainingCompletionRecordingId">@T("RecordCompletions.VoidReason")</label>
                                                <input id="rv-@recording.TrainingCompletionRecordingId" name="reason" class="form-control input-sm" maxlength="500" required placeholder="@T("RecordCompletions.VoidReason")" />
                                                <button type="submit" class="btn btn-white btn-xs"><i class="fa fa-undo" aria-hidden="true"></i> @T("RecordCompletions.Void")</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </div>
</div>
