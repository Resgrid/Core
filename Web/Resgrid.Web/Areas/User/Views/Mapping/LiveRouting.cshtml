@model Resgrid.WebCore.Areas.User.Models.Mapping.StationRoutingView
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Mapping.Mapping> localizer
@{
    ViewBag.Title = "Resgrid | " + localizer["LiveRoutingPageTitle"];
}

@section Styles
{
    <style>
        #dvMap {
            height: 500px;
        }
    </style>
}

<div class="row wrapper border-bottom white-bg page-heading">
    <div class="col-sm-4">
        <h2>@localizer["LiveRoutingHeader"]</h2>
        <ol class="breadcrumb">
            <li>
                <a asp-controller="Home" asp-action="Dashboard" asp-route-area="User">@commonLocalizer["HomeModule"]</a>
            </li>
            <li>
                <a asp-controller="Mapping" asp-action="Index" asp-route-area="User">@localizer["MappingHeader"]</a>
            </li>
            <li class="active">
                <strong>@localizer["LiveRoutingHeader"]</strong>
            </li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="col-xs-8">
        <div class="wrapper wrapper-content">
            <div class="ibox float-e-margins">
                <div class="ibox-content">
                    <div id="dvDistance" style="font-size:x-large; text-align: center">
                    </div>
                    <div id="dvMap">
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-4">
        <div class="wrapper wrapper-content">
            <div class="ibox float-e-margins">
                <div class="ibox-content">
                    <div id="dvPanel">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts
{
    <partial name="_MapKitConfig" />
    <script src="~/js/app/internal/mapping/resgrid.mapping.routing.js" asp-append-version="true"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            var end = [Number(@Html.ScriptJson(Model.EndLat)), Number(@Html.ScriptJson(Model.EndLon))];
            navigator.geolocation.getCurrentPosition(function (position) {
                resgrid.mapping.routing.show([position.coords.latitude, position.coords.longitude], end, { distance: @Html.ScriptJson(localizer["DistanceLabel"].Value), duration: @Html.ScriptJson(localizer["DurationLabel"].Value) });
            }, function () {
                console.log('Geolocation not available');
            }, { timeout: 5000 });
        });
    </script>
}
