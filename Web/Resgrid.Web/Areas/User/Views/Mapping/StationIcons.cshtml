@using Resgrid.Model
@using Resgrid.Web.Areas.User.Models.Mapping
@model Resgrid.Web.Areas.User.Models.Mapping.StationIconsView
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Mapping.Mapping> localizer
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Mapping.MapIconLegend> legendStrings
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Icons.IconUpload> iconStrings
@{
	var moduleTitle = await departmentTerms.NameAsync(DepartmentTerms.Mapping, localizer["MappingHeader"]);
	var title = legendStrings["StationIconsTitle"].Value;
	ViewBag.Title = "Resgrid | " + title;
}
@section Styles
{
	<style>
		.rg-legend-icon { display: inline-block; vertical-align: bottom; }
		.rg-legend-icon.pin { width: 32px; height: 37px; }
		.rg-legend-icon.upload { width: 32px; height: 32px; object-fit: contain; }
		.rg-status-icons td { vertical-align: middle !important; }
		.rg-status-icons form { display: inline-block; margin: 0 4px 0 0; }
		.rg-status-icons input[type=file] { display: inline-block; max-width: 230px; }
		.rg-status-icons tr.rg-station-default td { font-weight: 600; }
	</style>
}

<div class="row wrapper border-bottom white-bg page-heading">
	<div class="col-sm-8">
		<h2>@title</h2>
		<ol class="breadcrumb">
			<li>
				<a asp-controller="Home" asp-action="Dashboard" asp-route-area="User">@commonLocalizer["HomeModule"]</a>
			</li>
			<li>
				<a asp-controller="Mapping" asp-action="Index" asp-route-area="User">@moduleTitle</a>
			</li>
			<li>
				<a asp-controller="Mapping" asp-action="Legend" asp-route-area="User">@legendStrings["LegendPageTitle"]</a>
			</li>
			<li class="active">
				<strong>@title</strong>
			</li>
		</ol>
	</div>
</div>

<div class="row">
	<div class="col-xs-12">
		<div class="wrapper wrapper-content">
			<div class="ibox float-e-margins">
				<div class="ibox-content">
					@if (!String.IsNullOrEmpty(Model.Message))
					{
						<div class="alert alert-success">@Model.Message</div>
					}
					@if (!String.IsNullOrEmpty(Model.ErrorMessage))
					{
						<div class="alert alert-danger">@Model.ErrorMessage</div>
					}
					<p>@legendStrings["StationIconsIntro"]</p>
					<p class="text-muted">@iconStrings["IconGuidanceFormat"] @iconStrings["IconGuidanceSize"]</p>

					<div class="table-responsive">
						<table class="table table-striped rg-status-icons">
							<thead>
								<tr>
									<th>@legendStrings["StationColumn"]</th>
									<th>@legendStrings["OnMapColumn"]</th>
									<th>@legendStrings["UploadedColumn"]</th>
									<th></th>
								</tr>
							</thead>
							<tbody>
								<tr class="rg-station-default">
									<td>
										@legendStrings["AllStations"]
										<div class="text-muted" style="font-weight: normal;">@legendStrings["AllStationsHelp"]</div>
									</td>
									<td><img class="rg-legend-icon @(Model.DepartmentIcon.IsUploaded ? "upload" : "pin")" src="@Model.DepartmentIcon.Url" alt="" /></td>
									<td>
										@if (Model.DepartmentUploadedUrl != null)
										{
											<img class="rg-legend-icon upload" src="@Model.DepartmentUploadedUrl" alt="" />
										}
										else
										{
											<span class="text-muted">@legendStrings["NoneUploaded"]</span>
										}
									</td>
									<td style="white-space: nowrap;">
										<form asp-controller="Mapping" asp-action="UploadStationIcon" asp-route-area="User" method="post" enctype="multipart/form-data">
											<input type="hidden" name="groupId" value="@TypeIcons.DepartmentStationTypeId" />
											<input type="file" name="iconFile" accept="image/png,image/jpeg,image/gif,image/webp" required aria-label="@legendStrings["AllStations"]" />
											<button class="btn btn-xs btn-primary" type="submit">@legendStrings["Upload"]</button>
										</form>
										@if (Model.DepartmentUploadedUrl != null)
										{
											<form asp-controller="Mapping" asp-action="RemoveStationIcon" asp-route-area="User" method="post">
												<input type="hidden" name="groupId" value="@TypeIcons.DepartmentStationTypeId" />
												<button class="btn btn-xs btn-danger" type="submit">@legendStrings["Remove"]</button>
											</form>
										}
									</td>
								</tr>
								@if (!Model.Stations.Any())
								{
									<tr>
										<td colspan="4" class="text-muted">@legendStrings["NoStations"]</td>
									</tr>
								}
								@foreach (var row in Model.Stations)
								{
									<tr>
										<td>@row.Name</td>
										<td><img class="rg-legend-icon @(row.Icon.IsUploaded ? "upload" : "pin")" src="@row.Icon.Url" alt="" /></td>
										<td>
											@if (row.UploadedUrl != null)
											{
												<img class="rg-legend-icon upload" src="@row.UploadedUrl" alt="" />
											}
											else
											{
												<span class="text-muted">@legendStrings["NoneUploaded"]</span>
											}
										</td>
										<td style="white-space: nowrap;">
											<form asp-controller="Mapping" asp-action="UploadStationIcon" asp-route-area="User" method="post" enctype="multipart/form-data">
												<input type="hidden" name="groupId" value="@row.GroupId" />
												<input type="file" name="iconFile" accept="image/png,image/jpeg,image/gif,image/webp" required aria-label="@row.Name" />
												<button class="btn btn-xs btn-primary" type="submit">@legendStrings["Upload"]</button>
											</form>
											@if (row.UploadedUrl != null)
											{
												<form asp-controller="Mapping" asp-action="RemoveStationIcon" asp-route-area="User" method="post">
													<input type="hidden" name="groupId" value="@row.GroupId" />
													<button class="btn btn-xs btn-danger" type="submit">@legendStrings["Remove"]</button>
												</form>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
