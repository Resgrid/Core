@using Resgrid.Model
@using Resgrid.Model.Helpers
@using Resgrid.Web.Helpers
@model Resgrid.Web.Areas.User.Models.Profile.CertificationsView
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Profile.Profile> localizer
@{
    ViewBag.Title = "Resgrid | " + @localizer["CertificationsHeader"];
}

<div class="row wrapper border-bottom white-bg page-heading">
    <div class="col-sm-4">
        <h2>
            @if (Model.Self)
            {
                <h1>@localizer["CertificationsHeader"]</h1>
            }
            else
            {
                <h1>@Model.Name's @localizer["CertificationsHeader"]</h1>
            }
        </h2>
        <ol class="breadcrumb">
            <li>
                <a asp-controller="Home" asp-action="Dashboard" asp-route-area="User">@commonLocalizer["HomeModule"]</a>
            </li>
            <li>
                <a asp-controller="Home" asp-action="EditUserProfile" asp-route-area="User" asp-route-userId="@ClaimsAuthorizationHelper.GetUserId()">@localizer["EditProfile"]</a>
            </li>
            <li class="active">
                <strong>@localizer["CertificationsHeader"]</strong>
            </li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="col-xs-12">
        <div class="wrapper wrapper-content">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>@localizer["CertificationsHeader"]</h5>
                    <div class="ibox-tools">
                        <div class="buttons-actions">
                            @if (Model.Self)
                            {
                                <a title="Add a new scheduled report" class="btn btn-success" asp-controller="Profile" asp-action="AddCertification" asp-route-area="User">@localizer["AddCertification"]</a>
                            }
                            else
                            {
                                <a title="Add a new scheduled report" class="btn btn-success" asp-controller="Profile" asp-action="AddCertification" asp-route-area="User" asp-route-userId="@Model.UserId">@localizer["AddCertification"]</a>
                            }
                        </div>
                    </div>
                </div>
                <div class="ibox-content">
                    @if (Model.IsProtected)
                    {
                        <div class="alert alert-info" id="adpProtectedBanner">
                            <i class="fa fa-shield"></i>
                            <strong>@commonLocalizer["AdpProtectedCertifications"]</strong> &mdash; @commonLocalizer["AdpProtectedBannerDescription"]
                            <button type="button" class="btn btn-primary btn-xs pull-right" id="adpRevealButton">@commonLocalizer["AdpVerifyAndReveal"]</button>
                            <button type="button" class="btn btn-default btn-xs pull-right" id="adpConcealButton" style="margin-right: 6px;">@commonLocalizer["AdpConceal"]</button>
                        </div>
                    }
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>
                                        @commonLocalizer["Name"]
                                    </th>
                                    <th>
                                        @commonLocalizer["Number"]
                                    </th>
                                    <th>
                                        @commonLocalizer["Type"]
                                    </th>
                                    <th>
                                        @localizer["ExpiresOn"]
                                    </th>
                                    <th>
                                        @commonLocalizer["Status"]
                                    </th>
                                    <th class="span1">
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var g in Model.Certifications)
                                {
                                    <tr>
                                        <td data-adp-field="personnelcertifications.name:@g.PersonnelCertificationId">
                                            @g.Name
                                        </td>
                                        <td data-adp-field="personnelcertifications.number:@g.PersonnelCertificationId">
                                            @g.Number
                                        </td>
                                        <td data-adp-field="personnelcertifications.type:@g.PersonnelCertificationId">
                                            @g.Type
                                        </td>
                                        <td>
                                            @if (g.ExpiresOn.HasValue)
                                            {
                                                @g.ExpiresOn.Value.ToShortDateString()
                                            }
                                            else
                                            {
                                                <span>Never</span>
                                            }
                                        </td>
                                        <td>
                                            @if (g.ExpiresOn.HasValue && g.ExpiresOn.Value <= DateTime.UtcNow.TimeConverter(Model.Department))
                                            {
                                                <span class="label label-danger">@commonLocalizer["Expired"]</span>
                                            }
                                            else
                                            {
                                                <span class="label label-success">@commonLocalizer["Valid"]</span>
                                            }
                                        </td>
                                        <td>
                                            <a class="btn btn-xs btn-danger" asp-controller="Profile" asp-action="DeleteCertification" asp-route-area="User" asp-route-certId="@g.PersonnelCertificationId" data-confirm="@localizer["CertificationDeleteWarning"]" rel="nofollow">@commonLocalizer["Delete"]</a>
                                            <a class="btn btn-xs btn-primary" asp-controller="Profile" asp-action="EditCertification" asp-route-area="User" asp-route-certId="@g.PersonnelCertificationId">Edit</a>

                                            @* Presence is judged on Filetype, not Data: a protected row's bytes are
                                                stripped on the way out, and hiding the button would tell the member their
                                                document had been deleted rather than concealed. *@
                                            @if (!String.IsNullOrWhiteSpace(g.Filetype))
                                            {
                                                @if (Model.IsProtected)
                                                {
                                                    @* A plain link cannot carry the grant header, so the reveal module
                                                        fetches the file and hands it to the browser as a blob. *@
                                                    <a class="btn btn-xs btn-success adp-download" href="#"
                                                       data-adp-url="@Url.Action("GetCertificationData", "Profile", new { area = "User", certId = g.PersonnelCertificationId })"
                                                       data-adp-filename="certification-@g.PersonnelCertificationId">@commonLocalizer["Download"]</a>
                                                }
                                                else
                                                {
                                                    <a class="btn btn-xs btn-success" asp-controller="Profile" asp-action="GetCertificationData" asp-route-area="User" asp-route-certId="@g.PersonnelCertificationId">@commonLocalizer["Download"]</a>
                                                }
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.IsProtected)
{
<div class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" id="adpStepUpModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title"><i class="fa fa-shield"></i> @commonLocalizer["AdpStepUpTitle"]</h4>
            </div>
            <div class="modal-body">
                <p>@commonLocalizer["AdpStepUpInstructions"]</p>
                <div class="alert alert-danger" id="adpStepUpError" style="display: none;"></div>
                <div class="form-group">
                    <label for="adpStepUpCode">@commonLocalizer["AdpVerificationCode"]</label>
                    <input type="text" class="form-control" id="adpStepUpCode" maxlength="8" autocomplete="one-time-code" inputmode="numeric" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">@commonLocalizer["Cancel"]</button>
                <button type="button" class="btn btn-primary" id="adpStepUpSubmit">@commonLocalizer["AdpVerify"]</button>
            </div>
        </div>
    </div>
</div>
}

@section Scripts
    {
    @if (Model.IsProtected)
    {
        <form id="adpAntiForgeryForm">@Html.AntiForgeryToken()</form>
        <script src="~/js/app/internal/dataprotection/resgrid.adp.reveal.js" type="text/javascript"></script>
        <script type="text/javascript">
            $(function () {
                resgridAdpReveal.init({
                    verifyUrl: '@Url.Action("VerifyStepUp", "DataProtection", new { area = "User" })',
                    revealUrl: '@Url.Action("RevealCertifications", "Profile", new { area = "User" })',
                    revealData: { userId: '@Model.UserId' },
                    messages: {
                        invalid_totp: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(commonLocalizer["AdpErrorInvalidCode"].Value)),
                        too_many_attempts: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(commonLocalizer["AdpErrorTooManyAttempts"].Value)),
                        mfa_not_enrolled: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(commonLocalizer["AdpErrorMfaNotEnrolled"].Value)),
                        grants_not_configured: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(commonLocalizer["AdpErrorGrantsNotConfigured"].Value)),
                        step_up_required: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(commonLocalizer["AdpErrorStepUpRequired"].Value)),
                        grant_expired: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(commonLocalizer["AdpErrorGrantExpired"].Value)),
                        grant_revoked: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(commonLocalizer["AdpErrorGrantRevoked"].Value)),
                        protected_access_denied: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(commonLocalizer["AdpErrorAccessDenied"].Value)),
                        broker_unavailable: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(commonLocalizer["AdpErrorBrokerUnavailable"].Value)),
                        generic: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(commonLocalizer["AdpErrorGeneric"].Value))
                    },
                    antiForgeryToken: $('#adpAntiForgeryForm input[name="__RequestVerificationToken"]').val()
                });

                $('.adp-download').on('click', function (e) {
                    e.preventDefault();
                    var $link = $(this);
                    resgridAdpReveal.download($link.data('adp-url'), $link.data('adp-filename'), function (message) {
                        window.alert(message);
                    });
                });
            });
        </script>
    }
}
