@model Resgrid.WebCore.Areas.User.Models.Protocols.ProtocolPrintModel
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Protocols.Protocols> localizer
@*
    The print view of a protocol version (P3): the content exactly as members read it (sanitized on output), stamped with the
    version, effective date, approver and content short code, with the protocol's QR code for the printed copy. No page chrome.
*@
@{
    Layout = null;
    var p = Model.Protocol;
    var v = Model.Version;
    var departmentTime = DepartmentTime.From(ViewData);
}
<!DOCTYPE html>
<html lang="@(Model.Locale ?? "en")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@p.Name</title>
    <link rel="stylesheet" href="~/css/protocol-content.css" asp-append-version="true" />
    <style>
        body { font-family: Arial, Helvetica, sans-serif; color: #222; margin: 24px; background: #fff; }
        .rgp-print-head { display: flex; gap: 16px; align-items: flex-start; border-bottom: 2px solid #333; padding-bottom: 8px; margin-bottom: 12px; }
        .rgp-print-head .rgp-print-title { flex: 1 1 auto; }
        .rgp-print-head h1 { font-size: 22px; margin: 0 0 4px; }
        .rgp-print-stamp { font-size: 12px; color: #444; }
        .rgp-print-qr img { width: 110px; height: 110px; image-rendering: pixelated; }
        .rgp-print-foot { margin-top: 16px; border-top: 1px solid #999; padding-top: 6px; font-size: 11px; color: #555; word-break: break-all; }
        @@media print { .rgp-print-tools { display: none; } body { margin: 0; } }
    </style>
</head>
<body>
    <div class="rgp-print-tools">
        <a href="@Url.Action("View", "Protocols", new { area = "User", id = p.DispatchProtocolId })">@localizer["BackToProtocolButton"]</a>
    </div>
    <div class="rgp-print-head">
        <div class="rgp-print-title">
            <h1>@(string.IsNullOrWhiteSpace(p.Number) ? p.Code : p.Number) @p.Name</h1>
            <div class="rgp-print-stamp">
                @Model.DepartmentName ·
                @localizer["BookVersion"] @(v.Label == null ? "-" : "v" + v.Label) ·
                @localizer["BookEffective"] @(departmentTime?.Date(v.EffectiveOn) ?? "-") ·
                @localizer["BookApprovedBy"] @(string.IsNullOrWhiteSpace(Model.ApproverNames) ? "-" : Model.ApproverNames) ·
                @localizer["BookContent"] <span style="font-family: monospace">@SignaturePolicy.ShortCode(v.ContentHash)</span>
                @if (Model.IsTranslation)
                {
                    <span> · @string.Format(localizer["TranslationShownNotice"].Value, Resgrid.WebCore.Areas.User.Models.Protocols.ProtocolDisplay.LanguageName(Model.Locale))</span>
                }
            </div>
        </div>
        @if (!string.IsNullOrEmpty(Model.QrDataUrl))
        {
            <div class="rgp-print-qr"><img src="@Model.QrDataUrl" alt="@string.Format(localizer["QrCodeAlt"].Value, p.Name)" /></div>
        }
    </div>
    @if (string.IsNullOrWhiteSpace(Model.Html))
    {
        <p><em>@localizer["BookDocumentBacked"]</em></p>
    }
    else
    {
        <div class="protocol-content rgp-reader">@Html.ProtocolContent(Model.Html, Model.DosingToolUrl, localizer["DosingToolLinkText"].Value)</div>
    }
    <div class="rgp-print-foot">@localizer["DeepLinkLabel"]: @Model.DeepLink</div>
</body>
</html>
