@using Resgrid.Model
@using Resgrid.Framework
@using Resgrid.WebCore.Areas.User.Models.Protocols
@model Resgrid.WebCore.Areas.User.Models.Protocols.ProtocolEditorModel
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Protocols.Protocols> localizer
@inject Resgrid.Model.Services.IProtocolLibraryService protocolLibrary
@*
    The full-page protocol editor (P1). The protocol's own fields, its library fields, triggers, questions and audience take
    effect when saved; the text is the draft's (a new version), published only after review. The page carries the protocol's
    and the draft's row versions: a save against an older copy is refused with who changed it and when (R-P8). The text is
    autosaved to the draft every 30 seconds while it changes.
*@
@{
    var departmentTime = DepartmentTime.From(ViewData);
    var title = localizer["EditProtocolHeader"].Value;
    ViewBag.Title = "Resgrid | " + title;
    ViewData["Title"] = title;
    ViewData["Subtitle"] = Model.Name;
    ViewData["Section"] = "Library";
    ViewData["IsManager"] = true;
    var error = TempData["ProtocolError"] as string;
    var draftStatus = Model.DraftStatus.HasValue ? ProtocolDisplay.VersionStatusName(Model.DraftStatus.Value, localizer) : null;
    // A document-backed protocol (P1 R-P5): its content is the file of the draft (or of the version in force until a draft exists);
    // a new upload replaces it, the editor saves only the rest.
    var versions = Model.ProtocolId > 0 ? await protocolLibrary.GetVersionsAsync(ClaimsAuthorizationHelper.GetDepartmentId(), Model.ProtocolId) : new List<ProtocolVersion>();
    var contentVersion = Model.DraftVersionId.HasValue ? versions.FirstOrDefault(v => v.ProtocolVersionId == Model.DraftVersionId.Value)
        : versions.FirstOrDefault(v => v.Status == (int)ProtocolVersionStatuses.Published);
    var isDocument = contentVersion != null && contentVersion.IsDocument;
    // P3: a block draft (or a block version in force with no draft yet) is edited in the block editor.
    var isBlocks = !isDocument && !Model.ContentLocked && !string.IsNullOrEmpty(Model.ContentJson);
}

@await Html.PartialAsync("_Shell")

<div class="wrapper wrapper-content rgw-page">
    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-success" role="status"><i class="fa fa-check" aria-hidden="true"></i> @Model.Message</div>
    }
    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger" role="alert"><i class="fa fa-exclamation-triangle" aria-hidden="true"></i> @error</div>
    }

    <div class="rgw-next-action" role="status">
        <i class="fa fa-code-fork" aria-hidden="true"></i>
        @if (Model.DraftVersionId.HasValue)
        {
            @string.Format(localizer["EditingDraftCallout"].Value, draftStatus, Model.DraftUpdatedBy, departmentTime.Format(Model.DraftUpdatedOn))
        }
        else
        {
            @string.Format(localizer["EditingNoDraftCallout"].Value, Model.CurrentVersionLabel ?? "-")
        }
        <a class="btn btn-xs btn-default" asp-controller="Protocols" asp-action="View" asp-route-area="User" asp-route-id="@Model.ProtocolId" asp-route-versionId="@Model.DraftVersionId" asp-route-preview="true" hidden="@(!Model.DraftVersionId.HasValue)"><i class="fa fa-eye" aria-hidden="true"></i> @localizer["PreviewAsMemberButton"]</a>
    </div>

    <form id="protocolEditorForm" method="post" enctype="multipart/form-data" asp-controller="Protocols" asp-action="Edit" asp-route-area="User" asp-route-id="@Model.ProtocolId"
          data-autosave-url="@Url.Action("SaveDraft", "Protocols", new { area = "User", id = Model.ProtocolId })" data-content-locked="@(Model.ContentLocked || isDocument ? "true" : "false")">
        @Html.AntiForgeryToken()
        <input type="hidden" name="RowVersion" value="@Model.RowVersion" />
        <input type="hidden" id="DraftRowVersion" name="DraftRowVersion" value="@Model.DraftRowVersion" />
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <p id="autosaveStatus" class="text-muted small" role="status" aria-live="polite"></p>

        <div class="ibox">
            <div class="ibox-title"><h5><i class="fa fa-id-card-o" aria-hidden="true"></i> @localizer["BasicsHeader"]</h5></div>
            <div class="ibox-content">
                <div class="rgw-grid">
                    <div class="form-group">
                        <label class="control-label required" for="Name">@localizer["ProtocolNameLabel"]</label>
                        <input class="form-control" id="Name" name="Name" value="@Model.Name" maxlength="100" required autofocus />
                    </div>
                    <div class="form-group">
                        <label class="control-label required" for="Code">@localizer["ProtocolCodeLabel"]</label>
                        <input class="form-control" id="Code" name="Code" value="@Model.Code" maxlength="@DispatchProtocol.CodeMaxLength" required pattern="[A-Za-z0-9][A-Za-z0-9 ._/\-]*" aria-describedby="CodeHelp" />
                        <span id="CodeHelp" class="help-block">@string.Format(localizer["CodeHelp"].Value, DispatchProtocol.CodeMaxLength)</span>
                    </div>
                    <div class="form-group protocol-dispatch-only" hidden="@(!ProtocolKindRules.TriggersApply(Model.Library.Kind))">
                        <label class="control-label" for="MinimumWeight">@localizer["ActivationQuestionWeightLabel"]</label>
                        <input class="form-control" id="MinimumWeight" name="MinimumWeight" type="number" min="0" max="1000" value="@Model.MinimumWeight" aria-describedby="MinimumWeightHelpText" />
                        <span id="MinimumWeightHelpText" class="help-block">@localizer["MinimumWeightEditorHelp"]</span>
                    </div>
                    <div class="form-group">
                        <span class="control-label">@localizer["StatusLabel"]</span>
                        <div class="checkbox">
                            <label>
                                <input type="checkbox" name="IsDisabled" value="true" @(Model.IsDisabled ? "checked" : "") />
                                @localizer["DisabledCheckbox"]
                            </label>
                            <input type="hidden" name="IsDisabled" value="false" />
                        </div>
                        <span class="help-block">@localizer["DisabledCheckboxHelp"]</span>
                    </div>
                </div>
                @await Html.PartialAsync("_LibraryFields", Model)
            </div>
        </div>

        <div class="ibox">
            <div class="ibox-title"><h5><i class="fa fa-file-text-o" aria-hidden="true"></i> @localizer["ContentHeader"]</h5></div>
            <div class="ibox-content">
                <div class="form-group">
                    <label class="control-label" for="editor-container" id="DescriptionLabelText">@localizer["DescriptionLabel"]</label>
                    <input type="hidden" id="Description" name="Description" value="@Model.Description" />
                    <div id="editor-container" style="width:100%; height: 140px;" aria-labelledby="DescriptionLabelText">@Html.SanitizedHtml(Model.Description)</div>
                    <span class="help-block">@string.Format(localizer["DescriptionHelp"].Value, DispatchProtocol.DescriptionTextMaxLength)</span>
                </div>
                <div class="form-group">
                    <label class="control-label" for="editor-container2" id="ProtocolTextLabelText">@localizer["ProtocolTextLabel"]</label>
                    @if (isDocument)
                    {
                        <input type="hidden" id="ProtocolText" name="ProtocolText" value="@Model.ProtocolText" />
                        @await Component.InvokeAsync("ProtocolDocumentContent", new { versionId = contentVersion.ProtocolVersionId, title = Model.Name, protocolId = Model.ProtocolId, showUpload = !Model.ContentLocked })
                    }
                    else if (Model.ContentLocked)
                    {
                        <div class="alert alert-info" role="status"><i class="fa fa-lock" aria-hidden="true"></i> @localizer["ContentLockedNotice"]</div>
                        <input type="hidden" id="ProtocolText" name="ProtocolText" value="@Model.ProtocolText" />
                        <div class="protocol-content well">@Html.ProtocolContent(Model.ProtocolText)</div>
                    }
                    else if (isBlocks)
                    {
                        <input type="hidden" id="ProtocolText" name="ProtocolText" value="" />
                        @await Html.PartialAsync("_BlockEditor", Model)
                    }
                    else
                    {
                        <div class="rgw-next-action" role="status">
                            <i class="fa fa-th-list" aria-hidden="true"></i> @localizer["ConvertToBlocksCallout"]
                            <button type="submit" form="convertToBlocksForm" class="btn btn-xs btn-primary" data-confirm="@localizer["ConvertToBlocksConfirm"]"><i class="fa fa-th-list" aria-hidden="true"></i> @localizer["ConvertToBlocksButton"]</button>
                        </div>
                        <input type="hidden" id="ProtocolText" name="ProtocolText" value="@Model.ProtocolText" />
                        <div id="editor-container2" style="width:100%; height: 420px;" aria-labelledby="ProtocolTextLabelText">@Html.SanitizedHtml(Model.ProtocolText)</div>
                        <span class="help-block">@localizer["ProtocolTextHeadingsHelp"]</span>
                    }
                </div>
                <div class="checkbox">
                    <label>
                        <input type="checkbox" id="Library_RequiresAcknowledgment" name="Library.RequiresAcknowledgment" value="true" @(Model.Library.RequiresAcknowledgment ? "checked" : "") />
                        @localizer["RequiresAcknowledgmentCheckbox"]
                    </label>
                    <input type="hidden" name="Library.RequiresAcknowledgment" value="false" />
                    <span class="help-block">@localizer["RequiresAcknowledgmentHelp"]</span>
                </div>
            </div>
        </div>

        @await Html.PartialAsync("_TriggerQuestionBuilder", Model)

        @if (!isDocument && Model.Library.Kind == (int)ProtocolKinds.Dispatch)
        {
            @* Protocols P4: the case flow (decision graph), part of the draft's content. *@
            @await Html.PartialAsync("_CaseFlowBuilder", Model)
        }

        <div class="ibox">
            <div class="ibox-title"><h5><i class="fa fa-users" aria-hidden="true"></i> @localizer["AudienceLabel"]</h5></div>
            <div class="ibox-content">
                @await Html.PartialAsync("_AudiencePicker", Model)
            </div>
        </div>

        <div class="ibox">
            <div class="ibox-title"><h5><i class="fa fa-paperclip" aria-hidden="true"></i> @localizer["AttachmentsLabel"]</h5></div>
            <div class="ibox-content">
                @if (Model.ExistingAttachments.Count > 0)
                {
                    <div class="table-responsive">
                        <table class="table table-striped rgw-table">
                            <thead>
                                <tr>
                                    <th>@localizer["FileNameColumn"]</th>
                                    <th>@localizer["SizeColumn"]</th>
                                    <th>@localizer["RemoveOnSaveColumn"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in Model.ExistingAttachments)
                                {
                                    <tr>
                                        <td><a asp-controller="Protocols" asp-action="GetProtocolAttachment" asp-route-area="User" asp-route-protocolAttachmentId="@a.DispatchProtocolAttachmentId"><i class="fa fa-download" aria-hidden="true"></i> @a.FileName</a></td>
                                        <td>@((a.Size ?? 0).GetSizeInMemory())</td>
                                        <td>
                                            <label class="m-b-none">
                                                <input type="checkbox" name="RemoveAttachmentIds" value="@a.DispatchProtocolAttachmentId" @(Model.RemoveAttachmentIds.Contains(a.DispatchProtocolAttachmentId) ? "checked" : "") />
                                                <span>@localizer["RemoveButton"]</span><span class="sr-only"> @a.FileName</span>
                                            </label>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                <div class="form-group">
                    <label class="control-label" for="attachments">@localizer["AddFilesLabel"]</label>
                    <input name="attachments" id="attachments" type="file" multiple aria-describedby="AttachmentsHelp" />
                    <span id="AttachmentsHelp" class="help-block">@string.Format(localizer["AttachmentsLimitsHelp"].Value, ProtocolRules.MaxFilesPerSave, ProtocolRules.MaxAttachmentBytes / 1000000, ProtocolRules.MaxBytesPerSave / 1000000)</span>
                    <span class="help-block">@localizer["AttachmentsReselectHelp"]</span>
                </div>
            </div>
        </div>

        <div class="ibox">
            <div class="ibox-title"><h5><i class="fa fa-paper-plane" aria-hidden="true"></i> @localizer["SubmitHeader"]</h5></div>
            <div class="ibox-content">
                <div class="form-group">
                    <label class="control-label" for="Library_ChangeSummary">@localizer["ChangeSummaryLabel"]</label>
                    <textarea class="form-control" id="Library_ChangeSummary" name="Library.ChangeSummary" rows="3" maxlength="@ProtocolVersion.ChangeSummaryMaxLength" aria-describedby="ChangeSummaryHelp" @(Model.ContentLocked ? "readonly" : "")>@Model.Library.ChangeSummary</textarea>
                    <span id="ChangeSummaryHelp" class="help-block">@localizer["ChangeSummaryHelp"]</span>
                </div>
                @if (Model.DraftVersionId.HasValue && !Model.ContentLocked)
                {
                    @* K2 drafting aid (Enhanced AI; hidden without it): a change summary drafted from the redline of this draft against the
                       version in force, written into the field above for the author to edit. Refused while "Do not use for AI" is ticked. *@
                    @await Html.PartialAsync("_AuthoringAids", new Resgrid.Web.Areas.User.Models.AuthoringAids.AuthoringAidsPanelModel
                    {
                        PanelId = "aids-protocol",
                        SourceKind = (int)AuthoringAidSourceKinds.ProtocolVersion,
                        SourceId = Model.DraftVersionId.Value,
                        OfferQuiz = false,
                        OfferOutline = false,
                        OfferChangeSummary = true,
                        ExcludeSelector = "input[type=checkbox][name='Library.ExcludeFromAi']",
                        SummaryTargetSelector = "#Library_ChangeSummary"
                    })
                }
            </div>
        </div>

        <div class="rgw-wizard-actions">
            <a class="btn btn-default" asp-controller="Protocols" asp-action="View" asp-route-area="User" asp-route-id="@Model.ProtocolId"><i class="fa fa-times" aria-hidden="true"></i> @commonLocalizer["Cancel"]</a>
            @if (Model.DraftVersionId.HasValue)
            {
                <a class="btn btn-default" asp-controller="ProtocolTools" asp-action="Translations" asp-route-area="User" asp-route-id="@Model.ProtocolId" asp-route-versionId="@Model.DraftVersionId" hidden="@(!Model.ContentLocked)"><i class="fa fa-language" aria-hidden="true"></i> @localizer["TranslationsButton"]</a>
            }
            <span class="rgw-wizard-spacer"></span>
            <button class="btn btn-primary" type="submit" name="Command" value="save"><i class="fa fa-save" aria-hidden="true"></i> @localizer["SaveProtocolButton"]</button>
            @if (!Model.ContentLocked)
            {
                <button class="btn btn-success" type="submit" name="Command" value="submit"><i class="fa fa-paper-plane" aria-hidden="true"></i> @localizer["SaveAndSubmitButton"]</button>
            }
        </div>
    </form>
    @if (!isDocument && !Model.ContentLocked && !isBlocks)
    {
        @* P3 "Convert to blocks": its own form (forms cannot nest); the button above submits it. *@
        <form id="convertToBlocksForm" method="post" asp-controller="Protocols" asp-action="ConvertToBlocks" asp-route-area="User" asp-route-id="@Model.ProtocolId" hidden>
            @Html.AntiForgeryToken()
            <input type="hidden" name="draftRowVersion" value="@Model.DraftRowVersion" />
        </form>
    }
</div>

<script type="application/json" id="protocolEditorText">@Html.ScriptJson(new
{
    saving = localizer["AutosaveSaving"].Value,
    saved = localizer["AutosaveSaved"].Value,
    failed = localizer["AutosaveFailed"].Value
})</script>

@section Styles {
    <link rel="stylesheet" href="~/css/workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/module-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/protocol-content.css" asp-append-version="true" />
}

@section Scripts
{
    <script src="~/js/app/internal/protocols/resgrid.protocols.editor.js" asp-append-version="true"></script>
    @if (!isDocument && !Model.ContentLocked && Model.Library.Kind == (int)ProtocolKinds.Dispatch)
    {
        <script src="~/js/app/internal/protocols/resgrid.protocols.caseflow.js" asp-append-version="true"></script>
    }
    @if (isBlocks)
    {
        <script src="~/js/app/internal/protocols/resgrid.protocols.blocks.js" asp-append-version="true"></script>
    }
}
