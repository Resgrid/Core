@using Resgrid.Model
@using Resgrid.WebCore.Areas.User.Models.Protocols
@model Resgrid.WebCore.Areas.User.Models.Protocols.ProtocolTriggerConditionsView
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Protocols.Protocols> localizer
@*
    Protocols P4: a trigger's conditions for the shared trigger engine (run cards use the same evaluator). Every condition that is set
    must also hold; an "any call" trigger needs at least one. Rendered for server rows and, with key __key__, in the row template.
*@
@{
    var k = Model.Key;
    var t = Model.Trigger ?? new ProtocolTriggerInput();
    var open = t.GeofenceGroupId.HasValue || t.PoiTypeId.HasValue || !string.IsNullOrWhiteSpace(t.Keywords) || (t.Days?.Count > 0)
               || !string.IsNullOrWhiteSpace(t.StartTime) || (t.CallSources?.Count > 0);
    var dayNames = System.Globalization.CultureInfo.CurrentUICulture.DateTimeFormat.AbbreviatedDayNames;
}
<details class="protocol-trigger-conditions m-t-sm" open="@open">
    <summary><i class="fa fa-sliders" aria-hidden="true"></i> @localizer["TriggerConditionsLabel"]</summary>
    <p class="help-block">@localizer["TriggerConditionsHelp"]</p>
    <div class="rgw-grid">
        <div class="form-group">
            <label class="control-label" for="trigger-keywords-@k">@localizer["TriggerKeywordsLabel"]</label>
            <input class="form-control" id="trigger-keywords-@k" name="Triggers[@k].Keywords" value="@t.Keywords" maxlength="@DispatchTriggerEngine.KeywordsMaxLength" placeholder="@localizer["TriggerKeywordsPlaceholder"]" />
        </div>
        <div class="form-group">
            <label class="control-label" for="trigger-zone-@k">@localizer["TriggerZoneLabel"]</label>
            <select class="form-control" id="trigger-zone-@k" name="Triggers[@k].GeofenceGroupId">
                <option value="">@localizer["TriggerAnyOption"]</option>
                @foreach (var group in Model.Groups)
                {
                    <option value="@group.DepartmentGroupId" selected="@(t.GeofenceGroupId == group.DepartmentGroupId)">@group.Name</option>
                }
            </select>
        </div>
        <div class="form-group">
            <label class="control-label" for="trigger-poitype-@k">@localizer["TriggerPoiTypeLabel"]</label>
            <select class="form-control" id="trigger-poitype-@k" name="Triggers[@k].PoiTypeId">
                <option value="">@localizer["TriggerAnyOption"]</option>
                @foreach (var poiType in Model.PoiTypes)
                {
                    <option value="@poiType.PoiTypeId" selected="@(t.PoiTypeId == poiType.PoiTypeId)">@poiType.Name</option>
                }
            </select>
        </div>
        <div class="form-group">
            <label class="control-label" for="trigger-from-@k">@localizer["TriggerFromLabel"]</label>
            <input class="form-control" type="time" id="trigger-from-@k" name="Triggers[@k].StartTime" value="@t.StartTime" />
        </div>
        <div class="form-group">
            <label class="control-label" for="trigger-to-@k">@localizer["TriggerToLabel"]</label>
            <input class="form-control" type="time" id="trigger-to-@k" name="Triggers[@k].EndTime" value="@t.EndTime" />
        </div>
    </div>
    <fieldset class="form-group">
        <legend class="control-label h5">@localizer["TriggerDaysLabel"]</legend>
        @for (var d = 0; d < 7; d++)
        {
            <label class="checkbox-inline">
                <input type="checkbox" name="Triggers[@k].Days" value="@d" checked="@(t.Days != null && t.Days.Contains(d))" /> @dayNames[d]
            </label>
        }
    </fieldset>
    <fieldset class="form-group">
        <legend class="control-label h5">@localizer["TriggerSourcesLabel"]</legend>
        @foreach (CallSources source in Enum.GetValues(typeof(CallSources)))
        {
            if (source == CallSources.Imported)
            {
                continue;
            }
            <label class="checkbox-inline">
                <input type="checkbox" name="Triggers[@k].CallSources" value="@((int)source)" checked="@(t.CallSources != null && t.CallSources.Contains((int)source))" /> @localizer["CallSource" + source]
            </label>
        }
    </fieldset>
</details>
