@model Resgrid.Web.Areas.User.Models.Deployments.DeploymentReportsView
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Deployments.Deployments> localizer
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Records.Records> recordsLocalizer
@{
    ViewBag.Title = "Resgrid | " + localizer["DeploymentReports"];
    var time = DepartmentTime.From(ViewData);
    var list = Model.Operations;
    var pages = Math.Max(1, (int)Math.Ceiling(list.Total / (double)list.PageSize));
}
<div class="row wrapper border-bottom white-bg page-heading"><div class="col-sm-12">
    <h2>@localizer["DeploymentReports"]</h2>
    <ol class="breadcrumb"><li><a asp-controller="Records" asp-action="Index">@recordsLocalizer["RecordsHeader"]</a></li><li class="active">@localizer["DeploymentReports"]</li></ol>
</div></div>
<div class="wrapper wrapper-content">
    <p class="alert alert-info">@localizer["ReportingIntro"]</p>
    <p><a class="btn btn-default" asp-action="Index" asp-route-includeClosed="@list.OpenOnly">@(list.OpenOnly ? localizer["ShowAll"] : localizer["ShowOpen"])</a>
    @if (Resgrid.Web.Helpers.ClaimsAuthorizationHelper.CanExportRecords()) { <a class="btn btn-info" asp-action="ExportSummary" asp-route-includeClosed="@(!list.OpenOnly)">@localizer["ExportSummary"]</a> }</p>
    <div class="ibox"><div class="ibox-content table-responsive">
    <table class="table table-striped"><thead><tr><th>@localizer["Name"]</th><th>@localizer["Status"]</th><th>@localizer["FinanceMode"]</th><th>@localizer["IncidentNumber"]</th><th>@localizer["Window"]</th></tr></thead><tbody>
    @foreach (var d in list.Deployments) {
        <tr><td><a asp-action="Report" asp-route-id="@d.DeploymentId">@d.Name</a></td><td>@localizer["Status" + (Resgrid.Model.Invoicing.DeploymentStatuses)d.Status]</td><td>@localizer["Finance" + (Resgrid.Model.Invoicing.DeploymentFinanceModes)d.FinanceMode]</td><td>@d.IncidentNumber</td><td>@time.Format(d.StartOn) → @time.Format(d.EndOn)</td></tr>
    }
    </tbody></table>
    @if (list.Deployments.Count == 0) { <p>@localizer["NoDeployments"]</p> }
    @if (pages > 1) { <ul class="pagination">@for (var p = 1; p <= pages; p++) { <li class="@(p == list.Page ? "active" : "")"><a asp-action="Index" asp-route-page="@p" asp-route-includeClosed="@(!list.OpenOnly)">@p</a></li> }</ul> }
    </div></div>
    @if (Model.Orders.Count > 0) {
    <div class="ibox"><div class="ibox-title"><h5>@localizer["ExternalOrders"]</h5></div><div class="ibox-content table-responsive">
        <table class="table table-striped"><thead><tr><th>@localizer["ResourceOrderNumber"]</th><th>@localizer["Name"]</th><th>@localizer["Status"]</th></tr></thead><tbody>
        @foreach (var order in Model.Orders) { <tr><td><a asp-action="Details" asp-route-id="@order.RmsExternalOrderId">@order.OrderNumber</a></td><td>@order.IncidentName</td><td>@((Resgrid.Model.RmsExternalOrderStatus)order.Status)</td></tr> }
        </tbody></table>
    </div></div> }
</div>
