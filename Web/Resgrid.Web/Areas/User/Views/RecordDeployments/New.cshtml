@using Resgrid.Model
@model Resgrid.Web.Areas.User.Models.Records.RecordDeploymentNewView
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Records.Records> localizer
@{
	ViewBag.Title = "Resgrid | " + localizer["NewDeployment"];
}

<div class="row wrapper border-bottom white-bg page-heading">
	<div class="col-sm-8">
		<h2>@localizer["NewDeployment"] <span class="label label-warning">@localizer["PreviewPack"]</span></h2>
		<ol class="breadcrumb">
			<li><a asp-controller="Home" asp-action="Dashboard" asp-route-area="User">@commonLocalizer["HomeModule"]</a></li>
			<li><a asp-controller="RecordDeployments" asp-action="Index" asp-route-area="User">@localizer["Deployments"]</a></li>
			<li class="active"><strong>@localizer["NewDeployment"]</strong></li>
		</ol>
	</div>
</div>

<div class="wrapper wrapper-content">
	@if (!string.IsNullOrEmpty(Model.ErrorMessage)) { <div class="alert alert-danger">@Model.ErrorMessage</div> }
	<div class="alert alert-info">@localizer["DeploymentPreviewStatement"]</div>
	<form class="form-horizontal" method="post" enctype="multipart/form-data" asp-controller="RecordDeployments" asp-action="New" asp-route-area="User">
		@Html.AntiForgeryToken()
		<div class="row">
			<div class="col-md-6">
				<div class="ibox">
					<div class="ibox-title"><h5>@localizer["DeploymentOrder"]</h5></div>
					<div class="ibox-content">
						<div class="form-group"><label class="col-sm-4 control-label required">@localizer["TemplateProfile"]</label><div class="col-sm-8"><select class="form-control" asp-for="ProfileKey" asp-items="Model.Profiles"></select></div></div>
						<div class="form-group"><label class="col-sm-4 control-label">@localizer["DeploymentSource"]</label><div class="col-sm-4"><input type="text" class="form-control" asp-for="SourceScheme" placeholder="iroc / ciffc / emac / local" /></div><div class="col-sm-4"><input type="text" class="form-control" asp-for="SourceSystem" placeholder="@localizer["DeploymentSourceSystem"]" /></div></div>
						<div class="form-group"><label class="col-sm-4 control-label required">@localizer["DeploymentOrderNumber"]</label><div class="col-sm-8"><input type="text" class="form-control" asp-for="OrderNumber" maxlength="100" /></div></div>
						<div class="form-group"><label class="col-sm-4 control-label required">@localizer["DeploymentIncident"]</label><div class="col-sm-5"><input type="text" class="form-control" asp-for="IncidentName" maxlength="200" /></div><div class="col-sm-3"><input type="text" class="form-control" asp-for="IncidentNumber" placeholder="#" maxlength="100" /></div></div>
						<div class="form-group"><label class="col-sm-4 control-label">@localizer["DeploymentLocation"]</label><div class="col-sm-3"><input type="text" class="form-control" asp-for="IncidentCountry" placeholder="US" maxlength="2" /></div><div class="col-sm-5"><input type="text" class="form-control" asp-for="IncidentSubdivision" placeholder="US-CA" maxlength="10" /></div></div>
						<div class="form-group"><label class="col-sm-4 control-label">@localizer["DeploymentOffices"]</label><div class="col-sm-4"><input type="text" class="form-control" asp-for="OrderingOffice" placeholder="@localizer["DeploymentOrderingOffice"]" /></div><div class="col-sm-4"><input type="text" class="form-control" asp-for="DispatchOffice" placeholder="@localizer["DeploymentDispatchOffice"]" /></div></div>
						<div class="form-group"><label class="col-sm-4 control-label">@localizer["DeploymentAgencies"]</label><div class="col-sm-8"><input type="text" class="form-control m-b-xs" asp-for="RequestingAgency" placeholder="@localizer["DeploymentRequestingAgency"]" /><input type="text" class="form-control m-b-xs" asp-for="ReceivingAgency" placeholder="@localizer["DeploymentReceivingAgency"]" /><input type="text" class="form-control" asp-for="SendingAgency" placeholder="@localizer["DeploymentSendingAgency"]" /></div></div>
						<div class="form-group"><label class="col-sm-4 control-label">@localizer["DeploymentRole"]</label><div class="col-sm-8"><select class="form-control" asp-for="DepartmentRole"><option value="filling">@localizer["DeploymentRoleFilling"]</option><option value="requesting">@localizer["DeploymentRoleRequesting"]</option><option value="host">@localizer["DeploymentRoleHost"]</option></select></div></div>
						<div class="form-group"><label class="col-sm-4 control-label">@localizer["DeploymentCost"]</label><div class="col-sm-4"><input type="text" class="form-control" asp-for="CostCode" placeholder="@localizer["DeploymentCostCode"]" /></div><div class="col-sm-4"><input type="text" class="form-control" asp-for="AgreementReference" placeholder="@localizer["DeploymentAgreement"]" /></div></div>
						<div class="form-group"><label class="col-sm-4 control-label">@localizer["DeploymentUnitsAndCurrency"]</label><div class="col-sm-3"><input type="text" class="form-control" asp-for="CurrencyCode" placeholder="USD" maxlength="3" /></div><div class="col-sm-3"><select class="form-control" asp-for="MeasurementSystem"><option value="">-</option><option value="imperial">imperial</option><option value="metric">metric</option></select></div><div class="col-sm-2"><input type="text" class="form-control" asp-for="TimeZoneId" placeholder="TZ" /></div></div>
						<div class="form-group"><label class="col-sm-4 control-label">@localizer["DeploymentArtifact"]</label><div class="col-sm-8"><input type="file" name="artifact" /><input type="text" class="form-control m-t-xs" asp-for="SourceVersion" placeholder="@localizer["DeploymentSourceVersion"]" /><input type="url" class="form-control m-t-xs" asp-for="ArtifactSafeUrl" placeholder="https://" /><span class="help-block">@localizer["DeploymentArtifactHelp"]</span></div></div>
					</div>
				</div>
			</div>
			<div class="col-md-6">
				<div class="ibox">
					<div class="ibox-title"><h5>@localizer["DeploymentFirstFill"]</h5></div>
					<div class="ibox-content">
						<p class="text-muted">@localizer["DeploymentFirstFillHelp"]</p>
						<div class="form-group"><label class="col-sm-4 control-label">@localizer["DeploymentRequestNumber"]</label><div class="col-sm-4"><input type="text" class="form-control" name="Fills[0].RequestNumber" placeholder="O-123 / C-45" /></div><div class="col-sm-4"><input type="text" class="form-control" name="Fills[0].RequestCategory" placeholder="overhead / crew / equipment" /></div></div>
						<div class="form-group"><label class="col-sm-4 control-label">@localizer["DeploymentResource"]</label><div class="col-sm-4"><select class="form-control" name="Fills[0].ResourceKind"><option value="">-</option><option value="person">person</option><option value="unit">unit</option><option value="crew">crew</option><option value="equipment">equipment</option></select></div><div class="col-sm-4"><input type="text" class="form-control" name="Fills[0].ResourceType" placeholder="Type 2 IA / Engine T3" /></div></div>
						<div class="form-group"><label class="col-sm-4 control-label">@localizer["DeploymentPosition"]</label><div class="col-sm-5"><input type="text" class="form-control" name="Fills[0].Position" placeholder="FFT1 / DIVS" /></div><div class="col-sm-3"><label><input type="checkbox" name="Fills[0].IsTrainee" value="true" /> @localizer["DeploymentTrainee"]</label></div></div>
						<div class="form-group"><label class="col-sm-4 control-label">@localizer["DeploymentAssigned"]</label><div class="col-sm-8"><select class="form-control" name="Fills[0].AssignedUserId" asp-items="Model.Personnel"><option value="">-</option></select></div></div>
						<div class="form-group"><label class="col-sm-4 control-label">@localizer["DeploymentHomeUnit"]</label><div class="col-sm-4"><input type="text" class="form-control" name="Fills[0].HomeUnit" /></div><div class="col-sm-4"><input type="text" class="form-control" name="Fills[0].HostAgency" placeholder="@localizer["DeploymentHostAgency"]" /></div></div>
						<div class="form-group"><label class="col-sm-4 control-label">@localizer["DeploymentNeededOn"]</label><div class="col-sm-8"><input type="datetime-local" class="form-control" name="Fills[0].NeededOn" /></div></div>
						<div class="form-group"><label class="col-sm-4 control-label">@commonLocalizer["Notes"]</label><div class="col-sm-8"><textarea class="form-control" rows="2" name="Fills[0].Notes"></textarea></div></div>
					</div>
				</div>
			</div>
		</div>
		<div class="ibox"><div class="ibox-content">
			<button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> @localizer["DeploymentCreate"]</button>
			<a class="btn btn-default" asp-controller="RecordDeployments" asp-action="Index" asp-route-area="User">@commonLocalizer["Cancel"]</a>
		</div></div>
	</form>
</div>
