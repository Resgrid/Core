@using Resgrid.Model
@using Resgrid.Model.Helpers
@model Resgrid.Web.Areas.User.Models.Records.RecordsSettingsView
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Records.Records> localizer
@{
	ViewBag.Title = "Resgrid | " + localizer["SettingsHeader"];
}

<div class="row wrapper border-bottom white-bg page-heading">
	<div class="col-sm-4">
		<h2>@localizer["SettingsHeader"]</h2>
		<ol class="breadcrumb">
			<li><a asp-controller="Home" asp-action="Dashboard" asp-route-area="User">@commonLocalizer["HomeModule"]</a></li>
			<li><a asp-controller="Records" asp-action="Index" asp-route-area="User">@localizer["RecordsHeader"]</a></li>
			<li class="active"><strong>@localizer["SettingsHeader"]</strong></li>
		</ol>
	</div>
</div>

<form id="records-settings-form" class="form-horizontal" method="post" asp-controller="Records" asp-action="Settings" asp-route-area="User" data-next-number-confirm="@localizer["NextNumberConfirm"]">
	@Html.AntiForgeryToken()
	<div class="row">
		<div class="col-lg-9">
			<div class="wrapper wrapper-content">
				@if (!string.IsNullOrEmpty(Model.Message))
				{
					<div class="alert alert-success">@Model.Message</div>
				}
				@if (!string.IsNullOrEmpty(Model.ErrorMessage))
				{
					<div class="alert alert-danger">@Model.ErrorMessage</div>
				}

				<div class="ibox float-e-margins">
					<div class="ibox-title"><h5>@localizer["RecordsHeader"]</h5></div>
					<div class="ibox-content">
						<div class="form-group">
							<label class="col-sm-3 control-label">@localizer["ActivatedOn"]</label>
							<div class="col-sm-9"><p class="form-control-static">@(Model.ModuleState.ActivatedOn.HasValue ? Model.ModuleState.ActivatedOn.Value.TimeConverterToString(Model.Department) : "-") @(Model.ModuleState.CutoverState.HasValue ? "(" + Model.ModuleState.CutoverState + ")" : string.Empty)</p></div>
						</div>
						<div class="form-group">
							<label class="col-sm-3 control-label">@localizer["DefaultLifecyclePreset"]</label>
							<div class="col-sm-4"><select class="form-control" asp-for="DefaultLifecyclePreset" asp-items="Model.Presets"></select></div>
						</div>
						<div class="form-group">
							<label class="col-sm-3 control-label">@localizer["ReviewDueHours"]</label>
							<div class="col-sm-2"><input type="number" min="1" max="8760" class="form-control" asp-for="ReviewDueHours" /></div>
						</div>
					</div>
				</div>

				<div class="ibox float-e-margins">
					<div class="ibox-title"><h5>@localizer["NerisWorkflowsHeader"]</h5></div>
					<div class="ibox-content">
						<p class="text-muted">@localizer["NerisWorkflowsIntro"]</p>
						<div class="form-group">
							<div class="col-sm-offset-3 col-sm-9"><label><input type="checkbox" asp-for="NerisWorkflowsEnabled" /> @localizer["NerisWorkflowsEnabled"]</label></div>
						</div>
						<p class="text-muted">@localizer["NerisWorkflowsOffHelp"]</p>
						@if (Model.NerisWorkflowsEnabled)
						{
							if (!Model.NerisSystemEnabled)
							{
								<p class="text-warning">@localizer["SystemDisabledNotice"]</p>
							}
							<p><a asp-controller="IncidentReports" asp-action="Settings" asp-route-area="User"><i class="fa fa-cog"></i> @localizer["ManageNerisProfile"]</a></p>
						}
					</div>
				</div>

				<div class="ibox float-e-margins">
					<div class="ibox-title"><h5>@localizer["Numbering"]</h5></div>
					<div class="ibox-content">
						<div class="form-group">
							<label class="col-sm-3 control-label">@localizer["NumberPattern"]</label>
							<div class="col-sm-5"><input type="text" class="form-control" maxlength="@RecordNumberFormat.MaxPatternLength" autocomplete="off" spellcheck="false" asp-for="NumberPattern" /></div>
							<div class="col-sm-4"><p class="form-control-static">@localizer["NumberPatternExample"] <code id="number-pattern-preview"></code></p></div>
						</div>
						<div class="form-group">
							<div class="col-sm-offset-3 col-sm-9"><span class="help-block">@localizer["NumberPatternHelp"]</span></div>
						</div>
						<div class="form-group">
							<label class="col-sm-3 control-label">@localizer["SequenceWidth"]</label>
							<div class="col-sm-2"><input type="number" min="@RecordNumberFormat.MinWidth" max="@RecordNumberFormat.MaxWidth" class="form-control" asp-for="SequenceWidth" /></div>
						</div>
						@{
							var recordYearStart = new NumberingYearStart(Model.NumberingYearStartMonth, Model.NumberingYearStartDay, (Resgrid.Model.NumberingYearLabel)Model.NumberingYearLabel);
							var recordYearMonths = System.Globalization.CultureInfo.CurrentUICulture.DateTimeFormat.MonthNames.Take(12)
								.Select((name, i) => new SelectListItem(name, (i + 1).ToString(System.Globalization.CultureInfo.InvariantCulture), i + 1 == recordYearStart.Month)).ToList();
						}
						<div class="form-group">
							<label class="col-sm-3 control-label" for="NumberingYearStartMonth">@localizer["NumberingYearStart"]</label>
							<div class="col-sm-9">
								<div class="numbering-year-start">
									<select class="form-control" asp-for="NumberingYearStartMonth" asp-items="recordYearMonths"></select>
									<input type="number" class="form-control numbering-year-day" min="1" max="31" asp-for="NumberingYearStartDay" aria-label="@localizer["NumberingYearStartDay"]" />
									<select class="form-control" asp-for="NumberingYearLabel" aria-label="@localizer["NumberingYearStart"]">
										<option value="@((int)Resgrid.Model.NumberingYearLabel.EndYear)">@localizer["NumberingYearLabelEndYear"]</option>
										<option value="@((int)Resgrid.Model.NumberingYearLabel.StartYear)">@localizer["NumberingYearLabelStartYear"]</option>
									</select>
								</div>
							</div>
						</div>
						<div class="form-group">
							<div class="col-sm-offset-3 col-sm-9"><span class="help-block">@localizer["NumberingYearStartHelp"]</span></div>
						</div>

						<h5>@localizer["NumberPrefixesHeader"]</h5>
						<p class="text-muted">@localizer["NumberPrefixesIntro"]</p>
						<div class="table-responsive">
							<table class="table table-condensed">
								<thead>
									<tr>
										<th>@localizer["NumberPrefixType"]</th>
										<th>@localizer["NumberPrefixDefault"]</th>
										<th style="width:25%">@localizer["DefinitionNumberPrefix"]</th>
									</tr>
								</thead>
								<tbody>
									@for (var i = 0; i < Model.NumberPrefixes.Count; i++)
									{
										<tr>
											<td>
												@Html.HiddenFor(m => m.NumberPrefixes[i].DefinitionKey)
												@Model.NumberPrefixes[i].Label
											</td>
											<td><code>@Model.NumberPrefixes[i].DefaultPrefix</code></td>
											<td><input type="text" class="form-control input-sm number-prefix-input" asp-for="NumberPrefixes[i].Prefix" maxlength="@RecordNumberFormat.MaxPrefixLength" pattern="[A-Za-z0-9]{@RecordNumberFormat.MinPrefixLength,@RecordNumberFormat.MaxPrefixLength}" title="@localizer["NumberPrefixRule"]" placeholder="@Model.NumberPrefixes[i].DefaultPrefix" autocomplete="off" spellcheck="false" style="text-transform:uppercase" data-preview-prefix="@(Model.NumberPrefixes[i].DefinitionKey == RmsDefinitionKeys.NerisIncidentReport ? "true" : "false")" aria-label="@localizer["DefinitionNumberPrefix"] @Model.NumberPrefixes[i].Label" /></td>
										</tr>
									}
								</tbody>
							</table>
						</div>

						@if (recordYearStart.IsCalendarYear)
						{
							<h5>@localizer["NextNumbersHeader", Model.NumberingYear]</h5>
						}
						else
						{
							var periodStart = recordYearStart.StartOfYear(Model.NumberingYear);
							<h5>@localizer["NextNumbersHeaderPeriod", Model.NumberingYear, periodStart.ToString("d", System.Globalization.CultureInfo.CurrentUICulture), periodStart.AddYears(1).AddDays(-1).ToString("d", System.Globalization.CultureInfo.CurrentUICulture)]</h5>
						}
						<p class="text-muted">@localizer["NextNumbersIntro"]</p>
						<input type="hidden" asp-for="NumberingYear" />
						<div class="table-responsive">
							<table class="table table-condensed">
								<thead>
									<tr>
										<th>@localizer["NextNumberSequence"]</th>
										<th>@localizer["NextNumberCurrent"]</th>
										<th style="width:25%">@localizer["NextNumberRaiseTo"]</th>
									</tr>
								</thead>
								<tbody>
									@for (var i = 0; i < Model.NextNumbers.Count; i++)
									{
										<tr>
											<td>
												@Html.HiddenFor(m => m.NextNumbers[i].ScopeKey)
												@Model.NextNumbers[i].Label
											</td>
											<td><code>@Model.NextNumbers[i].NextNumber</code></td>
											<td><input type="number" class="form-control input-sm next-number-input" asp-for="NextNumbers[i].NextSequence" min="@Model.NextNumbers[i].CurrentNextSequence" max="@RecordNumberFormat.MaxSequence" placeholder="@Model.NextNumbers[i].CurrentNextSequence" aria-label="@localizer["NextNumberRaiseTo"] @Model.NextNumbers[i].Label" /></td>
										</tr>
									}
								</tbody>
							</table>
						</div>

						<h5>@localizer["OtherNumbersHeader"]</h5>
						<p class="text-muted">@localizer["OtherNumbersIntro"]</p>
						<div class="table-responsive">
							<table class="table table-condensed">
								<thead>
									<tr>
										<th>@localizer["NumberPrefixType"]</th>
										<th style="width:28%">@localizer["NumberPattern"]</th>
										<th style="width:10%">@localizer["SequenceWidth"]</th>
										<th>@localizer["NextNumberCurrent"]</th>
										<th style="width:14%">@localizer["NextNumberRaiseTo"]</th>
									</tr>
								</thead>
								<tbody>
									@for (var i = 0; i < Model.OtherNumbers.Count; i++)
									{
										var row = Model.OtherNumbers[i];
										<tr class="other-number-row" data-legacy-pattern="@row.LegacyPattern" data-legacy-width="@row.LegacyWidth">
											<td>
												@Html.HiddenFor(m => m.OtherNumbers[i].Kind)
												@Html.HiddenFor(m => m.OtherNumbers[i].ScopeKey)
												@row.Label
											</td>
											<td>
												<input type="text" class="form-control input-sm other-number-pattern" asp-for="OtherNumbers[i].Pattern" maxlength="@CallNumberFormat.MaxPatternLength" placeholder="@row.LegacyPattern" autocomplete="off" spellcheck="false" aria-label="@localizer["NumberPattern"] @row.Label" />
												<span class="help-block m-b-none small">@localizer["NumberPatternExample"] <code class="other-number-preview"></code></span>
											</td>
											<td><input type="number" class="form-control input-sm other-number-width" asp-for="OtherNumbers[i].SequenceWidth" min="@CallNumberFormat.MinWidth" max="@CallNumberFormat.MaxWidth" aria-label="@localizer["SequenceWidth"] @row.Label" /></td>
											<td>
												@if (row.Custom)
												{
													<code>@row.NextNumber</code>
												}
												else
												{
													<span class="text-muted">@localizer["OtherNumberBuiltIn"]</span> <code>@row.Example</code>
												}
											</td>
											<td>
												@if (row.Custom)
												{
													<input type="number" class="form-control input-sm next-number-input" asp-for="OtherNumbers[i].RaiseTo" min="@row.CurrentNextSequence" max="@CallNumberFormat.MaxSequence" placeholder="@row.CurrentNextSequence" aria-label="@localizer["NextNumberRaiseTo"] @row.Label" />
												}
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					</div>
				</div>

				<div class="ibox float-e-margins">
					<div class="ibox-title"><h5>@localizer["Retention"]</h5></div>
					<div class="ibox-content">
						<p class="text-muted">@localizer["RetentionIntro"]</p>
						<div class="form-group">
							<label class="col-sm-3 control-label">@localizer["DepartmentDefaultYears"]</label>
							<div class="col-sm-2"><input type="number" min="1" max="100" class="form-control" asp-for="DepartmentDefaultYears" /></div>
						</div>
						<h5>@localizer["RetentionOverrides"]</h5>
						<table class="table table-condensed">
							<tbody>
								@for (var i = 0; i < Model.RetentionOverrides.Count; i++)
								{
									<tr>
										<td style="width:40%">
											@Html.HiddenFor(m => m.RetentionOverrides[i].DefinitionKey)
											@Html.HiddenFor(m => m.RetentionOverrides[i].Restricted)
											@Model.RetentionOverrides[i].Label
											@if (Model.RetentionOverrides[i].Restricted)
											{
												<i class="fa fa-lock text-muted" title="@localizer["RestrictedSection"]"></i>
											}
										</td>
										<td style="width:20%"><input type="number" min="0" max="100" class="form-control input-sm" asp-for="RetentionOverrides[i].RetentionYears" /></td>
										<td>
											@if (Model.RetentionOverrides[i].Restricted)
											{
												<label class="small"><input type="checkbox" asp-for="RetentionOverrides[i].ConfirmRestricted" /> @localizer["RestrictedOverrideConfirm"]</label>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>

				<div class="ibox float-e-margins">
					<div class="ibox-title"><h5>@localizer["GroupVisibility"]</h5></div>
					<div class="ibox-content">
						<div class="form-group">
							<label class="col-sm-3 control-label">@localizer["GroupVisibility"]</label>
							<div class="col-sm-4"><select class="form-control" asp-for="GroupVisibilityMode" asp-items="Model.VisibilityModes"></select></div>
						</div>
						<p class="text-muted">@localizer["GroupVisibilityNote"]</p>
						@if (Model.GroupScopePreview != null)
						{
							var preview = Model.GroupScopePreview;
							<h4>@localizer["GroupScopePreviewHeader"]</h4>
							<p class="text-muted">@localizer["GroupScopePreviewIntro"]</p>
							<dl class="dl-horizontal">
								<dt>@localizer["GroupScopeTotalRecords"]</dt><dd>@preview.TotalRecords</dd>
								<dt>@localizer["GroupScopeHiddenFromUngrouped"]</dt><dd>@preview.RecordsHiddenFromUngroupedUsers</dd>
								<dt>@localizer["GroupScopeUnanchored"]</dt><dd>@preview.RecordsWithoutGroupAnchor</dd>
								<dt>@localizer["GroupScopeUsersWithoutGroup"]</dt><dd>@preview.UsersWithoutGroup / @preview.UsersInDepartment</dd>
								<dt>@localizer["GroupScopeLegacyRows"]</dt><dd>@(preview.LegacyLogsWithoutGroup + preview.LegacyUnitLogs)</dd>
							</dl>
							@if (preview.Groups.Count > 0)
							{
								<table class="table table-condensed table-bordered">
									<thead><tr><th>@localizer["GroupScopeGroup"]</th><th>@localizer["GroupScopeMembers"]</th><th>@localizer["GroupScopeRecords"]</th></tr></thead>
									<tbody>
										@foreach (var g in preview.Groups)
										{
											<tr><td>@g.GroupName</td><td>@g.MemberCount</td><td>@g.RecordCount</td></tr>
										}
									</tbody>
								</table>
							}
							<div class="checkbox"><label><input asp-for="ConfirmGroupScoping" /> @localizer["GroupScopeConfirm"]</label></div>
						}
					</div>
				</div>

				<div class="ibox float-e-margins">
					<div class="ibox-title"><h5>@localizer["PrintLayoutHeader"]</h5></div>
					<div class="ibox-content">
						<p class="text-muted">@localizer["PrintLayoutIntro"] <a asp-controller="Department" asp-action="Profile" asp-route-area="User">@localizer["ManageDepartmentProfile"]</a></p>
						@if (!Model.HasLogo)
						{
							<p class="text-warning">@localizer["NoLogoNotice"]</p>
						}
						<div class="form-group">
							<div class="col-sm-9 col-sm-offset-3">
								<div class="checkbox"><label><input asp-for="PrintLayout.ShowLogo" /> @localizer["PrintShowLogo"]</label></div>
								<div class="checkbox"><label><input asp-for="PrintLayout.UseShortName" /> @localizer["PrintUseShortName"]</label></div>
								<div class="checkbox"><label><input asp-for="PrintLayout.ShowAddress" /> @localizer["PrintShowAddress"]</label></div>
								<div class="checkbox"><label><input asp-for="PrintLayout.ShowPhone" /> @localizer["PrintShowPhone"]</label></div>
								<div class="checkbox"><label><input asp-for="PrintLayout.ShowWebsite" /> @localizer["PrintShowWebsite"]</label></div>
							</div>
						</div>
						<div class="form-group">
							<label class="col-sm-3 control-label">@localizer["PrintLetterheadLine1"]</label>
							<div class="col-sm-9"><input asp-for="PrintLayout.LetterheadLine1" class="form-control" maxlength="200" /></div>
						</div>
						<div class="form-group">
							<label class="col-sm-3 control-label">@localizer["PrintLetterheadLine2"]</label>
							<div class="col-sm-9"><input asp-for="PrintLayout.LetterheadLine2" class="form-control" maxlength="200" /></div>
						</div>
						<div class="form-group">
							<label class="col-sm-3 control-label">@localizer["PrintFooterText"]</label>
							<div class="col-sm-9"><textarea asp-for="PrintLayout.FooterText" class="form-control" rows="2" maxlength="500"></textarea></div>
						</div>
						<div class="form-group">
							<label class="col-sm-3 control-label">@localizer["PrintWatermark"]</label>
							<div class="col-sm-4"><input asp-for="PrintLayout.WatermarkLabel" class="form-control" maxlength="40" /></div>
						</div>
						<div class="form-group">
							<label class="col-sm-3 control-label">@localizer["PrintPageSize"]</label>
							<div class="col-sm-3">
								<select asp-for="PrintLayout.PageSize" class="form-control">
									@foreach (var size in RecordsPrintLayoutConfig.PageSizes)
									{
										<option value="@size" selected="@(size == Model.PrintLayout.PageSize)">@size</option>
									}
								</select>
							</div>
						</div>
						<div class="form-group">
							<label class="col-sm-3 control-label">@localizer["PrintDateTimeFormat"]</label>
							<div class="col-sm-4"><input asp-for="PrintLayout.DateTimeFormat" class="form-control" maxlength="40" /></div>
							<div class="col-sm-5"><span class="help-block">@localizer["PrintDateTimeFormatHelp"]</span></div>
						</div>
						<p class="text-muted">@localizer["PrintLayoutVersionLabel"]: @Model.PrintLayoutVersion</p>
					</div>
				</div>

				<div class="ibox float-e-margins">
					<div class="ibox-title"><h5>@localizer["DisclosureSettingsHeader"]</h5></div>
					<div class="ibox-content">
						<p class="text-muted">@localizer["DisclosureSettingsIntro"]</p>
						<div class="form-group">
							<label class="col-sm-3 control-label">@localizer["StatutoryClockDays"]</label>
							<div class="col-sm-2"><input type="number" min="1" max="365" class="form-control" asp-for="DisclosureStatutoryClockDays" /></div>
							<div class="col-sm-7"><span class="help-block">@localizer["StatutoryClockDaysHelp"]</span></div>
						</div>
						<div class="form-group">
							<label class="col-sm-3 control-label">@localizer["DefaultRedactionProfile"]</label>
							<div class="col-sm-4"><select class="form-control" asp-for="DisclosureDefaultRedactionProfile" asp-items="Model.RedactionProfiles"></select></div>
							<div class="col-sm-5"><span class="help-block">@localizer["DefaultRedactionProfileHelp"]</span></div>
						</div>
						<div class="form-group">
							<label class="col-sm-3 control-label">@localizer["DisclosureReleaseApprover"]</label>
							<div class="col-sm-4"><select class="form-control" asp-for="DisclosureReleaseApproverUserId" asp-items="Model.ReleaseApprovers"></select></div>
							<div class="col-sm-5"><span class="help-block">@localizer["DisclosureReleaseApproverHelp"]</span></div>
						</div>
					</div>
				</div>

				<div class="ibox float-e-margins">
					<div class="ibox-title"><h5>@localizer["SearchIndexStatus"]</h5></div>
					<div class="ibox-content">
						<dl class="dl-horizontal">
							<dt>@localizer["SearchIndexStatus"]</dt><dd>@(Model.SearchHealth == null || !Model.SearchHealth.Enabled ? localizer["SearchDisabled"] : Model.SearchHealth.Online ? localizer["SearchOnline"] : localizer["SearchOffline"])</dd>
							@if (Model.SearchHealth != null && Model.SearchHealth.Online)
							{
								<dt>@localizer["SearchDocuments"]</dt><dd>@Model.SearchHealth.DocumentCount</dd>
							}
							<dt>@localizer["Narrative"]</dt><dd>@(Model.NarrativeSearchAvailable ? localizer["NarrativeSearchOn"] : localizer["NarrativeSearchOff"])</dd>
						</dl>
						<p class="text-muted">@localizer["SearchIndexNote"]</p>
					</div>
				</div>

				<div class="ibox float-e-margins">
					<div class="ibox-content">
						<button type="submit" class="btn btn-primary">@localizer["Save"]</button>
						<a class="btn btn-default" asp-controller="Records" asp-action="Index" asp-route-area="User">@commonLocalizer["Cancel"]</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</form>

@section Scripts {
	<script type="text/javascript">
		(function () {
			var pattern = $('#NumberPattern'), width = $('#SequenceWidth'), preview = $('#number-pattern-preview');
			var samplePrefix = $('.number-prefix-input[data-preview-prefix="true"]');
			var startMonth = $('#NumberingYearStartMonth'), startDay = $('#NumberingYearStartDay'), yearLabel = $('#NumberingYearLabel');
			var today = { y: @Model.NumberingPreviewDate.Year, m: @Model.NumberingPreviewDate.Month, d: @Model.NumberingPreviewDate.Day };
			// Mirrors NumberingYearStart.YearOf: the year naming today's numbering year under the year start being edited.
			function numberingYear() {
				var m = parseInt(startMonth.val(), 10) || 1, d = parseInt(startDay.val(), 10) || 1;
				var startYear = today.m > m || (today.m === m && today.d >= d) ? today.y : today.y - 1;
				return (m === 1 && d === 1) || yearLabel.val() === '@((int)Resgrid.Model.NumberingYearLabel.StartYear)' ? startYear : startYear + 1;
			}
			// A sample only: the server validates the pattern and renders the real numbers listed below it.
			function render() {
				var digits = Math.max(@RecordNumberFormat.MinWidth, Math.min(@RecordNumberFormat.MaxWidth, parseInt(width.val(), 10) || @RecordNumberFormat.DefaultWidth));
				var prefix = ($.trim(samplePrefix.val() || '') || samplePrefix.attr('placeholder') || 'INC').toUpperCase();
				var year = String(numberingYear());
				preview.text((pattern.val() || '')
					.replace(/\{PREFIX\}/gi, prefix).replace(/\{YYYY\}/gi, year).replace(/\{YY\}/gi, year.slice(-2))
					.replace(/\{GROUP\}/gi, 'G12').replace(/\{SEQ\}/gi, ('00000000' + '153').slice(-digits)));
				// Which year names a fiscal year only matters when it does not start on January 1.
				yearLabel.toggle(!(startMonth.val() === '1' && (parseInt(startDay.val(), 10) || 1) === 1));
				// The other Records numbers, in their own pattern or the built-in one.
				$('.other-number-row').each(function () {
					var row = $(this), input = row.find('.other-number-pattern');
					var text = $.trim(input.val()) || String(row.data('legacy-pattern'));
					var otherDigits = Math.max(@CallNumberFormat.MinWidth, Math.min(@CallNumberFormat.MaxWidth, ($.trim(input.val()) ? parseInt(row.find('.other-number-width').val(), 10) : parseInt(row.data('legacy-width'), 10)) || @CallNumberFormat.DefaultWidth));
					var otherYear = /\{(MM|DD)\}/i.test(text) ? String(today.y) : year;
					row.find('.other-number-preview').text(text
						.replace(/\{YYYY\}/gi, otherYear).replace(/\{YY\}/gi, otherYear.slice(-2))
						.replace(/\{MM\}/gi, ('0' + today.m).slice(-2)).replace(/\{DD\}/gi, ('0' + today.d).slice(-2))
						.replace(/\{SEQ\}/gi, ('00000000' + '153').slice(-otherDigits)));
				});
			}
			pattern.on('input', render);
			width.on('input', render);
			samplePrefix.on('input', render);
			$('.other-number-pattern, .other-number-width').on('input', render);
			startMonth.on('change', render);
			startDay.on('input', render);
			yearLabel.on('change', render);
			render();

			$('#records-settings-form').on('submit', function (e) {
				var raised = $('.next-number-input').filter(function () { return this.value !== ''; }).length;
				if (raised > 0 && !window.confirm($(this).data('next-number-confirm')))
					e.preventDefault();
			});
		})();
	</script>
}
