@using Resgrid.Model
@using Resgrid.Web.Areas.User.Models.Records
@model RecordsWorkloadView
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Records.Records> L
@{
	ViewBag.Title = "Resgrid | " + L["AnalyticsHeader"] + " - " + L["AnalyticsWorkload"];
	var w = Model.Workload;
	var max = w == null || w.ByWeekdayHour.Count == 0 ? 0 : w.ByWeekdayHour.Max(c => c.Count);
	var days = System.Globalization.CultureInfo.CurrentUICulture.DateTimeFormat.AbbreviatedDayNames;
}
@await Html.PartialAsync("_AnalyticsShell", Model)
<div class="wrapper wrapper-content" style="padding-top:0">
	@if (w != null)
	{
		<div class="ibox"><div class="ibox-content">
			<div class="row">
				<div class="col-md-2 col-sm-4 col-xs-6 rms-kpi"><div class="value">@w.RecordsFinalized</div><div class="label">@L["AnalyticsRecordsFinalized"]</div></div>
				<div class="col-md-2 col-sm-4 col-xs-6 rms-kpi"><div class="value">@w.IncidentReportsFinalized</div><div class="label">@L["AnalyticsIncidentReports"]</div></div>
				<div class="col-md-2 col-sm-4 col-xs-6 rms-kpi"><div class="value">@RmsAnalyticsDisplay.Hours(w.RecordHours)</div><div class="label">@L["AnalyticsRecordHours"]</div></div>
				<div class="col-md-2 col-sm-4 col-xs-6 rms-kpi"><div class="value">@RmsAnalyticsDisplay.Hours(w.PersonnelHours)</div><div class="label">@L["AnalyticsPersonnelHours"]</div></div>
				<div class="col-md-2 col-sm-4 col-xs-6 rms-kpi"><div class="value">@RmsAnalyticsDisplay.Hours(w.TrainingHours)</div><div class="label">@L["AnalyticsTrainingHours"]</div></div>
				<div class="col-md-2 col-sm-4 col-xs-6 rms-kpi"><div class="value">@w.UnitResponses</div><div class="label">@L["AnalyticsResponses"]</div><small class="text-muted">@RmsAnalyticsDisplay.Hours(w.UnitOnSceneHours) @L["AnalyticsUnitOnSceneHours"]</small></div>
			</div>
		</div></div>
		<div class="row">
			<div class="col-md-6">@await Html.PartialAsync("_AnalyticsCounts", w.ByMonth, new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData) { { "Title", L["AnalyticsByMonth"].Value }, { "Chart", "bar" }, { "ShowHours", true }, { "Take", 24 } })</div>
			<div class="col-md-6">@await Html.PartialAsync("_AnalyticsCounts", w.ByDefinition, new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData) { { "Title", L["ByDefinition"].Value }, { "Chart", "doughnut" }, { "ShowHours", true } })</div>
		</div>
		<div class="ibox"><div class="ibox-title"><h5>@L["AnalyticsHeatMap"]</h5></div><div class="ibox-content">
			@if (max == 0) { <p class="text-muted">@L["AnalyticsNoData"]</p> }
			else
			{
				<table class="rms-heat">
					<thead><tr><th></th>@for (var h = 0; h < 24; h++) { <th>@h</th> }</tr></thead>
					<tbody>
						@for (var d = 0; d < 7; d++)
						{
							<tr><th>@days[d]</th>@for (var h = 0; h < 24; h++) { var cell = w.ByWeekdayHour.FirstOrDefault(c => c.Weekday == d && c.Hour == h); var n = cell?.Count ?? 0; <td class="@RmsAnalyticsDisplay.Heat(n, max)" title="@n">@(n == 0 ? "" : n.ToString())</td> }</tr>
						}
					</tbody>
				</table>
			}
		</div></div>
		<div class="row">
			<div class="col-md-4">@await Html.PartialAsync("_AnalyticsCounts", w.ByPerson, new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData) { { "Title", L["AnalyticsByPerson"].Value }, { "ShowHours", true }, { "Take", 25 } })</div>
			<div class="col-md-4">@await Html.PartialAsync("_AnalyticsCounts", w.ByUnit, new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData) { { "Title", L["ByUnit"].Value }, { "Chart", "bar" }, { "ShowHours", true }, { "Take", 25 } })</div>
			<div class="col-md-4">
				@await Html.PartialAsync("_AnalyticsCounts", w.ByAuthor, new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData) { { "Title", L["ByAuthor"].Value }, { "ShowHours", true }, { "Take", 25 } })
				@await Html.PartialAsync("_AnalyticsCounts", w.ByStationGroup, new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData) { { "Title", L["AnalyticsByStationGroup"].Value }, { "ShowHours", true } })
			</div>
		</div>
	}
</div>
