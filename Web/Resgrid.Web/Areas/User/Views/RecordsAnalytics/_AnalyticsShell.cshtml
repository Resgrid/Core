@using Resgrid.Model
@using Resgrid.Web.Areas.User.Models.Records
@model RecordsAnalyticsBaseView
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Records.Records> L
@{
	// Action, icon, caption, and which of the filters that action accepts, so switching tabs carries the filter
	// state across instead of silently resetting it to the defaults.
	var tabs = new[]
	{
		("Index", "fa-tachometer", L["AnalyticsExecutive"].Value, true, false),
		("ResponsePerformance", "fa-clock-o", L["AnalyticsResponse"].Value, true, true),
		("Workload", "fa-tasks", L["AnalyticsWorkload"].Value, true, false),
		("Accreditation", "fa-certificate", L["AnalyticsAccreditation"].Value, false, true),
		("CommunityRisk", "fa-shield", L["AnalyticsCommunityRisk"].Value, false, false),
		("Readiness", "fa-truck", L["ReadinessHeader"].Value, false, false)
	};
	var result = Model.Result;
}
<div class="row wrapper border-bottom white-bg page-heading">
	<div class="col-sm-12">
		<h2>@L["AnalyticsHeader"]</h2>
		<ol class="breadcrumb">
			<li><a asp-controller="Home" asp-action="Dashboard" asp-route-area="User">@commonLocalizer["HomeModule"]</a></li>
			<li><a asp-controller="Records" asp-action="Index" asp-route-area="User">@L["RecordsHeader"]</a></li>
			<li class="active"><strong>@L["AnalyticsHeader"]</strong></li>
		</ol>
	</div>
</div>
<div class="wrapper wrapper-content">
	<div class="tabs-container">
		<ul class="nav nav-tabs">
			@foreach (var tab in tabs)
			{
				<li class="@(Model.Action == tab.Item1 ? "active" : "")"><a asp-controller="RecordsAnalytics" asp-action="@tab.Item1" asp-route-area="User" asp-route-start="@Model.Start.ToString("yyyy-MM-dd")" asp-route-end="@Model.End.ToString("yyyy-MM-dd")" asp-route-stationGroupId="@Model.StationGroupId" asp-route-definitionKey="@(tab.Item4 ? Model.DefinitionKey : null)" asp-route-turnoutTargetSeconds="@(tab.Item5 ? (int?)Model.TurnoutTargetSeconds : null)" asp-route-travelTargetSeconds="@(tab.Item5 ? (int?)Model.TravelTargetSeconds : null)"><i class="fa @tab.Item2"></i> @tab.Item3</a></li>
			}
		</ul>
	</div>
	<div class="ibox m-t-sm"><div class="ibox-content">
		<form method="get" class="form-inline" asp-controller="RecordsAnalytics" asp-action="@Model.Action" asp-route-area="User">
			<label>@L["AnalyticsFrom"]</label> <input type="date" class="form-control input-sm" name="start" value="@Model.Start.ToString("yyyy-MM-dd")" />
			<label class="m-l-sm">@L["AnalyticsTo"]</label> <input type="date" class="form-control input-sm" name="end" value="@Model.End.ToString("yyyy-MM-dd")" />
			<label class="m-l-sm">@L["Station"]</label> <select class="form-control input-sm" name="stationGroupId" asp-items="Model.Groups"></select>
			@if (Model.ShowDefinitionFilter)
			{
				<label class="m-l-sm">@L["Definition"]</label> <select class="form-control input-sm" name="definitionKey" asp-items="Model.Definitions"></select>
			}
			@if (Model.ShowTargets)
			{
				<label class="m-l-sm">@L["AnalyticsTurnoutTarget"]</label> <input type="number" class="form-control input-sm" style="width:80px" name="turnoutTargetSeconds" min="0" max="3600" value="@Model.TurnoutTargetSeconds" />
				<label class="m-l-sm">@L["AnalyticsTravelTarget"]</label> <input type="number" class="form-control input-sm" style="width:80px" name="travelTargetSeconds" min="0" max="7200" value="@Model.TravelTargetSeconds" />
			}
			<button class="btn btn-sm btn-primary m-l-sm">@L["Filter"]</button>
			@if (result != null) { <span class="text-muted m-l-sm">@L["GeneratedOn"] @RmsEnumDisplay.Utc(result.GeneratedOn) · @L["AnalyticsRecordsRead"]: @result.RecordsRead</span> }
		</form>
		<p class="text-muted m-t-sm m-b-none">@L["AnalyticsIntro"]</p>
	</div></div>
	@if (result != null)
	{
		if (result.GroupScoped) { <div class="alert alert-info"><i class="fa fa-users"></i> @L["AnalyticsGroupScoped"]</div> }
		foreach (var w in result.Warnings) { <div class="alert alert-warning">@w</div> }
	}
	@if (!string.IsNullOrEmpty(Model.ErrorMessage)) { <div class="alert alert-danger">@Model.ErrorMessage</div> }
</div>
<script>
	// One helper for every analytics chart; Chart.js is loaded by the user layout.
	window.rmsChart = function (id, labels, values, type, label, color) {
		var el = document.getElementById(id); if (!el || !window.Chart) return;
		new Chart(el, { type: type || 'bar', data: { labels: labels, datasets: [{ label: label || '', data: values, backgroundColor: color || 'rgba(26,179,148,0.7)', borderColor: 'rgba(26,179,148,1)', fill: type === 'line' ? false : true, tension: 0.3 }] },
			options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: type === 'doughnut' ? {} : { y: { beginAtZero: true }, x: { ticks: { maxRotation: 45, autoSkip: true } } } } });
	};
</script>
