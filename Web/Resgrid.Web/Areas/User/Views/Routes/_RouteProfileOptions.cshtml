@model Resgrid.Web.Areas.User.Models.Routes.IRouteEditorModel
@using Resgrid.Model
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Routes.Routes> localizer
@{
    // Routing profile and roads to avoid (maplibre-mapping-routing-navigation-plan.md §10.6). Driving with traffic is
    // offered only where the routing provider has live traffic, unless the plan already uses it.
    var profile = Model.Plan?.RoutingProfile ?? 0;
    var avoid = Model.Plan?.AvoidOptions ?? 0;
    var avoidOptions = new[]
    {
        (Flag: RouteAvoidOptions.Tolls, Label: "AvoidTolls"),
        (Flag: RouteAvoidOptions.Highways, Label: "AvoidHighways"),
        (Flag: RouteAvoidOptions.Ferries, Label: "AvoidFerries"),
        (Flag: RouteAvoidOptions.Unpaved, Label: "AvoidUnpaved")
    };
}
<div class="form-group">
    <label class="col-sm-2 control-label" asp-for="Plan.RoutingProfile">@localizer["RouteProfile"]</label>
    <div class="col-sm-4">
        <select class="form-control" asp-for="Plan.RoutingProfile">
            <option value="@((int)RoutingProfile.Driving)">@localizer["ProfileDriving"]</option>
            @if (Model.Editor.TrafficAvailable || profile == (int)RoutingProfile.DrivingTraffic)
            {
                <option value="@((int)RoutingProfile.DrivingTraffic)">@localizer["ProfileDrivingTraffic"]@(Model.Editor.TrafficAvailable ? "" : " " + localizer["ProfileTrafficUnavailable"].Value)</option>
            }
            <option value="@((int)RoutingProfile.Truck)">@localizer["ProfileTruck"]</option>
            <option value="@((int)RoutingProfile.Walking)">@localizer["ProfileWalking"]</option>
            <option value="@((int)RoutingProfile.Cycling)">@localizer["ProfileCycling"]</option>
        </select>
        <div id="truckInfo" class="help-block m-b-none" style="display:none;"></div>
    </div>
</div>

<div class="form-group">
    <label class="col-sm-2 control-label">@localizer["AvoidLabel"]</label>
    <div class="col-sm-10">
        <input type="hidden" asp-for="Plan.AvoidOptions" />
        @foreach (var option in avoidOptions)
        {
            <label class="checkbox-inline">
                <input type="checkbox" class="route-avoid" data-flag="@((int)option.Flag)" checked="@((avoid & (int)option.Flag) != 0)" /> @localizer[option.Label]
            </label>
        }
    </div>
</div>
