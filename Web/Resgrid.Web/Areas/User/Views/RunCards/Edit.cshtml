@model Resgrid.Web.Areas.User.Models.RunCards.EditRunCardModel
@using Newtonsoft.Json
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Department.Department> localizer
@{
    ViewBag.Title = "Resgrid | " + localizer["RunCardsHeader"];

    // Both payloads are emitted through Html.Raw into a script block and carry
    // admin-entered free text (card/level names, type and role names, status button
    // text), so escape HTML-significant characters to keep a name like "</script>"
    // from breaking out of the block.
    var jsonSettings = new JsonSerializerSettings { StringEscapeHandling = StringEscapeHandling.EscapeHtml };

    var cardJson = JsonConvert.SerializeObject(new
    {
        runCardId = Model.RunCard.RunCardId,
        name = Model.RunCard.Name,
        description = Model.RunCard.Description,
        isDisabled = Model.RunCard.IsDisabled,
        dispatchModeOverride = Model.RunCard.DispatchModeOverride,
        autoDispatchOverride = Model.RunCard.AutoDispatchOverride,
        minimumStaffingLevelOverride = Model.RunCard.MinimumStaffingLevelOverride,
        homeStationGroupId = Model.RunCard.HomeStationGroupId,
        relaxUnfilledRows = Model.RunCard.RelaxUnfilledRows,
        waitingCallAutoDispatchOverride = Model.RunCard.WaitingCallAutoDispatchOverride,
        triggers = (Model.RunCard.Triggers ?? new List<Resgrid.Model.RunCardTrigger>()).Select(t => new
        {
            runCardTriggerId = t.RunCardTriggerId,
            triggerType = t.TriggerType,
            priority = t.Priority,
            callTypeId = t.CallTypeId
        }),
        alarmLevels = (Model.RunCard.AlarmLevels ?? new List<Resgrid.Model.RunCardAlarmLevel>()).Select(l => new
        {
            runCardAlarmLevelId = l.RunCardAlarmLevelId,
            alarmLevel = l.AlarmLevel,
            name = l.Name,
            responsePackageId = l.ResponsePackageId,
            decisionNodes = (l.DecisionNodes ?? new List<Resgrid.Model.RunCardDecisionNode>()).OrderBy(n => n.SortOrder).Select(n => new
            {
                nodeKey = n.NodeKey,
                isRoot = n.IsRoot,
                nodeKind = n.NodeKind,
                label = n.Label,
                conditionType = n.ConditionType,
                subjectStatusFilter = n.SubjectStatusFilter,
                subjectStatusBaseTypes = n.SubjectStatusBaseTypes,
                referenceStatusFilter = n.ReferenceStatusFilter,
                referenceStatusBaseTypes = n.ReferenceStatusBaseTypes,
                thresholdSeconds = n.ThresholdSeconds,
                requiredCount = n.RequiredCount,
                yesNodeKey = n.YesNodeKey,
                noNodeKey = n.NoNodeKey,
                responsePackageId = n.ResponsePackageId,
                adviceText = n.AdviceText,
                subjectTargets = (n.SubjectTargets ?? new List<Resgrid.Model.RunCardTarget>()).Select(x => new { targetKind = x.TargetKind, targetRefId = x.TargetRefId }),
                referenceTargets = (n.ReferenceTargets ?? new List<Resgrid.Model.RunCardTarget>()).Select(x => new { targetKind = x.TargetKind, targetRefId = x.TargetRefId })
            }),
            unitRequirements = (l.UnitRequirements ?? new List<Resgrid.Model.RunCardUnitRequirement>()).Select(r => new
            {
                runCardUnitRequirementId = r.RunCardUnitRequirementId,
                unitTypeId = r.UnitTypeId,
                requiredCount = r.RequiredCount
            }),
            roleRequirements = (l.RoleRequirements ?? new List<Resgrid.Model.RunCardRoleRequirement>()).Select(r => new
            {
                runCardRoleRequirementId = r.RunCardRoleRequirementId,
                personnelRoleId = r.PersonnelRoleId,
                requiredCount = r.RequiredCount
            })
        }),
        selections = (Model.RunCard.AvailabilitySelections ?? new List<Resgrid.Model.RunCardAvailabilitySelection>()).Select(s => new
        {
            runCardAvailabilitySelectionId = s.RunCardAvailabilitySelectionId,
            selectionType = s.SelectionType,
            unitTypeId = s.UnitTypeId,
            isCustomState = s.IsCustomState,
            stateId = s.StateId
        })
    }, jsonSettings);

    Func<Resgrid.Web.Areas.User.Models.RunCards.StatusOptionModel, object> statusOption = o => new
    {
        stateId = o.StateId,
        isCustomState = o.IsCustomState,
        text = o.Text,
        isMeaning = o.IsMeaning,
        meaningName = o.MeaningName,
        availability = o.Availability
    };

    var lookupsJson = JsonConvert.SerializeObject(new
    {
        priorities = Model.CallPriorities.Items.Cast<Resgrid.Model.DepartmentCallPriority>().Select(p => new { id = p.DepartmentCallPriorityId, name = p.Name }),
        callTypes = Model.CallTypes.Select(t => new { id = t.CallTypeId, name = t.Type }),
        stations = Model.StationGroups.Select(s => new { id = s.DepartmentGroupId, name = s.Name }),
        unitTypes = Model.UnitTypes.Select(t => new { id = t.UnitTypeId, name = t.Type }),
        roles = Model.PersonnelRoles.Select(r => new { id = r.PersonnelRoleId, name = r.Name }),
        unitStatusOptions = Model.UnitStatusOptions.ToDictionary(kv => kv.Key.ToString(), kv => kv.Value.Select(statusOption)),
        unitMeaningOptions = Model.UnitMeaningOptions.Select(statusOption),
        personnelStatusOptions = Model.PersonnelStatusOptions.Select(statusOption),
        staffingOptions = Model.StaffingOptions.Select(statusOption),
        conditionsEnabled = Model.ConditionsEnabled,
        packages = Model.ResponsePackages.Select(p => new { id = p.ResponsePackageId, name = p.IsRetired ? p.Name + " (" + localizer["ResponsePackageRetiredBadge"].Value + ")" : p.Name }),
        unitClasses = Enum.GetValues(typeof(Resgrid.Model.UnitTypeClasses)).Cast<Resgrid.Model.UnitTypeClasses>().Where(c => c != Resgrid.Model.UnitTypeClasses.None)
            .Select(c => new { id = (int)c, name = localizer["RunCardTargetAnyClass", Resgrid.Framework.StringHelpers.GetDisplayString(c)].Value }),
        baseTypes = Enum.GetValues(typeof(Resgrid.Model.ActionBaseTypes)).Cast<Resgrid.Model.ActionBaseTypes>().Where(b => b != Resgrid.Model.ActionBaseTypes.None)
            .Select(b => new { id = (int)b, name = Resgrid.Framework.StringHelpers.GetDisplayString(b) })
    }, jsonSettings);
}

@section Styles
{
    <style>
        #tab-selections .rc-guide { margin-bottom: 18px; padding: 12px 16px; border: 1px solid #d6e9f5; border-left: 4px solid #23c6c8; border-radius: 4px; background: #f4f9fc; }
        #tab-selections .rc-guide h4 { margin: 0 0 6px 0; }
        #tab-selections .rc-guide ul { margin: 0; padding-left: 18px; }
        #tab-selections .rc-guide li { margin-bottom: 3px; }
        #tab-selections .rc-section { margin-bottom: 16px; border: 1px solid #e7eaec; border-radius: 4px; }
        #tab-selections .rc-section-head { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding: 10px 14px; border-bottom: 1px solid #e7eaec; background: #f9fafb; }
        #tab-selections .rc-section-head h4 { flex: 1 1 auto; margin: 0; }
        #tab-selections .rc-section-body { padding: 12px 14px; }
        #tab-selections .rc-help { margin-bottom: 10px; color: #676a6c; }
        #tab-selections .rc-subsection, #tab-selections .rc-unit-body { padding: 10px 12px; border: 1px solid #eef0f2; border-radius: 4px; background: #fbfcfd; }
        #tab-selections .rc-subsection-head { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-bottom: 4px; }
        #tab-selections .rc-actions { margin-left: auto; }
        #tab-selections .rc-actions .btn { margin: 0 0 0 4px; }
        #tab-selections .rc-group + .rc-group { margin-top: 12px; }
        #tab-selections .rc-group-title { margin-bottom: 6px; font-weight: 600; }
        #tab-selections .rc-group-title small { margin-left: 6px; font-weight: 400; color: #999; }
        #tab-selections .rc-cols { display: flex; flex-wrap: wrap; gap: 12px; }
        #tab-selections .rc-col { flex: 1 1 200px; min-width: 180px; }
        #tab-selections .rc-col-title { margin-bottom: 6px; font-size: 12px; font-weight: 600; }
        #tab-selections .rc-col-title small { display: block; font-weight: 400; color: #999; }
        #tab-selections .rc-col--available .rc-col-title { color: #18a689; }
        #tab-selections .rc-col--busy .rc-col-title { color: #c27c0e; }
        #tab-selections .rc-col--unavailable .rc-col-title { color: #a94442; }
        #tab-selections .rc-option { display: flex; align-items: center; gap: 8px; margin: 0 0 4px 0; padding: 4px 8px; border: 1px solid #e7eaec; border-radius: 4px; background: #fff; font-weight: 400; cursor: pointer; }
        #tab-selections .rc-option:hover { border-color: #c4c9cc; }
        #tab-selections .rc-option.is-on { border-color: #1ab394; background: #e8f7f3; }
        #tab-selections .rc-option input { margin: 0; }
        #tab-selections .rc-unit-row { padding: 8px 0; border-top: 1px solid #f0f0f0; }
        #tab-selections .rc-unit-row-head { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
        #tab-selections .rc-unit-name { min-width: 140px; font-weight: 600; }
        #tab-selections .rc-unit-state { flex: 1 1 auto; color: #676a6c; }
        #tab-selections .rc-unit-body { margin-top: 8px; }
        #tab-selections .rc-unit-body .rc-actions { display: block; margin: 0 0 10px 0; }
        #tab-selections .rc-unit-body .rc-actions .btn { margin: 0 4px 0 0; }
    </style>
}

<div class="row wrapper border-bottom white-bg page-heading">
    <div class="col-sm-8">
        <h2>@(Model.IsNew ? localizer["NewRunCardButton"] : Model.RunCard.Name)</h2>
        <ol class="breadcrumb">
            <li><a asp-controller="Home" asp-action="Dashboard" asp-route-area="User">@commonLocalizer["HomeModule"]</a></li>
            <li><a asp-controller="RunCards" asp-action="Index" asp-route-area="User">@localizer["RunCardsHeader"]</a></li>
            <li class="active"><strong>@(Model.IsNew ? localizer["NewRunCardButton"] : Model.RunCard.Name)</strong></li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="col-xs-12">
        <div class="wrapper wrapper-content">
            <div class="ibox float-e-margins">
                <div class="ibox-content">
                    <div class="alert alert-danger" id="saveError" style="display: none"></div>
                    @if (TempData["TemplateApplied"] != null)
                    {
                        <div class="alert alert-info">@localizer["RunCardTemplateAppliedMessage"]</div>
                    }
                    <div class="alert alert-success" id="saveSuccess" style="display: none">@localizer["RunCardSavedMessage"]</div>
                    @if (Model.RemovedReferenceCount > 0)
                    {
                        <div class="alert alert-warning">@localizer["RunCardDetachedReferencesRemoved", Model.RemovedReferenceCount]</div>
                    }

                    <div class="alert alert-warning" id="triggerRequired" role="alert" style="display: none">@localizer["RunCardTriggerRequired"]</div>

                    <div class="tabs-container">
                        <ul class="nav nav-tabs">
                            <li class="active"><a data-toggle="tab" href="#tab-general">@localizer["RunCardGeneralTab"]</a></li>
                            <li><a data-toggle="tab" href="#tab-triggers">@localizer["RunCardTriggersHeader"]</a></li>
                            <li><a data-toggle="tab" href="#tab-alarms">@localizer["RunCardAlarmLevelsHeader"]</a></li>
                            <li><a data-toggle="tab" href="#tab-selections">@localizer["RunCardSelectionsHeader"]</a></li>
                            <li><a data-toggle="tab" href="#tab-test">@localizer["RunCardTestHeader"]</a></li>
                        </ul>
                        <div class="tab-content">
                            <div id="tab-general" class="tab-pane active">
                                <div class="panel-body form-horizontal">
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">@localizer["RunCardNameLabel"]</label>
                                        <div class="col-sm-9"><input type="text" id="cardName" class="form-control" maxlength="100" /></div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">@localizer["RunCardDescriptionLabel"]</label>
                                        <div class="col-sm-9"><input type="text" id="cardDescription" class="form-control" maxlength="500" /></div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">@localizer["RunCardDisabledLabel"]</label>
                                        <div class="col-sm-9"><input type="checkbox" id="cardDisabled" /></div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">@localizer["DispatchRecommendationModeLabel"]</label>
                                        <div class="col-sm-9">
                                            <select id="cardModeOverride" class="form-control" style="width: 70%">
                                                <option value="">@localizer["RunCardDefaultLabel"]</option>
                                                <option value="0">@localizer["RunCardManualOnlyLabel"]</option>
                                                <option value="1">Station Based</option>
                                                <option value="2">Closest Unit</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">@localizer["DispatchAutoDispatchLabel"]</label>
                                        <div class="col-sm-9">
                                            <select id="cardAutoOverride" class="form-control" style="width: 70%">
                                                <option value="">@localizer["RunCardDefaultLabel"]</option>
                                                <option value="0">@localizer["RunCardPrePopulateLabel"]</option>
                                                <option value="1">@localizer["RunCardAutoDispatchOptionLabel"]</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">@localizer["StaffingGateLabel"]</label>
                                        <div class="col-sm-9">
                                            <select id="cardStaffingOverride" class="form-control" style="width: 70%">
                                                <option value="">@localizer["RunCardDefaultLabel"]</option>
                                                <option value="0">@localizer["RunCardNoGateLabel"]</option>
                                                <option value="2">Partially Staffed</option>
                                                <option value="3">Degraded</option>
                                                <option value="4">Fully Staffed</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">@localizer["RunCardHomeStationLabel"]</label>
                                        <div class="col-sm-9"><select id="cardHomeStation" class="form-control" style="width: 70%"></select></div>
                                    </div>
                                    @if (Model.ConditionsEnabled)
                                    {
                                        <div class="form-group">
                                            <label class="col-sm-3 control-label">@localizer["RunCardRelaxUnfilledRowsLabel"]</label>
                                            <div class="col-sm-9">
                                                <input type="checkbox" id="cardRelaxUnfilledRows" />
                                                <span class="help-block m-b-none">@localizer["RunCardRelaxUnfilledRowsHelp"]</span>
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="col-sm-3 control-label">@localizer["RunCardWaitingAutoDispatchLabel"]</label>
                                            <div class="col-sm-9">
                                                <select id="cardWaitingAutoDispatch" class="form-control" style="width: 70%">
                                                    <option value="">@localizer["RunCardDefaultLabel"]</option>
                                                    <option value="0">@localizer["RunCardWaitingAutoDispatchOff"]</option>
                                                    <option value="1">@localizer["RunCardWaitingAutoDispatchOn"]</option>
                                                </select>
                                                <span class="help-block m-b-none">@localizer["RunCardWaitingAutoDispatchHelp"]</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div id="tab-triggers" class="tab-pane">
                                <div class="panel-body">
                                    <p class="text-muted">@localizer["RunCardTriggersHelp"]</p>
                                    <table class="table table-striped" id="triggersTable">
                                        <thead>
                                            <tr>
                                                <th>@localizer["RunCardTriggerTypeLabel"]</th>
                                                <th>@localizer["CallPriority"]</th>
                                                <th>@localizer["CallType"]</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                    <button type="button" class="btn btn-white" id="addTriggerButton">@localizer["RunCardAddTriggerButton"]</button>
                                </div>
                            </div>

                            <div id="tab-alarms" class="tab-pane">
                                <div class="panel-body">
                                    <p class="text-muted">@localizer["RunCardAlarmLevelsHelp"]</p>
                                    @if (Model.ConditionsEnabled)
                                    {
                                        <p class="text-muted">@localizer["RunCardDecisionGraphHelp"] <a asp-controller="RunCards" asp-action="Packages" asp-route-area="User">@localizer["ResponsePackagesHeader"]</a></p>
                                    }
                                    <div id="alarmLevels"></div>
                                    <button type="button" class="btn btn-white" id="addAlarmLevelButton">@localizer["RunCardAddAlarmLevelButton"]</button>
                                </div>
                            </div>

                            <div id="tab-selections" class="tab-pane">
                                <div class="panel-body">
                                    <div class="rc-guide">
                                        <h4>@localizer["RunCardSelectionsGuideTitle"]</h4>
                                        <ul>
                                            <li>@localizer["RunCardSelectionsGuideDefault"]</li>
                                            <li>@localizer["RunCardSelectionsGuideReplace"]</li>
                                            <li>@localizer["RunCardSelectionsGuideStart"]</li>
                                            <li>@localizer["RunCardSelectionsGuideMeanings"]</li>
                                        </ul>
                                    </div>

                                    <div class="rc-section">
                                        <div class="rc-section-head">
                                            <h4>@localizer["RunCardSelectionsUnitsTitle"] <span id="rcUnitsSummary"></span></h4>
                                            <button type="button" class="btn btn-white btn-xs rc-clear" data-type="1" data-scope="all">@localizer["RunCardSelectionsClear"]</button>
                                        </div>
                                        <div class="rc-section-body">
                                            <p class="rc-help">@localizer["RunCardSelectionsUnitsHelp"]</p>
                                            <div class="rc-subsection">
                                                <div class="rc-subsection-head">
                                                    <strong>@localizer["RunCardSelectionsAllUnitTypes"]</strong> <span id="rcUnitAllSummary"></span>
                                                    <span class="rc-actions">
                                                        <button type="button" class="btn btn-white btn-xs rc-start-standard" data-type="1" data-unit-type-id="">@localizer["RunCardSelectionsStartStandard"]</button>
                                                        <button type="button" class="btn btn-white btn-xs rc-clear" data-type="1" data-unit-type-id="">@localizer["RunCardSelectionsClear"]</button>
                                                    </span>
                                                </div>
                                                <p class="rc-help">@localizer["RunCardSelectionsAllUnitTypesHelp"]</p>
                                                <div id="rcUnitAllOptions"></div>
                                            </div>
                                            <div class="rc-group-title" style="margin-top: 14px;">@localizer["RunCardSelectionsByUnitType"]</div>
                                            <div id="rcUnitTypes"></div>
                                        </div>
                                    </div>

                                    <div class="rc-section">
                                        <div class="rc-section-head">
                                            <h4>@localizer["RunCardSelectionsPersonnelTitle"] <span id="rcPersonnelSummary"></span></h4>
                                            <span class="rc-actions">
                                                <button type="button" class="btn btn-white btn-xs rc-start-standard" data-type="2" data-unit-type-id="">@localizer["RunCardSelectionsStartStandard"]</button>
                                                <button type="button" class="btn btn-white btn-xs rc-clear" data-type="2" data-unit-type-id="">@localizer["RunCardSelectionsClear"]</button>
                                            </span>
                                        </div>
                                        <div class="rc-section-body">
                                            <p class="rc-help">@localizer["RunCardSelectionsPersonnelHelp"]</p>
                                            <div id="rcPersonnelOptions"></div>
                                        </div>
                                    </div>

                                    <div class="rc-section">
                                        <div class="rc-section-head">
                                            <h4>@localizer["RunCardStaffingSelectionsLabel"] <span id="rcStaffingSummary"></span></h4>
                                            <span class="rc-actions">
                                                <button type="button" class="btn btn-white btn-xs rc-start-standard" data-type="3" data-unit-type-id="">@localizer["RunCardSelectionsStartStandard"]</button>
                                                <button type="button" class="btn btn-white btn-xs rc-clear" data-type="3" data-unit-type-id="">@localizer["RunCardSelectionsClear"]</button>
                                            </span>
                                        </div>
                                        <div class="rc-section-body">
                                            <p class="rc-help">@localizer["RunCardSelectionsStaffingHelp"]</p>
                                            <div id="rcStaffingOptions"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div id="tab-test" class="tab-pane">
                                <div class="panel-body form-horizontal">
                                    <p class="text-muted">@localizer["RunCardTestHelp"]</p>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">@localizer["CallPriority"]</label>
                                        <div class="col-sm-9"><select id="testPriority" class="form-control" style="width: 50%"></select></div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">@localizer["CallType"]</label>
                                        <div class="col-sm-9"><select id="testCallType" class="form-control" style="width: 50%"></select></div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">Latitude / Longitude</label>
                                        <div class="col-sm-9">
                                            <input type="text" id="testLatitude" class="form-control" style="width: 24%; display: inline-block" placeholder="39.7392" />
                                            <input type="text" id="testLongitude" class="form-control" style="width: 24%; display: inline-block" placeholder="-104.9903" />
                                            <input type="number" id="testAlarmLevel" class="form-control" style="width: 15%; display: inline-block" min="1" value="1" title="@localizer["RunCardAlarmLevelsHeader"]" />
                                            <button type="button" class="btn btn-primary" id="runTestButton">@localizer["RunCardRunTestButton"]</button>
                                        </div>
                                    </div>
                                    <div id="testRendered" style="display: none"></div>
                                    <a href="#" id="testRawToggle" style="display: none">@localizer["RunCardShowRawJson"]</a>
                                    <pre id="testResults" style="display: none; max-height: 500px; overflow: auto"></pre>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="hr-line-dashed"></div>
                    <div class="form-group">
                        <form id="saveCardForm">@Html.AntiForgeryToken()</form>
                        <a class="btn btn-white" asp-controller="RunCards" asp-action="Index" asp-route-area="User">@commonLocalizer["Cancel"]</a>
                        <button class="btn btn-primary" type="button" id="saveCardButton">@commonLocalizer["Save"]</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
<script src="~/js/app/internal/dispatch/resgrid.dispatch.runcarddecision.js"></script>
<script>
    $(function () {
        var card = @Html.Raw(cardJson);
        var lookups = @Html.Raw(lookupsJson);

        card.triggers = card.triggers || [];
        card.alarmLevels = card.alarmLevels || [];
        card.selections = card.selections || [];

        function optionList(items, selected, allowEmpty, emptyText) {
            var html = allowEmpty ? '<option value="">' + (emptyText || '') + '</option>' : '';
            $.each(items, function (i, item) {
                var sel = (selected !== null && selected !== undefined && String(selected) === String(item.id)) ? ' selected' : '';
                html += '<option value="' + item.id + '"' + sel + '>' + $('<span>').text(item.name).html() + '</option>';
            });
            return html;
        }

        // ── General tab ──
        $('#cardName').val(card.name || '');
        $('#cardDescription').val(card.description || '');
        $('#cardDisabled').prop('checked', card.isDisabled === true);
        $('#cardModeOverride').val(card.dispatchModeOverride === null || card.dispatchModeOverride === undefined ? '' : String(card.dispatchModeOverride));
        $('#cardAutoOverride').val(card.autoDispatchOverride === null || card.autoDispatchOverride === undefined ? '' : String(card.autoDispatchOverride));
        $('#cardStaffingOverride').val(card.minimumStaffingLevelOverride === null || card.minimumStaffingLevelOverride === undefined ? '' : String(card.minimumStaffingLevelOverride));
        $('#cardHomeStation').html(optionList(lookups.stations, card.homeStationGroupId, true, '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(localizer["RunCardNoHomeStationLabel"].Value))'));
        $('#cardRelaxUnfilledRows').prop('checked', card.relaxUnfilledRows === true);
        $('#cardWaitingAutoDispatch').val(card.waitingCallAutoDispatchOverride === null || card.waitingCallAutoDispatchOverride === undefined ? '' : String(card.waitingCallAutoDispatchOverride));

        // ── Triggers tab ──
        function renderTriggers() {
            var $body = $('#triggersTable tbody').empty();
            $('#triggerRequired').toggle(card.triggers.length === 0);
            $('#saveCardButton').prop('disabled', card.triggers.length === 0);
            $.each(card.triggers, function (index, trigger) {
                var row = '<tr data-index="' + index + '">';
                row += '<td><select class="form-control trigger-type">';
                row += '<option value="0"' + (trigger.triggerType === 0 ? ' selected' : '') + '>@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(localizer["RunCardTriggerPriorityOption"].Value))</option>';
