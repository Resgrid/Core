            if (type === 2) { return lookups.personnelStatusOptions; }
            if (type === 3) { return lookups.staffingOptions; }
            if (scopeKey(unitTypeId) !== '') { return lookups.unitStatusOptions[scopeKey(unitTypeId)] || []; }

            // All unit types offers the meanings; anything else saved there (not something this editor creates) is
            // still listed so it can be seen and removed.
            var options = lookups.unitMeaningOptions.slice();
            $.each(selectionsIn(1, null), function (i, s) {
                if (options.some(function (o) { return o.isCustomState === s.isCustomState && o.stateId === s.stateId; })) { return; }
                var known = null;
                $.each(lookups.unitStatusOptions, function (typeId, typeOptions) {
                    known = known || typeOptions.filter(function (o) { return o.isCustomState === s.isCustomState && o.stateId === s.stateId; })[0] || null;
                });
                options.push(known || { stateId: s.stateId, isCustomState: s.isCustomState, text: '#' + s.stateId, isMeaning: false, availability: 0 });
            });
            return options;
        }

        function optionLabel(option) {
            return option.isMeaning ? option.meaningName : option.text;
        }

        function summaryHtml(count) {
            return count
                ? '<span class="label label-primary">' + esc(selectionText.selected.replace('{0}', count)) + '</span>'
                : '<span class="label label-default">' + esc(selectionText.standard) + '</span>';
        }

        function optionHtml(type, unitTypeId, option) {
            var on = hasSelection(type, unitTypeId, option);
            return '<label class="rc-option' + (on ? ' is-on' : '') + '"><input type="checkbox" class="selection-check" data-selection-type="' + type
                + '" data-unit-type-id="' + scopeKey(unitTypeId) + '" data-custom="' + option.isCustomState + '" data-state-id="' + option.stateId + '"'
                + (on ? ' checked' : '') + ' /> <span>' + esc(optionLabel(option)) + '</span></label>';
        }

        function optionColumns(type, unitTypeId, options) {
            var html = '<div class="rc-cols">';
            $.each(selectionColumns, function (i, column) {
                var items = options.filter(function (o) { return column.classes.indexOf(o.availability) >= 0; });
                if (!items.length) { return; }
                html += '<div class="rc-col rc-col--' + column.key + '"><div class="rc-col-title">' + esc(column.title) + (column.note ? '<small>' + esc(column.note) + '</small>' : '') + '</div>';
                $.each(items, function (j, option) { html += optionHtml(type, unitTypeId, option); });
                html += '</div>';
            });
            return html + '</div>';
        }

        // Meanings first: they keep working when a status set changes, so they are the better default.
        function optionGroups(type, unitTypeId, options) {
            var meanings = options.filter(function (o) { return o.isMeaning; });
            var statuses = options.filter(function (o) { return !o.isMeaning; });
            var html = '';
            if (meanings.length) {
                html += '<div class="rc-group"><div class="rc-group-title">' + esc(selectionText.meaningsTitle) + '<small>' + esc(selectionText.meaningsHelp) + '</small></div>' + optionColumns(type, unitTypeId, meanings) + '</div>';
            }
            if (statuses.length) {
                html += '<div class="rc-group"><div class="rc-group-title">' + esc(selectionText.specificTitle) + '<small>' + esc(selectionText.specificHelp) + '</small></div>' + optionColumns(type, unitTypeId, statuses) + '</div>';
            }
            return html;
        }

        function selectedNames(type, unitTypeId) {
            var options = optionsFor(type, unitTypeId);
            var names = selectionsIn(type, unitTypeId).map(function (s) {
                var option = options.filter(function (o) { return o.isCustomState === s.isCustomState && o.stateId === s.stateId; })[0];
                return option ? option.text : '#' + s.stateId;
            });
            var shown = names.slice(0, 4).map(esc).join(', ');
            return names.length > 4 ? shown + ' ' + esc(selectionText.more.replace('{0}', names.length - 4)) : shown;
        }

        function scopeButton(cssClass, type, unitTypeId, label) {
            return '<button type="button" class="btn btn-white btn-xs ' + cssClass + '" data-type="' + type + '" data-unit-type-id="' + scopeKey(unitTypeId) + '">' + esc(label) + '</button>';
        }

        function unitTypeRowHtml(unitType, followsAll) {
            var own = selectionsIn(1, unitType.id).length;
            var open = !!expandedUnitTypes[unitType.id];
            var state = own
                ? '<span class="label label-primary">' + esc(selectionText.ownRule) + '</span> ' + selectedNames(1, unitType.id)
                : followsAll
                    ? '<span class="label label-info">' + esc(selectionText.followsAll) + '</span>'
                    : '<span class="label label-default">' + esc(selectionText.standard) + '</span>';

            var html = '<div class="rc-unit-row" data-unit-type-id="' + unitType.id + '"><div class="rc-unit-row-head">'
                + '<span class="rc-unit-name">' + esc(unitType.name) + '</span><span class="rc-unit-state">' + state + '</span>'
                + '<button type="button" class="btn btn-white btn-xs rc-toggle-unit" aria-expanded="' + open + '">' + esc(open ? selectionText.done : selectionText.customize) + '</button></div>';
            if (open) {
                html += '<div class="rc-unit-body"><div class="rc-actions">' + scopeButton('rc-start-standard', 1, unitType.id, selectionText.startStandard)
                    + (followsAll ? scopeButton('rc-copy-all', 1, unitType.id, selectionText.copyAll) : '')
                    + scopeButton('rc-clear', 1, unitType.id, selectionText.clear) + '</div>'
                    + optionGroups(1, unitType.id, optionsFor(1, unitType.id)) + '</div>';
            }
            return html + '</div>';
        }

        function renderSelections() {
            var generic = selectionsIn(1, null).length;
            var unitTotal = card.selections.filter(function (s) { return s.selectionType === 1; }).length;

            $('#rcUnitsSummary').html(summaryHtml(unitTotal));
            $('#rcUnitAllSummary').html(summaryHtml(generic));
            $('#rcUnitAllOptions').html(optionGroups(1, null, optionsFor(1, null)));
            $('#rcUnitTypes').html(lookups.unitTypes.length
                ? lookups.unitTypes.map(function (unitType) { return unitTypeRowHtml(unitType, generic > 0); }).join('')
                : '<p class="text-muted">' + esc(selectionText.noUnitTypes) + '</p>');

            $('#rcPersonnelSummary').html(summaryHtml(selectionsIn(2, null).length));
            $('#rcPersonnelOptions').html(optionGroups(2, null, optionsFor(2, null)));
            $('#rcStaffingSummary').html(summaryHtml(selectionsIn(3, null).length));
            $('#rcStaffingOptions').html(optionGroups(3, null, optionsFor(3, null)));
        }

        function scopeOf(element) {
            var $el = $(element);
            var unitTypeId = String($el.attr('data-unit-type-id') || '');
            return { type: parseInt($el.attr('data-type') || $el.attr('data-selection-type'), 10), unitTypeId: unitTypeId === '' ? null : parseInt(unitTypeId, 10) };
        }

        // Every change re-renders the tab (summaries and unit type states follow the selections), then puts focus back
        // on the control that was used.
        function rerenderKeepingFocus(selector) {
            renderSelections();
            $('#tab-selections').find(selector).first().trigger('focus');
        }

        $('#tab-selections').on('change', '.selection-check', function () {
            var scope = scopeOf(this);
            var option = { isCustomState: String($(this).attr('data-custom')) === 'true', stateId: parseInt($(this).attr('data-state-id'), 10) };
            setSelection(scope.type, scope.unitTypeId, option, this.checked);
            rerenderKeepingFocus('.selection-check[data-selection-type="' + scope.type + '"][data-unit-type-id="' + scopeKey(scope.unitTypeId)
                + '"][data-custom="' + option.isCustomState + '"][data-state-id="' + option.stateId + '"]');
        });

        // Starting from the standard rules ticks the meanings they count as available, so a dispatcher can add to
        // them (Returning, say) instead of rebuilding them from memory.
        $('#tab-selections').on('click', '.rc-start-standard', function () {
            var scope = scopeOf(this);
            clearScope(scope.type, scope.unitTypeId);
            $.each(optionsFor(scope.type, scope.unitTypeId), function (i, option) {
                if (option.isMeaning && (option.availability === 1 || option.availability === 4)) {
                    setSelection(scope.type, scope.unitTypeId, option, true);
                }
            });
            renderSelections();
        });

        $('#tab-selections').on('click', '.rc-copy-all', function () {
            var scope = scopeOf(this);
            clearScope(1, scope.unitTypeId);
            $.each(selectionsIn(1, null), function (i, s) { setSelection(1, scope.unitTypeId, s, true); });
            renderSelections();
        });

        $('#tab-selections').on('click', '.rc-clear', function () {
            var scope = scopeOf(this);
            if ($(this).attr('data-scope') === 'all') {
                card.selections = card.selections.filter(function (s) { return s.selectionType !== scope.type; });
            } else {
                clearScope(scope.type, scope.unitTypeId);
            }
            renderSelections();
        });

        $('#tab-selections').on('click', '.rc-toggle-unit', function () {
            var unitTypeId = $(this).closest('.rc-unit-row').attr('data-unit-type-id');
            expandedUnitTypes[unitTypeId] = !expandedUnitTypes[unitTypeId];
            rerenderKeepingFocus('.rc-unit-row[data-unit-type-id="' + unitTypeId + '"] .rc-toggle-unit');
        });

        // ── Test tab ──
        $('#testPriority').html(optionList(lookups.priorities, null, false));
        $('#testCallType').html(optionList(lookups.callTypes.map(function (t) { return { id: t.name, name: t.name }; }), null, true));

        $('#runTestButton').on('click', function () {
            $.getJSON('@Url.Action("Preview", "RunCards", new { area = "User" })', {
                priority: $('#testPriority').val(),
                type: $('#testCallType').val(),
                latitude: $('#testLatitude').val() || null,
                longitude: $('#testLongitude').val() || null,
                alarmLevel: $('#testAlarmLevel').val() || 1,
                // A saved card is tested as itself, even while disabled; a new card falls back to matching.
                runCardId: card.runCardId || null
            }, function (response) {
                if (response.success) {
                    $('#testResults').text(JSON.stringify(response.result, null, 2)).hide();
                    $('#testRendered').html(resgrid.dispatch.runcarddecision.renderResult(response.result)).show();
                    $('#testRawToggle').show();
                }
            });
        });

        $('#testRawToggle').on('click', function (e) {
            e.preventDefault();
            $('#testResults').toggle();
        });

        // ── Save ──
        $('#saveCardButton').on('click', function () {
            var payload = {
                runCardId: card.runCardId || 0,
                name: $('#cardName').val(),
                description: $('#cardDescription').val(),
                isDisabled: $('#cardDisabled').is(':checked'),
                dispatchModeOverride: $('#cardModeOverride').val() === '' ? null : parseInt($('#cardModeOverride').val(), 10),
                autoDispatchOverride: $('#cardAutoOverride').val() === '' ? null : parseInt($('#cardAutoOverride').val(), 10),
                minimumStaffingLevelOverride: $('#cardStaffingOverride').val() === '' ? null : parseInt($('#cardStaffingOverride').val(), 10),
                homeStationGroupId: $('#cardHomeStation').val() === '' ? null : parseInt($('#cardHomeStation').val(), 10),
                relaxUnfilledRows: $('#cardRelaxUnfilledRows').is(':checked'),
                waitingCallAutoDispatchOverride: !$('#cardWaitingAutoDispatch').length || $('#cardWaitingAutoDispatch').val() === '' ? null : parseInt($('#cardWaitingAutoDispatch').val(), 10),
                triggers: card.triggers,
                alarmLevels: card.alarmLevels,
                selections: card.selections
            };

            $.ajax({
                url: '@Url.Action("Save", "RunCards", new { area = "User" })',
                type: 'POST',
                contentType: 'application/json',
                // JSON bodies cannot carry the token as a field, so it travels in the
                // header the antiforgery options look for (see PerformCheckIn).
                headers: { 'RequestVerificationToken': $('#saveCardForm input[name="__RequestVerificationToken"]').val() },
                data: JSON.stringify(payload),
                success: function (response) {
                    if (response.success) {
                        window.location.href = '@Url.Action("Index", "RunCards", new { area = "User" })';
                    } else {
                        $('#saveError').show().text(response.message);
                    }
                },
                error: function (xhr) {
                    $('#saveError').show().text(xhr.responseJSON && xhr.responseJSON.message || 'Save failed.');
                }
            });
        });

        renderTriggers();
        renderAlarmLevels();
        renderSelections();
    });
</script>
}
