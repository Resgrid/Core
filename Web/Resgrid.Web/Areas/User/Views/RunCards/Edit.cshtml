@model Resgrid.Web.Areas.User.Models.RunCards.EditRunCardModel
@using Newtonsoft.Json
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Department.Department> localizer
@{
    ViewBag.Title = "Resgrid | " + localizer["RunCardsHeader"];

    // Both payloads are emitted through Html.Raw into a script block and carry
    // admin-entered free text (card/level names, type and role names, status button
    // text), so escape HTML-significant characters to keep a name like "</script>"
    // from breaking out of the block.
    var jsonSettings = new JsonSerializerSettings { StringEscapeHandling = StringEscapeHandling.EscapeHtml };

    var cardJson = JsonConvert.SerializeObject(new
    {
        runCardId = Model.RunCard.RunCardId,
        name = Model.RunCard.Name,
        description = Model.RunCard.Description,
        isDisabled = Model.RunCard.IsDisabled,
        dispatchModeOverride = Model.RunCard.DispatchModeOverride,
        autoDispatchOverride = Model.RunCard.AutoDispatchOverride,
        minimumStaffingLevelOverride = Model.RunCard.MinimumStaffingLevelOverride,
        homeStationGroupId = Model.RunCard.HomeStationGroupId,
        relaxUnfilledRows = Model.RunCard.RelaxUnfilledRows,
        waitingCallAutoDispatchOverride = Model.RunCard.WaitingCallAutoDispatchOverride,
        triggers = (Model.RunCard.Triggers ?? new List<Resgrid.Model.RunCardTrigger>()).Select(t => new
        {
            runCardTriggerId = t.RunCardTriggerId,
            triggerType = t.TriggerType,
            priority = t.Priority,
            callTypeId = t.CallTypeId
        }),
        alarmLevels = (Model.RunCard.AlarmLevels ?? new List<Resgrid.Model.RunCardAlarmLevel>()).Select(l => new
        {
            runCardAlarmLevelId = l.RunCardAlarmLevelId,
            alarmLevel = l.AlarmLevel,
            name = l.Name,
            responsePackageId = l.ResponsePackageId,
            decisionNodes = (l.DecisionNodes ?? new List<Resgrid.Model.RunCardDecisionNode>()).OrderBy(n => n.SortOrder).Select(n => new
            {
                nodeKey = n.NodeKey,
                isRoot = n.IsRoot,
                nodeKind = n.NodeKind,
                label = n.Label,
                conditionType = n.ConditionType,
                subjectStatusFilter = n.SubjectStatusFilter,
                subjectStatusBaseTypes = n.SubjectStatusBaseTypes,
                referenceStatusFilter = n.ReferenceStatusFilter,
                referenceStatusBaseTypes = n.ReferenceStatusBaseTypes,
                thresholdSeconds = n.ThresholdSeconds,
                requiredCount = n.RequiredCount,
                yesNodeKey = n.YesNodeKey,
                noNodeKey = n.NoNodeKey,
                responsePackageId = n.ResponsePackageId,
                adviceText = n.AdviceText,
                subjectTargets = (n.SubjectTargets ?? new List<Resgrid.Model.RunCardTarget>()).Select(x => new { targetKind = x.TargetKind, targetRefId = x.TargetRefId }),
                referenceTargets = (n.ReferenceTargets ?? new List<Resgrid.Model.RunCardTarget>()).Select(x => new { targetKind = x.TargetKind, targetRefId = x.TargetRefId })
            }),
            unitRequirements = (l.UnitRequirements ?? new List<Resgrid.Model.RunCardUnitRequirement>()).Select(r => new
            {
                runCardUnitRequirementId = r.RunCardUnitRequirementId,
                unitTypeId = r.UnitTypeId,
                requiredCount = r.RequiredCount
            }),
            roleRequirements = (l.RoleRequirements ?? new List<Resgrid.Model.RunCardRoleRequirement>()).Select(r => new
            {
                runCardRoleRequirementId = r.RunCardRoleRequirementId,
                personnelRoleId = r.PersonnelRoleId,
                requiredCount = r.RequiredCount
            })
        }),
        selections = (Model.RunCard.AvailabilitySelections ?? new List<Resgrid.Model.RunCardAvailabilitySelection>()).Select(s => new
        {
            runCardAvailabilitySelectionId = s.RunCardAvailabilitySelectionId,
            selectionType = s.SelectionType,
            unitTypeId = s.UnitTypeId,
            isCustomState = s.IsCustomState,
            stateId = s.StateId
        })
    }, jsonSettings);

    var lookupsJson = JsonConvert.SerializeObject(new
    {
        priorities = Model.CallPriorities.Items.Cast<Resgrid.Model.DepartmentCallPriority>().Select(p => new { id = p.DepartmentCallPriorityId, name = p.Name }),
        callTypes = Model.CallTypes.Select(t => new { id = t.CallTypeId, name = t.Type }),
        stations = Model.StationGroups.Select(s => new { id = s.DepartmentGroupId, name = s.Name }),
        unitTypes = Model.UnitTypes.Select(t => new { id = t.UnitTypeId, name = t.Type }),
        roles = Model.PersonnelRoles.Select(r => new { id = r.PersonnelRoleId, name = r.Name }),
        unitStatusOptions = Model.UnitStatusOptions.ToDictionary(kv => kv.Key.ToString(), kv => kv.Value.Select(o => new { stateId = o.StateId, isCustomState = o.IsCustomState, text = o.Text })),
        personnelStatusOptions = Model.PersonnelStatusOptions.Select(o => new { stateId = o.StateId, isCustomState = o.IsCustomState, text = o.Text }),
        staffingOptions = Model.StaffingOptions.Select(o => new { stateId = o.StateId, isCustomState = o.IsCustomState, text = o.Text }),
        conditionsEnabled = Model.ConditionsEnabled,
        packages = Model.ResponsePackages.Select(p => new { id = p.ResponsePackageId, name = p.IsRetired ? p.Name + " (" + localizer["ResponsePackageRetiredBadge"].Value + ")" : p.Name }),
        unitClasses = Enum.GetValues(typeof(Resgrid.Model.UnitTypeClasses)).Cast<Resgrid.Model.UnitTypeClasses>().Where(c => c != Resgrid.Model.UnitTypeClasses.None)
            .Select(c => new { id = (int)c, name = localizer["RunCardTargetAnyClass", Resgrid.Framework.StringHelpers.GetDisplayString(c)].Value }),
        baseTypes = Enum.GetValues(typeof(Resgrid.Model.ActionBaseTypes)).Cast<Resgrid.Model.ActionBaseTypes>().Where(b => b != Resgrid.Model.ActionBaseTypes.None)
            .Select(b => new { id = (int)b, name = Resgrid.Framework.StringHelpers.GetDisplayString(b) })
    }, jsonSettings);
}

<div class="row wrapper border-bottom white-bg page-heading">
    <div class="col-sm-8">
        <h2>@(Model.IsNew ? localizer["NewRunCardButton"] : Model.RunCard.Name)</h2>
        <ol class="breadcrumb">
            <li><a asp-controller="Home" asp-action="Dashboard" asp-route-area="User">@commonLocalizer["HomeModule"]</a></li>
            <li><a asp-controller="RunCards" asp-action="Index" asp-route-area="User">@localizer["RunCardsHeader"]</a></li>
            <li class="active"><strong>@(Model.IsNew ? localizer["NewRunCardButton"] : Model.RunCard.Name)</strong></li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="col-xs-12">
        <div class="wrapper wrapper-content">
            <div class="ibox float-e-margins">
                <div class="ibox-content">
                    <div class="alert alert-danger" id="saveError" style="display: none"></div>
                    @if (TempData["TemplateApplied"] != null)
                    {
                        <div class="alert alert-info">@localizer["RunCardTemplateAppliedMessage"]</div>
                    }
                    <div class="alert alert-success" id="saveSuccess" style="display: none">@localizer["RunCardSavedMessage"]</div>
                    @if (Model.RemovedReferenceCount > 0)
                    {
                        <div class="alert alert-warning">@localizer["RunCardDetachedReferencesRemoved", Model.RemovedReferenceCount]</div>
                    }

                    <div class="alert alert-warning" id="triggerRequired" role="alert" style="display: none">@localizer["RunCardTriggerRequired"]</div>

                    <div class="tabs-container">
                        <ul class="nav nav-tabs">
                            <li class="active"><a data-toggle="tab" href="#tab-general">@localizer["RunCardGeneralTab"]</a></li>
                            <li><a data-toggle="tab" href="#tab-triggers">@localizer["RunCardTriggersHeader"]</a></li>
                            <li><a data-toggle="tab" href="#tab-alarms">@localizer["RunCardAlarmLevelsHeader"]</a></li>
                            <li><a data-toggle="tab" href="#tab-selections">@localizer["RunCardSelectionsHeader"]</a></li>
                            <li><a data-toggle="tab" href="#tab-test">@localizer["RunCardTestHeader"]</a></li>
                        </ul>
                        <div class="tab-content">
                            <div id="tab-general" class="tab-pane active">
                                <div class="panel-body form-horizontal">
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">@localizer["RunCardNameLabel"]</label>
                                        <div class="col-sm-9"><input type="text" id="cardName" class="form-control" maxlength="100" /></div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">@localizer["RunCardDescriptionLabel"]</label>
                                        <div class="col-sm-9"><input type="text" id="cardDescription" class="form-control" maxlength="500" /></div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">@localizer["RunCardDisabledLabel"]</label>
                                        <div class="col-sm-9"><input type="checkbox" id="cardDisabled" /></div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">@localizer["DispatchRecommendationModeLabel"]</label>
                                        <div class="col-sm-9">
                                            <select id="cardModeOverride" class="form-control" style="width: 70%">
                                                <option value="">@localizer["RunCardDefaultLabel"]</option>
                                                <option value="0">@localizer["RunCardManualOnlyLabel"]</option>
                                                <option value="1">Station Based</option>
                                                <option value="2">Closest Unit</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">@localizer["DispatchAutoDispatchLabel"]</label>
                                        <div class="col-sm-9">
                                            <select id="cardAutoOverride" class="form-control" style="width: 70%">
                                                <option value="">@localizer["RunCardDefaultLabel"]</option>
                                                <option value="0">@localizer["RunCardPrePopulateLabel"]</option>
                                                <option value="1">@localizer["RunCardAutoDispatchOptionLabel"]</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">@localizer["StaffingGateLabel"]</label>
                                        <div class="col-sm-9">
                                            <select id="cardStaffingOverride" class="form-control" style="width: 70%">
                                                <option value="">@localizer["RunCardDefaultLabel"]</option>
                                                <option value="0">@localizer["RunCardNoGateLabel"]</option>
                                                <option value="2">Partially Staffed</option>
                                                <option value="3">Degraded</option>
                                                <option value="4">Fully Staffed</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">@localizer["RunCardHomeStationLabel"]</label>
                                        <div class="col-sm-9"><select id="cardHomeStation" class="form-control" style="width: 70%"></select></div>
                                    </div>
                                    @if (Model.ConditionsEnabled)
                                    {
                                        <div class="form-group">
                                            <label class="col-sm-3 control-label">@localizer["RunCardRelaxUnfilledRowsLabel"]</label>
                                            <div class="col-sm-9">
                                                <input type="checkbox" id="cardRelaxUnfilledRows" />
                                                <span class="help-block m-b-none">@localizer["RunCardRelaxUnfilledRowsHelp"]</span>
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="col-sm-3 control-label">@localizer["RunCardWaitingAutoDispatchLabel"]</label>
                                            <div class="col-sm-9">
                                                <select id="cardWaitingAutoDispatch" class="form-control" style="width: 70%">
                                                    <option value="">@localizer["RunCardDefaultLabel"]</option>
                                                    <option value="0">@localizer["RunCardWaitingAutoDispatchOff"]</option>
                                                    <option value="1">@localizer["RunCardWaitingAutoDispatchOn"]</option>
                                                </select>
                                                <span class="help-block m-b-none">@localizer["RunCardWaitingAutoDispatchHelp"]</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div id="tab-triggers" class="tab-pane">
                                <div class="panel-body">
                                    <p class="text-muted">@localizer["RunCardTriggersHelp"]</p>
                                    <table class="table table-striped" id="triggersTable">
                                        <thead>
                                            <tr>
                                                <th>@localizer["RunCardTriggerTypeLabel"]</th>
                                                <th>@localizer["CallPriority"]</th>
                                                <th>@localizer["CallType"]</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                    <button type="button" class="btn btn-white" id="addTriggerButton">@localizer["RunCardAddTriggerButton"]</button>
                                </div>
                            </div>

                            <div id="tab-alarms" class="tab-pane">
                                <div class="panel-body">
                                    <p class="text-muted">@localizer["RunCardAlarmLevelsHelp"]</p>
                                    @if (Model.ConditionsEnabled)
                                    {
                                        <p class="text-muted">@localizer["RunCardDecisionGraphHelp"] <a asp-controller="RunCards" asp-action="Packages" asp-route-area="User">@localizer["ResponsePackagesHeader"]</a></p>
                                    }
                                    <div id="alarmLevels"></div>
                                    <button type="button" class="btn btn-white" id="addAlarmLevelButton">@localizer["RunCardAddAlarmLevelButton"]</button>
                                </div>
                            </div>

                            <div id="tab-selections" class="tab-pane">
                                <div class="panel-body">
                                    <p class="text-muted">@localizer["RunCardSelectionsHelp"]</p>
                                    <h4>@localizer["UnitCallDispatchStatusLabel"]</h4>
                                    <div id="unitStatusSelections"></div>
                                    <h4>@localizer["PersonCallDispatchStatusLabel"]</h4>
                                    <div id="personnelStatusSelections" class="row" style="margin-left: 0"></div>
                                    <h4>@localizer["RunCardStaffingSelectionsLabel"]</h4>
                                    <div id="staffingSelections" class="row" style="margin-left: 0"></div>
                                </div>
                            </div>

                            <div id="tab-test" class="tab-pane">
                                <div class="panel-body form-horizontal">
                                    <p class="text-muted">@localizer["RunCardTestHelp"]</p>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">@localizer["CallPriority"]</label>
                                        <div class="col-sm-9"><select id="testPriority" class="form-control" style="width: 50%"></select></div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">@localizer["CallType"]</label>
                                        <div class="col-sm-9"><select id="testCallType" class="form-control" style="width: 50%"></select></div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">Latitude / Longitude</label>
                                        <div class="col-sm-9">
                                            <input type="text" id="testLatitude" class="form-control" style="width: 24%; display: inline-block" placeholder="39.7392" />
                                            <input type="text" id="testLongitude" class="form-control" style="width: 24%; display: inline-block" placeholder="-104.9903" />
                                            <input type="number" id="testAlarmLevel" class="form-control" style="width: 15%; display: inline-block" min="1" value="1" title="@localizer["RunCardAlarmLevelsHeader"]" />
                                            <button type="button" class="btn btn-primary" id="runTestButton">@localizer["RunCardRunTestButton"]</button>
                                        </div>
                                    </div>
                                    <div id="testRendered" style="display: none"></div>
                                    <a href="#" id="testRawToggle" style="display: none">@localizer["RunCardShowRawJson"]</a>
                                    <pre id="testResults" style="display: none; max-height: 500px; overflow: auto"></pre>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="hr-line-dashed"></div>
                    <div class="form-group">
                        <form id="saveCardForm">@Html.AntiForgeryToken()</form>
                        <a class="btn btn-white" asp-controller="RunCards" asp-action="Index" asp-route-area="User">@commonLocalizer["Cancel"]</a>
                        <button class="btn btn-primary" type="button" id="saveCardButton">@commonLocalizer["Save"]</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
<script src="~/js/app/internal/dispatch/resgrid.dispatch.runcarddecision.js"></script>
<script>
    $(function () {
        var card = @Html.Raw(cardJson);
        var lookups = @Html.Raw(lookupsJson);

        card.triggers = card.triggers || [];
        card.alarmLevels = card.alarmLevels || [];
        card.selections = card.selections || [];

        function optionList(items, selected, allowEmpty, emptyText) {
            var html = allowEmpty ? '<option value="">' + (emptyText || '') + '</option>' : '';
            $.each(items, function (i, item) {
                var sel = (selected !== null && selected !== undefined && String(selected) === String(item.id)) ? ' selected' : '';
                html += '<option value="' + item.id + '"' + sel + '>' + $('<span>').text(item.name).html() + '</option>';
            });
            return html;
        }

        // ── General tab ──
        $('#cardName').val(card.name || '');
        $('#cardDescription').val(card.description || '');
        $('#cardDisabled').prop('checked', card.isDisabled === true);
        $('#cardModeOverride').val(card.dispatchModeOverride === null || card.dispatchModeOverride === undefined ? '' : String(card.dispatchModeOverride));
        $('#cardAutoOverride').val(card.autoDispatchOverride === null || card.autoDispatchOverride === undefined ? '' : String(card.autoDispatchOverride));
        $('#cardStaffingOverride').val(card.minimumStaffingLevelOverride === null || card.minimumStaffingLevelOverride === undefined ? '' : String(card.minimumStaffingLevelOverride));
        $('#cardHomeStation').html(optionList(lookups.stations, card.homeStationGroupId, true, '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(localizer["RunCardNoHomeStationLabel"].Value))'));
        $('#cardRelaxUnfilledRows').prop('checked', card.relaxUnfilledRows === true);
        $('#cardWaitingAutoDispatch').val(card.waitingCallAutoDispatchOverride === null || card.waitingCallAutoDispatchOverride === undefined ? '' : String(card.waitingCallAutoDispatchOverride));

        // ── Triggers tab ──
        function renderTriggers() {
            var $body = $('#triggersTable tbody').empty();
            $('#triggerRequired').toggle(card.triggers.length === 0);
            $('#saveCardButton').prop('disabled', card.triggers.length === 0);
            $.each(card.triggers, function (index, trigger) {
                var row = '<tr data-index="' + index + '">';
                row += '<td><select class="form-control trigger-type">';
                row += '<option value="0"' + (trigger.triggerType === 0 ? ' selected' : '') + '>@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(localizer["RunCardTriggerPriorityOption"].Value))</option>';
                row += '<option value="1"' + (trigger.triggerType === 1 ? ' selected' : '') + '>@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(localizer["RunCardTriggerTypeOption"].Value))</option>';
                row += '<option value="2"' + (trigger.triggerType === 2 ? ' selected' : '') + '>@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(localizer["RunCardTriggerBothOption"].Value))</option>';
                row += '</select></td>';
                row += '<td><select class="form-control trigger-priority">' + optionList(lookups.priorities, trigger.priority, true) + '</select></td>';
                row += '<td><select class="form-control trigger-calltype">' + optionList(lookups.callTypes, trigger.callTypeId, true) + '</select></td>';
                row += '<td><button type="button" class="btn btn-danger btn-xs remove-trigger">@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(commonLocalizer["Delete"].Value))</button></td>';
                row += '</tr>';
                $body.append(row);
            });
        }

        $('#addTriggerButton').on('click', function () {
            card.triggers.push({ runCardTriggerId: 0, triggerType: 2, priority: null, callTypeId: null });
            renderTriggers();
        });

        $('#triggersTable').on('click', '.remove-trigger', function () {
            card.triggers.splice($(this).closest('tr').data('index'), 1);
            renderTriggers();
        });

        $('#triggersTable').on('change', 'select', function () {
            var index = $(this).closest('tr').data('index');
            var $row = $(this).closest('tr');
            card.triggers[index].triggerType = parseInt($row.find('.trigger-type').val(), 10);
            var priority = $row.find('.trigger-priority').val();
            var callType = $row.find('.trigger-calltype').val();
            card.triggers[index].priority = priority === '' ? null : parseInt(priority, 10);
            card.triggers[index].callTypeId = callType === '' ? null : parseInt(callType, 10);
        });

        // ── Alarm levels tab ──
        function requirementRows(requirements, items, cssClass) {
            var html = '';
            $.each(requirements, function (i, requirement) {
                var itemId = requirement.unitTypeId !== undefined ? requirement.unitTypeId : requirement.personnelRoleId;
                html += '<div class="form-inline m-b-xs ' + cssClass + '" data-req-index="' + i + '">';
                html += '<select class="form-control req-item">' + optionList(items, itemId, false) + '</select> ';
                html += '<input type="number" class="form-control req-count" style="width: 80px" min="1" value="' + (requirement.requiredCount || 1) + '" /> ';
                html += '<button type="button" class="btn btn-danger btn-xs remove-req">@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(commonLocalizer["Delete"].Value))</button>';
                html += '</div>';
            });
            return html;
        }

        function renderAlarmLevels() {
            var $container = $('#alarmLevels').empty();
            card.alarmLevels.sort(function (a, b) { return a.alarmLevel - b.alarmLevel; });

            $.each(card.alarmLevels, function (index, level) {
                var html = '<div class="panel panel-default" data-level-index="' + index + '">';
                html += '<div class="panel-heading"><strong>@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(localizer["RunCardAlarmLevelLabel"].Value)) ' + level.alarmLevel + '</strong> ';
                html += '<input type="text" class="form-control level-name" style="width: 250px; display: inline-block" placeholder="@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(localizer["RunCardAlarmLevelNamePlaceholder"].Value))" value="' + $('<span>').text(level.name || '').html() + '" /> ';
                html += '<button type="button" class="btn btn-danger btn-xs pull-right remove-level">@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(commonLocalizer["Delete"].Value))</button></div>';
                html += '<div class="panel-body">';
                html += '<h5>@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(localizer["RunCardUnitRequirementsLabel"].Value))</h5>';
                html += '<div class="unit-reqs">' + requirementRows(level.unitRequirements || [], lookups.unitTypes, 'unit-req') + '</div>';
                html += '<button type="button" class="btn btn-white btn-xs add-unit-req">@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(localizer["RunCardAddUnitRequirementButton"].Value))</button>';
                html += '<h5>@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(localizer["RunCardRoleRequirementsLabel"].Value))</h5>';
                html += '<div class="role-reqs">' + requirementRows(level.roleRequirements || [], lookups.roles, 'role-req') + '</div>';
                html += '<button type="button" class="btn btn-white btn-xs add-role-req">@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(localizer["RunCardAddRoleRequirementButton"].Value))</button>';
                if (lookups.conditionsEnabled) {
                    html += conditionalLevelHtml(level);
                }
                html += '</div></div>';
                $container.append(html);
            });
        }

        $('#addAlarmLevelButton').on('click', function () {
            var next = card.alarmLevels.length > 0 ? Math.max.apply(null, card.alarmLevels.map(function (l) { return l.alarmLevel; })) + 1 : 1;
            card.alarmLevels.push({ runCardAlarmLevelId: 0, alarmLevel: next, name: '', unitRequirements: [], roleRequirements: [] });
            renderAlarmLevels();
        });

        $('#alarmLevels').on('click', '.remove-level', function () {
            card.alarmLevels.splice($(this).closest('.panel').data('level-index'), 1);
            $.each(card.alarmLevels, function (i, level) { level.alarmLevel = i + 1; });
            renderAlarmLevels();
        });

        $('#alarmLevels').on('click', '.add-unit-req', function () {
            // With nothing to pick, a row would post id 0, which the save rejects.
            if (!lookups.unitTypes.length) { return; }
            var level = card.alarmLevels[$(this).closest('.panel').data('level-index')];
            level.unitRequirements = level.unitRequirements || [];
            level.unitRequirements.push({ runCardUnitRequirementId: 0, unitTypeId: lookups.unitTypes[0].id, requiredCount: 1 });
            renderAlarmLevels();
        });

        $('#alarmLevels').on('click', '.add-role-req', function () {
            if (!lookups.roles.length) { return; }
            var level = card.alarmLevels[$(this).closest('.panel').data('level-index')];
            level.roleRequirements = level.roleRequirements || [];
            level.roleRequirements.push({ runCardRoleRequirementId: 0, personnelRoleId: lookups.roles[0].id, requiredCount: 1 });
            renderAlarmLevels();
        });

        $('#alarmLevels').on('click', '.remove-req', function () {
            var level = card.alarmLevels[$(this).closest('.panel').data('level-index')];
            var $req = $(this).closest('div[data-req-index]');
            if ($req.hasClass('unit-req')) {
                level.unitRequirements.splice($req.data('req-index'), 1);
            } else {
                level.roleRequirements.splice($req.data('req-index'), 1);
            }
            renderAlarmLevels();
        });

        $('#alarmLevels').on('change', '.level-name', function () {
            card.alarmLevels[$(this).closest('.panel').data('level-index')].name = $(this).val();
        });

        $('#alarmLevels').on('change', '.req-item, .req-count', function () {
            var level = card.alarmLevels[$(this).closest('.panel').data('level-index')];
            var $req = $(this).closest('div[data-req-index]');
            var target = $req.hasClass('unit-req') ? level.unitRequirements[$req.data('req-index')] : level.roleRequirements[$req.data('req-index')];
            var itemId = parseInt($req.find('.req-item').val(), 10);
            if ($req.hasClass('unit-req')) { target.unitTypeId = itemId; } else { target.personnelRoleId = itemId; }
            target.requiredCount = parseInt($req.find('.req-count').val(), 10) || 1;
        });

        // ── Conditional run cards: level package and decision graph ──
        var nodeKeySeed = 0;
        function newNodeKey() {
            nodeKeySeed++;
            return 'n' + Date.now().toString(36) + nodeKeySeed;
        }

        function esc(text) {
            return $('<span>').text(text === null || text === undefined ? '' : text).html();
        }

        function targetOptions(targets) {
            var chosen = {};
            $.each(targets || [], function (i, t) { chosen[t.targetKind + ':' + (t.targetRefId === null || t.targetRefId === undefined ? '' : t.targetRefId)] = true; });
            function opt(kind, ref, name) {
                var value = kind + ':' + (ref === null ? '' : ref);
                return '<option value="' + value + '"' + (chosen[value] ? ' selected' : '') + '>' + esc(name) + '</option>';
            }
            var html = '<optgroup label="@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(localizer["RunCardTargetUnitsGroup"].Value))">' + opt(3, null, '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(localizer["RunCardTargetAnyUnit"].Value))');
            $.each(lookups.unitClasses, function (i, c) { html += opt(2, c.id, c.name); });
            $.each(lookups.unitTypes, function (i, u) { html += opt(1, u.id, u.name); });
            html += '</optgroup><optgroup label="@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(localizer["RunCardTargetPeopleGroup"].Value))">' + opt(5, null, '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(localizer["RunCardTargetAnyPerson"].Value))');
            $.each(lookups.roles, function (i, r) { html += opt(4, r.id, r.name); });
            return html + '</optgroup>';
        }

        function readTargets($select) {
            return ($select.val() || []).map(function (value) {
                var parts = value.split(':');
                return { targetKind: parseInt(parts[0], 10), targetRefId: parts[1] === '' ? null : parseInt(parts[1], 10) };
            });
        }

        function statusFilterHtml(cssClass, filter, baseTypes) {
            var options = [[0, '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(localizer["RunCardStatusAnyAvailable"].Value))'], [1, '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(localizer["RunCardStatusInQuarters"].Value))'], [2, '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(localizer["RunCardStatusAwayFromQuarters"].Value))'], [3, '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(localizer["RunCardStatusBaseTypes"].Value))']];
            var html = '<select class="form-control input-sm ' + cssClass + '-filter" style="width: auto; display: inline-block">';
            $.each(options, function (i, o) { html += '<option value="' + o[0] + '"' + ((filter || 0) === o[0] ? ' selected' : '') + '>' + o[1] + '</option>'; });
            html += '</select> ';
            var selected = (baseTypes || '').split(',');
            html += '<select multiple class="form-control input-sm ' + cssClass + '-basetypes" size="3" style="width: auto; display: ' + (filter === 3 ? 'inline-block' : 'none') + '">';
            $.each(lookups.baseTypes, function (i, b) { html += '<option value="' + b.id + '"' + (selected.indexOf(String(b.id)) >= 0 ? ' selected' : '') + '>' + esc(b.name) + '</option>'; });
            return html + '</select>';
        }

        function nodeChoices(level, current, selected) {
            var html = '<option value="">@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(localizer["RunCardNodeChoose"].Value))</option>';
            $.each(level.decisionNodes || [], function (i, n) {
                if (n.nodeKey === current) { return; }
                var text = (n.nodeKind === 2 ? '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(localizer["RunCardOutcomePrefix"].Value)) ' : '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(localizer["RunCardConditionPrefix"].Value)) ') + (n.label || n.nodeKey);
                html += '<option value="' + esc(n.nodeKey) + '"' + (n.nodeKey === selected ? ' selected' : '') + '>' + esc(text) + '</option>';
            });
            return html;
        }

        function nodeHtml(level, node, nodeIndex) {
            var html = '<div class="well well-sm decision-node" data-node-index="' + nodeIndex + '">';
            html += '<div class="form-inline m-b-xs">';
            html += '<label class="m-r-sm"><input type="radio" name="root_' + level.alarmLevel + '" class="node-root"' + (node.isRoot ? ' checked' : '') + '> @Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(localizer["RunCardNodeStartLabel"].Value))</label> ';
            html += '<span class="label ' + (node.nodeKind === 2 ? 'label-primary' : 'label-info') + '">' + (node.nodeKind === 2 ? '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(localizer["RunCardOutcomePrefix"].Value))' : '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(localizer["RunCardConditionPrefix"].Value))') + '</span> ';
            html += '<input type="text" class="form-control input-sm node-label" maxlength="200" style="width: 320px" placeholder="@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(localizer["RunCardNodeLabelPlaceholder"].Value))" value="' + esc(node.label) + '" /> ';
            html += '<button type="button" class="btn btn-danger btn-xs pull-right remove-node">@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(commonLocalizer["Delete"].Value))</button>';
            html += '</div>';

            if (node.nodeKind === 2) {
                html += '<div class="form-inline m-b-xs">@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(localizer["RunCardOutcomePackageLabel"].Value)) <select class="form-control input-sm node-package">' + optionList(lookups.packages, node.responsePackageId, true, '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(localizer["RunCardNoPackageOption"].Value))') + '</select></div>';
                html += '<div>@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(localizer["RunCardOutcomeAdviceLabel"].Value))<textarea class="form-control input-sm node-advice" maxlength="1000" rows="2">' + esc(node.adviceText) + '</textarea></div>';
            } else {
                var isBefore = node.conditionType !== 2;
                html += '<div class="form-inline m-b-xs"><select class="form-control input-sm node-type">';
                html += '<option value="1"' + (isBefore ? ' selected' : '') + '>@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(localizer["RunCardConditionArrivesBefore"].Value))</option>';
                html += '<option value="2"' + (!isBefore ? ' selected' : '') + '>@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(localizer["RunCardConditionAvailableWithin"].Value))</option></select></div>';
                html += '<div class="row m-b-xs"><div class="col-sm-6"><label>@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(localizer["RunCardConditionSubjectLabel"].Value))</label><select multiple class="form-control input-sm node-subject" size="5">' + targetOptions(node.subjectTargets) + '</select>' + statusFilterHtml('node-subject', node.subjectStatusFilter, node.subjectStatusBaseTypes) + '</div>';
                if (isBefore) {
                    html += '<div class="col-sm-6"><label>@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(localizer["RunCardConditionReferenceLabel"].Value))</label><select multiple class="form-control input-sm node-reference" size="5">' + targetOptions(node.referenceTargets) + '</select>' + statusFilterHtml('node-reference', node.referenceStatusFilter, node.referenceStatusBaseTypes) + '</div>';
                }
                html += '</div><div class="form-inline m-b-xs">';
                html += (isBefore ? '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(localizer["RunCardConditionMarginLabel"].Value))' : '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(localizer["RunCardConditionWithinLabel"].Value))') + ' <input type="number" class="form-control input-sm node-threshold" min="0" max="7200" style="width: 100px" value="' + (node.thresholdSeconds === null || node.thresholdSeconds === undefined ? (isBefore ? 0 : 480) : node.thresholdSeconds) + '" /> ';
                if (!isBefore) {
                    html += '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(localizer["RunCardConditionCountLabel"].Value)) <input type="number" class="form-control input-sm node-count" min="1" max="25" style="width: 70px" value="' + (node.requiredCount || 1) + '" /> ';
                }
                html += '</div><div class="form-inline">';
                html += '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(localizer["RunCardConditionYesLabel"].Value)) <select class="form-control input-sm node-yes">' + nodeChoices(level, node.nodeKey, node.yesNodeKey) + '</select> ';
                html += '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(localizer["RunCardConditionNoLabel"].Value)) <select class="form-control input-sm node-no">' + nodeChoices(level, node.nodeKey, node.noNodeKey) + '</select>';
                html += '</div>';
            }

            return html + '</div>';
        }

        function conditionalLevelHtml(level) {
            level.decisionNodes = level.decisionNodes || [];
            var html = '<hr/><div class="form-inline m-b-sm"><strong>@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(localizer["RunCardLevelPackageLabel"].Value))</strong> ';
            html += '<select class="form-control input-sm level-package">' + optionList(lookups.packages, level.responsePackageId, true, '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(localizer["RunCardNoPackageOption"].Value))') + '</select></div>';
            html += '<h5>@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(localizer["RunCardDecisionGraphLabel"].Value))</h5><div class="decision-nodes">';
            $.each(level.decisionNodes, function (i, node) { html += nodeHtml(level, node, i); });
            html += '</div><button type="button" class="btn btn-white btn-xs add-condition">@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(localizer["RunCardAddConditionButton"].Value))</button> ';
            html += '<button type="button" class="btn btn-white btn-xs add-outcome">@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(localizer["RunCardAddOutcomeButton"].Value))</button>';
            return html;
        }

        function levelOf(element) {
            return card.alarmLevels[$(element).closest('.panel').data('level-index')];
        }

        function nodeOf(element) {
            return levelOf(element).decisionNodes[$(element).closest('.decision-node').data('node-index')];
        }

        $('#alarmLevels').on('change', '.level-package', function () {
            var value = $(this).val();
            levelOf(this).responsePackageId = value === '' ? null : parseInt(value, 10);
        });

        $('#alarmLevels').on('click', '.add-condition, .add-outcome', function () {
            var level = levelOf(this);
            level.decisionNodes = level.decisionNodes || [];
            var outcome = $(this).hasClass('add-outcome');
            level.decisionNodes.push({
                nodeKey: newNodeKey(), isRoot: level.decisionNodes.length === 0, nodeKind: outcome ? 2 : 1, label: '',
                conditionType: 1, subjectStatusFilter: 0, referenceStatusFilter: 0, thresholdSeconds: outcome ? null : 0, requiredCount: 1,
                subjectTargets: [], referenceTargets: [], yesNodeKey: null, noNodeKey: null, responsePackageId: null, adviceText: ''
            });
            renderAlarmLevels();
        });

        $('#alarmLevels').on('click', '.remove-node', function () {
            var level = levelOf(this);
            var removed = level.decisionNodes.splice($(this).closest('.decision-node').data('node-index'), 1)[0];
            $.each(level.decisionNodes, function (i, n) {
                if (n.yesNodeKey === removed.nodeKey) { n.yesNodeKey = null; }
                if (n.noNodeKey === removed.nodeKey) { n.noNodeKey = null; }
            });
            if (removed.isRoot && level.decisionNodes.length) { level.decisionNodes[0].isRoot = true; }
            renderAlarmLevels();
        });

        $('#alarmLevels').on('change', '.node-root', function () {
            var level = levelOf(this);
            var index = $(this).closest('.decision-node').data('node-index');
            $.each(level.decisionNodes, function (i, n) { n.isRoot = i === index; });
        });

        $('#alarmLevels').on('change', '.node-type', function () {
            nodeOf(this).conditionType = parseInt($(this).val(), 10);
            renderAlarmLevels();
        });

        $('#alarmLevels').on('change', '.node-subject-filter, .node-reference-filter', function () {
            var $node = $(this).closest('.decision-node');
            var reference = $(this).hasClass('node-reference-filter');
            var filter = parseInt($(this).val(), 10);
            $node.find(reference ? '.node-reference-basetypes' : '.node-subject-basetypes').toggle(filter === 3);
        });

        // Labels and selections are read on every change, so a re-render (adding a node) never loses an edit.
        $('#alarmLevels').on('change', '.decision-node input, .decision-node select, .decision-node textarea', function () {
            var node = nodeOf(this);
            var $node = $(this).closest('.decision-node');
            node.label = $node.find('.node-label').val();

            if (node.nodeKind === 2) {
                var packageValue = $node.find('.node-package').val();
                node.responsePackageId = packageValue === '' || packageValue === undefined ? null : parseInt(packageValue, 10);
                node.adviceText = $node.find('.node-advice').val();
                return;
            }

            node.subjectTargets = readTargets($node.find('.node-subject'));
            node.subjectStatusFilter = parseInt($node.find('.node-subject-filter').val(), 10) || 0;
            node.subjectStatusBaseTypes = ($node.find('.node-subject-basetypes').val() || []).join(',');
            if ($node.find('.node-reference').length) {
                node.referenceTargets = readTargets($node.find('.node-reference'));
                node.referenceStatusFilter = parseInt($node.find('.node-reference-filter').val(), 10) || 0;
                node.referenceStatusBaseTypes = ($node.find('.node-reference-basetypes').val() || []).join(',');
            }
            var threshold = parseInt($node.find('.node-threshold').val(), 10);
            node.thresholdSeconds = isNaN(threshold) ? 0 : threshold;
            node.requiredCount = parseInt($node.find('.node-count').val(), 10) || 1;
            node.yesNodeKey = $node.find('.node-yes').val() || null;
            node.noNodeKey = $node.find('.node-no').val() || null;
        });

        $('#alarmLevels').on('change', '.node-label', function () {
            renderAlarmLevels();
        });

        // ── Selections tab ──
        function isSelected(selectionType, unitTypeId, option) {
            return card.selections.some(function (s) {
                return s.selectionType === selectionType
                    && String(s.unitTypeId || '') === String(unitTypeId || '')
                    && s.isCustomState === option.isCustomState
                    && s.stateId === option.stateId;
            });
        }

        function checkboxes(selectionType, unitTypeId, options) {
            var html = '';
            $.each(options, function (i, option) {
                var checked = isSelected(selectionType, unitTypeId, option) ? ' checked' : '';
                html += '<label class="checkbox-inline" style="margin-right: 12px">';
                html += '<input type="checkbox" class="selection-check" data-selection-type="' + selectionType + '" data-unit-type-id="' + (unitTypeId || '') + '" data-custom="' + option.isCustomState + '" data-state-id="' + option.stateId + '"' + checked + '> ' + $('<span>').text(option.text).html();
                html += '</label>';
            });
            return html;
        }

        function renderSelections() {
            var $units = $('#unitStatusSelections').empty();
            $.each(lookups.unitTypes, function (i, unitType) {
                var options = lookups.unitStatusOptions[String(unitType.id)] || [];
                $units.append('<div class="m-b-sm"><strong>' + $('<span>').text(unitType.name).html() + '</strong><br/>' + checkboxes(1, unitType.id, options) + '</div>');
            });
            $('#personnelStatusSelections').html(checkboxes(2, null, lookups.personnelStatusOptions));
            $('#staffingSelections').html(checkboxes(3, null, lookups.staffingOptions));
        }

        $('#tab-selections').on('change', '.selection-check', function () {
            var $check = $(this);
            var selection = {
                runCardAvailabilitySelectionId: 0,
                selectionType: parseInt($check.data('selection-type'), 10),
                unitTypeId: $check.data('unit-type-id') === '' ? null : parseInt($check.data('unit-type-id'), 10),
                isCustomState: String($check.data('custom')) === 'true',
                stateId: parseInt($check.data('state-id'), 10)
            };

            if ($check.is(':checked')) {
                card.selections.push(selection);
            } else {
                card.selections = card.selections.filter(function (s) {
                    return !(s.selectionType === selection.selectionType
                        && String(s.unitTypeId || '') === String(selection.unitTypeId || '')
                        && s.isCustomState === selection.isCustomState
                        && s.stateId === selection.stateId);
                });
            }
        });

        // ── Test tab ──
        $('#testPriority').html(optionList(lookups.priorities, null, false));
        $('#testCallType').html(optionList(lookups.callTypes.map(function (t) { return { id: t.name, name: t.name }; }), null, true));

        $('#runTestButton').on('click', function () {
            $.getJSON('@Url.Action("Preview", "RunCards", new { area = "User" })', {
                priority: $('#testPriority').val(),
                type: $('#testCallType').val(),
                latitude: $('#testLatitude').val() || null,
                longitude: $('#testLongitude').val() || null,
                alarmLevel: $('#testAlarmLevel').val() || 1,
                // A saved card is tested as itself, even while disabled; a new card falls back to matching.
                runCardId: card.runCardId || null
            }, function (response) {
                if (response.success) {
                    $('#testResults').text(JSON.stringify(response.result, null, 2)).hide();
                    $('#testRendered').html(resgrid.dispatch.runcarddecision.renderResult(response.result)).show();
                    $('#testRawToggle').show();
                }
            });
        });

        $('#testRawToggle').on('click', function (e) {
            e.preventDefault();
            $('#testResults').toggle();
        });

        // ── Save ──
        $('#saveCardButton').on('click', function () {
            var payload = {
                runCardId: card.runCardId || 0,
                name: $('#cardName').val(),
                description: $('#cardDescription').val(),
                isDisabled: $('#cardDisabled').is(':checked'),
                dispatchModeOverride: $('#cardModeOverride').val() === '' ? null : parseInt($('#cardModeOverride').val(), 10),
                autoDispatchOverride: $('#cardAutoOverride').val() === '' ? null : parseInt($('#cardAutoOverride').val(), 10),
                minimumStaffingLevelOverride: $('#cardStaffingOverride').val() === '' ? null : parseInt($('#cardStaffingOverride').val(), 10),
                homeStationGroupId: $('#cardHomeStation').val() === '' ? null : parseInt($('#cardHomeStation').val(), 10),
                relaxUnfilledRows: $('#cardRelaxUnfilledRows').is(':checked'),
                waitingCallAutoDispatchOverride: !$('#cardWaitingAutoDispatch').length || $('#cardWaitingAutoDispatch').val() === '' ? null : parseInt($('#cardWaitingAutoDispatch').val(), 10),
                triggers: card.triggers,
                alarmLevels: card.alarmLevels,
                selections: card.selections
            };

            $.ajax({
                url: '@Url.Action("Save", "RunCards", new { area = "User" })',
                type: 'POST',
                contentType: 'application/json',
                // JSON bodies cannot carry the token as a field, so it travels in the
                // header the antiforgery options look for (see PerformCheckIn).
                headers: { 'RequestVerificationToken': $('#saveCardForm input[name="__RequestVerificationToken"]').val() },
                data: JSON.stringify(payload),
                success: function (response) {
                    if (response.success) {
                        window.location.href = '@Url.Action("Index", "RunCards", new { area = "User" })';
                    } else {
                        $('#saveError').show().text(response.message);
                    }
                },
                error: function (xhr) {
                    $('#saveError').show().text(xhr.responseJSON && xhr.responseJSON.message || 'Save failed.');
                }
            });
        });

        renderTriggers();
        renderAlarmLevels();
        renderSelections();
    });
</script>
}
