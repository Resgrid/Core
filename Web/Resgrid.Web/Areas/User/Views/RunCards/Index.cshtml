@model Resgrid.Web.Areas.User.Models.RunCards.RunCardsIndexModel
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Department.Department> localizer
@{
    ViewBag.Title = "Resgrid | " + localizer["RunCardsHeader"];
}

<div class="row wrapper border-bottom white-bg page-heading">
    <div class="col-sm-8">
        <h2>@localizer["RunCardsHeader"]</h2>
        <ol class="breadcrumb">
            <li>
                <a asp-controller="Home" asp-action="Dashboard" asp-route-area="User">@commonLocalizer["HomeModule"]</a>
            </li>
            <li>
                <a asp-controller="Department" asp-action="Settings" asp-route-area="User">@localizer["DepartmentSettingsHeader"]</a>
            </li>
            <li class="active">
                <strong>@localizer["RunCardsHeader"]</strong>
            </li>
        </ol>
    </div>
    <div class="col-sm-4">
        <div class="title-action">
            <a asp-controller="RunCards" asp-action="New" asp-route-area="User" class="btn btn-primary">@localizer["NewRunCardButton"]</a>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xs-12">
        <div class="wrapper wrapper-content">
            <div class="ibox float-e-margins">
                <div class="ibox-content">
                    <p class="text-muted">@localizer["RunCardsHelp"]</p>

                    <table class="table table-striped table-hover" id="runCardsTable">
                        <thead>
                            <tr>
                                <th>@localizer["RunCardNameLabel"]</th>
                                <th>@localizer["RunCardDescriptionLabel"]</th>
                                <th>@localizer["RunCardAlarmLevelsHeader"]</th>
                                <th>@localizer["RunCardTriggersHeader"]</th>
                                <th>@localizer["StationCoverageEnabledLabel"]</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var card in Model.RunCards)
                            {
                                <tr>
                                    <td>@card.Name</td>
                                    <td>@card.Description</td>
                                    <td>@(card.AlarmLevels?.Count ?? 0)</td>
                                    <td>@(card.Triggers?.Count ?? 0)</td>
                                    <td>@(card.IsDisabled ? commonLocalizer["No"] : commonLocalizer["Yes"])</td>
                                    <td>
                                        <a asp-controller="RunCards" asp-action="Edit" asp-route-area="User" asp-route-runCardId="@card.RunCardId" class="btn btn-primary btn-xs">@localizer["RunCardEditButton"]</a>
                                        <button type="button" class="btn btn-danger btn-xs delete-card" data-id="@card.RunCardId" data-name="@card.Name">@commonLocalizer["Delete"]</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <form id="deleteForm">@Html.AntiForgeryToken()</form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
<script>
    $(function () {
        $('#runCardsTable').on('click', '.delete-card', function () {
            if (!confirm('@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(localizer["RunCardDeleteConfirm"].Value))')) {
                return;
            }

            $.post('@Url.Action("Delete", "RunCards", new { area = "User" })', {
                __RequestVerificationToken: $('#deleteForm input[name="__RequestVerificationToken"]').val(),
                runCardId: $(this).data('id')
            }, function (response) {
                if (response.success) {
                    window.location.reload();
                }
            });
        });
    });
</script>
}
