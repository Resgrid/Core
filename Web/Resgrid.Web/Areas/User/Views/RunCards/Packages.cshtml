@model Resgrid.Web.Areas.User.Models.RunCards.ResponsePackagesIndexModel
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Department.Department> localizer
@{
    ViewBag.Title = "Resgrid | " + localizer["ResponsePackagesHeader"];
}

<div class="row wrapper border-bottom white-bg page-heading">
    <div class="col-sm-8">
        <h2>@localizer["ResponsePackagesHeader"]</h2>
        <ol class="breadcrumb">
            <li>
                <a asp-controller="Home" asp-action="Dashboard" asp-route-area="User">@commonLocalizer["HomeModule"]</a>
            </li>
            <li>
                <a asp-controller="RunCards" asp-action="Index" asp-route-area="User">@localizer["RunCardsHeader"]</a>
            </li>
            <li class="active">
                <strong>@localizer["ResponsePackagesHeader"]</strong>
            </li>
        </ol>
    </div>
    <div class="col-sm-4">
        <div class="title-action">
            <a asp-controller="RunCards" asp-action="NewPackage" asp-route-area="User" class="btn btn-primary">@localizer["NewResponsePackageButton"]</a>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xs-12">
        <div class="wrapper wrapper-content">
            <div class="ibox float-e-margins">
                <div class="ibox-content">
                    <p class="text-muted">@localizer["ResponsePackagesHelp"]</p>
                    <div class="alert alert-danger" id="deleteError" style="display: none"></div>

                    <table class="table table-striped table-hover" id="packagesTable">
                        <thead>
                            <tr>
                                <th>@localizer["ResponsePackageNameLabel"]</th>
                                <th>@localizer["ResponsePackageRowsLabel"]</th>
                                <th>@localizer["ResponsePackageUsedBy"]</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var package in Model.Packages)
                            {
                                Model.Usage.TryGetValue(package.ResponsePackageId, out var usage);
                                <tr>
                                    <td>
                                        @package.Name
                                        @if (package.IsRetired)
                                        {
                                            <span class="label label-default">@localizer["ResponsePackageRetiredBadge"]</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(package.Description))
                                        {
                                            <br /><small class="text-muted">@package.Description</small>
                                        }
                                    </td>
                                    <td>@(package.Rows?.Count ?? 0)</td>
                                    <td>
                                        @if (usage == null || !usage.Any())
                                        {
                                            <span class="text-muted">@localizer["ResponsePackageNotUsed"]</span>
                                        }
                                        else
                                        {
                                            @string.Join(", ", usage)
                                        }
                                    </td>
                                    <td>
                                        <a asp-controller="RunCards" asp-action="EditPackage" asp-route-area="User" asp-route-responsePackageId="@package.ResponsePackageId" class="btn btn-primary btn-xs">@localizer["RunCardEditButton"]</a>
                                        <button type="button" class="btn btn-danger btn-xs delete-package" data-id="@package.ResponsePackageId">@commonLocalizer["Delete"]</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <form id="deleteForm">@Html.AntiForgeryToken()</form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
<script>
    $(function () {
        $('#packagesTable').on('click', '.delete-package', function () {
            if (!confirm('@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(localizer["ResponsePackageDeleteConfirm"].Value))')) {
                return;
            }

            $.post('@Url.Action("DeletePackage", "RunCards", new { area = "User" })', {
                __RequestVerificationToken: $('#deleteForm input[name="__RequestVerificationToken"]').val(),
                responsePackageId: $(this).data('id')
            }, function (response) {
                if (response.success) {
                    window.location.reload();
                } else {
                    $('#deleteError').show().text(response.message || '');
                }
            });
        });
    });
</script>
}
