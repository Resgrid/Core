@using Resgrid.Model.Search
@using Resgrid.Web.Helpers
@model Resgrid.WebCore.Areas.User.Models.Search.SearchIndexView
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Search.Search> localizer
@{
	ViewBag.Title = "Resgrid | " + localizer["PageTitle"];
	string FamilyLabel(string type) => localizer["Family." + type].ResourceNotFound ? type : localizer["Family." + type].Value;
	string BadgeLabel(string type) => localizer["Badge." + type].ResourceNotFound ? type : localizer["Badge." + type].Value;
	// The snippet often repeats the summary with different separators ("Station 1 · Attack" / "Station 1 Attack").
	bool SameText(string a, string b) => string.Equals(new string((a ?? "").Where(char.IsLetterOrDigit).ToArray()), new string((b ?? "").Where(char.IsLetterOrDigit).ToArray()), StringComparison.OrdinalIgnoreCase);
	// Icons follow the side navigation for the family's module; tones are defined in css/search.css.
	(string Icon, string Tone) FamilyStyle(string type) => type switch
	{
		SearchEntityTypes.Call => ("fa-bullhorn", "tone-danger"),
		SearchEntityTypes.Unit => ("fa-road", "tone-primary"),
		SearchEntityTypes.Personnel => ("fa-user", "tone-primary"),
		SearchEntityTypes.Group => ("fa-sitemap", "tone-primary"),
		SearchEntityTypes.Shift => ("fa-briefcase", "tone-primary"),
		SearchEntityTypes.Contact => ("fa-address-book", "tone-primary"),
		SearchEntityTypes.Message => ("fa-envelope", "tone-info"),
		SearchEntityTypes.Note => ("fa-clipboard", "tone-info"),
		SearchEntityTypes.Document => ("fa-file-archive-o", "tone-info"),
		SearchEntityTypes.CalendarEvent => ("fa-calendar", "tone-info"),
		SearchEntityTypes.Training => ("fa-book", "tone-info"),
		SearchEntityTypes.Protocol => ("fa-list-alt", "tone-info"),
		SearchEntityTypes.Record => ("fa-file", "tone-warning"),
		SearchEntityTypes.Log => ("fa-history", "tone-warning"),
		SearchEntityTypes.Occupancy => ("fa-building-o", "tone-warning"),
		SearchEntityTypes.Poi => ("fa-map-marker", "tone-warning"),
		SearchEntityTypes.Invoice => ("fa-file-text-o", "tone-success"),
		SearchEntityTypes.Bid => ("fa-handshake-o", "tone-success"),
		SearchEntityTypes.ServiceContract => ("fa-file-text", "tone-success"),
		SearchEntityTypes.RateCard => ("fa-money", "tone-success"),
		SearchEntityTypes.Deployment => ("fa-truck", "tone-success"),
		SearchEntityTypes.CertificationType => ("fa-certificate", "tone-success"),
		_ => ("fa-search", "")
	};
	var showPager = Model.Searched && (Model.Page > 1 || Model.HasMore);
	var lastPage = Model.Total.HasValue ? Math.Max(1, (int)Math.Ceiling(Model.Total.Value / (double)Model.PageSize)) : (int?)null;
}

<div class="row wrapper border-bottom white-bg page-heading">
	<div class="col-sm-8">
		<h2>@localizer["PageTitle"]</h2>
		<ol class="breadcrumb">
			<li>
				<a asp-controller="Home" asp-action="Dashboard" asp-route-area="User">@commonLocalizer["HomeModule"]</a>
			</li>
			<li class="active">
				<strong>@localizer["PageTitle"]</strong>
			</li>
		</ol>
	</div>
	@if (Model.Searched && Model.Results.Count > 0)
	{
		<div class="col-sm-4">
			<div class="btn-group top-page-buttons" style="float:right;padding-right:15px;">
				<a class="btn btn-default" title="@string.Format(localizer["ExportHelp"].Value, Model.MaxExportRows)"
				   asp-controller="Search" asp-action="Export" asp-route-area="User"
				   asp-route-q="@Model.Query" asp-route-type="@Model.Type" asp-route-from="@Model.From" asp-route-to="@Model.To" asp-route-sort="@Model.Sort">
					<i class="fa fa-download"></i> @localizer["ExportCsv"]
				</a>
			</div>
		</div>
	}
</div>

<div class="wrapper wrapper-content search-page">
	<div class="row">
		<div class="col-lg-12">
			@if (Model.Unavailable)
			{
				<div class="alert alert-warning">@localizer["SearchUnavailable"]</div>
			}
			else
			{
				<div class="ibox float-e-margins">
					<div class="ibox-title">
						<form method="get" asp-controller="Search" asp-action="Index" asp-route-area="User" id="search-page-form">
							<div class="input-group search-query">
								<input type="search" name="q" value="@Model.Query" class="form-control" placeholder="@localizer["Placeholder"]" maxlength="500" autofocus aria-label="@localizer["PageTitle"]" />
								<span class="input-group-btn">
									<button type="submit" class="btn btn-primary"><i class="fa fa-search"></i> @localizer["SearchButton"]</button>
								</span>
							</div>
							<div class="search-filters">
								<div class="form-group">
									<label for="search-type">@localizer["SearchIn"]</label>
									<select id="search-type" name="type" class="form-control">
										<option value="" selected="@(Model.Type == null)">@localizer["AllFamilies"]</option>
										@foreach (var family in Model.Families)
										{
											<option value="@family" selected="@(string.Equals(family, Model.Type, StringComparison.OrdinalIgnoreCase))">@FamilyLabel(family)</option>
										}
									</select>
								</div>
								<div class="form-group">
									<label for="search-from">@localizer["FromLabel"]</label>
									<input id="search-from" type="date" name="from" value="@Model.From" class="form-control" />
								</div>
								<div class="form-group">
									<label for="search-to">@localizer["ToLabel"]</label>
									<input id="search-to" type="date" name="to" value="@Model.To" class="form-control" />
								</div>
								<div class="form-group">
									<label for="search-sort">@localizer["SortLabel"]</label>
									<select id="search-sort" name="sort" class="form-control">
										<option value="@SearchSortOrders.Relevance" selected="@(Model.Sort == SearchSortOrders.Relevance)">@localizer["SortRelevance"]</option>
										<option value="@SearchSortOrders.Newest" selected="@(Model.Sort == SearchSortOrders.Newest)">@localizer["SortNewest"]</option>
										<option value="@SearchSortOrders.Oldest" selected="@(Model.Sort == SearchSortOrders.Oldest)">@localizer["SortOldest"]</option>
									</select>
								</div>
							</div>
						</form>
						<div class="text-muted small search-tips">@localizer["Tips"]</div>
					</div>
					<div class="ibox-content">
						@if (Model.IndexBuilding)
						{
							<div class="alert alert-info">@localizer["IndexBuilding"]</div>
						}
						@if (Model.Degraded && !Model.IndexBuilding)
						{
							<div class="alert alert-warning">@localizer["IndexUnavailable"]</div>
						}
						@if (Model.InvalidDate)
						{
							<div class="alert alert-warning">@localizer["InvalidDate"]</div>
						}

						@if (!Model.Searched)
						{
							<div class="search-empty">
								<i class="fa fa-search" aria-hidden="true"></i>
								<p>@localizer["EnterQuery"]</p>
							</div>
						}
						else if (Model.Results.Count == 0)
						{
							<div class="search-empty">
								<i class="fa fa-search-minus" aria-hidden="true"></i>
								<h4>@localizer["NoResults"]</h4>
								<p>@localizer["NoResultsHint"]</p>
							</div>
						}
						else
						{
							<div class="search-summary">
								<p id="search-result-count">
									@if (Model.Total.HasValue)
									{
										@string.Format(localizer["ResultsOfTotal"].Value, Model.FirstIndex, Model.LastIndex, Model.Total.Value)
									}
									else
									{
										@string.Format(localizer["ResultsRange"].Value, Model.FirstIndex, Model.LastIndex)
									}
								</p>
								@if (!Model.Total.HasValue && Model.HasMore)
								{
									<p class="small">@localizer["TotalUnknown"]</p>
								}
							</div>

							<ul class="search-hits">
								@foreach (var row in Model.Results)
								{
									var style = FamilyStyle(row.EntityType);
									var hasUrl = !string.IsNullOrWhiteSpace(row.Url);
									<li class="search-hit @style.Tone @(hasUrl ? "is-link" : null)">
										<span class="search-hit-icon" aria-hidden="true"><i class="fa @style.Icon"></i></span>
										<div class="search-hit-body">
											<div class="search-hit-head">
												<h3 class="search-hit-title">
													@if (hasUrl)
													{
														<a href="@row.Url">@SearchHighlighter.Highlight(row.Title, Model.HighlightTerms)</a>
													}
													else
													{
														@SearchHighlighter.Highlight(row.Title, Model.HighlightTerms)
													}
												</h3>
												<span class="search-hit-type">@BadgeLabel(row.EntityType)</span>
											</div>
											<div class="search-hit-meta">
												@if (!string.IsNullOrWhiteSpace(row.Number))
												{
													<span><i class="fa fa-hashtag" aria-hidden="true"></i>@row.Number</span>
												}
												@if (!string.IsNullOrWhiteSpace(row.OccurredOn))
												{
													<span><i class="fa fa-clock-o" aria-hidden="true"></i>@row.OccurredOn</span>
												}
												@if (!string.IsNullOrWhiteSpace(row.Status))
												{
													<span class="search-hit-status">@row.Status</span>
												}
												@if (!string.IsNullOrWhiteSpace(row.Category) && row.Category != row.Status)
												{
													<span><i class="fa fa-tag" aria-hidden="true"></i>@row.Category</span>
												}
											</div>
											@if (!string.IsNullOrWhiteSpace(row.Summary))
											{
												<p class="search-hit-summary">@SearchHighlighter.Highlight(row.Summary, Model.HighlightTerms)</p>
											}
											@if (!string.IsNullOrWhiteSpace(row.Snippet) && !SameText(row.Snippet, row.Summary))
											{
												<p class="search-hit-snippet">@SearchHighlighter.Highlight(row.Snippet, Model.HighlightTerms)</p>
											}
										</div>
									</li>
								}
							</ul>

							@if (showPager)
							{
								<nav aria-label="@localizer["PageTitle"]">
									<ul class="pager">
										@if (Model.Page > 1)
										{
											<li class="previous">
												<a asp-controller="Search" asp-action="Index" asp-route-area="User"
												   asp-route-q="@Model.Query" asp-route-type="@Model.Type" asp-route-from="@Model.From" asp-route-to="@Model.To" asp-route-sort="@Model.Sort"
												   asp-route-page="@(Model.Page - 1)">&larr; @localizer["Previous"]</a>
											</li>
										}
										@if (lastPage.HasValue)
										{
											<li class="search-page-position"><span>@Model.Page / @lastPage.Value</span></li>
										}
										@if (Model.HasMore)
										{
											<li class="next">
												<a asp-controller="Search" asp-action="Index" asp-route-area="User"
												   asp-route-q="@Model.Query" asp-route-type="@Model.Type" asp-route-from="@Model.From" asp-route-to="@Model.To" asp-route-sort="@Model.Sort"
												   asp-route-page="@(Model.Page + 1)">@localizer["Next"] &rarr;</a>
											</li>
										}
									</ul>
								</nav>
							}
						}
					</div>
				</div>
			}
		</div>
	</div>
</div>

@section Styles {
	<link rel="stylesheet" href="~/css/search.css" asp-append-version="true" />
}

@section Scripts {
	<script>
		(function () {
			// Changing a filter re-runs the search from the first page.
			var form = document.getElementById('search-page-form');
			if (!form) return;
			var query = form.querySelector('input[name="q"]');
			['search-type', 'search-sort', 'search-from', 'search-to'].forEach(function (id) {
				var input = document.getElementById(id);
				if (input) input.addEventListener('change', function () { if (query && query.value.trim().length > 0) form.submit(); });
			});
		})();
	</script>
}
