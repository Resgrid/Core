@model Resgrid.Web.Areas.User.Models.Security.ViewAuditLogView
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Security.Security> localizer
@functions {
  public string DisplayValue(string value)
  {
    return String.IsNullOrWhiteSpace(value) ? localizer["AuditLogViewNotRecorded"].Value : value;
  }
}
@{
  ViewBag.Title = "Resgrid | " + localizer["AuditLogViewTitle"];
  var loggedBy = await UserHelper.GetFullNameForUser(Model.AuditLog.UserId);
  if (String.IsNullOrWhiteSpace(loggedBy))
  {
    loggedBy = localizer["AuditLogViewNotRecorded"].Value;
  }
}
@section Styles
{
  <style>
    .audit-log-value {
      margin: 0;
      max-height: 24rem;
      overflow: auto;
      padding: 0.75rem;
      white-space: pre-wrap;
      word-break: break-word;
    }
  </style>
}

<div class="row wrapper border-bottom white-bg page-heading">
  <div class="col-sm-4">
    <h2>@localizer["AuditLogViewTitle"]</h2>
    <ol class="breadcrumb">
      <li>
        <a asp-controller="Home" asp-action="Dashboard" asp-route-area="User">@localizer["BreadcrumbHome"]</a>
      </li>
      <li>
        <a asp-controller="Security" asp-action="Index" asp-route-area="User">@localizer["BreadcrumbSecurity"]</a>
      </li>
      <li>
        <a asp-controller="Security" asp-action="Audits" asp-route-area="User">@localizer["AuditLogsButton"]</a>
      </li>
      <li class="active">
        <strong>@localizer["AuditLogViewTitle"]</strong>
      </li>
    </ol>
  </div>
</div>

<div class="row">
  <div class="col-lg-12">
    <div class="wrapper wrapper-content animated fadeInUp">
      <div class="ibox">
        <div class="ibox-title">
          <h5>@localizer["AuditLogViewPanelTitle"]</h5>
          <div class="ibox-tools">
          </div>
        </div>
        <div class="ibox-content">
          <div class="row">
            <div class="col-lg-6">
              <dl class="dl-horizontal">
                <dt>@localizer["AuditLogViewAuditLogId"]</dt>
                <dd>@Model.AuditLog.AuditLogId</dd>
              </dl>
            </div>
            <div class="col-lg-6">
              <dl class="dl-horizontal">
                <dt>@localizer["AuditLogViewDepartmentId"]</dt>
                <dd>@Model.AuditLog.DepartmentId</dd>
              </dl>
            </div>
          </div>
          <div class="row">
            <div class="col-lg-6">
              <dl class="dl-horizontal">
                <dt>@localizer["AuditLogViewAuditType"]</dt>
                <dd>@Model.Type.ToString()</dd>
              </dl>
            </div>
            <div class="col-lg-6">
              <dl class="dl-horizontal">
                <dt>@localizer["AuditLogViewLogTypeId"]</dt>
                <dd>@Model.AuditLog.LogType</dd>
              </dl>
            </div>
          </div>
          <div class="row">
            <div class="col-lg-6">
              <dl class="dl-horizontal">
                <dt>@localizer["AuditLogViewTypeDescription"]</dt>
                <dd>@DisplayValue(Model.TypeName)</dd>
              </dl>
            </div>
            <div class="col-lg-6">
              <dl class="dl-horizontal">
                <dt>@localizer["AuditLogViewResult"]</dt>
                <dd>
                  @if (Model.AuditLog.Successful)
                  {
                    <span class="label label-success">@localizer["AuditLogsResultSuccessful"]</span>
                  }
                  else
                  {
                    <span class="label label-danger">@localizer["AuditLogsResultFailed"]</span>
                  }
                </dd>
              </dl>
            </div>
          </div>
          <div class="row">
            <div class="col-lg-6">
              <dl class="dl-horizontal">
                <dt>@localizer["AuditLogViewLoggedBy"]</dt>
                <dd>@loggedBy</dd>
              </dl>
            </div>
            <div class="col-lg-6">
              <dl class="dl-horizontal">
                <dt>@localizer["AuditLogViewUserId"]</dt>
                <dd>@DisplayValue(Model.AuditLog.UserId)</dd>
              </dl>
            </div>
          </div>
          <div class="row">
            <div class="col-lg-6">
              <dl class="dl-horizontal">
                <dt>@localizer["AuditLogViewLoggedOnLocal"]</dt>
                <dd>@(Model.AuditLog.LoggedOn.HasValue ? Model.AuditLog.LoggedOn.Value.TimeConverterToString(Model.Department) : localizer["AuditLogsUnknownTime"].Value)</dd>
              </dl>
            </div>
            <div class="col-lg-6">
              <dl class="dl-horizontal">
                <dt>@localizer["AuditLogViewLoggedOnUtc"]</dt>
                <dd>
                  @if (Model.AuditLog.LoggedOn.HasValue)
                  {
                    @DateTime.SpecifyKind(Model.AuditLog.LoggedOn.Value, DateTimeKind.Utc).ToString("yyyy-MM-dd HH:mm:ss.fffffff 'UTC'")
                  }
                  else
                  {
                    @localizer["AuditLogsUnknownTime"]
                  }
                </dd>
              </dl>
            </div>
          </div>
          <div class="row">
            <div class="col-lg-6">
              <dl class="dl-horizontal">
                <dt>@localizer["AuditLogViewIpAddress"]</dt>
                <dd>@DisplayValue(Model.AuditLog.IpAddress)</dd>
              </dl>
            </div>
            <div class="col-lg-6">
              <dl class="dl-horizontal">
                <dt>@localizer["AuditLogViewServerName"]</dt>
                <dd>@DisplayValue(Model.AuditLog.ServerName)</dd>
              </dl>
            </div>
          </div>
          <div class="row">
            <div class="col-lg-6">
              <dl class="dl-horizontal">
                <dt>@localizer["AuditLogViewObjectId"]</dt>
                <dd>@DisplayValue(Model.AuditLog.ObjectId)</dd>
              </dl>
            </div>
            <div class="col-lg-6">
              <dl class="dl-horizontal">
                <dt>@localizer["AuditLogViewObjectDepartmentId"]</dt>
                <dd>@Model.AuditLog.ObjectDepartmentId</dd>
              </dl>
            </div>
          </div>
          <div class="row">
            <div class="col-lg-12">
              <dl class="dl-horizontal">
                <dt>@localizer["AuditLogViewUserAgent"]</dt>
                <dd>@DisplayValue(Model.AuditLog.UserAgent)</dd>
              </dl>
            </div>
          </div>
          <div class="row">
            <div class="col-lg-12">
              <dl>
                <dt>@localizer["AuditLogViewMessage"]</dt>
                <dd><pre class="audit-log-value">@DisplayValue(Model.AuditLog.Message)</pre></dd>
              </dl>
            </div>
          </div>
          <div class="row">
            <div class="col-lg-12">
              <dl>
                <dt>@localizer["AuditLogViewData"]</dt>
                <dd><pre class="audit-log-value">@DisplayValue(Model.AuditLog.Data)</pre></dd>
              </dl>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

@section Scripts
{

}
