@using Resgrid.Model.Academy
@model AcademyGuidanceView
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Academy.AcademyGuidance> guidanceLocalizer
@*
    A3 dashboard card (AcademyGuidanceViewComponent): the member's role tour (first-run tasks from the Academy walkthroughs) while it is open,
    and the newest "What's new" lesson until read. Ticking a task or closing either is remembered per member (Help/TourTask, Help/Dismiss).
*@
@{
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<div class="row rgw-academy-guidance">
    @if (Model.Tour != null)
    {
        var tour = Model.Tour;
        <div class="@(Model.WhatsNew != null ? "col-lg-7" : "col-lg-12")">
            <section class="ibox" aria-labelledby="guidance-tour-title">
                <div class="ibox-title">
                    <h5 id="guidance-tour-title"><i class="fa fa-map-signs" aria-hidden="true"></i> @tour.Title</h5>
                    <span class="pull-right small text-muted">@string.Format(guidanceLocalizer["TourProgress"].Value, tour.DoneCount, tour.Tasks.Count)</span>
                </div>
                <div class="ibox-content">
                    @if (!string.IsNullOrWhiteSpace(tour.Intro))
                    {
                        <p class="text-muted small">@tour.Intro</p>
                    }
                    <ul class="list-unstyled">
                        @foreach (var task in tour.Tasks)
                        {
                            <li class="m-b-xs">
                                <form method="post" asp-controller="Help" asp-action="TourTask" asp-route-area="User" class="inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="tour" value="@tour.Key" />
                                    <input type="hidden" name="task" value="@task.Key" />
                                    <input type="hidden" name="done" value="@(task.Done ? "false" : "true")" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="submit" class="btn btn-link btn-xs p-0" title="@(task.Done ? guidanceLocalizer["MarkNotDone"] : guidanceLocalizer["MarkDone"])">
                                        <i class="fa @(task.Done ? "fa-check-square-o text-navy" : "fa-square-o")" aria-hidden="true"></i>
                                        <span class="sr-only">@(task.Done ? guidanceLocalizer["MarkNotDone"] : guidanceLocalizer["MarkDone"])</span>
                                    </button>
                                </form>
                                @if (!string.IsNullOrWhiteSpace(task.PageUrl))
                                {
                                    <a href="@task.PageUrl">@task.Title</a>
                                }
                                else
                                {
                                    @task.Title
                                }
                                @if (!string.IsNullOrWhiteSpace(task.LessonUrl))
                                {
                                    <a class="small" href="@task.LessonUrl" target="_blank" rel="noopener"><i class="fa fa-play-circle" aria-hidden="true"></i> @guidanceLocalizer["WatchLesson"]</a>
                                }
                            </li>
                        }
                    </ul>
                    <div class="rgw-toolbar">
                        <a class="btn btn-white btn-xs" asp-controller="Help" asp-action="Tours" asp-route-area="User"><i class="fa fa-list" aria-hidden="true"></i> @guidanceLocalizer["AllTours"]</a>
                        <form method="post" asp-controller="Help" asp-action="Dismiss" asp-route-area="User" class="inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="key" value="@(AcademyManifests.TourKeyPrefix + tour.Key)" />
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <button type="submit" class="btn btn-white btn-xs"><i class="fa fa-times" aria-hidden="true"></i> @guidanceLocalizer["DismissTour"]</button>
                        </form>
                    </div>
                </div>
            </section>
        </div>
    }
    @if (Model.WhatsNew != null)
    {
        var release = Model.WhatsNew;
        <div class="@(Model.Tour != null ? "col-lg-5" : "col-lg-12")">
            <section class="ibox" aria-labelledby="guidance-whatsnew-title">
                <div class="ibox-title">
                    <h5 id="guidance-whatsnew-title"><i class="fa fa-bullhorn" aria-hidden="true"></i> @release.Title</h5>
                </div>
                <div class="ibox-content">
                    @if (!string.IsNullOrWhiteSpace(release.Summary))
                    {
                        <p class="small">@release.Summary</p>
                    }
                    <ul class="small">
                        @foreach (var item in release.Items)
                        {
                            <li>@item.Title</li>
                        }
                    </ul>
                    <div class="rgw-toolbar">
                        <a class="btn btn-primary btn-xs" asp-controller="Help" asp-action="WhatsNew" asp-route-area="User" asp-route-release="@release.Release"><i class="fa fa-book" aria-hidden="true"></i> @string.Format(guidanceLocalizer["ReadMinutes"].Value, release.Minutes.ToString("0.#", System.Globalization.CultureInfo.CurrentCulture))</a>
                        <form method="post" asp-controller="Help" asp-action="Dismiss" asp-route-area="User" class="inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="key" value="@(AcademyManifests.WhatsNewKeyPrefix + release.Release)" />
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <button type="submit" class="btn btn-white btn-xs"><i class="fa fa-times" aria-hidden="true"></i> @guidanceLocalizer["DismissWhatsNew"]</button>
                        </form>
                    </div>
                </div>
            </section>
        </div>
    }
</div>
