@model Resgrid.Model.AdminAssist.SetupWorkspace
@using Resgrid.Model.AdminAssist
@using System.Globalization
@inject IAdminAssistCatalog catalog
@inject IStringLocalizer<Resgrid.Localization.Areas.User.AdminAssist.AdminAssist> aaLabels
@{
	// Setup progress as the wizard counts it: modules with a setup choice (security always has one) out of every module.
	var total = catalog.Areas.Count();
	var chosen = catalog.Areas.Count(a => a.Id == "security" || Model.Areas?.ContainsKey(a.Id) == true);
	var percent = total > 0 ? (chosen * 100.0 / total).ToString("0.##", CultureInfo.InvariantCulture) : "0";
	var progress = string.Format(aaLabels["Ui.AreasChosen"].Value, chosen, total);
}
<aside class="aa-setup-prompt" aria-labelledby="aa-setup-prompt-title">
	<span class="aa-setup-prompt__icon" aria-hidden="true"><i class="fa fa-magic"></i></span>
	<div class="aa-setup-prompt__body">
		<p class="aa-setup-prompt__title"><strong id="aa-setup-prompt-title">@aaLabels["Ui.wizard"]</strong> <span class="aa-setup-prompt__mode">@aaLabels["Ui." + Model.Mode]</span></p>
		<p class="aa-setup-prompt__text">@aaLabels["Ui.SetupPrompt"]</p>
		<div class="aa-setup-prompt__progress">
			<span class="aa-setup-prompt__bar" role="img" aria-label="@progress"><span style="width: @percent%"></span></span>
			<span class="aa-setup-prompt__count">@progress</span>
		</div>
	</div>
	<div class="aa-setup-prompt__actions">
		<a class="btn btn-primary btn-sm" asp-area="User" asp-controller="AdminAssist" asp-action="SetupWizard"><i class="fa fa-magic" aria-hidden="true"></i> @aaLabels["Ui.ResumeSetup"]</a>
		<a class="btn btn-white btn-sm" asp-area="User" asp-controller="AdminAssist" asp-action="SetupReport"><i class="fa fa-clipboard" aria-hidden="true"></i> @aaLabels["Ui.report"]</a>
		<form class="aa-setup-prompt__dismiss" asp-area="User" asp-controller="AdminAssist" asp-action="DismissSetup" method="post">
			<input type="hidden" name="revision" value="@Model.Revision" />
			<input type="hidden" name="catalogVersion" value="@Model.CatalogVersion" />
			<button type="submit" class="btn btn-link btn-xs"><i class="fa fa-times" aria-hidden="true"></i> @aaLabels["Ui.DismissSetup"]</button>
		</form>
	</div>
</aside>
