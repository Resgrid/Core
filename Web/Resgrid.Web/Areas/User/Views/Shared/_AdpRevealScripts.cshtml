@using System.Collections.Generic
@model Resgrid.Web.Areas.User.Models.AdpRevealView
@inject Resgrid.Model.Services.ISsoBrokerService ssoBroker
@inject Resgrid.Model.Services.ISsoReturnTargetRegistry ssoReturnTargets
@*
	Step-up modal + reveal module wiring (plan 7.2). Render inside the host view's Scripts
	section, paired with _AdpRevealBanner in the body. The grant issued by VerifyStepUp lives in
	the module's closure only — never a cookie, storage or the URL.

	A host page that needs to react to a reveal (re-fetching a client-rendered list with the
	grant attached, for example) defines window.resgridAdpPageRevealed / ...PageConcealed before
	this block runs; the module calls them and nothing else changes. ...PageRenewed runs after an
	in-place re-verification.

	Every page that renders this block gets the expiry warning: a fixed toast shown
	DataProtectionConfig.StepUpExpiryWarningSeconds before the grant window closes, with a
	re-verify button that renews the grant without leaving the page (revealed fields and typed
	work stay). Model.BindForms names the forms whose submit must carry the grant; Model.GrantExpiresOnUtc
	is set when the page was rendered by a *Revealed action and already holds the grant in that form.
*@
<div class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" id="adpStepUpModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title"><i class="fa fa-shield"></i> @commonLocalizer["AdpStepUpTitle"]</h4>
            </div>
            <div class="modal-body">
                <p>@commonLocalizer["AdpStepUpInstructions"]</p>
                <div class="alert alert-danger" id="adpStepUpError" style="display: none;"></div>
                <div class="form-group">
                    <label for="adpStepUpCode">@commonLocalizer["AdpVerificationCode"]</label>
                    <input type="text" class="form-control" id="adpStepUpCode" maxlength="8" autocomplete="one-time-code" inputmode="numeric" />
                </div>
                @* Other ways to verify, shown only when the server lists them for this user and department (passkey plan section 7.5). *@
                <div class="form-group">
                    <button type="button" class="btn btn-default" id="adpUsePasskey" style="display: none;"><i class="fa fa-key"></i> @commonLocalizer["AdpUsePasskey"]</button>
                    <button type="button" class="btn btn-default" id="adpUseResponder" style="display: none;"><i class="fa fa-mobile"></i> @commonLocalizer["AdpUseResponder"]</button>
                    <button type="button" class="btn btn-default" id="adpUseProvider" style="display: none;"><i class="fa fa-id-badge"></i> @commonLocalizer["AdpUseProvider"]</button>
                </div>
                <div class="well" id="adpApprovalPanel" style="display: none;" aria-live="polite">
                    <p>@commonLocalizer["AdpApprovalInstructions"]</p>
                    <p class="text-center" id="adpApprovalNumber" style="font-size: 32px; font-weight: bold; letter-spacing: 4px;"></p>
                    <p class="text-muted" id="adpApprovalStatus"></p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">@commonLocalizer["Cancel"]</button>
                <button type="button" class="btn btn-primary" id="adpStepUpSubmit">@commonLocalizer["AdpVerify"]</button>
            </div>
        </div>
    </div>
</div>

<form id="adpAntiForgeryForm">@Html.AntiForgeryToken()</form>
<script src="~/js/app/common/passkeys/resgrid.passkeys.js" type="text/javascript"></script>
<script src="~/js/app/internal/dataprotection/resgrid.adp.reveal.js" type="text/javascript"></script>
<script type="text/javascript">
    $(function () {
        resgridAdpReveal.init({
            verifyUrl: '@Url.Action("VerifyStepUp", "DataProtection", new { area = "User" })',
            @* Asked before the prompt is shown; answers step_up_required unless the department has
               exempted this app, in which case it returns a grant directly (plan 3.3). *@
            requestGrantUrl: '@Url.Action("RequestGrant", "DataProtection", new { area = "User" })',
            methodsUrl: '@Url.Action("StepUpMethods", "DataProtection", new { area = "User" })',
            passkeyOptionsUrl: '@Url.Action("PasskeyOptions", "DataProtection", new { area = "User" })',
            verifyPasskeyUrl: '@Url.Action("VerifyPasskey", "DataProtection", new { area = "User" })',
            requestApprovalUrl: '@Url.Action("RequestApproval", "DataProtection", new { area = "User" })',
            approvalStatusUrl: '@Url.Action("ApprovalStatus", "DataProtection", new { area = "User" })',
            completeApprovalUrl: '@Url.Action("CompleteApproval", "DataProtection", new { area = "User" })',
            @* Provider step-up runs in a popup through the department's identity provider and hands the grant back (plan section 7.8). *@
            federatedUrl: @Html.Raw(Resgrid.Web.Helpers.WebSsoRoundTrip.IsAvailable(ssoBroker, ssoReturnTargets)
                ? "'" + Url.Action("SsoSessionBegin", "Account", new { area = "" }) + "'"
                : "null"),
            @* A page with no per-record reveal endpoint (its values come from the API through its
               own component) leaves these unset; step-up alone is the whole job and the host
               reloads through onRevealed. *@
            revealUrl: @Html.Raw(string.IsNullOrWhiteSpace(Model.RevealAction)
                ? "null"
                : "'" + Url.Action(Model.RevealAction, Model.RevealController, new { area = "User" }) + "'"),
            revealData: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.RevealData)),
            grantExpiresOnUtc: @Html.Raw(Model.GrantExpiresOnUtc.HasValue ? "'" + Model.GrantExpiresOnUtc.Value.ToUniversalTime().ToString("O") + "'" : "null"),
            bindForms: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.BindForms ?? new List<string>())),
            warnBeforeSeconds: @Resgrid.Config.DataProtectionConfig.StepUpExpiryWarningSeconds,
            messages: {
                invalid_totp: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(commonLocalizer["AdpErrorInvalidCode"].Value)),
                too_many_attempts: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(commonLocalizer["AdpErrorTooManyAttempts"].Value)),
                mfa_not_enrolled: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(commonLocalizer["AdpErrorMfaNotEnrolled"].Value)),
                grants_not_configured: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(commonLocalizer["AdpErrorGrantsNotConfigured"].Value)),
                step_up_required: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(commonLocalizer["AdpErrorStepUpRequired"].Value)),
                grant_expired: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(commonLocalizer["AdpErrorGrantExpired"].Value)),
                grant_revoked: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(commonLocalizer["AdpErrorGrantRevoked"].Value)),
                protected_access_denied: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(commonLocalizer["AdpErrorAccessDenied"].Value)),
                broker_unavailable: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(commonLocalizer["AdpErrorBrokerUnavailable"].Value)),
                generic: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(commonLocalizer["AdpErrorGeneric"].Value)),
                expiring: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(commonLocalizer["AdpExpiringWarning"].Value)),
                expired: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(commonLocalizer["AdpExpiredWarning"].Value)),
                renew: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(commonLocalizer["AdpReverify"].Value)),
                passkey_cancelled: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(commonLocalizer["AdpPasskeyCancelled"].Value)),
                passkey_failed: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(commonLocalizer["AdpPasskeyFailed"].Value)),
                approval_waiting: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(commonLocalizer["AdpApprovalWaiting"].Value)),
                approval_denied: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(commonLocalizer["AdpApprovalDenied"].Value)),
                approval_expired: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(commonLocalizer["AdpApprovalExpired"].Value)),
                provider_popup_blocked: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(commonLocalizer["AdpProviderPopupBlocked"].Value))
            },
            onRevealed: function (values) {
                if (typeof window.resgridAdpPageRevealed === 'function')
                    window.resgridAdpPageRevealed(values);
            },
            onConcealed: function () {
                if (typeof window.resgridAdpPageConcealed === 'function')
                    window.resgridAdpPageConcealed();
            },
            onRenewed: function () {
                if (typeof window.resgridAdpPageRenewed === 'function')
                    window.resgridAdpPageRenewed();
            },
            antiForgeryToken: $('#adpAntiForgeryForm input[name="__RequestVerificationToken"]').val()
        });
    });
</script>
