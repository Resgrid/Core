@inject IStringLocalizer<Resgrid.Localization.Areas.User.CalOesMars.CalOesMars> calOesStrings
@*
    Page heading + module tabs shared by the Cal OES MARS screens (Workforce & Business Operations plan, Phase C-M3 / C6).
    ViewData["Title"] heading; ViewData["Subtitle"] optional; ViewData["MarsTab"] the active tab key.
*@
@{
    var title = (string)ViewData["Title"] ?? calOesStrings["CalOesMars"].Value;
    var subtitle = (string)ViewData["Subtitle"];
    var tab = (string)ViewData["MarsTab"] ?? "readiness";
    var isManager = ViewData["MarsIsManager"] as bool? ?? false;
    var canReconcile = ViewData["MarsCanReconcile"] as bool? ?? false;
}
<div class="row wrapper border-bottom white-bg page-heading rgw-page-heading">
    <div class="col-sm-12">
        <h2>@title</h2>
        <ol class="breadcrumb">
            <li><a asp-controller="Home" asp-action="Dashboard" asp-route-area="User">@commonLocalizer["HomeModule"]</a></li>
            @if (tab == "readiness")
            {
                <li class="active"><strong>@calOesStrings["CalOesMars"]</strong></li>
            }
            else
            {
                <li><a asp-controller="CalOesMars" asp-action="Index" asp-route-area="User">@calOesStrings["CalOesMars"]</a></li>
                <li class="active"><strong>@title</strong></li>
            }
        </ol>
        @if (!string.IsNullOrEmpty(subtitle))
        {
            <small class="text-muted">@subtitle</small>
        }
    </div>
    @await Html.PartialAsync("_WorkspaceHeaderActions")
        <div class="col-sm-12 rgw-module-navigation">
            <ul class="nav nav-pills rgw-module-tabs">
                <li class="@(tab == "readiness" ? "active" : null)"><a asp-controller="CalOesMars" asp-action="Index" aria-current="@(tab == "readiness" ? "page" : null)"><i class="fa fa-dashboard"></i> @calOesStrings["TabReadiness"]</a></li>
                <li class="@(tab == "queue" ? "active" : null)"><a asp-controller="CalOesMars" asp-action="Queue" aria-current="@(tab == "queue" ? "page" : null)"><i class="fa fa-tasks"></i> @calOesStrings["TabQueue"]</a></li>
                @if (isManager)
                {
                    <li class="@(tab == "rates" ? "active" : null)"><a asp-controller="CalOesMars" asp-action="Rates" aria-current="@(tab == "rates" ? "page" : null)"><i class="fa fa-table"></i> @calOesStrings["TabRates"]</a></li>
                    <li class="@(tab == "agreements" ? "active" : null)"><a asp-controller="CalOesMars" asp-action="Agreements" aria-current="@(tab == "agreements" ? "page" : null)"><i class="fa fa-file-text-o"></i> @calOesStrings["TabAgreements"]</a></li>
                    <li class="@(tab == "resources" ? "active" : null)"><a asp-controller="CalOesMars" asp-action="Resources" aria-current="@(tab == "resources" ? "page" : null)"><i class="fa fa-truck"></i> @calOesStrings["TabResources"]</a></li>
                    <li class="@(tab == "agency" ? "active" : null)"><a asp-controller="CalOesMars" asp-action="Agency" aria-current="@(tab == "agency" ? "page" : null)"><i class="fa fa-building"></i> @calOesStrings["TabAgency"]</a></li>
                }
                @if (isManager || canReconcile)
                {
                    <li class="@(tab == "reconciliation" ? "active" : null)"><a asp-controller="CalOesMars" asp-action="Reconciliation" aria-current="@(tab == "reconciliation" ? "page" : null)"><i class="fa fa-balance-scale"></i> @calOesStrings["TabReconciliation"]</a></li>
                }
            </ul>
        </div>
</div>
