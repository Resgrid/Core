@using Resgrid.Web.Areas.User.Models
@using Resgrid.Web.Helpers
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Signatures.Signatures> signatureText
@*
    Page heading for the signature pages (module-workspace.css): title, breadcrumb, a one line description and the sections
    (Verify a document for everyone; the e-sign platform account for department admins) in Shared/_ModuleTabs.
    ViewData["Section"] Verify or ESign; ViewData["Title"]; ViewData["Subtitle"]; ViewData["Message"] / ViewData["Error"].
*@
@{
    var section = ViewData["Section"] as string;
    var title = ViewData["Title"] as string ?? signatureText["SignaturesModuleTitle"].Value;
    var subtitle = ViewData["Subtitle"] as string;
    var message = ViewData["Message"] as string;
    var error = ViewData["Error"] as string;
    var sections = new ModuleTabsView { Label = signatureText["SignaturesModuleTitle"].Value };
    sections.Tabs.Add(new ModuleTab(signatureText["MySignaturesTab"].Value, "fa-pencil", "Signatures", "Mine", section == "Mine"));
    sections.Tabs.Add(new ModuleTab(signatureText["ApprovalsTab"].Value, "fa-check-square-o", "Approvals", "Index", false));
    sections.Tabs.Add(new ModuleTab(signatureText["VerifyTab"].Value, "fa-check-circle-o", "SealedDocuments", "Verify", section == "Verify"));
    if (ClaimsAuthorizationHelper.IsUserDepartmentAdmin())
    {
        sections.Tabs.Add(new ModuleTab(signatureText["ESignTab"].Value, "fa-pencil-square-o", "Signatures", "ESign", section == "ESign"));
    }
}
<div class="row wrapper border-bottom white-bg page-heading rgw-page-heading">
    <div class="col-sm-12">
        <h2>@title</h2>
        <ol class="breadcrumb">
            <li><a asp-controller="Home" asp-action="Dashboard" asp-route-area="User">@signatureText["HomeLink"]</a></li>
            <li class="active"><strong>@title</strong></li>
        </ol>
        @if (!string.IsNullOrEmpty(subtitle))
        {
            <small class="text-muted">@subtitle</small>
        }
    </div>
    <div class="col-sm-12 rgw-module-navigation">
        @await Html.PartialAsync("_ModuleTabs", sections)
    </div>
</div>
@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-success m-t-sm" role="status"><i class="fa fa-check" aria-hidden="true"></i> @message</div>
}
@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger m-t-sm" role="alert"><i class="fa fa-exclamation-triangle" aria-hidden="true"></i> @error</div>
}
