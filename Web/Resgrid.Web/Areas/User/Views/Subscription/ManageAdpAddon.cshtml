@using Newtonsoft.Json
@using Resgrid.Model
@using Resgrid.Web.Areas.User.Models.Subscription
@model Resgrid.Web.Areas.User.Models.Subscription.AdpAddonView
@inject IStringLocalizer<Resgrid.Localization.Areas.User.DataProtection.DataProtection> localizer
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Addons.Addons> addonLocalizer
@{
    ViewBag.Title = "Resgrid | " + @localizer["AddonPageTitle"];
    var adpAddon = Resgrid.Web.Areas.User.Models.Subscription.AddonCatalog.Get(PlanAddonTypes.ADP);

    // Billing status and protection status are shown as two separate lines throughout this page.
    // They genuinely can disagree - a cancelled addon still protects until its offboarding
    // migration runs - and collapsing them into one badge would tell a member their data was
    // already decrypted while it was not, or the reverse.
    var canCancel = Model.IsManagingMember && Model.HasAddon && !Model.IsCancelled;

    // JavaScript-encoded, not HTML-encoded. Html.Encode turns an apostrophe into &#x27;, which the
    // browser decodes back to ' while building the attribute value - the JS parser then sees an
    // unterminated string and the confirm() prompt silently stops running. Same escaping Index.cshtml
    // uses for the values it hands to script.
    var cancelConfirmJson = Html.Raw(JsonConvert.SerializeObject(localizer["AddonCancelConfirm"].Value,
        new JsonSerializerSettings { StringEscapeHandling = StringEscapeHandling.EscapeHtml }));
}

@section Styles {
    <link rel="stylesheet" href="~/css/addons.css" asp-append-version="true" />
}

<div class="row wrapper border-bottom white-bg page-heading">
    <div class="col-sm-8">
        <h2>@localizer["AddonManageHeading"]</h2>
        <ol class="breadcrumb">
            <li>
                <a asp-controller="Home" asp-action="Dashboard" asp-route-area="User">@localizer["BreadcrumbHome"]</a>
            </li>
            <li>
                <a asp-controller="Subscription" asp-action="Index" asp-route-area="User">@localizer["AddonBreadcrumbSubscription"]</a>
            </li>
            <li class="active">
                <strong>@localizer["AddonPageTitle"]</strong>
            </li>
        </ol>
    </div>
</div>

<div class="wrapper wrapper-content animated fadeInRight rg-addon-page addon-adp">
    <div class="rg-addon-hero">
        <div class="rg-addon-hero-main">
            <span class="rg-addon-icon rg-addon-icon-lg" aria-hidden="true"><i class="fa @adpAddon.Icon"></i></span>
            <div>
                <h2>@addonLocalizer[adpAddon.TitleKey]</h2>
                <p class="rg-addon-tagline">@addonLocalizer[adpAddon.TaglineKey]</p>
                <p class="rg-addon-hero-note">@addonLocalizer[adpAddon.NoteKey] <a href="@adpAddon.LearnMoreUrl" target="_blank" rel="noopener">@addonLocalizer["LearnMore"] <i class="fa fa-external-link" aria-hidden="true"></i></a></p>
            </div>
        </div>
        <div class="rg-addon-hero-price">
            <div class="rg-addon-price">@Model.Price<span class="rg-addon-period">@addonLocalizer["PerYear"]</span></div>
            <div class="rg-addon-unit">@addonLocalizer["PerDepartment"]</div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-10 col-lg-offset-1">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5><i class="fa fa-shield"></i> @localizer["AddonPageTitle"]</h5>
                </div>
                <div class="ibox-content">
                    @if (Model.AwaitingActivation)
                    {
                        <div class="alert alert-info" role="status"><i class="fa fa-spinner fa-spin" aria-hidden="true"></i> @addonLocalizer["BillingCheckoutComplete"]</div>
                    }
                    else if (Model.Result == AddonBillingResults.Complete)
                    {
                        <div class="alert alert-success" role="status"><i class="fa fa-check-circle" aria-hidden="true"></i> @addonLocalizer["BillingStatusActive"]</div>
                    }
                    else if (Model.Result == AddonBillingResults.Cancelled)
                    {
                        <div class="alert alert-warning" role="status"><i class="fa fa-info-circle" aria-hidden="true"></i> @addonLocalizer["BillingCheckoutCancelled"]</div>
                    }
                    @if (!Model.HasAddon)
                    {
                        // While a completed checkout waits for its webhook the page refreshes itself; offering another purchase then would be wrong.
                        if (!Model.AwaitingActivation)
                        {
                            <div class="alert alert-info">@localizer["AddonNotPurchased"]</div>
                            <a asp-controller="Subscription" asp-action="BuyAdpAddon" asp-route-area="User" class="btn btn-primary">@localizer["AddonBuyButton"]</a>
                        }
                    }
                    else
                    {
                        <dl class="dl-horizontal">
                            <dt>@localizer["AddonStatusLabel"]</dt>
                            <dd>
                                @if (Model.IsCancelled)
                                {
                                    <span class="label label-warning">@localizer["AddonStatusCancelled"]</span>
                                }
                                else
                                {
                                    <span class="label label-primary">@localizer["AddonStatusActive"]</span>
                                }
                            </dd>

                            @if (Model.EndingOn.HasValue)
                            {
                                <dt>@localizer["AddonRenewsOnLabel"]</dt>
                                <dd>@Model.EndingOn.Value.ToString("D")</dd>
                            }

                            @if (Model.PaidThroughOn.HasValue)
                            {
                                <dt>@localizer["AddonPaidThroughLabel"]</dt>
                                <dd>@Model.PaidThroughOn.Value.ToString("D")</dd>
                            }

                            <dt>@localizer["AddonProtectionStateLabel"]</dt>
                            <dd>@Model.ProtectionState.ToString()</dd>
                        </dl>

                        @if (Model.IsInGrace)
                        {
                            <div class="alert alert-warning">
                                @string.Format(localizer["AddonGraceNotice"].Value, Model.GraceEndsOn.Value.ToString("D"))
                            </div>
                        }

                        @if (Model.OffboardingEffectiveOn.HasValue)
                        {
                            <div class="alert alert-warning">
                                @string.Format(localizer["AddonOffboardingNotice"].Value, Model.OffboardingEffectiveOn.Value.ToString("D"))
                            </div>
                        }

                        <a asp-controller="DataProtection" asp-action="Index" asp-route-area="User" class="btn btn-primary">@localizer["AddonOpenSettings"]</a>

                        @if (canCancel)
                        {
                            <hr />
                            <p>@localizer["AddonCancelWarning"]</p>
                            <form asp-controller="Subscription" asp-action="CancelAdpAddon" asp-route-area="User" method="post"
                                  onsubmit='return confirm(@cancelConfirmJson);'>
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger">@localizer["AddonCancelButton"]</button>
                            </form>
                        }
                        else if (!Model.IsManagingMember)
                        {
                            <hr />
                            <div class="alert alert-warning">@localizer["AddonManagingMemberOnly"]</div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_AdpCheckoutScripts" model="Model" />
}
