@using Resgrid.Framework
@using Resgrid.Model
@model Resgrid.Web.Areas.User.Models.Subscription.BuyAddonView
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Subscription.Subscription> localizer
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Addons.Addons> addonLocalizer
@{
    ViewBag.Title = "Resgrid | " + @localizer["BuyAddonHeader"];
    var pttAddon = Resgrid.Web.Areas.User.Models.Subscription.AddonCatalog.Get(PlanAddonTypes.PTT);
    // Paddle departments change their packs through ManagePaddlePTTAddon; posting them to the Stripe action would always fail.
    var postAction = ViewBag.PttPostAction as string ?? "BuyAddon";
}

@section Styles
{
    <link rel="stylesheet" href="~/css/addons.css" asp-append-version="true" />
    <style>
        .up,
        .down {
          font-size: 6px;
          display: block;
          height: 10px;
        }
          .rotator  span {
          display: inline-block;
        }
    </style>
}

<div class="row wrapper border-bottom white-bg page-heading">
    <div class="col-sm-4">
        <h2>@localizer["BuyAddonHeader"]</h2>
        <ol class="breadcrumb">
            <li>
                <a asp-controller="Home" asp-action="Dashboard" asp-route-area="User">@commonLocalizer["HomeModule"]</a>
            </li>
            <li>
                <a asp-controller="Subscription" asp-action="Index" asp-route-area="User">@commonLocalizer["SubAndBilling"]</a>
            </li>
            <li class="active">
                <strong>@localizer["BuyAddonHeader"]</strong>
            </li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="col-xs-12">
        <div class="wrapper wrapper-content rg-addon-page addon-ptt">
            <div class="rg-addon-hero">
                <div class="rg-addon-hero-main">
                    <span class="rg-addon-icon rg-addon-icon-lg" aria-hidden="true"><i class="fa @pttAddon.Icon"></i></span>
                    <div>
                        <h2>@addonLocalizer[pttAddon.TitleKey]</h2>
                        <p class="rg-addon-tagline">@addonLocalizer[pttAddon.TaglineKey]</p>
                        <p class="rg-addon-hero-note">@addonLocalizer[pttAddon.NoteKey] <a href="@pttAddon.LearnMoreUrl" target="_blank" rel="noopener">@addonLocalizer["LearnMore"] <i class="fa fa-external-link" aria-hidden="true"></i></a></p>
                    </div>
                </div>
                <div class="rg-addon-hero-price">
                    <div class="rg-addon-price"><span class="rg-addon-currency">@Resgrid.Web.Areas.User.Models.Subscription.AddonCatalog.CurrencySymbol</span>@pttAddon.Price.ToString("N0")<span class="rg-addon-period">@addonLocalizer["PerMonth"]</span></div>
                    <div class="rg-addon-unit">@addonLocalizer["PerUserPack"]</div>
                </div>
            </div>
            <div class="ibox float-e-margins">
                <div class="ibox-content">
                    <form class="form-horizontal" role="form" asp-controller="Subscription" asp-action="@postAction" asp-route-area="User" method="post" id="payment-form" name="payment-form">
                        <div class="row">
                            <div class="col-sm-12">
                                <strong>@localizer["BuyPTTAddonInfo1"]</strong>

                                <h4>
                                    @localizer["BuyPTTAddonInfo2"]
                                </h4>

                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-8 col-md-offset-1 col-md-pull-1">
                                @if (!String.IsNullOrEmpty(Model.Message))
                                {
                                    <div class="alert alert-success">
                                        @Model.Message
                                    </div>
                                }
                                @Html.AntiForgeryToken()
                                @Html.HiddenFor(m => m.PlanAddonId)
                                <div asp-validation-summary="All" class="text-danger"></div>

                                @Html.TextBoxFor(m => m.Quantity, new { @class = "form-control numbersOnly", autofocus = "autofocus", type = "number", min = "0", step = "1", width = "50px" })

                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-8 col-md-offset-1 col-md-pull-1">
                                <p class="text-info">
                                    <b><span id="packCount">x</span></b> Ten Concurrent Push to Talk User Packs for a total <b><span id="packUserTotal">x</span></b> users costing @Resgrid.Web.Areas.User.Models.Subscription.AddonCatalog.CurrencySymbol<b><span id="packCost">10</span></b> a month
                                </p>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-8 col-md-offset-1 col-md-pull-1">
                                <div class="alert alert-warning">
                                    If you agree to the changes press save, else use the browsers back button or press @commonLocalizer["Cancel"]
                                    </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-sm-4 col-sm-offset-2">
                                <a class="btn btn-white" asp-controller="Subscription" asp-action="Index" asp-route-area="User">@commonLocalizer["Cancel"]</a>
                                <button class="btn btn-primary" type="submit" id="submit-button" name="submit-button">@commonLocalizer["Save"]</button>
                            </div>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script type="text/javascript">
		$(document).ready(function () {            
            $('input[name=Quantity]').change(function() { 
                updateQuantity();
             });
            
            $(".numbersOnly").keypress(function(event) {
              // Backspace, tab, enter, end, home, left, right
              // We don't support the del key in Opera because del == . == 46.
              var controlKeys = [8, 9, 13, 35, 36, 37, 39];
              // IE doesn't support indexOf
              var isControlKey = controlKeys.join(",").match(new RegExp(event.which));
              // Some browsers just don't raise events for control keys. Easy.
              // e.g. Safari backspace.
              if (!event.which || // Control keys in most browsers. e.g. Firefox tab is 0
                  (49 <= event.which && event.which <= 57) || // Always 1 through 9
                  (48 == event.which && $(this).attr("value")) || // No 0 first digit
                  isControlKey) { // Opera assigns values for control keys.
                return;
              } else {
                event.preventDefault();
              }
            });
            
            updateQuantity();
		});
        
        function updateQuantity() {
            let packCount = Number($('input[name=Quantity]').val())
            $('#packCount').text(packCount)
            $('#packUserTotal').text(packCount * 10)
            $('#packCost').text(packCount * @pttAddon.Price.ToString(System.Globalization.CultureInfo.InvariantCulture))
        }
	</script>
}
