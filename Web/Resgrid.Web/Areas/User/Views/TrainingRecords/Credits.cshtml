@using Resgrid.Model
@using Resgrid.Web.Areas.User.Models.Training
@model TrainingCreditsView
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Trainings.Trainings> localizer
@*
    Category credit mappings (T1 item 4, R-T5): a certification type counts the hours of a category. A verified record in the
    category becomes a credit in the certification cycle that contains its date, for records completed on or after the mapping was
    turned on; earlier history waits for "apply history to credits". Department administrators and certification managers edit.
*@
@{
    ViewBag.Title = "Resgrid | " + localizer["Rec.CreditsTitle"];
    ViewData["Section"] = "Records";
    ViewData["Title"] = localizer["Rec.CreditsTitle"].Value;
    ViewData["Subtitle"] = localizer["Rec.CreditsIntro"].Value;
    ViewData["Message"] = Model.Message;
    ViewData["Error"] = Model.Error;
    ViewData["SubTabs"] = Model.OfficerTabs;
    var input = Model.Input;
    var categories = Model.LiveCategories;
}

@await Html.PartialAsync("~/Areas/User/Views/Trainings/_Shell.cshtml")

<div class="wrapper wrapper-content rgw-page">
    @if (!Model.CanEdit)
    {
        <div class="alert alert-info" role="status"><i class="fa fa-lock" aria-hidden="true"></i> @localizer["Rec.CreditsReadOnly"]</div>
    }

    <div class="ibox float-e-margins">
        <div class="ibox-title"><h5><i class="fa fa-certificate" aria-hidden="true"></i> @localizer["Rec.MappingsHeader"]</h5></div>
        <div class="ibox-content">
            @if (Model.Mappings.Count == 0)
            {
                <p class="text-muted">@localizer["Rec.NoMappings"]</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped rgw-table">
                        <thead>
                            <tr>
                                <th>@localizer["Rec.CertificationTypeLabel"]</th>
                                <th>@localizer["Doc.Category"]</th>
                                <th>@localizer["Rec.ComponentLabel"]</th>
                                <th>@localizer["Doc.Status"]</th>
                                @if (Model.CanEdit)
                                {
                                    <th class="rgw-row-actions">@localizer["ActionColumn"]</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var mapping in Model.Mappings)
                            {
                                var category = Model.CategoryOf(mapping.CategoryId);
                                <tr>
                                    <td>@(Model.TypeName(mapping.DepartmentCertificationTypeId) ?? localizer["Rec.RemovedLabel"].Value)</td>
                                    <td>@(category == null ? localizer["Rec.RemovedLabel"].Value : category.IsDeleted ? string.Format(localizer["Rec.RemovedCategory"].Value, category.Name) : category.Name)</td>
                                    <td>@(string.IsNullOrWhiteSpace(mapping.ComponentKey) ? localizer["Rec.EveryComponent"].Value : mapping.ComponentKey)</td>
                                    <td>
                                        @if (mapping.IsEnabled)
                                        {
                                            <span class="label label-primary"><i class="fa fa-check" aria-hidden="true"></i> @localizer["Rec.EnabledLabel"]</span>
                                            @if (mapping.EnabledOn.HasValue)
                                            {
                                                <small class="rgw-sub text-muted">@string.Format(localizer["Rec.EnabledSince"].Value, TrainingStatePresentation.LocalDate(mapping.EnabledOn, Model.Department))</small>
                                            }
                                        }
                                        else
                                        {
                                            <span class="label label-default"><i class="fa fa-pause" aria-hidden="true"></i> @localizer["Rec.DisabledLabel"]</span>
                                        }
                                    </td>
                                    @if (Model.CanEdit)
                                    {
                                        <td class="rgw-row-actions">
                                            <a class="btn btn-xs btn-default" asp-controller="TrainingRecords" asp-action="Credits" asp-route-area="User" asp-route-id="@mapping.CategoryCreditMappingId"><i class="fa fa-pencil" aria-hidden="true"></i> @localizer["EditButton"]</a>
                                            <form method="post" asp-controller="TrainingRecords" asp-action="SaveMapping" asp-route-area="User">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="CategoryCreditMappingId" value="@mapping.CategoryCreditMappingId" />
                                                <input type="hidden" name="DepartmentCertificationTypeId" value="@mapping.DepartmentCertificationTypeId" />
                                                <input type="hidden" name="CategoryId" value="@mapping.CategoryId" />
                                                <input type="hidden" name="ComponentKey" value="@mapping.ComponentKey" />
                                                <input type="hidden" name="IsEnabled" value="@(mapping.IsEnabled ? "false" : "true")" />
                                                <button type="submit" class="btn btn-xs btn-default"><i class="fa @(mapping.IsEnabled ? "fa-pause" : "fa-play")" aria-hidden="true"></i> @localizer[mapping.IsEnabled ? "Rec.DisableButton" : "Rec.EnableButton"]</button>
                                            </form>
                                            <form method="post" asp-controller="TrainingRecords" asp-action="DeleteMapping" asp-route-area="User" asp-route-id="@mapping.CategoryCreditMappingId">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-xs btn-danger" data-confirm="@localizer["Rec.DeleteMappingConfirm"]"><i class="fa fa-trash" aria-hidden="true"></i> @localizer["DeleteButton"]</button>
                                            </form>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @if (Model.CanEdit)
    {
        <div class="ibox float-e-margins">
            <div class="ibox-title"><h5><i class="fa @(input.IsNew ? "fa-plus" : "fa-pencil")" aria-hidden="true"></i> @localizer[input.IsNew ? "Rec.AddMappingHeader" : "Rec.EditMappingHeader"]</h5></div>
            <div class="ibox-content">
                @if (Model.Types.Count == 0 || categories.Count == 0)
                {
                    <p class="text-muted">@localizer["Rec.MappingNeedsTypesAndCategories"]</p>
                }
                else
                {
                    <form method="post" asp-controller="TrainingRecords" asp-action="SaveMapping" asp-route-area="User">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="CategoryCreditMappingId" value="@input.CategoryCreditMappingId" />
                        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
                        <div class="rgw-grid">
                            <div class="form-group">
                                <label for="DepartmentCertificationTypeId" class="required">@localizer["Rec.CertificationTypeLabel"]</label>
                                <select id="DepartmentCertificationTypeId" name="DepartmentCertificationTypeId" class="form-control" required>
                                    <option value="">@localizer["SelectPlaceholder"]</option>
                                    @foreach (var type in Model.Types)
                                    {
                                        <option value="@type.DepartmentCertificationTypeId" selected="@(input.DepartmentCertificationTypeId == type.DepartmentCertificationTypeId)">@Model.TypeName(type.DepartmentCertificationTypeId)</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="CategoryId" class="required">@localizer["Doc.Category"]</label>
                                <select id="CategoryId" name="CategoryId" class="form-control" required>
                                    <option value="">@localizer["SelectPlaceholder"]</option>
                                    @foreach (var category in categories)
                                    {
                                        <option value="@category.TrainingCategoryId" selected="@(input.CategoryId == category.TrainingCategoryId)">@category.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="ComponentKey">@localizer["Rec.ComponentLabel"]</label>
                                <input id="ComponentKey" name="ComponentKey" class="form-control" maxlength="100" value="@input.ComponentKey" aria-describedby="ComponentKey-help" />
                                <span class="help-block" id="ComponentKey-help">@localizer["Rec.ComponentHelp"]</span>
                            </div>
                            <div class="form-group">
                                <div class="checkbox">
                                    <label>
                                        <input type="checkbox" name="IsEnabled" value="true" checked="@input.IsEnabled" />
                                        <input type="hidden" name="IsEnabled" value="false" />
                                        @localizer["Rec.EnabledLabel"]
                                    </label>
                                </div>
                                <span class="help-block">@localizer["Rec.MappingEnabledHelp"]</span>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary"><i class="fa fa-check" aria-hidden="true"></i> @localizer["Rec.SaveMappingButton"]</button>
                        @if (!input.IsNew)
                        {
                            <a class="btn btn-default" asp-controller="TrainingRecords" asp-action="Credits" asp-route-area="User"><i class="fa fa-times" aria-hidden="true"></i> @localizer["CancelButton"]</a>
                        }
                    </form>
                }
            </div>
        </div>

        <div class="ibox float-e-margins">
            <div class="ibox-title"><h5><i class="fa fa-history" aria-hidden="true"></i> @localizer["Rec.ApplyHistoryHeader"]</h5></div>
            <div class="ibox-content">
                <p class="text-muted">@localizer["Rec.ApplyHistoryHelp"]</p>
                @if (Model.MappedTypes.Count == 0)
                {
                    <p class="text-muted">@localizer["Rec.NoMappings"]</p>
                }
                else
                {
                    <ul class="rgw-journey">
                        @foreach (var type in Model.MappedTypes)
                        {
                            <li>
                                <span>@Model.TypeName(type.DepartmentCertificationTypeId)</span>
                                <a class="btn btn-xs btn-default" asp-controller="TrainingRecords" asp-action="ApplyHistory" asp-route-area="User" asp-route-typeId="@type.DepartmentCertificationTypeId"><i class="fa fa-history" aria-hidden="true"></i> @localizer["Rec.ApplyHistoryLink"]</a>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/module-workspace.css" asp-append-version="true" />
    <style>
        .rgw-row-actions form { display: inline-block; }
    </style>
}
