@using Resgrid.Model
@using Resgrid.Web.Areas.User.Models.Training
@model TrainingMySubmissionsView
@inject IStringLocalizer<Resgrid.Localization.Areas.User.TrainingReviews.TrainingReviews> text
@*
    The member's own training hours submissions (round 9B) and where each stands: waiting for review, more information needed (open it to
    add evidence and resubmit), approved, denied with the reason, or accepted as self-reported.
*@
@{
    ViewBag.Title = "Resgrid | " + text["Mine.Title"];
    ViewData["Section"] = "Transcript";
    ViewData["Title"] = text["Mine.Title"].Value;
    ViewData["Subtitle"] = text["Mine.Intro"].Value;
    ViewData["Message"] = Model.Message;
    ViewData["Error"] = Model.Error;

    Func<dynamic, Microsoft.AspNetCore.Html.IHtmlContent> headerActions = @<text>
        <a class="btn btn-success" asp-controller="TrainingRecords" asp-action="Submit" asp-route-area="User"><i class="fa fa-plus" aria-hidden="true"></i> @text["Mine.SubmitButton"]</a>
    </text>;
    ViewData["HeaderActions"] = Model.SubmissionsDisabled ? null : headerActions;
}

@await Html.PartialAsync("~/Areas/User/Views/Trainings/_Shell.cshtml")

<div class="wrapper wrapper-content rgw-page">
    <div class="ibox float-e-margins">
        <div class="ibox-content">
            @if (Model.Submissions.Count == 0)
            {
                <p class="text-muted m-b-none">@text["Mine.Empty"]</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped rgw-table">
                        <thead>
                            <tr>
                                <th scope="col">@text["Col.Training"]</th>
                                <th scope="col" class="text-right">@text["Col.Hours"]</th>
                                <th scope="col">@text["Col.State"]</th>
                                <th scope="col">@text["Detail.SubmittedOn"]</th>
                                <th scope="col" class="rgw-row-actions">@text["Col.Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var record in Model.Submissions)
                            {
                                var state = TrainingSubmissionRules.StateOf(record);
                                var category = Model.CategoryOf(record.CategoryId);
                                <tr>
                                    <td>
                                        @record.Title
                                        <small class="rgw-sub text-muted">
                                            <span>@TrainingStatePresentation.LocalDate(record.CompletedOn, Model.Department)</span>
                                            <span>@text["Col.Category"]: @(category?.Name ?? text["Filter.Uncategorized"].Value)</span>
                                        </small>
                                        @if ((state == TrainingSubmissionReviewStates.InfoRequested || state == TrainingSubmissionReviewStates.Denied) && !string.IsNullOrWhiteSpace(record.ReviewNote))
                                        {
                                            <small class="rgw-sub"><i class="fa fa-comment-o" aria-hidden="true"></i> @record.ReviewNote</small>
                                        }
                                    </td>
                                    <td class="text-right">@LearningRecordPresentation.Hours(record.Hours)</td>
                                    <td><span class="label @TrainingReviewPresentation.StateClass(state)"><i class="fa @TrainingReviewPresentation.StateIcon(state)" aria-hidden="true"></i> @text[TrainingReviewPresentation.StateKey(state) ?? "State.AwaitingReview"]</span></td>
                                    <td>@TrainingStatePresentation.LocalDateTime(TrainingSubmissionRules.WaitingSince(record), Model.Department)</td>
                                    <td class="rgw-row-actions">
                                        <a class="btn btn-xs @(state == TrainingSubmissionReviewStates.InfoRequested ? "btn-primary" : "btn-default")" asp-controller="TrainingReviews" asp-action="Submission" asp-route-area="User" asp-route-id="@record.LearningRecordId"><i class="fa fa-folder-open-o" aria-hidden="true"></i> @text["Mine.OpenButton"]</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/module-workspace.css" asp-append-version="true" />
}
