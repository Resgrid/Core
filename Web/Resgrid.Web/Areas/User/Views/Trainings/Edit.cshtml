@using Resgrid.Web.Areas.User.Models.Training
@model EditTrainingModel
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Trainings.Trainings> localizer
@{
    ViewBag.Title = "Resgrid | " + localizer["EditTrainingHeader"];
    ViewData["Title"] = localizer["EditTrainingHeader"].Value;
    ViewData["Subtitle"] = Model.Name;
    ViewData["Message"] = Model.Message;
    ViewData["Error"] = Model.Error;

    Func<dynamic, Microsoft.AspNetCore.Html.IHtmlContent> headerActions = @<text>
        <a class="btn btn-default" asp-controller="Trainings" asp-action="View" asp-route-area="User" asp-route-trainingId="@Model.TrainingId"><i class="fa fa-eye" aria-hidden="true"></i> @localizer["ViewTrainingButton"]</a>
        @if (Model.CanAssign)
        {
            <a class="btn btn-primary" asp-controller="Trainings" asp-action="Report" asp-route-area="User" asp-route-trainingId="@Model.TrainingId"><i class="fa fa-bar-chart" aria-hidden="true"></i> @localizer["ReportButton"]</a>
        }
    </text>;
    ViewData["HeaderActions"] = headerActions;
}

@await Html.PartialAsync("_Shell")

<div class="wrapper wrapper-content">
    @await Html.PartialAsync("_Editor", (TrainingEditorModel)Model)
    @await Html.PartialAsync("_EditorAids", (TrainingEditorModel)Model)
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/module-workspace.css" asp-append-version="true" />
}
@section Scripts {
    @await Html.PartialAsync("_EditorScripts")
}
