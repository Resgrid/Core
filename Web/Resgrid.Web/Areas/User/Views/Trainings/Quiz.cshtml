@using Resgrid.Model
@using Resgrid.Web.Areas.User.Models.Training
@model TrainingQuizView
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Trainings.Trainings> localizer
@*
    The quiz player: questions and options only (R-T11). The answer key never reaches the page; the server scores.
    With OneQuestionPerPage the script shows one question at a time; without script every question shows.
*@
@{
    ViewBag.Title = "Resgrid | " + localizer["QuizPageHeader"];
    ViewData["Title"] = localizer["QuizPageHeader"].Value;
    ViewData["Subtitle"] = Model.Name;
    var number = 0;
}

@await Html.PartialAsync("_Shell")

<div class="wrapper wrapper-content rgw-page">
    <div class="ibox">
        <div class="ibox-content">
            <p>@string.Format(localizer["QuizIntro"].Value, Model.Questions.Count, Model.MinimumScore.ToString("0.##"))</p>
            @if (Model.AttemptsLeft.HasValue)
            {
                <p class="rgw-progress-honest"><i class="fa fa-repeat" aria-hidden="true"></i> @string.Format(localizer["AttemptsLeftValue"].Value, Model.AttemptsLeft.Value)</p>
            }
            @if (Model.IsPreview)
            {
                <div class="alert alert-info"><i class="fa fa-eye" aria-hidden="true"></i> @localizer["QuizPreviewNotice"]</div>
            }

            <form id="quizForm" method="post" asp-controller="Trainings" asp-action="SubmitQuiz" asp-route-area="User" asp-route-trainingId="@Model.TrainingId" data-one-per-page="@(Model.OneQuestionPerPage ? "true" : "false")">
                @Html.AntiForgeryToken()
                @foreach (var question in Model.Questions)
                {
                    number++;
                    var name = "question_" + question.QuestionId;
                    var inputType = question.Type == (int)TrainingQuestionTypes.MultiChoice ? "checkbox" : "radio";
                    <fieldset class="rgw-builder-section quiz-question" data-index="@number">
                        <legend class="rgw-builder-heading">@string.Format(localizer["QuestionOfValue"].Value, number, Model.Questions.Count)</legend>
                        <p><strong>@question.Text</strong></p>
                        @if (question.Type == (int)TrainingQuestionTypes.MultiChoice)
                        {
                            <p class="text-muted"><i class="fa fa-check-square-o" aria-hidden="true"></i> @localizer["SelectAllThatApply"]</p>
                        }
                        @foreach (var option in question.Options)
                        {
                            var id = name + "_" + option.OptionId;
                            <div class="@inputType">
                                <label for="@id"><input type="@inputType" id="@id" name="@name" value="@option.OptionId" /> @option.Text</label>
                            </div>
                        }
                    </fieldset>
                }

                <div class="rgw-wizard-actions">
                    <button type="button" class="btn btn-default quiz-previous" style="display:none"><i class="fa fa-chevron-left" aria-hidden="true"></i> @localizer["PreviousButton"]</button>
                    <span class="rgw-progress-honest quiz-position" aria-live="polite"></span>
                    <button type="button" class="btn btn-default quiz-next" style="display:none">@localizer["NextButton"] <i class="fa fa-chevron-right" aria-hidden="true"></i></button>
                    @if (!Model.IsPreview)
                    {
                        <button type="submit" class="btn btn-primary quiz-submit" data-confirm="@localizer["SubmitQuizConfirm"]"><i class="fa fa-check" aria-hidden="true"></i> @localizer["FinishButton"]</button>
                    }
                    <a class="btn btn-white" asp-controller="Trainings" asp-action="View" asp-route-area="User" asp-route-trainingId="@Model.TrainingId">@localizer["CancelButton"]</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/module-workspace.css" asp-append-version="true" />
}
@section Scripts {
    <script>
        var resgridQuizI18n = @Html.ScriptJson(new { position = localizer["QuestionOfValue"].Value });
    </script>
    <script src="~/js/app/internal/training/resgrid.training.quiz.js" asp-append-version="true"></script>
}
