@using Resgrid.Model
@using Resgrid.Web.Areas.User.Models.Training
@model ViewTrainingModel
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Trainings.Trainings> localizer
@{
    ViewBag.Title = "Resgrid | " + Model.Training.Name;
    ViewData["Title"] = Model.Training.Name;
    ViewData["Message"] = Model.Message;
    ViewData["Error"] = Model.Error;

    var training = Model.Training;
    var assignment = Model.Assignment;
    var assigned = assignment != null && !assignment.RemovedOn.HasValue;
    // Round 7B: holders of Record Training Completions (135) record that members completed it together.
    var recordCompletions = Resgrid.Web.Helpers.ClaimsAuthorizationHelper.CanApplyTrainingCompletions();

    Func<dynamic, Microsoft.AspNetCore.Html.IHtmlContent> headerActions = @<text>
        @if (Model.CanAuthor || Model.CanAssign)
        {
            <a class="btn btn-info" asp-controller="Trainings" asp-action="Edit" asp-route-area="User" asp-route-trainingId="@training.TrainingId"><i class="fa fa-pencil" aria-hidden="true"></i> @localizer["EditButton"]</a>
        }
        @if (Model.CanAssign)
        {
            <a class="btn btn-primary" asp-controller="Trainings" asp-action="Report" asp-route-area="User" asp-route-trainingId="@training.TrainingId"><i class="fa fa-bar-chart" aria-hidden="true"></i> @localizer["ReportButton"]</a>
        }
        @if (recordCompletions)
        {
            <a class="btn btn-default" asp-controller="Trainings" asp-action="RecordCompletions" asp-route-area="User" asp-route-targetId="@training.TrainingId"><i class="fa fa-check-circle-o" aria-hidden="true"></i> @localizer["RecordCompletions.Title"]</a>
        }
    </text>;
    ViewData["HeaderActions"] = Model.CanAuthor || Model.CanAssign || recordCompletions ? headerActions : null;
}

@await Html.PartialAsync("_Shell")

<div class="wrapper wrapper-content">
    <div class="row">
        <div class="col-lg-9 col-md-8">
            <div class="ibox">
                <div class="ibox-content">
                    @if (training.IsArchived)
                    {
                        <div class="alert alert-warning"><i class="fa fa-archive" aria-hidden="true"></i> @localizer["ArchivedNotice"]</div>
                    }
                    @if (!training.HasStarted(DateTime.UtcNow))
                    {
                        <div class="alert alert-info"><i class="fa fa-clock-o" aria-hidden="true"></i> @string.Format(localizer["ScheduledNotice"].Value, TrainingStatePresentation.LocalDateTime(training.StartsOn, Model.Department))</div>
                    }
                    <div class="lead">@Html.SanitizedHtmlWithEmbeds(training.Description)</div>
                    <hr />
                    <div class="training-content">@Html.TrainingContent(training.TrainingText)</div>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-4">
            @if (!training.IsArchived && training.HasStarted(DateTime.UtcNow))
            {
                @await Html.PartialAsync("_KnowledgeAsk", new Resgrid.Web.Areas.User.Models.Knowledge.KnowledgeAskPanelModel { Surface = (int)KnowledgeAskSurfaces.Training, ScopeKind = (int)KnowledgeSourceKinds.Training, ScopeItemId = training.TrainingId.ToString(System.Globalization.CultureInfo.InvariantCulture), PanelId = "kask-training" })
            }
            <div class="ibox">
                <div class="ibox-title"><h5><i class="fa fa-tasks" aria-hidden="true"></i> @localizer["ProgressHeader"]</h5></div>
                <div class="ibox-content">
                    @if (assigned && Model.State.HasValue)
                    {
                        <p>@await Html.PartialAsync("_StatePill", Model.State.Value)</p>
                        <ul class="list-unstyled rgw-progress-honest">
                            <li><i class="fa @(assignment.Viewed ? "fa-check-square-o" : "fa-square-o")" aria-hidden="true"></i> @(assignment.Viewed ? string.Format(localizer["ViewedOnValue"].Value, TrainingStatePresentation.LocalDate(assignment.ViewedOn, Model.Department)) : localizer["NotViewed"].Value)</li>
                            @if (Model.HasQuiz)
                            {
                                <li>
                                    <i class="fa @(assignment.Complete ? "fa-check-square-o" : "fa-square-o")" aria-hidden="true"></i>
                                    @if (assignment.Passed == true)
                                    {
                                        @string.Format(localizer["QuizPassedValue"].Value, assignment.Score.ToString("0.##"))
                                    }
                                    else if (assignment.Passed == false)
                                    {
                                        @string.Format(localizer["QuizFailedValue"].Value, assignment.Score.ToString("0.##"), training.MinimumScore.ToString("0.##"))
                                    }
                                    else
                                    {
                                        @string.Format(localizer["QuizNotTakenValue"].Value, training.MinimumScore.ToString("0.##"))
                                    }
                                </li>
                                if (Model.AttemptsLeft.HasValue)
                                {
                                    <li><i class="fa fa-repeat" aria-hidden="true"></i> @string.Format(localizer["AttemptsLeftValue"].Value, Model.AttemptsLeft.Value)</li>
                                }
                            }
                            @if (assignment.Complete)
                            {
                                <li><i class="fa fa-check-circle" aria-hidden="true"></i> @string.Format(localizer["CompletedOnValue"].Value, TrainingStatePresentation.LocalDate(assignment.CompletedOn, Model.Department))</li>
                            }
                            <li><i class="fa fa-calendar" aria-hidden="true"></i> @(Model.DueUtc.HasValue ? localizer["DueOnLabel"].Value + " " + TrainingStatePresentation.LocalDate(Model.DueUtc, Model.Department) : localizer["NoDueDate"].Value)</li>
                            @if (assignment.ExtendedOn.HasValue)
                            {
                                <li><i class="fa fa-calendar-plus-o" aria-hidden="true"></i> @localizer["ExtendedLabel"]</li>
                            }
                            @if (assignment.IsExemptOn(DateTime.UtcNow))
                            {
                                <li><i class="fa fa-ban" aria-hidden="true"></i> @localizer["ExemptNotice"]</li>
                            }
                            @if (Model.OnLeave)
                            {
                                <li><i class="fa fa-pause-circle" aria-hidden="true"></i> @localizer["OnLeaveNotice"]</li>
                            }
                        </ul>

                        @* Round 9A read and confirm: a training without a quiz that asks for it completes on the member's confirmation. *@
                        if (training.RequiresAcknowledgment && !Model.HasQuiz && !assignment.Complete && !assignment.IsExemptOn(DateTime.UtcNow))
                        {
                            <form method="post" asp-controller="Trainings" asp-action="Acknowledge" asp-route-area="User" asp-route-trainingId="@training.TrainingId" class="m-b-sm">
                                @Html.AntiForgeryToken()
                                <div class="checkbox"><label><input type="checkbox" name="confirmed" value="true" required /> @localizer["AckStatement"]</label></div>
                                <button type="submit" class="btn btn-primary btn-block"><i class="fa fa-check" aria-hidden="true"></i> @localizer["AckButton"]</button>
                            </form>
                        }
                        if (Model.CanTakeQuiz)
                        {
                            <a class="btn btn-primary btn-block" asp-controller="Trainings" asp-action="Quiz" asp-route-area="User" asp-route-trainingId="@training.TrainingId">
                                <i class="fa @(assignment.Passed == false ? "fa-repeat" : "fa-pencil-square-o")" aria-hidden="true"></i> @(assignment.Passed == false ? localizer["RetakeQuizButton"] : localizer["TakeQuizButton"])
                            </a>
                        }
                        else if (Model.HasQuiz && !assignment.Complete && Model.AttemptsLeft == 0)
                        {
                            <p class="text-danger"><i class="fa fa-exclamation-circle" aria-hidden="true"></i> @localizer["QuizAttemptLimitError"]</p>
                        }
                    }
                    else if (Model.CanEnroll)
                    {
                        <p class="text-muted">@localizer["EnrollHelp"]</p>
                        <form method="post" asp-controller="Trainings" asp-action="Enroll" asp-route-area="User" asp-route-trainingId="@training.TrainingId">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-primary btn-block"><i class="fa fa-user-plus" aria-hidden="true"></i> @localizer["EnrollButton"]</button>
                        </form>
                    }
                    else
                    {
                        <p class="text-muted">@localizer["NotAssignedNotice"]</p>
                        if (Model.HasQuiz && (Model.CanAuthor || Model.CanAssign))
                        {
                            <a class="btn btn-default btn-block" asp-controller="Trainings" asp-action="Quiz" asp-route-area="User" asp-route-trainingId="@training.TrainingId"><i class="fa fa-eye" aria-hidden="true"></i> @localizer["PreviewQuizButton"]</a>
                        }
                    }
                </div>
            </div>

            <div class="ibox">
                <div class="ibox-title"><h5><i class="fa fa-paperclip" aria-hidden="true"></i> @localizer["TrainingAttachmentsHeader"]</h5></div>
                <div class="ibox-content">
                    @if (training.Attachments != null && training.Attachments.Count > 0)
                    {
                        <ul class="list-unstyled project-files">
                            @foreach (var attachment in training.Attachments)
                            {
                                <li><a asp-controller="Trainings" asp-action="GetTrainingAttachment" asp-route-area="User" asp-route-trainingAttachmentId="@attachment.TrainingAttachmentId" target="_blank"><i class="fa fa-file" aria-hidden="true"></i> @attachment.FileName</a></li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted">@localizer["NoAttachments"]</p>
                    }
                </div>
            </div>

            <div class="ibox">
                <div class="ibox-title"><h5><i class="fa fa-info-circle" aria-hidden="true"></i> @localizer["DetailsHeader"]</h5></div>
                <div class="ibox-content">
                    <dl>
                        @if (!string.IsNullOrEmpty(Model.CreatorUserName))
                        {
                            <dt>@localizer["CreatedByLabel"]</dt><dd>@Model.CreatorUserName</dd>
                        }
                        <dt>@localizer["CreatedOnLabel"]</dt><dd>@TrainingStatePresentation.LocalDate(training.CreatedOn, Model.Department)</dd>
                        @if (training.Hours.HasValue)
                        {
                            <dt>@localizer["HoursLabel"]</dt><dd>@training.Hours.Value.ToString("0.##")</dd>
                        }
                        @if (training.CeHours.HasValue || !string.IsNullOrEmpty(training.CeProvider) || !string.IsNullOrEmpty(training.CeCourseNumber))
                        {
                            <dt>@localizer["CeHoursLabel"]</dt>
                            <dd>@(training.CeHours?.ToString("0.##") ?? "-") @training.CeProvider @training.CeCourseNumber</dd>
                        }
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/module-workspace.css" asp-append-version="true" />
    <style>
        .training-content iframe.rg-embed { width: 100%; max-width: 960px; aspect-ratio: 16 / 9; height: auto; border: 0; }
        .training-content img { max-width: 100%; height: auto; }
    </style>
}
