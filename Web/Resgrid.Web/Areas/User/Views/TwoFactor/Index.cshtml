@model Resgrid.Web.Areas.User.Models.TwoFactor.TwoFactorIndexViewModel
@inject IStringLocalizer<Resgrid.Localization.Areas.User.TwoFactor.TwoFactor> localizer
@{
    ViewBag.Title = "Resgrid | " + localizer["PageTitle"];
}

<div class="row wrapper border-bottom white-bg page-heading">
    <div class="col-sm-4">
        <h2>@localizer["PageTitle"]</h2>
        <ol class="breadcrumb">
            <li><a asp-controller="Home" asp-action="Dashboard" asp-route-area="User">@commonLocalizer["HomeModule"]</a></li>
            <li class="active"><strong>@localizer["BreadcrumbTwoFactor"]</strong></li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="col-xs-12">
        <div class="wrapper wrapper-content">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>@localizer["AuthenticatorAppHeader"]</h5>
                </div>
                <div class="ibox-content">
                    @if (TempData["StatusMessage"] != null)
                    {
                        <div class="alert alert-success">@TempData["StatusMessage"]</div>
                    }

                    @if (Model.Is2FAEnabled)
                    {
                        <div class="alert alert-success">
                            <i class="fa fa-check-circle"></i> @Html.Raw(localizer["TwoFactorEnabledAlert"].Value)
                        </div>

                        @if (Model.RecoveryCodeWarning)
                        {
                            <div class="alert alert-warning">
                                <i class="fa fa-exclamation-triangle"></i>
                                @string.Format(localizer["RecoveryCodesWarningText"].Value, Model.RecoveryCodesLeft)
                                <form asp-action="RegenerateRecoveryCodes" method="post" style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-link p-0 align-baseline">@localizer["RegenerateRecoveryCodesButton"]</button>
                                </form>
                            </div>
                        }
                        else
                        {
                            <p>@string.Format(localizer["RecoveryCodesRemainingText"].Value, Model.RecoveryCodesLeft)</p>
                        }

                        <form asp-action="RegenerateRecoveryCodes" method="post" style="display:inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-warning">@localizer["RegenerateRecoveryCodesButton"]</button>
                        </form>
                        <a asp-action="ReplaceAuthenticator" class="btn btn-default">@localizer["ReplaceAuthenticatorButton"]</a>
                        <a asp-action="Disable2FA" class="btn btn-danger">@localizer["Disable2FAButton"]</a>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <i class="fa fa-exclamation-triangle"></i>
                            @Html.Raw(localizer["TwoFactorDisabledAlert"].Value)
                        </div>
                        <a asp-action="Enable2FA" class="btn btn-primary">@localizer["EnableAuthenticatorButton"]</a>
                    }
                </div>
            </div>

            @if (Model.PasskeyStatus != null)
            {
                <div class="alert alert-success" role="status">
                    @(Model.PasskeyStatus == "added" ? localizer["PasskeyAdded"] : Model.PasskeyStatus == "renamed" ? localizer["PasskeyRenamed"] : localizer["PasskeyRemoved"])
                </div>
            }
            <partial name="_Passkeys" model="Model" />
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/app/common/passkeys/resgrid.passkeys.js" type="text/javascript"></script>
    <script src="~/js/app/internal/security/resgrid.account.passkeys.js" type="text/javascript"></script>
    <script type="text/javascript">
        $(function () {
            resgridAccountPasskeys.init({
                optionsUrl: '@Url.Action("RegistrationOptions", "Passkeys", new { area = "User" })',
                completeUrl: '@Url.Action("CompleteRegistration", "Passkeys", new { area = "User" })',
                renameUrl: '@Url.Action("Rename", "Passkeys", new { area = "User" })',
                removeUrl: '@Url.Action("Remove", "Passkeys", new { area = "User" })',
                pageUrl: '@Url.Action("Index", "TwoFactor", new { area = "User" })',
                signInUrl: '@Url.Action("LogOn", "Account", new { area = "" })',
                messages: {
                    failed: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(localizer["PasskeyFailed"].Value)),
                    cancelled: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(localizer["PasskeyCancelled"].Value)),
                    notSupported: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(localizer["PasskeyNotSupported"].Value)),
                    alreadyRegistered: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(localizer["PasskeyAlreadyRegistered"].Value)),
                    limit: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(localizer["PasskeyLimitReached"].Value)),
                    unavailable: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(localizer["PasskeysUnavailable"].Value)),
                    renamePrompt: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(localizer["PasskeyRenamePrompt"].Value)),
                    removeConfirm: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(localizer["PasskeyRemoveConfirm"].Value))
                }
            });
        });
    </script>
}

