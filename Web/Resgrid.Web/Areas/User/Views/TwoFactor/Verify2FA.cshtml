@model Resgrid.Web.Areas.User.Models.TwoFactor.StepUpVerifyViewModel
@inject IStringLocalizer<Resgrid.Localization.Areas.User.TwoFactor.TwoFactor> localizer
@{
    ViewBag.Title = "Resgrid | " + localizer["VerifyPageTitle"];
    string Js(string key) => Newtonsoft.Json.JsonConvert.SerializeObject(localizer[key].Value);
}

<div class="row wrapper border-bottom white-bg page-heading">
    <div class="col-sm-4">
        <h2>@localizer["VerifyIdentityHeader"]</h2>
        <ol class="breadcrumb">
            <li><a asp-controller="Home" asp-action="Dashboard" asp-route-area="User">@commonLocalizer["HomeModule"]</a></li>
            <li class="active"><strong>@localizer["VerifyPageTitle"]</strong></li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="col-xs-12 col-md-6">
        <div class="wrapper wrapper-content">
            <div class="ibox float-e-margins">
                <div class="ibox-content">
                    <div class="alert alert-info">
                        <i class="fa fa-shield"></i>
                        @localizer["VerifyIdentityDescription"]
                    </div>
                    @if (TempData["StepUpMessage"] is string stepUpMessage)
                    {
                        <div class="alert alert-warning" id="stepUpMessage">@stepUpMessage</div>
                    }
                    @if (Model.HoldingSubmission)
                    {
                        <div class="alert alert-success" id="stepUpHoldingSubmission"><i class="fa fa-floppy-o"></i> @localizer["StepUpHoldingSubmission"]</div>
                    }
                    else if (Model.SubmissionNotHeld)
                    {
                        <div class="alert alert-warning" id="stepUpSubmissionNotHeld">@localizer["StepUpSubmissionNotHeld"]</div>
                    }

                    <form asp-action="Verify2FA" method="post" class="form-horizontal" id="verify2faForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ReturnUrl" />
                        <input type="hidden" asp-for="Scope" />
                        <input type="hidden" asp-for="EntryDepartmentId" />
                        <input type="hidden" asp-for="SubmissionNotHeld" />
                        <div asp-validation-summary="All" class="text-danger"></div>

                        <div class="form-group">
                            <label asp-for="Code" class="col-sm-3 control-label">@localizer["AuthenticatorCodeLabel"]</label>
                            <div class="col-sm-4">
                                <input asp-for="Code" class="form-control" autocomplete="one-time-code"
                                       inputmode="numeric" maxlength="7" placeholder="@localizer["VerificationCodePlaceholder"]"
                                       autofocus />
                                <span asp-validation-for="Code" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-sm-offset-3 col-sm-9">
                                <button type="submit" class="btn btn-primary">@localizer["VerifyButton"]</button>
                                @if (Model.PasskeyAvailable)
                                {
                                    <button type="button" class="btn btn-default" id="mfaUsePasskey"><i class="fa fa-key"></i> @localizer["VerifyWithPasskeyButton"]</button>
                                }
                                @if (Model.ApprovalAvailable)
                                {
                                    <button type="button" class="btn btn-default" id="mfaUseResponder"><i class="fa fa-mobile"></i> @localizer["ApproveWithResponderButton"]</button>
                                }
                                @if (Model.FederatedAvailable)
                                {
                                    <button type="submit" class="btn btn-default" id="mfaUseProvider" form="verifyProviderForm"><i class="fa fa-id-badge"></i> @localizer["VerifyWithProviderButton"]</button>
                                }
                            </div>
                        </div>
                        <div class="well" id="mfaApprovalPanel" style="display: none;">
                            <p>@localizer["ApprovalNumberLabel"]</p>
                            <p class="text-center" style="font-size: 32px; letter-spacing: 4px;"><strong id="mfaApprovalNumber"></strong></p>
                            <p class="text-muted" id="mfaApprovalStatus"></p>
                            <button type="button" class="btn btn-default btn-sm" id="mfaApprovalCancel">@localizer["ApprovalCancelButton"]</button>
                        </div>
                        <div class="alert alert-danger" id="mfaChoiceError" role="alert" style="display: none;"></div>
                    </form>
                    @if (Model.FederatedAvailable)
                    {
                        <form asp-area="" asp-controller="Account" asp-action="SsoSessionBegin" method="post" id="verifyProviderForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="purpose" value="step_up" />
                            <input type="hidden" name="scope" value="@Model.Scope" />
                            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (Model.PasskeyAvailable || Model.ApprovalAvailable)
    {
        <script src="~/js/app/common/passkeys/resgrid.passkeys.js" type="text/javascript"></script>
        <script src="~/js/app/common/passkeys/resgrid.mfa.choice.js" type="text/javascript"></script>
        <script type="text/javascript">
            // Step-up with a Web passkey or a Responder approval (passkey plan sections 7.5 rule 2 and 7.9): the server issues
            // every option, records the evidence and names the page to return to.
            $(function () {
                resgridMfaChoice.init({
                    antiForgeryToken: function () { return $('#verify2faForm input[name="__RequestVerificationToken"]').val(); },
                    extra: function () { return { returnUrl: $('#ReturnUrl').val(), scope: $('#Scope').val(), entry: $('#EntryDepartmentId').val() }; },
                    passkeyOptionsUrl: '@Url.Action("Verify2FAPasskeyOptions", "TwoFactor", new { area = "User" })',
                    verifyPasskeyUrl: '@Url.Action("Verify2FAPasskey", "TwoFactor", new { area = "User" })',
                    requestApprovalUrl: '@Url.Action("Verify2FARequestApproval", "TwoFactor", new { area = "User" })',
                    approvalStatusUrl: '@Url.Action("Verify2FAApprovalStatus", "TwoFactor", new { area = "User" })',
                    completeApprovalUrl: '@Url.Action("Verify2FACompleteApproval", "TwoFactor", new { area = "User" })',
                    messages: {
                        failed: @Html.Raw(Js("LoginMfaFailed")),
                        passkey_failed: @Html.Raw(Js("PasskeyFailed")),
                        passkey_cancelled: @Html.Raw(Js("PasskeyCancelled")),
                        passkey_not_supported: @Html.Raw(Js("PasskeyNotSupported")),
                        approval_waiting: @Html.Raw(Js("ApprovalWaiting")),
                        approval_denied: @Html.Raw(Js("ApprovalDenied")),
                        approval_expired: @Html.Raw(Js("ApprovalExpired")),
                        approval_unavailable: @Html.Raw(Js("ApprovalUnavailable"))
                    }
                });
            });
        </script>
    }
}
