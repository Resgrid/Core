@using Resgrid.Web
@using Resgrid.Web.Models
@using Resgrid.Web.Models.AccountViewModels
@using Microsoft.AspNetCore.Identity
@using Resgrid.Web.Helpers
@using Resgrid.Model.Helpers
@using Resgrid.Model
@using SelectList = Microsoft.AspNetCore.Mvc.Rendering.SelectList
@using FormMethod = Microsoft.AspNetCore.Mvc.Rendering.FormMethod
@using SelectListItem = Microsoft.AspNetCore.Mvc.Rendering.SelectListItem
@using Microsoft.Extensions.Localization
@addTagHelper *, WebOptimizer.Core
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Resgrid.Web
@inject IStringLocalizer<Resgrid.Localization.Common> commonLocalizer
@* Text placed inside a JavaScript string, whether in a script block or an inline on*="..." handler,
   goes through JsEncoder.Encode rather than Razor's HTML encoding. The browser decodes &#x27; back to
   an apostrophe before an inline handler runs, so an HTML-encoded "l'élément" ends the JS string early,
   and in a script block the entities are never decoded at all. Script that puts the text into HTML
   escapes it there. *@
@inject System.Text.Encodings.Web.JavaScriptEncoder JsEncoder

