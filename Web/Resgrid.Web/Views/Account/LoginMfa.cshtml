@using Microsoft.Extensions.Localization
@model Resgrid.Web.Models.AccountViewModels.LoginMfaViewModel
@inject IStringLocalizer<Resgrid.Localization.Areas.User.TwoFactor.TwoFactor> localizer
@{
    ViewData["Title"] = "Resgrid | " + localizer["LoginTwoFactorHeader"];
    Layout = null;
    string Js(string key) => Newtonsoft.Json.JsonConvert.SerializeObject(localizer[key].Value);
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    @Html.Partial("_StylePartial")
</head>
<body class="gray-bg">
    <div class="loginColumns animated fadeInDown">
        <div class="row">
            <div class="col-md-6 col-md-offset-3">
                <div style="text-align: center;">
                    <img src="~/images/Resgrid_JustText.png" style="width: 200px;" />
                </div>
                <h3>@localizer["LoginTwoFactorHeader"]</h3>
                <p>@localizer["LoginMfaDescription"]</p>

                <div class="ibox-content">
                    <form asp-action="LoginMfa" asp-controller="Account" method="post" class="m-t" id="loginMfaForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ReturnUrl" />
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div asp-validation-summary="All" class="alert alert-danger"></div>
                        }

                        @foreach (var method in Model.Methods)
                        {
                            if (method == "totp")
                            {
                                <div class="form-group" id="loginMfaTotp">
                                    <label asp-for="Code">@localizer["AuthenticatorCodeInputLabel"]</label>
                                    <input asp-for="Code" class="form-control"
                                           placeholder="@localizer["VerificationCodePlaceholder"]"
                                           autocomplete="one-time-code"
                                           inputmode="numeric"
                                           maxlength="7"
                                           autofocus="@(Model.Preferred == "totp")" />
                                    <span asp-validation-for="Code" class="text-danger small"></span>
                                </div>
                                <button type="submit" class="btn btn-primary block full-width m-b">@localizer["VerifyCodeButton"]</button>
                            }
                            else if (method == "passkey")
                            {
                                <button type="button" class="btn @(Model.Preferred == "passkey" ? "btn-primary" : "btn-default") block full-width m-b" id="mfaUsePasskey">
                                    <i class="fa fa-key"></i> @localizer["VerifyWithPasskeyButton"]
                                </button>
                            }
                            else if (method == "passkey_approval")
                            {
                                <button type="button" class="btn @(Model.Preferred == "passkey_approval" ? "btn-primary" : "btn-default") block full-width m-b" id="mfaUseResponder">
                                    <i class="fa fa-mobile"></i> @localizer["ApproveWithResponderButton"]
                                </button>
                            }
                            else if (method == "federated")
                            {
                                <button type="submit" formaction="@Url.Action("LoginMfaBeginFederated", "Account")" formnovalidate="formnovalidate"
                                        class="btn @(Model.Preferred == "federated" ? "btn-primary" : "btn-default") block full-width m-b" id="mfaUseProvider">
                                    <i class="fa fa-id-badge"></i> @localizer["VerifyWithProviderButton"]
                                </button>
                            }
                        }

                        <div class="well" id="mfaApprovalPanel" style="display: none;">
                            <p>@localizer["ApprovalNumberLabel"]</p>
                            <p class="text-center" style="font-size: 32px; letter-spacing: 4px;"><strong id="mfaApprovalNumber"></strong></p>
                            <p class="text-muted" id="mfaApprovalStatus"></p>
                            <button type="button" class="btn btn-default btn-sm" id="mfaApprovalCancel">@localizer["ApprovalCancelButton"]</button>
                        </div>
                        <div class="alert alert-danger" id="mfaChoiceError" role="alert" style="display: none;"></div>

                        @if (!Resgrid.Web.Helpers.WebSharedSession.IsWorkstation(Context.Request))
                        {
                            @* A shared workstation is never remembered (plan section 12.5.2). *@
                            <div class="form-group">
                                <div class="checkbox">
                                    <label><input asp-for="RememberBrowser" /> @localizer["RememberBrowserLabel"]</label>
                                </div>
                            </div>
                        }

                        @if (Model.RecoveryAvailable)
                        {
                            <p class="m-t text-center">
                                <a asp-action="LoginWithRecoveryCode" asp-route-returnUrl="@Model.ReturnUrl">@localizer["UseRecoveryCodeLink"]</a>
                            </p>
                        }
                        <p class="text-center">
                            <a asp-action="LostFactor" asp-route-returnUrl="@Model.ReturnUrl" id="lostFactorLink">@localizer["LostFactorLink"]</a>
                        </p>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @Html.Partial("_ScriptsPartial")
    <partial name="_ValidationScriptsPartial" />
    @if (Model.Methods.Contains("passkey") || Model.Methods.Contains("passkey_approval"))
    {
        <script src="~/js/app/common/passkeys/resgrid.passkeys.js" type="text/javascript"></script>
        <script src="~/js/app/common/passkeys/resgrid.mfa.choice.js" type="text/javascript"></script>
        <script type="text/javascript">
            $(function () {
                resgridMfaChoice.init({
                    antiForgeryToken: function () { return $('#loginMfaForm input[name="__RequestVerificationToken"]').val(); },
                    extra: function () { return { returnUrl: $('#ReturnUrl').val(), rememberBrowser: $('#RememberBrowser').is(':checked') }; },
                    passkeyOptionsUrl: '@Url.Action("LoginMfaPasskeyOptions", "Account")',
                    verifyPasskeyUrl: '@Url.Action("LoginMfaPasskey", "Account")',
                    requestApprovalUrl: '@Url.Action("LoginMfaRequestApproval", "Account")',
                    approvalStatusUrl: '@Url.Action("LoginMfaApprovalStatus", "Account")',
                    completeApprovalUrl: '@Url.Action("LoginMfaCompleteApproval", "Account")',
                    messages: {
                        failed: @Html.Raw(Js("LoginMfaFailed")),
                        passkey_failed: @Html.Raw(Js("PasskeyFailed")),
                        passkey_cancelled: @Html.Raw(Js("PasskeyCancelled")),
                        passkey_not_supported: @Html.Raw(Js("PasskeyNotSupported")),
                        approval_waiting: @Html.Raw(Js("ApprovalWaiting")),
                        approval_denied: @Html.Raw(Js("ApprovalDenied")),
                        approval_expired: @Html.Raw(Js("ApprovalExpired")),
                        approval_unavailable: @Html.Raw(Js("ApprovalUnavailable")),
                        mfa_method_not_allowed: @Html.Raw(Js("LoginMfaMethodUnavailable")),
                        maximum_sessions: @Html.Raw(Js("LoginMfaMaximumSessions")),
                        too_many_attempts: @Html.Raw(Js("LoginMfaTooManyAttempts")),
                        mfa_transaction_expired: @Html.Raw(Js("LoginMfaExpired")),
                        mfa_transaction_invalid: @Html.Raw(Js("LoginMfaInvalid")),
                        policy_changed: @Html.Raw(Js("LoginMfaPolicyChanged"))
                    }
                });
            });
        </script>
    }
</body>
</html>
