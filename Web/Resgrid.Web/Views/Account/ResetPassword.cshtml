@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
	Layout = "_RecoveryLayout";
}

<link rel="stylesheet" href="~/clib/validate-password-requirements/jquery.passwordRequirements.css" />

<h2>@ViewData["Title"]</h2>

<form id="recovery-fragment-form" asp-controller="Account" asp-action="BeginPasswordReset" method="post" hidden>
	@Html.AntiForgeryToken()
	<input id="recovery-fragment-token" name="token" type="hidden" />
</form>

@if (Model.InvalidOrExpired)
{
    <div class="alert alert-danger">This password reset link is invalid, expired, or has already been used. Request a new link from the forgot-password page.</div>
}
else
{
    <form asp-controller="Account" asp-action="ResetPassword" method="post" class="form-horizontal">
        <h4>Choose a new password</h4>
        <div class="alert alert-warning"><strong>Security notice:</strong> Changing your password will immediately log you out of every Resgrid web, mobile, dispatch, and big-board session and revoke all access and refresh tokens.</div>
        <hr />
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="form-group">
            <label asp-for="Password" class="col-md-2 control-label"></label>
            <div class="col-md-10">
				<input asp-for="Password" class="pr-password form-control" data-min-length="@Model.MinPasswordLength" />
                <span asp-validation-for="Password" class="text-danger"></span>
                <div class="well well-sm m-t-xs">
                    <strong>Password requirements:</strong>
                    <ul class="m-t-xs m-b-none small">
                        <li>At least @Model.MinPasswordLength characters</li>
                        <li>At least one uppercase and one lowercase letter</li>
                        <li>At least one number</li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label asp-for="ConfirmPassword" class="col-md-2 control-label"></label>
            <div class="col-md-10">
                <input asp-for="ConfirmPassword" class="form-control" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
        </div>
        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <button type="submit" class="btn btn-primary">Reset password</button>
            </div>
        </div>
    </form>
}

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="~/clib/validate-password-requirements/jquery.passwordRequirements.min.js"></script>
	<script src="~/js/app/public/resgrid.password-recovery.js" asp-append-version="true"></script>
}
