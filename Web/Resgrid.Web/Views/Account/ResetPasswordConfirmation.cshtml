@{
    ViewData["Title"] = "Reset password confirmation";
    // The reset responses carry a script-src 'self' policy: the recovery layout has no inline script for it to block.
    Layout = "_RecoveryLayout";
}

<h1>@ViewData["Title"].</h1>
<p>
    Your password has been reset and every existing session was signed out. Please <a asp-controller="Account" asp-action="LogOn">click here to log in</a> with your new password.
</p>
@if (ViewData["ResetUserName"] is string userName && !string.IsNullOrWhiteSpace(userName))
{
    <p>Your username is <strong>@userName</strong>.</p>
}
