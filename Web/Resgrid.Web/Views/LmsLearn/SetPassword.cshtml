@model Resgrid.Web.Models.LmsLearn.LmsLearnPasswordModel
@inject IStringLocalizer<Resgrid.Localization.Areas.User.LmsExternalLearners.LmsExternalLearners> localizer
@* An invitation's first password, or a reset; the token comes from the e-mailed link and is posted back, never the address. *@
@{
    ViewData["Title"] = localizer["Portal.ChoosePassword"].Value;
    var key = ViewData["PortalKey"] as string;
}
<div class="rgl-panel" style="max-width: 480px; margin: 0 auto;">
    <h2><i class="fa fa-key" aria-hidden="true"></i> @localizer["Portal.ChoosePassword"]</h2>
    @if (!string.IsNullOrEmpty(Model.Email))
    {
        <p class="text-muted">@Model.Email</p>
    }
    <form method="post" action="~/Learn/@key/@(Model.Invite ? "Accept" : "Reset")" data-submit-once>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Token" />
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <div class="form-group">
            <label asp-for="Password">@localizer["Portal.Password"]</label>
            <input asp-for="Password" class="form-control" autocomplete="new-password" aria-describedby="rgl-pwd-help" required />
            <span id="rgl-pwd-help" class="help-block">@localizer["Portal.PasswordHelp"]</span>
        </div>
        <div class="form-group">
            <label asp-for="ConfirmPassword">@localizer["Portal.ConfirmPassword"]</label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" required />
        </div>
        <button type="submit" class="btn btn-rgl"><i class="fa fa-check" aria-hidden="true"></i> @localizer["Portal.SetPassword"]</button>
    </form>
</div>
